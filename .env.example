# Copy to .env (gitignored) and fill with a strong password.
# docker compose up  will refuse to start without SQL_SA_PASSWORD.
SQL_SA_PASSWORD=REPLACE_WITH_StrongSqlPassword_123!
# All sample values in this file start with REPLACE_WITH_ so that an unedited
# copy can never ship weak credentials: Program.cs refuses to start in
# production when Jwt:Key contains "REPLACE_WITH" or is shorter than 32 chars.
# Replace every placeholder with a real secret before running docker compose up.

# Strong JWT signing secret (>= 32 chars). docker-compose.yml reads exactly
# this name and injects it into the container as Jwt__Key, which is the
# .NET configuration form of Jwt:Key. Set JWT_KEY only - a second
# "Jwt__Key=" line here would be inert, because Compose does not inject
# .env keys into the service automatically and nothing reads that name.
JWT_KEY=REPLACE_WITH_<64-char-random>

# Strong seed passwords required by docker-compose.yml for the three built-in
# accounts created at startup (Seed__AdminPassword, Seed__AccountantPassword,
# Seed__WarehousePassword in the container). No defaults ship any more: the
# production startup gate refuses to boot when these are missing, empty, or
# still set to a development value.
SEED_ADMIN_PASSWORD=REPLACE_WITH_StrongAdminPassword_123!
SEED_ACCOUNTANT_PASSWORD=REPLACE_WITH_StrongAccountantPassword_123!
SEED_WAREHOUSE_PASSWORD=REPLACE_WITH_StrongWarehousePassword_123!