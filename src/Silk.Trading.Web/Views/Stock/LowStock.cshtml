@model List<Silk.Trading.Web.ViewModels.Dashboard.LowStockItemViewModel>
@{
    ViewData["Title"] = "انخفاض المخزون";
}

<div class="page-header">
    <h2><i class="bi bi-exclamation-triangle text-danger"></i> انخفاض المخزون</h2>
</div>

<div class="card mb-4 border-warning">
    <div class="card-body py-2">
        <p class="mb-0 text-warning-emphasis fw-bold">
            <i class="bi bi-exclamation-triangle"></i> الأصناف التالية انخفض رصيدها عن الحد الأدنى (@Model.Count) وتحتاج إلى إعادة توريد.
        </p>
    </div>
</div>

<div class="table-container">
    <table class="table table-hover mb-0">
        <thead><tr><th scope="col">الكود</th><th scope="col">الصنف</th><th scope="col">التصنيف</th><th scope="col">الرصيد الحالي (عدد/كمية)</th><th scope="col">الحد الأدنى</th><th scope="col">النقص</th></tr></thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><code>@(item.Code ?? "—")</code></td>
                    <td><strong>@item.Name</strong></td>
                    <td><span class="badge bg-secondary">@item.CategoryName</span></td>
                    <td>
                        @if (item.IsCountLow)
                        { <span class="text-danger fw-bold">@item.CurrentCount.ToString("N2")</span> }
                        else
                        { <span>@item.CurrentCount.ToString("N2")</span> }
                        /
                        @if (item.IsQuantityLow)
                        { <span class="text-danger fw-bold">@item.CurrentQuantity.ToString("N2")</span> }
                        else
                        { <span>@item.CurrentQuantity.ToString("N2")</span> }
                    </td>
                    <td>@item.MinCount.ToString("N2") / @item.MinQuantity.ToString("N2")</td>
                    <td class="text-danger fw-bold">
                        @if (item.IsCountLow) { <span>عدد: -@item.CountDeficit.ToString("N2")</span> }
                        @if (item.IsQuantityLow) { <span>كمية: -@item.QuantityDeficit.ToString("N2")</span> }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-check-circle" style="font-size:3rem;"></i>
        <p class="mt-2">لا توجد أصناف بمخزون منخفض</p>
    </div>
}

<div class="mt-3">
    <a asp-controller="Stock" asp-action="Report" class="btn btn-outline-primary"><i class="bi bi-clipboard2-data"></i> تقرير المخزون</a>
</div>