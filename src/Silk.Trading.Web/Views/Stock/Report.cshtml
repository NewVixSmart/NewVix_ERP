@model Silk.Trading.Web.ViewModels.Stock.StockReportViewModel
@{
    ViewData["Title"] = "تقرير المخزون الكامل";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-clipboard2-data text-primary"></i> تقرير المخزون الكامل</h2>
    <div class="d-flex gap-2">
        <a asp-controller="Reports" asp-action="ExportItemsXlsx" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel"></i> تصدير الأصناف</a>
        <a asp-controller="Reports" asp-action="ExportStockXlsx" class="btn btn-outline-primary"><i class="bi bi-file-earmark-excel"></i> لقطة المخزون</a>
    </div>
</div>

<div class="card mb-4"><div class="card-body">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-4">
            <label class="form-label" for="searchInput">بحث</label>
            <input type="text" name="search" value="@Model.Search" class="form-control" id="searchInput" placeholder="اسم الصنف أو الكود..." />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="categoryFilter">التصنيف</label>
            <select name="categoryId" id="categoryFilter" class="form-select">
                <option value="">الكل</option>
                @foreach (var c in Model.Categories)
                { <option value="@c.Id" selected="@(Model.CategoryId?.ToString() == c.Id.ToString())">@c.Name</option> }
            </select>
        </div>
        <div class="col-md-3">
            <div class="form-check form-switch mt-4">
                <input type="checkbox" name="lowOnly" value="true" class="form-check-input" id="lowOnly" checked="@(Model.LowOnly)" />
                <label class="form-check-label" for="lowOnly">فقط المخزون المنخفض</label>
            </div>
        </div>
        <div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> تصفية</button></div>
    </form>
</div></div>

<div class="row g-3 mb-4">
    <div class="col-md-3"><div class="stat-card text-center"><div class="text-muted small">عدد الأصناف</div><h4 class="mb-0">@Model.TotalItems</h4></div></div>
    <div class="col-md-3"><div class="stat-card text-center"><div class="text-muted small">أصناف منخفضة</div><h4 class="mb-0 text-danger">@Model.LowItems</h4></div></div>
    <div class="col-md-3"><div class="stat-card text-center"><div class="text-muted small">إجمالي الكمية</div><h4 class="mb-0">@Model.TotalQuantity.ToString("N2")</h4></div></div>
    <div class="col-md-3"><div class="stat-card text-center"><div class="text-muted small">قيمة المخزون (بسعر الشراء)</div><h4 class="mb-0 text-success">@Model.TotalValue.ToString("N2")</h4></div></div>
</div>

<div class="table-container">
    <table class="table table-hover mb-0">
        <thead><tr><th scope="col">الكود</th><th scope="col">الصنف</th><th scope="col">النوع</th><th scope="col">التصنيف</th><th scope="col">الرصيد الحالي</th><th scope="col">الحد الأدنى</th><th scope="col">الحالة</th><th scope="col">القيمة</th></tr></thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                bool low = (item.CurrentCount <= item.MinCount && item.MinCount > 0) || (item.CurrentQuantity <= item.MinQuantity && item.MinQuantity > 0);
                <tr>
                    <td><code>@(item.Code ?? "—")</code></td>
                    <td><strong>@item.Name</strong></td>
                    <td>
                        <span class="badge bg-primary">@(item.ItemType?.Name ?? "—")</span>
                    </td>
                    <td><span class="badge bg-secondary">@item.Category.Name</span></td>
                    <td>
                        @item.CurrentCount.ToString("N2") @(item.CountUnit?.ShortName ?? item.CountUnit?.Name ?? "")<br/>
                        <small class="text-muted">@item.CurrentQuantity.ToString("N2") @(item.QuantityUnit?.ShortName ?? item.QuantityUnit?.Name ?? "")</small>
                    </td>
                    <td>
                        @item.MinCount.ToString("N2")<br/>
                        <small class="text-muted">@item.MinQuantity.ToString("N2")</small>
                    </td>
                    <td>
                        @if (low)
                        { <span class="badge bg-danger">منخفض</span> }
                        else
                        { <span class="badge bg-success">كافٍ</span> }
                    </td>
                    <td class="fw-bold">@(((item.QuantityUnitId.HasValue || item.CurrentQuantity > 0) ? item.CurrentQuantity * item.PurchasePrice : item.CurrentCount * item.PurchasePrice).ToString("N2")) ج.م</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Items.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox" style="font-size:3rem;"></i>
        <p class="mt-2">لا توجد أصناف مطابقة</p>
    </div>
}

<partial name="_Pager" />