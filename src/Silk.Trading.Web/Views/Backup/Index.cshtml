@model IReadOnlyList<Silk.Trading.Web.Services.BackupFileInfo>
@inject Silk.Trading.Web.Services.IBackupService Backup
@{ ViewData["Title"] = "النسخ الاحتياطي والاستعادة"; }

<div class="page-header">
    <h2><i class="bi bi-database text-primary"></i> النسخ الاحتياطي والاستعادة</h2>
</div>

<p class="text-muted mb-3">أنشئ نسخًا احتياطية كاملة لقاعدة البيانات، واستعدها عند الحاجة، أو أعد ضبط النظام بالكامل.</p>

<div class="row g-4">
    <div class="col-xl-4">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-plus-circle" aria-hidden="true"></i> إنشاء نسخة احتياطية</div>
            <div class="card-body">
                <p class="card-text">تُحفظ النسخة كملف <code>.bak</code> في مجلد Backups داخل التطبيق.</p>
                <form asp-action="Create" method="post" data-loading-submit data-loading-text="جارٍ إنشاء النسخة...">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary"><i class="bi bi-database-add" aria-hidden="true"></i> إنشاء نسخة احتياطية الآن</button>
                </form>
                <div class="mt-3 small text-muted d-flex align-items-center gap-1">
                    <i class="bi bi-folder2-open" aria-hidden="true"></i>
                    <span dir="ltr">@Backup.BackupDirectory</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <div class="card h-100">
            <div class="card-header"><i class="bi bi-archive" aria-hidden="true"></i> النسخ الاحتياطية المتاحة</div>
            <div class="card-body p-0">
                <div class="table-container">
                    <table class="table table-hover mb-0">
                        <caption class="visually-hidden">النسخ الاحتياطية المتاحة</caption>
                        <thead>
                            <tr>
                                <th scope="col">اسم الملف</th>
                                <th scope="col">الحجم</th>
                                <th scope="col">تاريخ الإنشاء</th>
                                <th scope="col" class="text-center">إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in Model)
                            {
                                var sizeText = f.LengthBytes < 1024 * 1024
                                    ? Math.Round(f.LengthBytes / 1024d, 1) + " KB"
                                    : Math.Round(f.LengthBytes / 1024d / 1024d, 2) + " MB";
                                <tr>
                                    <td dir="ltr" class="text-start"><code>@f.FileName</code></td>
                                    <td>@sizeText</td>
                                    <td>@f.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                    <td class="text-center">
                                        <div class="d-flex gap-1 justify-content-center">
                                            <a asp-action="Download" asp-route-fileName="@f.FileName" class="btn btn-sm btn-outline-secondary" aria-label="تنزيل @f.FileName"><i class="bi bi-download" aria-hidden="true"></i></a>
                                            <form asp-action="Restore" method="post" class="d-inline" data-confirm="سيتم استبدال قاعدة البيانات الحالية بهذه النسخة. متابعة؟" data-confirm-ok="استعادة" data-loading-submit data-loading-text="جارٍ الاستعادة...">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="fileName" value="@f.FileName" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary" aria-label="استعادة @f.FileName"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>
                                            </form>
                                            <form asp-action="Delete" method="post" class="d-inline" data-confirm="حذف هذه النسخة الاحتياطية نهائيًا؟" data-confirm-ok="حذف" data-loading-submit data-loading-text="جارٍ الحذف...">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="fileName" value="@f.FileName" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="حذف @f.FileName"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!Model.Any())
                {
                    <div class="empty-state text-center py-5">
                        <div class="empty-icon"><i class="bi bi-inbox"></i></div>
                        <h4>لا توجد نسخ احتياطية بعد</h4>
                        <p class="text-muted">أنشئ أول نسخة احتياطية لحماية بياناتك.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<section class="card border-danger mt-4" aria-labelledby="dangerZoneTitle">
    <div class="card-header bg-danger text-white" id="dangerZoneTitle"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i> منطقة الخطر — إعادة ضبط النظام</div>
    <div class="card-body">
        <p class="card-text">تحذير شديد: حذف كامل لكل بيانات النظام (الأصناف، المبيعات، المشتريات، الأصول/القيود، العملاء، الموردين، المستخدمين ما عدا admin، الإعدادات، والبيانات التجريبية). لا يمكن التراجع.</p>
        <form asp-action="Reset" method="post" data-confirm="متأكد؟ سيفقد كل شيء وسيُحذف نهائيًا." data-confirm-ok="نعم، احذف كل شيء" data-loading-submit data-loading-text="جارٍ إعادة الضبط...">
            @Html.AntiForgeryToken()
            <div class="d-flex flex-wrap align-items-center gap-2">
                <div>
                    <label for="confirmText" class="form-label mb-1">اكتب كلمة التأكيد <strong>حذف نهائي</strong> للمتابعة</label>
                    <input type="text" name="confirmText" id="confirmText" class="form-control form-control-sm w-auto" placeholder="حذف نهائي" autocomplete="off" required aria-describedby="confirmHelp" />
                    <small id="confirmHelp" class="form-text text-muted">هذا الإجراء نهائي ولا يمكن التراجع عنه.</small>
                </div>
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash3" aria-hidden="true"></i> إعادة ضبط النظام بالكامل</button>
            </div>
        </form>
    </div>
</section>