@model Silk.Trading.Web.ViewModels.Core.ItemListViewModel
@inject Silk.Trading.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "الأصناف"; }

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h2><i class="bi bi-box-seam text-primary"></i> الأصناف</h2>
    <div class="d-flex gap-2 flex-wrap">
        @if (await Perm.HasAsync("Reports.Export"))
        {
        <a asp-controller="Reports" asp-action="ExportItemsXlsx" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel"></i> تصدير Excel
        </a>
        }
        @if (await Perm.HasAsync("Items.Create"))
        {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> صنف جديد
        </a>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label" for="searchInput">بحث</label>
                <input type="text" name="search" value="@Model.Search" class="form-control" id="searchInput" placeholder="اسم الصنف أو الكود..." />
            </div>
            <div class="col-md-3">
                <label class="form-label" for="categoryFilter">التصنيف</label>
                <select name="categoryId" class="form-select" id="categoryFilter">
                    <option value="">الكل</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id" selected="@(Model.CategoryId?.ToString() == cat.Id.ToString())">@cat.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> بحث</button>
            </div>
        </form>
    </div>
</div>

<div class="table-container">
    <table class="table table-hover mb-0">
        <thead>
            <tr>
                <th scope="col">الكود</th>
                <th scope="col">اسم الصنف</th>
                <th scope="col">النوع</th>
                <th scope="col">التصنيف</th>
                <th scope="col">العدد / الكمية</th>
                <th scope="col">الرصيد الحالي</th>
                <th scope="col" class="text-center">إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td><code>@item.Code</code></td>
                    <td><strong>@item.Name</strong></td>
                    <td>
                        <span class="badge bg-primary">@(item.ItemType?.Name ?? "—")</span>
                    </td>
                    <td><span class="badge bg-secondary">@item.Category.Name</span></td>
                    <td>
                        <small>عدد: @(item.CountUnit?.Name ?? "—")، كمية: @(item.QuantityUnit?.Name ?? "—")</small>
                    </td>
                    <td>
                        @{
                            bool low = (item.CurrentCount <= item.MinCount && item.MinCount > 0) || (item.CurrentQuantity <= item.MinQuantity && item.MinQuantity > 0);
                        }
                        <span class="badge @(low ? "bg-danger" : "bg-success")">
                            @item.CurrentCount / @item.CurrentQuantity
                        </span>
                    </td>
                    <td class="text-center">
                        @if (await Perm.HasAsync("Items.Edit"))
                        {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" aria-label="تعديل @item.Name">
                            <i class="bi bi-pencil" aria-hidden="true"></i>
                        </a>
                        }
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" aria-label="تفاصيل @item.Name">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </a>
                        @if (await Perm.HasAsync("Items.Delete"))
                        {
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من الحذف؟')">
                            <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="حذف @item.Name">
                                <i class="bi bi-trash" aria-hidden="true"></i>
                            </button>
                        </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" />

@if (!Model.Items.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox" style="font-size:3rem;"></i>
        <p class="mt-2">لا توجد أصناف</p>
    </div>
}
