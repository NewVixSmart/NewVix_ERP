@model IEnumerable<Silk.Trading.Web.Models.Sales.SaleReturn>
@inject Silk.Trading.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "مرتجعات البيع"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-arrow-return-left text-primary"></i> مرتجعات البيع</h2>
    @if (await Perm.HasAsync("SaleReturns.Create"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> مرتجع جديد</a>
    }
</div>

<div class="table-container">
    <table class="table table-hover mb-0">
        <thead><tr><th scope="col">رقم المرتجع</th><th scope="col">العميل</th><th scope="col">التاريخ</th><th scope="col">الإجمالي</th><th scope="col">الحالة</th><th scope="col" class="text-center">إجراء</th></tr></thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td><code>@r.ReturnNumber</code></td>
                    <td><strong>@(r.Customer?.Name ?? "—")</strong></td>
                    <td>@r.ReturnDate.ToString("dd/MM/yyyy")</td>
                    <td class="fw-bold">@r.TotalAmount.ToString("N2") ج.م</td>
                    <td>
                        @if (r.Status == Silk.Trading.Web.Models.Accounting.ReturnStatus.Posted)
                        {
                            <span class="badge bg-success">مرحّل</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">مسودة</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-info" aria-label="عرض مرتجع البيع @r.ReturnNumber"><i class="bi bi-eye"></i></a>
                        @if (r.Status == Silk.Trading.Web.Models.Accounting.ReturnStatus.Draft && await Perm.HasAsync("SaleReturns.Post"))
                        {
                            <form asp-action="Post" asp-route-id="@r.Id" method="post" class="d-inline" onclick="return confirm('هل تريد ترحيل هذا المرتجع؟')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-success" aria-label="ترحيل مرتجع البيع @r.ReturnNumber"><i class="bi bi-check-circle"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" />
