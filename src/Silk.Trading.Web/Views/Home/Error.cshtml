@model Silk.Trading.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "خطأ";
}

<div class="text-center py-5">
    <h1 class="display-1 text-danger"><i class="bi bi-exclamation-octagon"></i></h1>
    <h2 class="mb-3">حدث خطأ أثناء معالجة طلبك</h2>
    <p class="text-muted mb-4">نعتذر عن الإزعاج، يرجى المحاولة مرة أخرى.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">المعرف: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="bi bi-house"></i> العودة للرئيسية</a>
</div>