@model Silk.Trading.Web.ViewModels.Core.BrandingViewModel
@{
    ViewData["Title"] = "العلامة التجارية والمظهر";
}
<div class="d-flex flex-wrap align-items-center gap-2 mb-4">
    <h1 class="h3 mb-0">
        <i class="bi bi-palette text-primary" aria-hidden="true"></i> العلامة التجارية والمظهر
    </h1>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm ms-auto"><i class="bi bi-arrow-right" aria-hidden="true"></i> العودة للإعدادات</a>
</div>

<form asp-action="SaveBranding" method="post" enctype="multipart/form-data" class="row g-4" data-loading-submit data-loading-text="جاري الحفظ...">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-building" aria-hidden="true"></i> بيانات الشركة
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label asp-for="CompanyName" class="form-label"></label>
                    <input asp-for="CompanyName" class="form-control" />
                    <span asp-validation-for="CompanyName" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Tagline" class="form-label"></label>
                    <input asp-for="Tagline" class="form-control" placeholder="نظام التجارة الفاخر" />
                </div>
                <div class="mb-3">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" />
                </div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                    </div>
                </div>
                <div class="mt-3">
                    <label asp-for="TaxNumber" class="form-label"></label>
                    <input asp-for="TaxNumber" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-image" aria-hidden="true"></i> شعار الشركة
            </div>
            <div class="card-body">
                @if (Model.HasLogo)
                {
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <img class="brand-logo" style="width:72px;height:72px;" src="@Model.LogoDataUri" alt="@Model.CompanyName" />
                        <div>
                            <div class="fw-semibold">الشعار الحالي</div>
                            <small class="text-muted d-block">@(Model.LogoFileName ?? "شعار مرفوع") — يظهر في الشريط الجانبي، صفحة الدخول، الفواتير، والطباعة.</small>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info small" role="status">لم يتم رفع شعار بعد. سيُستخدم الحرف الأول من اسم الشركة كشعار مبدئي.</div>
                }
                <div class="mb-3">
                    <label asp-for="LogoFile" class="form-label">رفع شعار جديد</label>
                    <input asp-for="LogoFile" class="form-control" type="file" accept="image/png,image/svg+xml,image/jpeg,image/webp,image/gif" />
                    <small class="text-muted">صيغ PNG أو SVG أو JPEG أو WEBP بحد أقصى 2 ميجابايت.</small>
                </div>
                @if (Model.HasLogo)
                {
                    <div class="form-check">
                        <input asp-for="RemoveLogo" class="form-check-input" />
                        <label asp-for="RemoveLogo" class="form-check-label">إزالة الشعار الحالي</label>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-palette2" aria-hidden="true"></i> لوحة ألوان النظام
            </div>
            <div class="card-body">
                <p class="text-muted small mb-3">اختر لوحة جاهزة تناسب هوية شركتك أو خصّص الألوان يدويًا. ستُطبَّق فورًا على كامل النظام (الأزرار، الشريط الجانبي، التقارير، الطباعة...).</p>

                <input type="hidden" asp-for="SelectedPreset" />

                <div class="row g-2 mb-4">
                    @foreach (var preset in Model.Presets)
                    {
                        <div class="col-6 col-md-3">
                            <label class="preset-card @(Model.SelectedPreset == preset.Id ? "selected" : "")">
                                <input type="radio" name="presetRadio" value="@preset.Id"
                                       class="d-none"
                                       data-primary="@preset.Primary"
                                       data-accent="@preset.Accent"
                                       data-sidebar="@preset.SidebarBg"
                                       data-page="@preset.PageBg"
                                       @(Model.SelectedPreset == preset.Id ? "checked" : "") />
                                <span class="preset-name">@preset.NameAr</span>
                                <span class="preset-swatches" aria-hidden="true">
                                    <span style="background:@preset.Primary"></span>
                                    <span style="background:@preset.Accent"></span>
                                    <span style="background:@preset.SidebarBg"></span>
                                    <span style="background:@preset.PageBg"></span>
                                </span>
                            </label>
                        </div>
                    }
                    @if (string.IsNullOrEmpty(Model.SelectedPreset))
                    {
                        <div class="col-12">
                            <div class="form-check">
                                <input type="radio" name="presetRadio" value="" id="presetCustom" class="form-check-input" checked />
                                <label class="form-check-label" for="presetCustom">ألوان مخصصة</label>
                            </div>
                        </div>
                    }
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6 col-md-3">
                        <label asp-for="Primary" class="form-label">اللون الأساسي</label>
                        <div class="input-group">
                            <input asp-for="Primary" type="color" class="form-control form-control-color" title="اللون الأساسي" />
                            <input id="PrimaryHex" name="Primary" type="text" class="form-control" placeholder="#0b7a54" />
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <label asp-for="Accent" class="form-label">اللون الذهبي</label>
                        <div class="input-group">
                            <input asp-for="Accent" type="color" class="form-control form-control-color" title="اللون الذهبي" />
                            <input id="AccentHex" name="Accent" type="text" class="form-control" placeholder="#b98b12" />
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <label asp-for="SidebarBg" class="form-label">لون الشريط الجانبي</label>
                        <div class="input-group">
                            <input asp-for="SidebarBg" type="color" class="form-control form-control-color" title="لون الشريط الجانبي" />
                            <input id="SidebarBgHex" name="SidebarBg" type="text" class="form-control" placeholder="#ffffff" />
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <label asp-for="PageBg" class="form-label">لون خلفية الصفحات</label>
                        <div class="input-group">
                            <input asp-for="PageBg" type="color" class="form-control form-control-color" title="لون خلفية الصفحات" />
                            <input id="PageBgHex" name="PageBg" type="text" class="form-control" placeholder="#f5f8f6" />
                        </div>
                    </div>
                </div>

                <div class="border rounded-3 overflow-hidden">
                    <div class="d-flex" id="themePreview">
                        <div class="p-3 flex-grow-1" id="prevPage" style="background:#f5f8f6;" role="img" aria-label="معاينة لوحة الألوان">
                            <span class="badge rounded-pill" id="prevPrimary" style="background:#0b7a54;color:#fff;">زر أساسي</span>
                            <span class="badge rounded-pill" id="prevAccent" style="background:#b98b12;color:#fff;">لمسة ذهبية</span>
                            <div class="rounded-2 p-2 mt-2 small" id="prevSidebar" style="background:#ffffff;color:#22302c;border:1px solid #e3eae7;">شريط جانبي — نص</div>
                        </div>
                    </div>
                    <div class="bg-white border-top small text-muted p-2">معاينة حية — احرص على تباين مناسب للنصوص (4.5:1 على الأقل).</div>
                </div>
            </div>
            <div class="card-footer text-end">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle" aria-hidden="true"></i> حفظ العلامة التجارية</button>
            </div>
        </div>
    </div>
</form>

<script nonce="@Context.GetCspNonce()">
    (function () {
        function isLight(hex) {
            var c = hex.replace('#', '');
            if (c.length === 3) c = c[0] + c[0] + c[1] + c[1] + c[2] + c[2];
            var r = parseInt(c.slice(0, 2), 16) / 255, g = parseInt(c.slice(2, 4), 16) / 255, b = parseInt(c.slice(4, 6), 16) / 255;
            function lin(v) { return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); }
            return (0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b)) > 0.55;
        }
        function pick(el) { return document.getElementById(el); }
        var primary = pick('Primary'), accent = pick('Accent'), sidebar = pick('SidebarBg'), page = pick('PageBg');
        function syncTextFromColor(colorEl, textEl) {
            textEl.value = colorEl.value;
        }
        function apply() {
            var p = primary.value, a = accent.value, s = sidebar.value;
            document.getElementById('prevPrimary').style.background = p;
            document.getElementById('prevAccent').style.background = a;
            document.getElementById('prevSidebar').style.background = s;
            document.getElementById('prevSidebar').style.color = isLight(s) ? '#22302c' : '#cbd5e1';
            document.getElementById('prevPage').style.background = page.value;
        }
        function wire(el) {
            var color = el.parentElement.querySelector('input[type=color]');
            var text = el.parentElement.querySelector('input[type=text]');
            if (!color || !text) { apply(); return; }
            syncTextFromColor(color, text);
            color.addEventListener('input', function () { syncTextFromColor(color, text); apply(); });
            text.addEventListener('input', function () { if (/^#[0-9a-fA-F]{6}$/.test(text.value)) { color.value = text.value; apply(); } });
        }
        [primary, accent, sidebar, page].forEach(wire);
        document.querySelectorAll('input[name="presetRadio"]').forEach(function (r) {
            r.addEventListener('change', function () {
                if (!r.checked) return;
                document.getElementById('SelectedPreset').value = r.value || '';
                if (!r.value) return;
                primary.value = r.dataset.primary; accent.value = r.dataset.accent;
                sidebar.value = r.dataset.sidebar; page.value = r.dataset.page;
                [primary, accent, sidebar, page].forEach(wire);
                document.querySelectorAll('.preset-card').forEach(function (c) { c.classList.toggle('selected', c.querySelector('input').checked); });
            });
        });
        apply();
    })();
</script>