@model Silk.Trading.Web.ViewModels.Core.SettingsViewModel
@{ ViewData["Title"] = "الإعدادات"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-gear text-primary"></i> الإعدادات</h2>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-rulers"></i> وحدات القياس</span>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addUnitModal"><i class="bi bi-plus-lg"></i> وحدة جديدة</button>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead><tr><th scope="col">الاسم</th><th scope="col">الاختصار</th><th scope="col">الوحدة الفرعية</th><th scope="col">الحالة</th><th scope="col" class="text-center">إجراءات</th></tr></thead>
                    <tbody>
                        @foreach (var u in Model.Units)
                        {
                            <tr>
                                <td><strong>@u.Name</strong></td>
                                <td>@(u.ShortName ?? "—")</td>
                                <td>
                                    @if (u.SubUnits > 0) { @($"{u.SubUnits.Value} × {Model.Units.FirstOrDefault(p => p.Id == u.ParentUnitId)?.Name}") }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td>
                                    @if (u.IsActive)
                                    { <span>نشط</span> }
                                    else
                                    { <span class="text-danger">معطل</span> }
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-primary btn-edit-unit" data-id="@u.Id" data-name="@u.Name" data-short="@u.ShortName" data-sub="@u.SubUnits" data-parent="@u.ParentUnitId" data-active="@u.IsActive.ToString().ToLower()" aria-label="تعديل وحدة @u.Name"><i class="bi bi-pencil"></i></button>
                                    <form asp-action="DeleteUnit" asp-route-id="@u.Id" method="post" class="d-inline" onsubmit="return confirm('حذف هذه الوحدة؟')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="حذف وحدة @u.Name"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Units.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">لا توجد وحدات بعد</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5 d-flex flex-column gap-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-tags"></i> التصنيفات الرئيسية</span>
                <a asp-controller="Categories" asp-action="Index" class="btn btn-sm btn-outline-primary">إدارة</a>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var c in Model.Categories)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@c.Name</span>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-secondary">@c.Items.Count صنف</span>
                            @if (!c.IsActive) { <span class="badge bg-warning text-dark">معطل</span> }
                        </div>
                    </div>
                }
                @if (!Model.Categories.Any())
                {
                    <div class="list-group-item text-center text-muted">لا توجد تصنيفات</div>
                }
            </div>
        </div>
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-grid"></i> أنواع الأصناف</span>
                <a asp-controller="ItemTypes" asp-action="Index" class="btn btn-sm btn-outline-primary">إدارة</a>
            </div>
            <div class="list-group list-group-flush">
                @foreach (var t in Model.ItemTypes)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@t.Name</span>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-secondary">@t.Items.Count صنف</span>
                            @if (!t.IsActive) { <span class="badge bg-warning text-dark">معطل</span> }
                        </div>
                    </div>
                }
                @if (!Model.ItemTypes.Any())
                {
                    <div class="list-group-item text-center text-muted">لا توجد أنواع</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-0">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-currency-exchange"></i> العملات</span>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addCurrencyModal"><i class="bi bi-plus-lg"></i> عملة جديدة</button>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead><tr><th scope="col">الرمز</th><th scope="col">الاسم</th><th scope="col">سعر الصرف</th><th scope="col">الحالة</th><th scope="col" class="text-center">إجراءات</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.Currencies)
                        {
                            <tr>
                                <td><strong>@c.Code</strong> @if (c.IsBase) { <span class="badge bg-primary">الأساسية</span> }</td>
                                <td>@c.Name</td>
                                <td>@c.ExchangeRate.ToString("N2")</td>
                                <td>@(c.IsActive ? "نشطة" : "معطلة")</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-primary btn-edit-currency" data-id="@c.Id" data-code="@c.Code" data-name="@c.Name" data-symbol="@c.Symbol" data-rate="@c.ExchangeRate.ToString(System.Globalization.CultureInfo.InvariantCulture)" data-active="@c.IsActive.ToString().ToLower()" aria-label="تعديل عملة @c.Code"><i class="bi bi-pencil"></i></button>
                                    @if (!c.IsBase)
                                    {
                                        <form asp-action="SetBaseCurrency" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('جعل @c.Name العملة الأساسية؟')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success" aria-label="تعيين @c.Name كعملة أساسية"><i class="bi bi-star"></i></button>
                                        </form>
                                    }
                                    <form asp-action="DeleteCurrency" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('حذف هذه العملة؟')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="حذف عملة @c.Code"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Currencies.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">لا توجد عملات بعد</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-diagram-3"></i> الفروع</span>
                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addBranchModal"><i class="bi bi-plus-lg"></i> فرع جديد</button>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead><tr><th scope="col">الرمز</th><th scope="col">الاسم</th><th scope="col">العنوان</th><th scope="col">الحالة</th><th scope="col" class="text-center">إجراءات</th></tr></thead>
                    <tbody>
                        @foreach (var b in Model.Branches)
                        {
                            <tr>
                                <td><strong>@b.Code</strong></td>
                                <td>@b.Name @if (Model.CurrentBranchId == b.Id) { <span class="badge bg-success">الحالي</span> }</td>
                                <td>@(b.Address ?? "—")</td>
                                <td>@(b.IsActive ? "نشط" : "معطل")</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-primary btn-edit-branch" data-id="@b.Id" data-code="@b.Code" data-name="@b.Name" data-address="@b.Address" data-phone="@b.Phone" data-active="@b.IsActive.ToString().ToLower()" aria-label="تعديل فرع @b.Code"><i class="bi bi-pencil"></i></button>
                                    @if (Model.CurrentBranchId != b.Id)
                                    {
                                        <form asp-action="SetCurrentBranch" method="post" class="d-inline" onsubmit="return confirm('التعامل مع @b.Name كفرع حالي؟')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="branchId" value="@b.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success" aria-label="تعيين @b.Name كفرع حالي"><i class="bi bi-check2"></i></button>
                                        </form>
                                    }
                                    <form asp-action="DeleteBranch" asp-route-id="@b.Id" method="post" class="d-inline" onsubmit="return confirm('حذف هذا الفرع؟')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="حذف فرع @b.Code"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Branches.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">لا توجد فروع بعد</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addUnitModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="AddUnit" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header"><h5 class="modal-title">وحدة قياس جديدة</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label" for="addUnitName">اسم الوحدة</label><input name="Name" id="addUnitName" class="form-control" required maxlength="50" /></div>
                <div class="mb-3"><label class="form-label" for="addUnitShort">الاختصار</label><input name="ShortName" id="addUnitShort" class="form-control" maxlength="20" placeholder="مثل: كجم" /></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="editUnitModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="UpdateUnit" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="editUnitId" />
            <div class="modal-header"><h5 class="modal-title">تعديل الوحدة</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label" for="editUnitName">اسم الوحدة</label><input name="Name" id="editUnitName" class="form-control" required maxlength="50" /></div>
                <div class="mb-3"><label class="form-label" for="editUnitShort">الاختصار</label><input name="ShortName" id="editUnitShort" class="form-control" maxlength="20" /></div>
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label" for="editUnitSub">الوحدات الفرعية</label>
                        <input type="number" name="SubUnits" id="editUnitSub" class="form-control" min="0" value="0" />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="editUnitParent">الوحدة الأم</label>
                        <select name="ParentUnitId" id="editUnitParent" class="form-select">
                            <option value="">— بدون —</option>
                            @foreach (var u in Model.Units.Where(x => x.SubUnits > 0 || x.ParentUnitId == null))
                            {
                                <option value="@u.Id" data-parent-of="@u.ParentUnitId">@u.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-check form-switch mt-3">
                    <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="editUnitActive" checked />
                    <label class="form-check-label" for="editUnitActive">نشطة</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="addCurrencyModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="AddCurrency" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header"><h5 class="modal-title">عملة جديدة</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label" for="addCurCode">رمز العملة</label><input name="Code" id="addCurCode" class="form-control" required maxlength="10" placeholder="مثل: USD" /></div>
                <div class="mb-3"><label class="form-label" for="addCurName">اسم العملة</label><input name="Name" id="addCurName" class="form-control" required maxlength="100" placeholder="مثل: دولار أمريكي" /></div>
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label" for="addCurSymbol">الرمز</label>
                        <input name="Symbol" id="addCurSymbol" class="form-control" maxlength="10" placeholder="$" />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="addCurRate">سعر الصرف</label>
                        <input type="number" step="any" name="ExchangeRate" id="addCurRate" class="form-control" value="1" min="0.000001" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="editCurrencyModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="UpdateCurrency" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="editCurrencyId" />
            <div class="modal-header"><h5 class="modal-title">تعديل العملة</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label" for="editCurrencyCode">رمز العملة</label><input name="Code" id="editCurrencyCode" class="form-control" required maxlength="10" /></div>
                <div class="mb-3"><label class="form-label" for="editCurrencyName">اسم العملة</label><input name="Name" id="editCurrencyName" class="form-control" required maxlength="100" /></div>
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label" for="editCurrencySymbol">الرمز</label>
                        <input name="Symbol" id="editCurrencySymbol" class="form-control" maxlength="10" />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="editCurrencyRate">سعر الصرف</label>
                        <input type="number" step="any" name="ExchangeRate" id="editCurrencyRate" class="form-control" min="0.000001" />
                    </div>
                </div>
                <div class="form-check form-switch mt-3">
                    <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="editCurrencyActive" checked />
                    <label class="form-check-label" for="editCurrencyActive">نشطة</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="addBranchModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="AddBranch" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header"><h5 class="modal-title">فرع جديد</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label" for="addBranchCode">رمز الفرع</label><input name="Code" id="addBranchCode" class="form-control" required maxlength="50" placeholder="مثل: BR-003" /></div>
                <div class="mb-3"><label class="form-label" for="addBranchName">اسم الفرع</label><input name="Name" id="addBranchName" class="form-control" required maxlength="200" /></div>
                <div class="mb-3"><label class="form-label" for="addBranchAddress">العنوان</label><input name="Address" id="addBranchAddress" class="form-control" maxlength="300" /></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="editBranchModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-action="UpdateBranch" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="editBranchId" />
            <div class="modal-header"><h5 class="modal-title">تعديل الفرع</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label" for="editBranchCode">رمز الفرع</label><input name="Code" id="editBranchCode" class="form-control" required maxlength="50" /></div>
                <div class="mb-3"><label class="form-label" for="editBranchName">اسم الفرع</label><input name="Name" id="editBranchName" class="form-control" required maxlength="200" /></div>
                <div class="mb-3"><label class="form-label" for="editBranchAddress">العنوان</label><input name="Address" id="editBranchAddress" class="form-control" maxlength="300" /></div>
                <div class="mb-3"><label class="form-label" for="editBranchPhone">الهاتف</label><input name="Phone" id="editBranchPhone" class="form-control" maxlength="20" /></div>
                <div class="form-check form-switch">
                    <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="editBranchActive" checked />
                    <label class="form-check-label" for="editBranchActive">نشط</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script nonce="@Context.GetCspNonce()">
        document.querySelectorAll('.btn-edit-unit').forEach(btn => btn.addEventListener('click', function() {
            document.getElementById('editUnitId').value = this.dataset.id;
            document.getElementById('editUnitName').value = this.dataset.name;
            document.getElementById('editUnitShort').value = this.dataset.short || '';
            document.getElementById('editUnitSub').value = this.dataset.sub || 0;
            const parent = document.getElementById('editUnitParent');
            parent.value = (this.dataset.parent && this.dataset.parent !== '') ? this.dataset.parent : '';
            document.getElementById('editUnitActive').checked = this.dataset.active === 'true';
            new bootstrap.Modal(document.getElementById('editUnitModal')).show();
        }));

        document.querySelectorAll('.btn-edit-currency').forEach(btn => btn.addEventListener('click', function() {
            document.getElementById('editCurrencyId').value = this.dataset.id;
            document.getElementById('editCurrencyCode').value = this.dataset.code;
            document.getElementById('editCurrencyName').value = this.dataset.name;
            document.getElementById('editCurrencySymbol').value = this.dataset.symbol || '';
            document.getElementById('editCurrencyRate').value = this.dataset.rate || '1';
            document.getElementById('editCurrencyActive').checked = this.dataset.active === 'true';
            new bootstrap.Modal(document.getElementById('editCurrencyModal')).show();
        }));

        document.querySelectorAll('.btn-edit-branch').forEach(btn => btn.addEventListener('click', function() {
            document.getElementById('editBranchId').value = this.dataset.id;
            document.getElementById('editBranchCode').value = this.dataset.code;
            document.getElementById('editBranchName').value = this.dataset.name;
            document.getElementById('editBranchAddress').value = this.dataset.address || '';
            document.getElementById('editBranchPhone').value = this.dataset.phone || '';
            document.getElementById('editBranchActive').checked = this.dataset.active === 'true';
            new bootstrap.Modal(document.getElementById('editBranchModal')).show();
        }));
    </script>
}