@model Silk.Trading.Web.ViewModels.Reports.TrialBalanceReportViewModel
@{ ViewData["Title"] = "ميزان المراجعة"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-balance-scale text-primary"></i> ميزان المراجعة</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> كل التقارير</a>
</div>

<div class="card mb-4"><div class="card-body">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label" for="asOfDate">حتى تاريخ</label>
            <input type="date" name="asOf" value="@Model.AsOf.ToString("yyyy-MM-dd")" id="asOfDate" class="form-control" />
        </div>
        <div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> عرض</button></div>
    </form>
</div></div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-md-4"><div class="stat-card text-center"><div class="text-muted small">إجمالي المدين</div><h3 class="mb-0 text-primary">@Model.TotalDebit.ToString("N2")</h3></div></div>
    <div class="col-12 col-sm-6 col-md-4"><div class="stat-card text-center"><div class="text-muted small">إجمالي الدائن</div><h3 class="mb-0 text-primary">@Model.TotalCredit.ToString("N2")</h3></div></div>
    <div class="col-12 col-sm-6 col-md-4"><div class="stat-card text-center">
        <div class="text-muted small">حالة التوازن</div>
        @if (Model.IsBalanced)
        { <h4 class="mb-0 text-success"><i class="bi bi-check-circle"></i> متوازن</h4> }
        else
        { <h4 class="mb-0 text-danger"><i class="bi bi-x-circle"></i> غير متوازن</h4> }
    </div></div>
</div>

<div class="table-container">
    <table class="table table-hover mb-0" data-table-plain>
        <thead><tr><th scope="col">الرمز</th><th scope="col">الحساب</th><th scope="col">مدين</th><th scope="col">دائن</th><th scope="col">الرصيد</th></tr></thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td><code>@r.Code</code></td>
                    <td>@r.Name</td>
                    <td>@(r.Debit > 0 ? r.Debit.ToString("N2") : "—")</td>
                    <td>@(r.Credit > 0 ? r.Credit.ToString("N2") : "—")</td>
                    <td class="fw-bold @(r.IsDebitBalance ? "text-primary" : r.IsCreditBalance ? "text-success" : "")">@(r.Balance == 0 ? "—" : r.Balance.ToString("N2"))</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="table-light fw-bold">
                <th scope="row" colspan="2">الإجمالي</th>
                <td class="text-primary">@Model.TotalDebit.ToString("N2")</td>
                <td class="text-success">@Model.TotalCredit.ToString("N2")</td>
                <td></td>
            </tr>
        </tfoot>
    </table>
</div>

@if (!Model.Rows.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox" style="font-size:3rem;"></i>
        <p class="mt-2">لا توجد حسابات نشطة</p>
    </div>
}

<div class="mt-4 d-print-none d-flex gap-2 flex-wrap">
    <button type="button" class="btn btn-outline-dark" data-auto-print><i class="bi bi-printer"></i> طباعة</button>
    <a asp-action="ExportTrialBalancePdf" asp-route-asOf="@Model.AsOf.ToString("yyyy-MM-dd")" class="btn btn-outline-danger"><i class="bi bi-file-earmark-pdf"></i> تصدير PDF</a>
    <a asp-action="ExportTrialBalanceXlsx" asp-route-asOf="@Model.AsOf.ToString("yyyy-MM-dd")" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel"></i> تصدير Excel</a>
</div>
