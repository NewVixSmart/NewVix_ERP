@{ ViewData["Title"] = "التقارير"; }

@inject Silk.Trading.Web.Services.IPermissionService Perm

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-file-earmark-bar-graph text-primary"></i> التقارير</h2>
    <a asp-action="Dashboard" class="btn btn-primary"><i class="bi bi-speedometer2"></i> لوحة التقارير</a>
</div>
<p class="text-muted mb-0">اختار نوع التقرير لعرض ملخص وحركات الفترة</p>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body py-5">
                <i class="bi bi-cart-check text-primary" style="font-size:3rem;"></i>
                <h5 class="mt-3">تقرير المبيعات</h5>
                <p class="text-muted small">فواتير البيع ومرتجعات البيع في فترة محددة</p>
                <a asp-action="Sales" class="btn btn-primary"><i class="bi bi-arrow-left"></i> فتح التقرير</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body py-5">
                <i class="bi bi-cart-dash text-warning" style="font-size:3rem;"></i>
                <h5 class="mt-3">تقرير المشتريات</h5>
                <p class="text-muted small">فواتير الشراء ومرتجعات الشراء في فترة محددة</p>
                <a asp-action="Purchases" class="btn btn-primary"><i class="bi bi-arrow-left"></i> فتح التقرير</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body py-5">
                <i class="bi bi-wallet2 text-success" style="font-size:3rem;"></i>
                <h5 class="mt-3">تقرير المدفوعات</h5>
                <p class="text-muted small">المقبوضات والمصروفات في فترة محددة</p>
                <a asp-action="Payments" class="btn btn-primary"><i class="bi bi-arrow-left"></i> فتح التقرير</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mt-1">
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body py-5">
                <i class="bi bi-box-seam text-primary" style="font-size:3rem;"></i>
                <h5 class="mt-3">تصدير الأصناف</h5>
                <p class="text-muted small">قائمة الأصناف وأرصدتها (Excel)</p>
                <a asp-action="ExportItemsXlsx" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel"></i> تصدير Excel</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body py-5">
                <i class="bi bi-boxes text-warning" style="font-size:3rem;"></i>
                <h5 class="mt-3">لقطة المخزون</h5>
                <p class="text-muted small">أرصدة المخزون الحالية (Excel)</p>
                <div class="d-flex gap-2 justify-content-center">
                    <a asp-action="ExportStockXlsx" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel"></i> كل الأصناف</a>
                    <a asp-action="ExportStockXlsx" asp-route-lowOnly="true" class="btn btn-outline-warning"><i class="bi bi-exclamation-triangle"></i> المنخفض</a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center">
            <div class="card-body py-5">
                <i class="bi bi-balance-scale text-danger" style="font-size:3rem;"></i>
                <h5 class="mt-3">القوائم المالية</h5>
                <p class="text-muted small">ميزان المراجعة والقوائم مع تصدير PDF وExcel</p>
                <a asp-action="TrialBalance" class="btn btn-primary"><i class="bi bi-arrow-left"></i> فتح القوائم</a>
            </div>
        </div>
    </div>
    @if (await Perm.HasAsync("AuditLedger.View"))
    {
        <div class="col-md-4">
            <div class="card h-100 text-center">
                <div class="card-body py-5">
                    <i class="bi bi-journal-bookmark text-dark" style="font-size:3rem;"></i>
                    <h5 class="mt-3">سجل التدقيق المركزي</h5>
                    <p class="text-muted small">كل قيود دفتر الأستاذ العام مع تصدير Excel</p>
                    <a asp-action="AuditLedger" class="btn btn-primary"><i class="bi bi-arrow-left"></i> فتح السجل</a>
                </div>
            </div>
        </div>
        }
        @if (await Perm.HasAsync("Aging.View"))
        {
        <div class="col-md-4">
            <div class="card h-100 text-center">
                <div class="card-body py-5">
                    <i class="bi bi-hourglass-split text-warning" style="font-size:3rem;"></i>
                    <h5 class="mt-3">القائمة العمرية</h5>
                    <p class="text-muted small">تحليل ذمم العملاء والموردين حسب تاريخ الاستحقاق مع تصدير Excel</p>
                    <a asp-action="Aging" class="btn btn-primary"><i class="bi bi-arrow-left"></i> فتح التقرير</a>
                </div>
            </div>
        </div>
        }
        <div class="col-md-4">
            <div class="card h-100 text-center">
                <div class="card-body py-5">
                    <i class="bi bi-cash-stack text-success" style="font-size:3rem;"></i>
                    <h5 class="mt-3">كشف التدفق النقدي</h5>
                    <p class="text-muted small">المقبوضات والمصروفات وصافي التدفق مع تصدير Excel</p>
                    <a asp-action="CashFlow" class="btn btn-primary"><i class="bi bi-arrow-left"></i> فتح التقرير</a>
                </div>
            </div>
        </div>
</div>