@model IEnumerable<Silk.Trading.Web.Models.Stock.InventoryAdjustment>
@inject Silk.Trading.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "سجلات الجرد"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-clipboard-data text-primary"></i> سجلات الجرد</h2>
    @if (await Perm.HasAsync("InventoryAdjustments.Create"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> جرد جديد</a>
    }
</div>

<div class="table-container">
    <table class="table table-hover mb-0">
        <thead><tr><th scope="col">رقم المستند</th><th scope="col">الصنف</th><th scope="col">العدد الجديد</th><th scope="col">الكمية الجديدة</th><th scope="col">السبب</th><th scope="col">تاريخ الجرد</th><th scope="col">بواسطة</th><th scope="col" class="text-center">إجراء</th></tr></thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td><code>@a.ReferenceNumber</code></td>
                    <td><strong>@a.Item.Name</strong></td>
                    <td>@a.NewCount.ToString("N2")</td>
                    <td>@a.NewQuantity.ToString("N2")</td>
                    <td>@(a.Reason ?? "—")</td>
                    <td>@a.AdjustmentDate.ToString("dd/MM/yyyy")</td>
                    <td>@(a.CreatedBy ?? "—")</td>
                    <td class="text-center">
                        @if (await Perm.HasAsync("InventoryAdjustments.Delete"))
                        {
                        <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline" onsubmit="return confirm('حذف سجل الجرد وحركته المرتبطة؟')">
                            <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="حذف سجل الجرد @a.ReferenceNumber"><i class="bi bi-trash"></i></button>
                        </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pager" />
