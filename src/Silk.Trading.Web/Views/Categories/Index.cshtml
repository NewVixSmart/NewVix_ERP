@model IEnumerable<Silk.Trading.Web.Models.Core.ItemCategory>
@inject Silk.Trading.Web.Services.IPermissionService Perm
@{
    ViewData["Title"] = "التصنيفات الرئيسية";
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (!isAjax)
    {
        Layout = "_Layout";
    }
}
@if (!isAjax)
{
    <div class="page-header d-flex justify-content-between align-items-center">
        <h2><i class="bi bi-tags text-primary"></i> التصنيفات الرئيسية</h2>
        @if (await Perm.HasAsync("Items.Create"))
        {
            <button type="button" class="btn btn-primary" id="pageAddCatBtn" data-focus-target="pageNewCat"><i class="bi bi-plus-lg"></i> إضافة تصنيف</button>
        }
    </div>
    @if (await Perm.HasAsync("Items.Create"))
    {
    <div class="card mb-3">
        <div class="card-body">
            <div class="input-group">
                <label for="pageNewCat" class="visually-hidden">اسم تصنيف جديد</label>
                <input type="text" id="pageNewCat" class="form-control" placeholder="اسم تصنيف جديد..." autocomplete="off" />
                <button type="button" class="btn btn-success" id="pageAddCatBtn2" data-create-category><i class="bi bi-check-lg"></i> إضافة</button>
            </div>
        </div>
    </div>
    }
}
<table class="table table-hover mb-0" id="categoriesTable" data-load="true">
    <thead><tr><th scope="col">الاسم</th><th>الحالة</th><th class="text-center">إجراءات</th></tr></thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td data-name="@c.Name">@c.Name</td>
                <td>@(c.IsActive ? "نشط" : "غير نشط")</td>
                <td class="text-center">
                    @if (await Perm.HasAsync("Items.Edit"))
                    {
                    <button type="button" class="btn btn-sm btn-outline-primary btn-edit" data-id="@c.Id" title="تعديل"><i class="bi bi-pencil"></i></button>
                    }
                    @if (await Perm.HasAsync("Items.Delete"))
                    {
                    <button type="button" class="btn btn-sm btn-outline-danger btn-del" data-id="@c.Id" title="حذف"><i class="bi bi-trash"></i></button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
