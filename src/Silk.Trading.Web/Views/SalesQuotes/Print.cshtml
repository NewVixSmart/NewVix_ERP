@model Silk.Trading.Web.Models.Sales.SaleQuote
@{ ViewData["Title"] = $"طباعة عرض سعر {Model.QuoteNumber}"; }

<div class="print-toolbar no-print d-flex flex-wrap gap-2 align-items-center justify-content-between mb-3">
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer"></i> طباعة / نسخة للعميل</button>
        <a asp-action="Pdf" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-filetype-pdf"></i> تحميل PDF</a>
    </div>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> رجوع</a>
</div>

<article class="print-doc card">
    <div class="card-body p-4">
        <header class="text-center border-bottom pb-3 mb-3">
            <h2 class="h3 mb-1">سلك للتجارة</h2>
            <p class="mb-0 text-muted">عرض سعر — @Model.QuoteNumber</p>
        </header>

        <div class="row mb-3">
            <div class="col-md-6"><strong>العميل:</strong> @(Model.Customer?.Name ?? "—")</div>
            <div class="col-md-3"><strong>التاريخ:</strong> @Model.QuoteDate.ToString("dd/MM/yyyy")</div>
            <div class="col-md-3"><strong>صالح حتى:</strong> @(Model.ValidUntil?.ToString("dd/MM/yyyy") ?? "—")</div>
        </div>

        @if (Model.SupplierQuote != null)
        {
            <div class="row mb-3">
                <div class="col-12"><strong>عرض المورد المرجعي:</strong> مرتبط بعرض المورد #@Model.SupplierQuote.Id <span>— @(Model.SupplierQuote.Supplier?.Name ?? "—")</span></div>
            </div>
        }

        <table class="table table-bordered mb-3">
            <caption class="visually-hidden">أصناف عرض السعر @Model.QuoteNumber</caption>
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">الصنف</th>
                    <th scope="col">العدد</th>
                    <th scope="col">الكمية</th>
                    <th scope="col">سعر الوحدة</th>
                    <th scope="col">الإجمالي</th>
                </tr>
            </thead>
            <tbody>
                @{ var row = 1; }
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@row</td>
                        <td>@(item.Item?.Name ?? "—")</td>
                        <td>@item.Count</td>
                        <td>@item.Quantity</td>
                        <td>@item.UnitPrice.ToString("N2")</td>
                        <td class="fw-bold">@item.Total.ToString("N2")</td>
                    </tr>
                    row++;
                }
            </tbody>
        </table>

        <div class="row g-3">
            <div class="col-md-3"><div class="text-muted small">الإجمالي</div><div class="fw-bold">@Model.TotalAmount.ToString("N2")</div></div>
            <div class="col-md-3"><div class="text-muted small">الخصم</div><div class="fw-bold">@Model.Discount.ToString("N2")</div></div>
            <div class="col-md-3"><div class="text-muted small">الضريبة</div><div class="fw-bold">@Model.Tax.ToString("N2")</div></div>
            <div class="col-md-3"><div class="text-muted small">الصافي</div><div class="fw-bold h4">@Model.NetAmount.ToString("N2") ج.م</div></div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Notes))
        {
            <div class="mt-3"><strong>ملاحظات:</strong> @Model.Notes</div>
        }
    </div>
</article>