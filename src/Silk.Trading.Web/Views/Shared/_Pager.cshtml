@{
    var page = (int)(ViewBag.Page ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var search = ViewBag.Search as string;
    var categoryId = ViewBag.CategoryId?.ToString();
    var itemId = ViewBag.ItemId?.ToString();
    var type = ViewBag.Type?.ToString();
    var from = ViewBag.From?.ToString();
    var to = ViewBag.To?.ToString();
    var lowOnly = ViewBag.LowOnly?.ToString();
    var accountId = ViewBag.AccountId?.ToString();
    var source = ViewBag.Source?.ToString();
    Func<string, string> href = (string p) =>
    {
        var qs = "?page=" + p;
        if (!string.IsNullOrEmpty(search))
            qs += "&search=" + Uri.EscapeDataString(search);
        if (!string.IsNullOrEmpty(categoryId))
            qs += "&categoryId=" + Uri.EscapeDataString(categoryId);
        if (!string.IsNullOrEmpty(itemId))
            qs += "&itemId=" + Uri.EscapeDataString(itemId);
        if (!string.IsNullOrEmpty(type))
            qs += "&type=" + Uri.EscapeDataString(type);
        if (!string.IsNullOrEmpty(from))
            qs += "&from=" + Uri.EscapeDataString(from);
        if (!string.IsNullOrEmpty(to))
            qs += "&to=" + Uri.EscapeDataString(to);
        if (lowOnly == "true")
            qs += "&lowOnly=true";
        if (!string.IsNullOrEmpty(accountId))
            qs += "&accountId=" + Uri.EscapeDataString(accountId);
        if (!string.IsNullOrEmpty(source))
            qs += "&source=" + Uri.EscapeDataString(source);
        return qs;
    };
    const int windowSize = 2;
    var windowStart = Math.Max(2, page - windowSize);
    var windowEnd = Math.Min(totalPages - 1, page + windowSize);
}
@if (totalPages > 1)
{
    <nav aria-label="ترقيم الصفحات" class="mt-3">
        <ul class="pagination justify-content-center mb-0 flex-wrap">
            <li class="page-item @(page <= 1 ? "disabled" : "")">
                <a class="page-link" href="@(page > 1 ? href((page - 1).ToString()) : "#")" aria-label="السابق" tabindex="@(page > 1 ? 0 : -1)">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>

            <li class="page-item @(page == 1 ? "active" : "")" @(page == 1 ? "aria-current=\"page\"" : "")>
                <a class="page-link" href="@href("1")">1</a>
            </li>

            @if (windowStart > 2)
            {
                <li class="page-item disabled">
                    <span class="page-link" aria-hidden="true">&hellip;</span>
                    <span class="visually-hidden">صفحات أخرى</span>
                </li>
            }

            @for (var i = windowStart; i <= windowEnd; i++)
            {
                <li class="page-item @(i == page ? "active" : "")" @(i == page ? "aria-current=\"page\"" : "")>
                    <a class="page-link" href="@href(i.ToString())">@i</a>
                </li>
            }

            @if (windowEnd < totalPages - 1)
            {
                <li class="page-item disabled">
                    <span class="page-link" aria-hidden="true">&hellip;</span>
                    <span class="visually-hidden">صفحات أخرى</span>
                </li>
            }

            @if (totalPages > 1)
            {
                <li class="page-item @(page == totalPages ? "active" : "")" @(page == totalPages ? "aria-current=\"page\"" : "")>
                    <a class="page-link" href="@href(totalPages.ToString())">@totalPages</a>
                </li>
            }

            <li class="page-item @(page >= totalPages ? "disabled" : "")">
                <a class="page-link" href="@(page < totalPages ? href((page + 1).ToString()) : "#")" aria-label="التالي" tabindex="@(page < totalPages ? 0 : -1)">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>
        </ul>
    </nav>
}