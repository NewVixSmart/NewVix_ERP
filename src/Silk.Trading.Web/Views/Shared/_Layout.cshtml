<!DOCTYPE html>
<html lang="ar" dir="rtl">
@inject Silk.Trading.Web.Services.IPermissionService Perm
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - سلك للتجارة</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/lib/fonts/cairo/cairo.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    @Html.AntiForgeryToken()
    <a class="skip-link" href="#mainContent">تخطى إلى المحتوى الرئيسي</a>
    <div class="mobile-overlay" id="mobileOverlay"></div>

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            <h4><i class="bi bi-shop" aria-hidden="true"></i> سلك</h4>
            <small>نظام التجارة الفاخر</small>
        </div>
        <nav class="sidebar-nav" id="mainMenu" aria-label="القائمة الرئيسية">
            <div class="nav-section">الرئيسية</div>
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door" aria-hidden="true"></i> لوحة التحكم
            </a>

            @if (await Perm.HasAnyAsync("Items.View", "Purchases.View", "PurchaseOrders.View", "PurchaseRequests.View", "Sales.View", "SaleReturns.View", "PurchaseReturns.View", "Shipments.View", "Batch.SalesCreate", "Batch.AdjustmentCreate"))
            {
                <div class="nav-section">العمليات</div>
                @if (await Perm.HasAsync("Items.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Items" ? "active" : "")" asp-controller="Items" asp-action="Index">
                        <i class="bi bi-box-seam" aria-hidden="true"></i> الأصناف
                    </a>
                }
                @if (await Perm.HasAsync("PurchaseOrders.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PurchaseOrders" ? "active" : "")" asp-controller="PurchaseOrders" asp-action="Index">
                        <i class="bi bi-clipboard-check" aria-hidden="true"></i> أوامر الشراء
                    </a>
                }
                @if (await Perm.HasAsync("Purchases.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Purchases" ? "active" : "")" asp-controller="Purchases" asp-action="Index">
                        <i class="bi bi-cart-dash" aria-hidden="true"></i> فواتير الشراء
                    </a>
                }
                @if (await Perm.HasAsync("PurchaseRequests.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PurchaseRequests" ? "active" : "")" asp-controller="PurchaseRequests" asp-action="Index">
                        <i class="bi bi-envelope-open" aria-hidden="true"></i> طلبات عرض سعر
                    </a>
                }
                @if (await Perm.HasAsync("Sales.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sales" ? "active" : "")" asp-controller="Sales" asp-action="Index">
                        <i class="bi bi-cart-check" aria-hidden="true"></i> المبيعات
                    </a>
                }
                @if (await Perm.HasAsync("SaleReturns.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SaleReturns" ? "active" : "")" asp-controller="SaleReturns" asp-action="Index">
                        <i class="bi bi-arrow-return-left" aria-hidden="true"></i> مرتجعات البيع
                    </a>
                }
                @if (await Perm.HasAsync("PurchaseReturns.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PurchaseReturns" ? "active" : "")" asp-controller="PurchaseReturns" asp-action="Index">
                        <i class="bi bi-arrow-return-right" aria-hidden="true"></i> مرتجعات الشراء
                    </a>
                }
                @if (await Perm.HasAsync("Shipments.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Shipments" ? "active" : "")" asp-controller="Shipments" asp-action="Index">
                        <i class="bi bi-truck" aria-hidden="true"></i> الشحنات
                    </a>
                }
                @if (await Perm.HasAsync("Batch.SalesCreate"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Batch" && ViewContext.RouteData.Values["action"]?.ToString() == "Sales" ? "active" : "")" asp-controller="Batch" asp-action="Sales">
                        <i class="bi bi-collection" aria-hidden="true"></i> المبيعات الجماعية
                    </a>
                }
                @if (await Perm.HasAsync("Batch.AdjustmentCreate"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Batch" && ViewContext.RouteData.Values["action"]?.ToString() == "Adjustment" ? "active" : "")" asp-controller="Batch" asp-action="Adjustment">
                        <i class="bi bi-clipboard-check" aria-hidden="true"></i> جرد جماعي
                    </a>
                }
            }

            @if (await Perm.HasAnyAsync("Customers.View", "Suppliers.View", "Payments.View"))
            {
                <div class="nav-section">الحسابات</div>
                @if (await Perm.HasAsync("Customers.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")" asp-controller="Customers" asp-action="Index">
                        <i class="bi bi-people" aria-hidden="true"></i> العملاء
                    </a>
                }
                @if (await Perm.HasAsync("Suppliers.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Suppliers" ? "active" : "")" asp-controller="Suppliers" asp-action="Index">
                        <i class="bi bi-building" aria-hidden="true"></i> الموردين
                    </a>
                }
                @if (await Perm.HasAsync("Payments.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payments" ? "active" : "")" asp-controller="Payments" asp-action="Index">
                        <i class="bi bi-wallet2" aria-hidden="true"></i> المدفوعات
                    </a>
                }
            }

            @if (await Perm.HasAnyAsync("Stock.View", "StockReport.View", "InventoryAdjustments.View", "Warehouses.View", "StockTransfers.View"))
            {
                <div class="nav-section">المخزون</div>
                @if (await Perm.HasAsync("Stock.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Stock" && ViewContext.RouteData.Values["action"]?.ToString() != "Report" && ViewContext.RouteData.Values["action"]?.ToString() != "LowStock" ? "active" : "")" asp-controller="Stock" asp-action="Index">
                        <i class="bi bi-boxes" aria-hidden="true"></i> حركة المخزون
                    </a>
                }
                @if (await Perm.HasAsync("InventoryAdjustments.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "InventoryAdjustments" ? "active" : "")" asp-controller="InventoryAdjustments" asp-action="Index">
                        <i class="bi bi-clipboard-data" aria-hidden="true"></i> الجرد
                    </a>
                }
                @if (await Perm.HasAsync("Warehouses.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Warehouses" ? "active" : "")" asp-controller="Warehouses" asp-action="Index">
                        <i class="bi bi-house-gear" aria-hidden="true"></i> المستودعات
                    </a>
                }
                @if (await Perm.HasAsync("StockTransfers.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "StockTransfers" ? "active" : "")" asp-controller="StockTransfers" asp-action="Index">
                        <i class="bi bi-arrow-left-right" aria-hidden="true"></i> نقل مخزون
                    </a>
                }
                @if (await Perm.HasAsync("StockReport.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Stock" && ViewContext.RouteData.Values["action"]?.ToString() == "Report" ? "active" : "")" asp-controller="Stock" asp-action="Report">
                        <i class="bi bi-clipboard2-data" aria-hidden="true"></i> تقرير المخزون
                    </a>
                }
                @if (await Perm.HasAsync("Stock.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Stock" && ViewContext.RouteData.Values["action"]?.ToString() == "LowStock" ? "active" : "")" asp-controller="Stock" asp-action="LowStock">
                        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> انخفاض المخزون
                    </a>
                }
            }

            @if (await Perm.HasAsync("Reports.View"))
            {
                <div class="nav-section">التقارير</div>
                @if (await Perm.HasAsync("Reports.Dashboard"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" asp-controller="Reports" asp-action="Dashboard">
                        <i class="bi bi-speedometer2" aria-hidden="true"></i> لوحة التقارير
                    </a>
                }
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Reports" asp-action="Index">
                    <i class="bi bi-list-ul" aria-hidden="true"></i> قائمة التقارير
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Sales" ? "active" : "")" asp-controller="Reports" asp-action="Sales">
                    <i class="bi bi-cart-check" aria-hidden="true"></i> تقرير المبيعات
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Purchases" ? "active" : "")" asp-controller="Reports" asp-action="Purchases">
                    <i class="bi bi-cart-dash" aria-hidden="true"></i> تقرير المشتريات
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Payments" ? "active" : "")" asp-controller="Reports" asp-action="Payments">
                    <i class="bi bi-wallet2" aria-hidden="true"></i> تقرير المدفوعات
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "CashFlow" ? "active" : "")" asp-controller="Reports" asp-action="CashFlow">
                    <i class="bi bi-cash-stack" aria-hidden="true"></i> التدفق النقدي
                </a>
                @if (await Perm.HasAsync("AuditLedger.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "AuditLedger" ? "active" : "")" asp-controller="Reports" asp-action="AuditLedger">
                        <i class="bi bi-journal-bookmark" aria-hidden="true"></i> سجل التدقيق
                    </a>
                }
                @if (await Perm.HasAsync("Reports.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "BudgetVariance" ? "active" : "")" asp-controller="Reports" asp-action="BudgetVariance">
                        <i class="bi bi-graph-up" aria-hidden="true"></i> واريانس الميزانية
                    </a>
                }
            }

            @if (await Perm.HasAsync("Reports.View"))
            {
                <div class="nav-section">القوائم المالية</div>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "TrialBalance" ? "active" : "")" asp-controller="Reports" asp-action="TrialBalance">
                    <i class="bi bi-balance-scale" aria-hidden="true"></i> ميزان المراجعة
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "IncomeStatement" ? "active" : "")" asp-controller="Reports" asp-action="IncomeStatement">
                    <i class="bi bi-graph-up-arrow" aria-hidden="true"></i> قائمة الدخل
                </a>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "BalanceSheet" ? "active" : "")" asp-controller="Reports" asp-action="BalanceSheet">
                    <i class="bi bi-layers" aria-hidden="true"></i> الميزانية العمومية
                </a>
            }

            @if (await Perm.HasAnyAsync("Settings.View", "FiscalClose.Close", "ChartOfAccounts.View", "Budgets.View"))
            {
                <div class="nav-section">الإدارة</div>
                @if (await Perm.HasAsync("Settings.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")" asp-controller="Settings" asp-action="Index">
                        <i class="bi bi-gear" aria-hidden="true"></i> الإعدادات
                    </a>
                }
                @if (await Perm.HasAsync("ChartOfAccounts.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Accounts" ? "active" : "")" asp-controller="Accounts" asp-action="Index">
                        <i class="bi bi-journal-code" aria-hidden="true"></i> مخطط الحسابات
                    </a>
                }
                @if (await Perm.HasAsync("Budgets.View"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Budgets" ? "active" : "")" asp-controller="Budgets" asp-action="Index">
                        <i class="bi bi-calendar3" aria-hidden="true"></i> الميزانيات
                    </a>
                }
                @if (await Perm.HasAsync("FiscalClose.Close"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Fiscal" ? "active" : "")" asp-controller="Fiscal" asp-action="Index">
                        <i class="bi bi-lock" aria-hidden="true"></i> الإقفال السنوي
                    </a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index">
                        <i class="bi bi-person-gear" aria-hidden="true"></i> المستخدمون والصلاحيات
                    </a>
                }
            }
        </nav>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="sidebar-profile">
                <span class="user-avatar" aria-hidden="true">@(!string.IsNullOrEmpty(User.Identity.Name) ? User.Identity.Name.Substring(0, 1).ToUpper() : "؟")</span>
                <div class="user-meta">
                    <strong>@User.Identity.Name</strong>
                    <small>مستخدم مسجل الدخول</small>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" aria-label="تسجيل الخروج">
                    <button type="submit" class="btn btn-sm" aria-label="تسجيل الخروج">
                        <i class="bi bi-box-arrow-left" aria-hidden="true"></i>
                    </button>
                </form>
            </div>
        }
    </aside>

    <div class="main-content">
        <div class="top-bar">
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm navbar-toggler" id="sidebarToggle" aria-label="فتح القائمة الجانبية" aria-expanded="false" aria-controls="sidebar">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>
                <h6 class="mb-0 text-muted">@ViewData["Title"]</h6>
            </div>
            <div class="d-flex align-items-center gap-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-muted small d-none d-lg-inline">
                        <i class="bi bi-person-circle" aria-hidden="true"></i> @User.Identity.Name
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline d-lg-none" aria-label="تسجيل الخروج">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-box-arrow-left" aria-hidden="true"></i> خروج
                        </button>
                    </form>
                }
            </div>
        </div>

        <main class="page-content" id="mainContent" role="main" tabindex="-1">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert" aria-live="assertive">
                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق التنبيه"></button>
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status" aria-live="polite">
                    <i class="bi bi-check-circle" aria-hidden="true"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق التنبيه"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>