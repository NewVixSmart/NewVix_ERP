@model IEnumerable<Silk.Trading.Web.Models.Sales.Customer>
@inject Silk.Trading.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "العملاء"; }

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h2><i class="bi bi-people text-primary"></i> العملاء</h2>
    @if (await Perm.HasAsync("Customers.Create"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> عميل جديد</a>
    }
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="visually-hidden" for="searchInput">بحث</label>
                <input type="text" name="search" value="@ViewBag.Search" id="searchInput" class="form-control" placeholder="بحث بالاسم أو الكود..." />
            </div>
            <div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> بحث</button></div>
        </form>
    </div>
</div>

<div class="table-container">
    <table class="table table-hover mb-0">
        <thead><tr><th scope="col">الكود</th><th scope="col">اسم العميل</th><th scope="col">التليفون</th><th scope="col">العنوان</th><th scope="col">الرصيد</th><th scope="col" class="text-center">إجراءات</th></tr></thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td><code>@(c.Code ?? "—")</code></td>
                    <td><strong>@c.Name</strong></td>
                    <td>@(c.Phone ?? "—")</td>
                    <td>@(c.Address ?? "—")</td>
                    <td>@c.OpeningBalance.ToString("N2") ج.م</td>
                    <td class="text-center">
                        <a asp-action="Ledger" asp-route-id="@c.Id" class="btn btn-sm btn-outline-success" aria-label="دفتر أستاذ العميل @c.Name"><i class="bi bi-journal-bookmark"></i></a>
                        @if (await Perm.HasAsync("Customers.Edit"))
                        {
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary" aria-label="تعديل العميل @c.Name"><i class="bi bi-pencil"></i></a>
                        }
                        @if (await Perm.HasAsync("Customers.Delete"))
                        {
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد؟')">
                                <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="حذف العميل @c.Name"><i class="bi bi-trash"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <partial name="_Pager" />
</div>