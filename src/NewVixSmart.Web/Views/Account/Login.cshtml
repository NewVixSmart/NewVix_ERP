@model NewVixSmart.Web.Controllers.LoginViewModel
@inject NewVixSmart.Web.Services.IBrandingService Branding
@{ Layout = null; ViewData["Title"] = "تسجيل الدخول"; var _brand = await Branding.LoadAsync(); }
<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme-mode="system" data-theme="light" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>تسجيل الدخول - @_brand.Profile.CompanyName</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/lib/fonts/cairo/cairo.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <style nonce="@Context.GetCspNonce()">
        @Html.Raw(Branding.RenderThemeCss(_brand.Theme))
    </style>
    <script nonce="@Context.GetCspNonce()">
        (function () {
            var stored = null;
            try { stored = localStorage.getItem('theme-mode'); } catch (e) { stored = null; }
            var mode = (stored === 'light' || stored === 'dark') ? stored : 'system';
            var resolved = mode === 'system'
                ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                : mode;
            document.documentElement.setAttribute('data-theme-mode', mode);
            document.documentElement.setAttribute('data-theme', resolved);
            document.documentElement.setAttribute('data-bs-theme', resolved);
        })();
    </script>
    <link href="~/css/dark-theme.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/auth.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <div class="lg-stage">
        <div class="lg-aura" aria-hidden="true"></div>
        <div class="lg-shell">
            <section class="lg-hero" aria-label="نبذة عن النظام">
                <p class="lg-hero__eyebrow">
                    <span class="lg-hero__eyebrow-dot" aria-hidden="true"></span>
                    نظام إدارة الأعمال المتكامل
                </p>
                @if (_brand.Profile.HasLogo)
                {
                    <img class="lg-hero__brand lg-hero__logo" src="@_brand.Profile.LogoDataUri()" alt="@_brand.Profile.CompanyName" />
                }
                else
                {
                    <div class="lg-hero__brand lg-hero__monogram" aria-hidden="true"><i class="bi bi-shop"></i></div>
                }
                <h1 class="lg-hero__title">@_brand.Profile.CompanyName</h1>
                <p class="lg-hero__tagline">@(_brand.Profile.Tagline ?? "Smart Solutions")</p>
                <div class="lg-preview" aria-hidden="true">
                    <div class="lg-preview__head">
                        <span class="lg-preview__title">نظرة على الأداء</span>
                        <span class="lg-preview__live"><span class="lg-preview__live-dot" aria-hidden="true"></span>مباشر</span>
                    </div>
                    <div class="lg-preview__grid">
                        <div class="lg-stat">
                            <span class="lg-stat__value">+128</span>
                            <span class="lg-stat__label">مبيعات اليوم</span>
                        </div>
                        <div class="lg-stat">
                            <span class="lg-stat__value">1,240</span>
                            <span class="lg-stat__label">الأصناف</span>
                        </div>
                        <div class="lg-stat">
                            <span class="lg-stat__value">36</span>
                            <span class="lg-stat__label">فواتير معلّقة</span>
                        </div>
                    </div>
                    <div class="lg-preview__chart" aria-hidden="true">
                        <span class="lg-bar lg-bar--h2"></span>
                        <span class="lg-bar lg-bar--h5"></span>
                        <span class="lg-bar lg-bar--h3"></span>
                        <span class="lg-bar lg-bar--h4"></span>
                        <span class="lg-bar lg-bar--h1"></span>
                        <span class="lg-bar lg-bar--h5"></span>
                        <span class="lg-bar lg-bar--h3"></span>
                    </div>
                </div>
                <div class="lg-hero__badges" aria-hidden="true">
                    <span class="lg-hero__badge"><i class="bi bi-box-seam" aria-hidden="true"></i>المخزون</span>
                    <span class="lg-hero__badge"><i class="bi bi-cart-check" aria-hidden="true"></i>المبيعات</span>
                    <span class="lg-hero__badge"><i class="bi bi-graph-up-arrow" aria-hidden="true"></i>التقارير</span>
                </div>
                <p class="lg-hero__trust"><i class="bi bi-shield-lock" aria-hidden="true"></i> بياناتك محمية ومنقولة بتشفير آمن</p>
            </section>
            <section class="lg-panel">
                <div class="lg-theme">
                    <div class="theme-selector" role="group" aria-label="مظهر الواجهة">
                        <button type="button" class="theme-mode-btn" data-theme-value="system" aria-pressed="true">
                            <i class="bi bi-display" aria-hidden="true"></i>
                            <span class="theme-mode-label">النظام</span>
                        </button>
                        <button type="button" class="theme-mode-btn" data-theme-value="light" aria-pressed="false">
                            <i class="bi bi-sun" aria-hidden="true"></i>
                            <span class="theme-mode-label">فاتح</span>
                        </button>
                        <button type="button" class="theme-mode-btn" data-theme-value="dark" aria-pressed="false">
                            <i class="bi bi-moon-stars" aria-hidden="true"></i>
                            <span class="theme-mode-label">داكن</span>
                        </button>
                    </div>
                </div>
                <header class="lg-panel__head">
                    <p class="lg-panel__eyebrow">مرحبًا بعودتك</p>
                    <h2 class="lg-title">تسجيل الدخول</h2>
                    <p class="lg-subtitle">أدخل بياناتك للمتابعة إلى لوحة العمل</p>
                </header>

                @if (TempData["Success"] is string successMsg)
                {
                    <div class="lg-alert">
                        <div class="alert alert-success alert-dismissible fade show" role="status" aria-live="polite">
                            @successMsg
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
                        </div>
                    </div>
                }
                @if (TempData["Error"] is string errorMsg)
                {
                    <div class="lg-alert">
                        <div class="alert alert-danger alert-dismissible fade show" role="alert" aria-live="assertive">
                            @errorMsg
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
                        </div>
                    </div>
                }

                <form class="lg-form" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" data-loading-submit data-loading-text="جاري الدخول...">
                    <div asp-validation-summary="All" class="text-danger mb-3" role="alert" tabindex="-1"></div>
                    <div class="lg-field">
                        <label asp-for="Username" class="form-label"></label>
                        <div class="lg-control">
                            <span class="lg-control__icon" aria-hidden="true"><i class="bi bi-person"></i></span>
                            <input asp-for="Username" class="form-control lg-input" id="Username" placeholder="أدخل اسم المستخدم" autofocus autocomplete="username" />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small" aria-invalid="true"></span>
                    </div>
                    <div class="lg-field">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="lg-control lg-control--password">
                            <span class="lg-control__icon" aria-hidden="true"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control lg-input" id="Password" placeholder="أدخل كلمة المرور" autocomplete="current-password" />
                            <button type="button" class="lg-password-toggle" data-password-toggle aria-controls="Password" aria-pressed="false" aria-label="إظهار كلمة المرور" title="إظهار كلمة المرور">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small" aria-invalid="true"></span>
                    </div>
                    <div class="lg-actions">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">تذكرني</label>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary w-100 lg-submit">
                        <i class="bi bi-box-arrow-in-left" aria-hidden="true"></i>
                        <span>دخول</span>
                    </button>
                </form>

                <p class="lg-secure"><i class="bi bi-lock" aria-hidden="true"></i> اتصال مشفّر وآمن</p>

                <p class="lg-foot">&copy; @DateTime.Now.Year @_brand.Profile.CompanyName &mdash; جميع الحقوق محفوظة</p>
            </section>
        </div>
    </div>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>