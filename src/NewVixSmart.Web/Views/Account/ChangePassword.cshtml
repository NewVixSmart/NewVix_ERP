@model NewVixSmart.Web.Controllers.ChangePasswordViewModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
}

@if (TempData["Success"] != null)
{
    <div class="ui-alert ui-alert-ok ui-rise">@TempData["Success"]</div>
}

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">الحساب</span>
        <h2><i class="bi bi-shield-lock" aria-hidden="true"></i> تغيير كلمة المرور</h2>
    </div>
</div>

<div class="ui-section ui-card ui-rise" style="max-width:520px">
    <div class="card-body">
        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert" tabindex="-1"></div>
            <div class="mb-4">
                <label class="form-label" for="CurrentPassword">كلمة المرور الحالية</label>
                <input asp-for="CurrentPassword" class="form-control ui-input" dir="ltr" required />
                <span asp-validation-for="CurrentPassword" class="text-danger" aria-invalid="true"></span>
            </div>
            <div class="mb-4">
                <label class="form-label" for="NewPassword">كلمة المرور الجديدة</label>
                <input asp-for="NewPassword" class="form-control ui-input" dir="ltr" required />
                <div class="form-text">8 أحرف على الأقل مع حرف كبير وصغير ورقم ورمز</div>
                <span asp-validation-for="NewPassword" class="text-danger" aria-invalid="true"></span>
            </div>
            <div class="mb-4">
                <label class="form-label" for="ConfirmPassword">تأكيد كلمة المرور الجديدة</label>
                <input asp-for="ConfirmPassword" class="form-control ui-input" dir="ltr" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger" aria-invalid="true"></span>
            </div>
            <div class="flex gap-2">
                <button type="submit" class="ui-btn ui-btn-pri"><i class="bi bi-check-lg" aria-hidden="true"></i> حفظ</button>
                <a asp-controller="Home" asp-action="Index" class="ui-btn ui-btn-ghost">إلغاء</a>
            </div>
        </form>
    </div>
</div>
