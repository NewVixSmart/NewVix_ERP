@model NewVixSmart.Web.Controllers.ChangePasswordViewModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="page-header">
    <h2><i class="bi bi-shield-lock text-primary"></i> تغيير كلمة المرور</h2>
</div>

<div class="card" style="max-width:520px">
    <div class="card-body">
        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label class="form-label" for="CurrentPassword">كلمة المرور الحالية</label>
                <input asp-for="CurrentPassword" class="form-control" dir="ltr" required />
                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" for="NewPassword">كلمة المرور الجديدة</label>
                <input asp-for="NewPassword" class="form-control" dir="ltr" required />
                <div class="form-text">8 أحرف على الأقل مع حرف كبير وصغير ورقم ورمز</div>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label" for="ConfirmPassword">تأكيد كلمة المرور الجديدة</label>
                <input asp-for="ConfirmPassword" class="form-control" dir="ltr" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
        </form>
    </div>
</div>