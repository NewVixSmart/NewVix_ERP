@model NewVixSmart.Web.ViewModels.Export.ExportCenterViewModel
@{ ViewData["Title"] = "مركز التصدير"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-box-arrow-up text-primary"></i> مركز التصدير</h2>
</div>
<p class="text-muted mb-4">صدّر بيانات كل وحدة من وحدات النظام إلى ملفات Excel أو CSV جاهزة للاستخدام. تُنزَّل الملفات باسم موحّد يتضمن تاريخ اليوم، وتُفتح الحروف العربية تلقائيًا في Excel.</p>

<div class="row g-3">
    @foreach (var item in Model.Items)
    {
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-1">
                        <i class="bi @item.Icon text-primary" style="font-size:2rem;" aria-hidden="true"></i>
                        <div>
                            <h3 class="fs-6 fw-bold mb-0">@item.NameAr</h3>
                            <small class="text-muted">@item.Description</small>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <a asp-action="ExportXlsx" asp-route-key="@item.Key" class="btn btn-sm btn-outline-success" aria-label="تصدير @item.NameAr إلى Excel"><i class="bi bi-file-earmark-excel"></i> تصدير Excel</a>
                        @if (item.HasCsv)
                        {
                            <a asp-action="ExportCsv" asp-route-key="@item.Key" class="btn btn-sm btn-outline-primary" aria-label="تصدير @item.NameAr إلى CSV"><i class="bi bi-filetype-csv"></i> تصدير CSV</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="alert alert-info mt-4 d-flex align-items-center gap-2 mb-0" role="note">
    <i class="bi bi-archive" aria-hidden="true"></i>
    <span>ملفات Excel الأرشيفية تتضمن كل سجل وبياناته التفصيلية (مثل أصناف الفواتير وبنود القيود). للحفاظ على نسخة مؤرشفة من بيانات النظام، يُنصح بتصدير الوحدات بانتظام وحفظ الملفات في مجلد آمن.</span>
</div>