@model NewVixSmart.Web.ViewModels.Export.ExportCenterViewModel
@{ ViewData["Title"] = "مركز التصدير"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">الإعدادات</span>
        <h2><i class="bi bi-box-arrow-up" aria-hidden="true"></i> مركز التصدير</h2>
    </div>
</div>
<p class="text-muted mb-4">صدّر بيانات كل وحدة من وحدات النظام إلى ملفات Excel أو CSV جاهزة للاستخدام. تُنزَّل الملفات باسم موحّد يتضمن تاريخ اليوم، وتُفتح الحروف العربية تلقائيًا في Excel.</p>

<div class="ui-grid ui-grid-3">
    @foreach (var item in Model.Items)
    {
        <div class="ui-card ui-rise">
            <div class="ui-card-body">
                <div class="flex items-center gap-3 mb-1">
                    <i class="bi @item.Icon text-primary text-3xl" aria-hidden="true"></i>
                    <div>
                        <h3 class="ui-card-title mb-0">@item.NameAr</h3>
                        <small class="text-muted">@item.Description</small>
                    </div>
                </div>
                <div class="flex flex-wrap gap-2 mt-3">
                    <a asp-action="ExportXlsx" asp-route-key="@item.Key" class="ui-btn ui-btn-sm ui-btn-ok" aria-label="تصدير @item.NameAr إلى Excel"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> تصدير Excel</a>
                    @if (item.HasCsv)
                    {
                        <a asp-action="ExportCsv" asp-route-key="@item.Key" class="ui-btn ui-btn-sm ui-btn-outline" aria-label="تصدير @item.NameAr إلى CSV"><i class="bi bi-filetype-csv" aria-hidden="true"></i> تصدير CSV</a>
                    }
                </div>
            </div>
        </div>
    }
</div>

<div class="ui-alert ui-alert-info mt-4 flex items-center gap-2 mb-0" role="note">
    <i class="bi bi-archive" aria-hidden="true"></i>
    <span>ملفات Excel الأرشيفية تتضمن كل سجل وبياناته التفصيلية (مثل أصناف الفواتير وبنود القيود). للحفاظ على نسخة مؤرشفة من بيانات النظام، يُنصح بتصدير الوحدات بانتظام وحفظ الملفات في مجلد آمن.</span>
</div>
