@model NewVixSmart.Web.ViewModels.Core.ItemListViewModel
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "الأصناف"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المخزون</span>
        <h2><i class="bi bi-box-seam" aria-hidden="true"></i> الأصناف</h2>
    </div>
    <div class="ui-pagehead-actions">
        @if (await Perm.HasAsync("Reports.Export"))
        {
        <a asp-controller="Reports" asp-action="ExportItemsXlsx" class="ui-btn ui-btn-ok">
            <i class="bi bi-file-earmark-excel" aria-hidden="true"></i> تصدير Excel
        </a>
        }
        @if (await Perm.HasAsync("Items.Create"))
        {
        <a asp-action="Create" class="ui-btn ui-btn-pri">
            <i class="bi bi-plus-lg" aria-hidden="true"></i> صنف جديد
        </a>
        }
    </div>
</div>

<div class="ui-section ui-card ui-rise">
    <div class="card-body">
        <form method="get" class="ui-grid ui-grid-3 items-end">
            <div>
                <label class="form-label" for="categoryFilter">التصنيف</label>
                <select name="categoryId" class="form-select" id="categoryFilter">
                    <option value="">الكل</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Id" selected="@(Model.CategoryId?.ToString() == cat.Id.ToString())">@cat.Name</option>
                    }
                </select>
            </div>
            <div>
                <button type="submit" class="ui-btn ui-btn-outline w-full"><i class="bi bi-search" aria-hidden="true"></i> بحث</button>
            </div>
        </form>
    </div>
</div>

<div class="table-container ui-rise">
    <table class="table">
        <caption class="visually-hidden">الأصناف: الكود، اسم الصنف، النوع، التصنيف، وحدات العدد والكمية، الرصيد الحالي</caption>
        <thead>
            <tr>
                <th scope="col">الكود</th>
                <th scope="col">اسم الصنف</th>
                <th scope="col">النوع</th>
                <th scope="col">التصنيف</th>
                <th scope="col">العدد / الكمية</th>
                <th scope="col">الرصيد الحالي</th>
                <th scope="col" class="text-center">إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td><code>@item.Code</code></td>
                    <td><strong>@item.Name</strong></td>
                    <td>
                        <span class="ui-badge ui-badge-info">@(item.ItemType?.Name ?? "—")</span>
                    </td>
                    <td><span class="ui-badge ui-badge-mute">@item.Category.Name</span></td>
                    <td>
                        <small class="text-muted">عدد: @(item.CountUnit?.Name ?? "—")، كمية: @(item.QuantityUnit?.Name ?? "—")</small>
                    </td>
                    <td>
                        @{
                            bool low = (item.CurrentCount <= item.MinCount && item.MinCount > 0) || (item.CurrentQuantity <= item.MinQuantity && item.MinQuantity > 0);
                        }
                        <span class="ui-badge @(low ? "ui-badge-bad" : "ui-badge-ok")">
                            @(low ? "منخفض: " : "متوفر: ")<span class="num">@item.CurrentCount.ToString("N2") / @item.CurrentQuantity.ToString("N2")</span>
                        </span>
                    </td>
                    <td>
                        <div class="flex flex-wrap items-center justify-center gap-1">
                            @if (await Perm.HasAsync("Items.Edit"))
                            {
                            <a asp-action="Edit" asp-route-id="@item.Id" class="ui-btn ui-btn-sm ui-btn-outline" aria-label="تعديل @item.Name">
                                <i class="bi bi-pencil" aria-hidden="true"></i>
                            </a>
                            }
                            <a asp-action="Details" asp-route-id="@item.PublicId" class="ui-btn ui-btn-sm ui-btn-outline" aria-label="تفاصيل @item.Name">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </a>
                            @if (await Perm.HasAsync("Items.Delete"))
                            {
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" data-confirm="هل أنت متأكد من حذف هذا الصنف؟" data-confirm-ok="حذف">
                                <button type="submit" class="ui-btn ui-btn-sm ui-btn-danger" aria-label="حذف @item.Name">
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                </button>
                            </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Items.Any())
{
    <div class="empty-state ui-rise">
        <div class="empty-icon"><i class="bi bi-inbox" aria-hidden="true"></i></div>
        <strong>لا توجد أصناف في المستودع بعد</strong>
        <p class="text-muted">ابدأ ببناء كتالوجك — أضف صنفك الأول وسيظهر هنا مباشرة.</p>
        <a asp-action="Create" class="ui-btn ui-btn-pri mt-2"><i class="bi bi-plus-lg" aria-hidden="true"></i> إضافة أول صنف</a>
    </div>
}
