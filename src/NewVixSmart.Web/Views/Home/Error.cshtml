@model NewVixSmart.Web.Models.ErrorViewModel
@{
    ViewData["Title"] = "خطأ";
}

<div class="card empty-state mx-auto my-5" style="max-width:520px;">
    <h1 class="display-1 text-danger mb-3"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i> خطأ</h1>
    <h2 class="mb-3">حدث خطأ أثناء معالجة طلبك</h2>
    <p class="text-muted mb-4">نعتذر عن الإزعاج، يرجى المحاولة مرة أخرى.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">المعرف: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary"><i class="bi bi-house" aria-hidden="true"></i> العودة للرئيسية</a>
</div>