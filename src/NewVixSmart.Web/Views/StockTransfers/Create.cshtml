@model NewVixSmart.Web.ViewModels.Stock.StockTransferFormViewModel
@{ ViewData["Title"] = "تحويل مخزون جديد"; var warehouses = Model.Warehouses; var items = Model.ItemsData; }
@{
    ViewData["LineItemColumns"] = 6;
    ViewData["ErrorKeysWithVisibleField"] = System.Array.Empty<string>();
    Func<int, string, IHtmlContent> fieldError = (index, field) =>
    {
        var key = "items[" + index + "]." + field;
        var failed = ViewData.ModelState.Any(entry =>
            entry.Key.Equals(key, StringComparison.OrdinalIgnoreCase) && entry.Value!.Errors.Count > 0);
        return failed
            ? Html.Raw(" aria-invalid=\"true\" aria-describedby=\"line-error-" + index + "\"")
            : Html.Raw(string.Empty);
    };
}

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المخزون</span>
        <h2><i class="bi bi-arrow-left-right" aria-hidden="true"></i> تحويل مخزون جديد</h2>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly" class="ui-alert ui-alert-bad ui-rise" role="alert" tabindex="-1"></div>
    @await Html.PartialAsync("_UnhandledFieldErrors")
}

<form asp-action="Create" id="transferForm">
    <div class="ui-section ui-card">
        <div class="ui-card-body">
            <div class="ui-grid ui-grid-4">
                <div>
                    <label class="ui-label" for="sourceWh">المستودع المصدر</label>
                    <select asp-for="Transfer.SourceWarehouseId" asp-items="warehouses" class="ui-input" id="sourceWh">
                        <option value="">-- اختر المستودع المصدر --</option>
                    </select>
                </div>
                <div>
                    <label class="ui-label" for="targetWh">المستودع الوجهة</label>
                    <select asp-for="Transfer.TargetWarehouseId" asp-items="warehouses" class="ui-input" id="targetWh">
                        <option value="">-- اختر المستودع الوجهة --</option>
                    </select>
                </div>
                <div>
                    <label asp-for="Transfer.TransferDate" class="ui-label"></label>
                    <input asp-for="Transfer.TransferDate" class="ui-input" type="date" />
                </div>
                <div>
                    <label asp-for="Transfer.Notes" class="ui-label"></label>
                    <input asp-for="Transfer.Notes" class="ui-input" />
                </div>
            </div>
        </div>
    </div>

    <div class="ui-section ui-card">
        <div class="ui-card-head"><i class="bi bi-list-ul" aria-hidden="true"></i> أصناف التحويل</div>
        <div class="ui-card-body p-0">
            <table class="table" id="itemsTable">
                <caption class="visually-hidden">أصناف تحويل المخزون المُدخلة: الصنف، العدد، الكمية، التكلفة، التاريخ الأصلي</caption>
                <thead>
                    <tr>
                        <th scope="col" style="width:30%">الصنف</th>
                        <th scope="col" style="width:20%">العدد</th>
                        <th scope="col" style="width:20%">الكمية</th>
                        <th scope="col" style="width:10%">التكلفة</th>
                        <th scope="col" style="width:10%">التاريخ الأصلي</th>
                        <th scope="col" style="width:10%" class="text-center">حذف</th>
                    </tr>
                </thead>
                <tbody id="itemsBody">
                    @for (var idx = 0; idx < Model.Items.Count; idx++)
                    {
                        var line = Model.Items[idx];
                        <tr>
                            <td>
                                <select name="items[@idx].ItemId" class="form-select ui-select-sm item-select" aria-label="الصنف" @(fieldError(idx, "ItemId"))>
                                    <option value="">اختر صنف</option>
                                    @foreach (var item in items)
                                    {
                                        <option value="@item.Id" data-count="@item.CurrentCount" data-qty="@item.CurrentQuantity" data-price="@item.PurchasePrice" selected="@(item.Id == line.ItemId)">@item.Name</option>
                                    }
                                </select>
                            </td>
                            <td><input name="items[@idx].Count" type="number" step="0.0001" class="form-control form-control-sm count" value="@line.Count" aria-label="العدد" @(fieldError(idx, "Count")) /></td>
                            <td><input name="items[@idx].Quantity" type="number" step="0.0001" class="form-control form-control-sm qty" value="@line.Quantity" aria-label="الكمية" @(fieldError(idx, "Quantity")) /></td>
                            <td><input name="items[@idx].UnitCost" type="number" step="0.000001" class="form-control form-control-sm price" value="@line.UnitCost" aria-label="التكلفة" @(fieldError(idx, "UnitCost")) /></td>
                            <td><input name="items[@idx].DateReceived" type="date" class="form-control form-control-sm" aria-label="التاريخ الأصلي" value="@line.DateReceived.ToString("yyyy-MM-dd")" /></td>
                            <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-row" aria-label="حذف السطر"><i class="bi bi-x" aria-hidden="true"></i></button></td>
                        </tr>
                        @await Html.PartialAsync("_LineItemErrors", idx)
                    }
                </tbody>
            </table>
        </div>
        <div class="ui-card-foot">
            <button type="button" class="ui-btn ui-btn-sm ui-btn-outline" id="addRow"><i class="bi bi-plus" aria-hidden="true"></i> إضافة صنف</button>
        </div>
    </div>

    <div class="ui-form-actions">
        <button type="submit" class="ui-btn ui-btn-pri"><i class="bi bi-check-lg" aria-hidden="true"></i> تنفيذ التحويل</button>
        <a asp-action="Index" class="ui-btn ui-btn-quiet"><i class="bi bi-x-lg" aria-hidden="true"></i> إلغاء</a>
    </div>
</form>

@section Scripts {
<script nonce="@Context.GetCspNonce()">
function escapeHtml(str) {
    return String(str == null ? '' : str)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

let rowIndex = @Model.Items.Count;
document.getElementById('addRow').addEventListener('click', function() {
    const tbody = document.getElementById('itemsBody');
    const items = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        items.Select(i => new { i.Id, i.Name, i.CurrentCount, i.CurrentQuantity, i.PurchasePrice }),
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default }));
    let options = '<option value="">اختر صنف</option>';
    items.forEach(i => { options += `<option value="${i.id}" data-count="${i.currentCount}" data-qty="${i.currentQuantity}" data-price="${i.purchasePrice}">${escapeHtml(i.name)}</option>`; });
    const tr = document.createElement('tr');
    tr.innerHTML = `<td><select name="items[${rowIndex}].ItemId" class="form-select ui-select-sm item-select" aria-label="الصنف">${options}</select></td>
        <td><input name="items[${rowIndex}].Count" type="number" step="0.0001" class="form-control form-control-sm count" value="0" aria-label="العدد" /></td>
        <td><input name="items[${rowIndex}].Quantity" type="number" step="0.0001" class="form-control form-control-sm qty" value="0" aria-label="الكمية" /></td>
        <td><input name="items[${rowIndex}].UnitCost" type="number" step="0.000001" class="form-control form-control-sm price" value="0" aria-label="التكلفة" /></td>
        <td><input name="items[${rowIndex}].DateReceived" type="date" class="form-control form-control-sm" aria-label="التاريخ الأصلي" /></td>
        <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-row" aria-label="حذف السطر"><i class="bi bi-x" aria-hidden="true"></i></button></td>`;
    tbody.appendChild(tr);
    rowIndex++;
    bindEvents();
});

function bindEvents() {
    document.querySelectorAll('.remove-row').forEach(btn => {
        if (btn.dataset.boundRow) return;
        btn.dataset.boundRow = 'true';
        btn.addEventListener('click', function() { this.closest('tr').remove(); });
    });
    document.querySelectorAll('.item-select').forEach(sel => {
        if (sel.dataset.boundItem) return;
        sel.dataset.boundItem = 'true';
        sel.addEventListener('change', function() {
            const opt = this.options[this.selectedIndex];
            const price = opt.dataset.price || 0;
            this.closest('tr').querySelector('.price').value = parseFloat(price).toFixed(6);
        });
    });
}

bindEvents();
</script>
}
