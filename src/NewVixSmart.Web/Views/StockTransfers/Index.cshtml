@model IEnumerable<NewVixSmart.Web.Models.Stock.StockTransfer>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "سجلات نقل المخزون"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المخزون</span>
        <h2><i class="bi bi-arrow-left-right" aria-hidden="true"></i> سجلات نقل المخزون</h2>
    </div>
    @if (await Perm.HasAsync("StockTransfers.Create"))
    {
        <div class="ui-pagehead-actions">
            <a asp-action="Create" class="ui-btn ui-btn-pri"><i class="bi bi-plus-lg" aria-hidden="true"></i> تحويل جديد</a>
        </div>
    }
</div>

<div class="table-container ui-rise">
    <table class="table">
        <caption class="visually-hidden">تحويلات المخزون</caption>
        <thead>
            <tr>
                <th scope="col">رقم التحويل</th>
                <th scope="col">المستودع المصدر</th>
                <th scope="col">المستودع الوجهة</th>
                <th scope="col">التاريخ</th>
                <th scope="col">عدد الأصناف</th>
                <th scope="col">بواسطة</th>
                <th scope="col"><span class="visually-hidden">إجراءات</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td><code>@t.TransferNumber</code></td>
                    <td><strong>@t.SourceWarehouse?.Name</strong></td>
                    <td><strong>@t.TargetWarehouse?.Name</strong></td>
                    <td class="num">@t.TransferDate.ToString("dd/MM/yyyy")</td>
                    <td class="num">@t.Items.Count</td>
                    <td>@(t.CreatedBy ?? "—")</td>
                    <td class="whitespace-nowrap">
                        <a asp-action="Print" asp-route-id="@t.Id" target="_blank" rel="noopener" class="ui-btn ui-btn-sm ui-btn-outline" aria-label="طباعة تحويل @t.TransferNumber"><i class="bi bi-printer" aria-hidden="true"></i></a>
                        <a asp-action="Pdf" asp-route-id="@t.Id" class="ui-btn ui-btn-sm ui-btn-outline" aria-label="تحميل PDF لتحويل @t.TransferNumber"><i class="bi bi-filetype-pdf" aria-hidden="true"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
