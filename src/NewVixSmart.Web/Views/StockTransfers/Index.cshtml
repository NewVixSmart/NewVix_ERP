@model IEnumerable<NewVixSmart.Web.Models.Stock.StockTransfer>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "سجلات نقل المخزون"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-arrow-left-right text-primary" aria-hidden="true"></i> سجلات نقل المخزون</h2>
    @if (await Perm.HasAsync("StockTransfers.Create"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> تحويل جديد</a>
    }
</div>

<div class="table-container">
    <table class="table table-hover mb-0">
        <caption class="visually-hidden">تحويلات المخزون</caption>
        <thead>
            <tr>
                <th scope="col">رقم التحويل</th>
                <th scope="col">المستودع المصدر</th>
                <th scope="col">المستودع الوجهة</th>
                <th scope="col">التاريخ</th>
                <th scope="col">عدد الأصناف</th>
                <th scope="col">بواسطة</th>
                <th scope="col"><span class="visually-hidden">إجراءات</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td><code>@t.TransferNumber</code></td>
                    <td><strong>@t.SourceWarehouse?.Name</strong></td>
                    <td><strong>@t.TargetWarehouse?.Name</strong></td>
                    <td>@t.TransferDate.ToString("dd/MM/yyyy")</td>
                    <td>@t.Items.Count</td>
                    <td>@(t.CreatedBy ?? "—")</td>
                    <td class="text-nowrap">
                        <a asp-action="Print" asp-route-id="@t.Id" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary" aria-label="طباعة تحويل @t.TransferNumber"><i class="bi bi-printer" aria-hidden="true"></i></a>
                        <a asp-action="Pdf" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary" aria-label="تحميل PDF لتحويل @t.TransferNumber"><i class="bi bi-filetype-pdf" aria-hidden="true"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
