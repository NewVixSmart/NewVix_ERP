@model NewVixSmart.Web.ViewModels.Purchases.SupplierLedgerViewModel
@{ ViewData["Title"] = $"دفتر أستاذ - {Model.Supplier?.Name ?? ""}"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-journal-bookmark text-primary"></i> دفتر أستاذ: @(Model.Supplier?.Name ?? "—")</h2>
    <div>
        <span class="badge @(Model.Balance >= 0 ? "bg-danger" : "bg-success") fs-6">الرصيد: @Money.Format(Model.Balance)</span>
        <a asp-action="LedgerXlsx" asp-route-id="@Model.Supplier?.Id" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel"></i> تصدير كشف حساب Excel</a>
        <a asp-action="LedgerPdf" asp-route-id="@Model.Supplier?.Id" class="btn btn-outline-danger"><i class="bi bi-file-earmark-pdf"></i> كشف حساب PDF</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> رجوع</a>
    </div>
</div>

<div class="card mb-3"><div class="card-body py-2">
    <div class="row g-3 small">
        <div class="col"><span class="text-muted">فاتح:</span> <strong>@Model.Supplier?.OpeningBalance.ToString("N2")</strong></div>
        <div class="col"><span class="text-muted">إجمالي الفواتير:</span> <strong>@Model.Invoices.Sum(i => i.NetAmount).ToString("N2")</strong></div>
        <div class="col"><span class="text-muted">إجمالي المدفوع:</span> <strong>@Model.Payments.Where(p => p.Type == NewVixSmart.Web.Models.Accounting.PaymentType.Disbursement).Sum(p => p.Amount).ToString("N2")</strong></div>
        <div class="col"><span class="text-muted">إجمالي المردودات:</span> <strong>@Model.Returns.Sum(r => r.TotalAmount).ToString("N2")</strong></div>
        <div class="col"><span class="text-muted">التليفون:</span> <strong>@(Model.Supplier?.Phone ?? "—")</strong></div>
    </div>
</div></div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card"><div class="card-header"><i class="bi bi-cart-dash"></i> فواتير الشراء</div><div class="card-body p-0">
            <table class="table table-hover mb-0"><thead><tr><th scope="col">الفاتورة</th><th scope="col">التاريخ</th><th scope="col">المبلغ</th><th scope="col">المدفوع</th></tr></thead>
            <tbody>@foreach (var i in Model.Invoices) { <tr><td><code>@i.InvoiceNumber</code></td><td>@i.InvoiceDate.ToString("dd/MM/yyyy")</td><td>@i.NetAmount.ToString("N2")</td><td>@i.PaidAmount.ToString("N2")</td></tr> }</tbody></table>
        </div></div>
    </div>
    <div class="col-lg-6">
        <div class="card"><div class="card-header"><i class="bi bi-wallet2"></i> المدفوعات (المصروفات)</div><div class="card-body p-0">
            <table class="table table-hover mb-0"><thead><tr><th scope="col">الإيصال</th><th scope="col">التاريخ</th><th scope="col">المبلغ</th><th scope="col">الطريقة</th></tr></thead>
            <tbody>@foreach (var p in Model.Payments) { <tr><td><code>@p.ReceiptNumber</code></td><td>@p.PaymentDate.ToString("dd/MM/yyyy")</td><td class="text-danger fw-bold">@p.Amount.ToString("N2")</td><td>@p.Method.GetDisplayName()</td></tr> }</tbody></table>
        </div></div>
    </div>
</div>

<div class="card mt-4"><div class="card-header"><i class="bi bi-arrow-counterclockwise"></i> مرتجعات الشراء</div><div class="card-body p-0">
    <table class="table table-hover mb-0"><thead><tr><th scope="col">المرتجع</th><th scope="col">التاريخ</th><th scope="col">المبلغ</th></tr></thead>
    <tbody>@foreach (var r in Model.Returns) { <tr><td><code>@r.ReturnNumber</code></td><td>@r.ReturnDate.ToString("dd/MM/yyyy")</td><td class="text-success fw-bold">-@r.TotalAmount.ToString("N2")</td></tr> } @if (!Model.Returns.Any()) { <tr><td colspan="3" class="text-center text-muted">لا توجد مردودات</td></tr> }</tbody></table>
</div></div>

@if (!Model.Invoices.Any() && !Model.Payments.Any() && !Model.Returns.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox" style="font-size:3rem;"></i>
        <p class="mt-2">لا توجد حركات على هذا المورد</p>
    </div>
}