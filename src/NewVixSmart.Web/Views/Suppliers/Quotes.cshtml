@model IEnumerable<NewVixSmart.Web.Models.Purchases.SupplierQuote>
@{ ViewData["Title"] = "أسعار الموردين"; }

<div class="page-header"><h2><i class="bi bi-cash-stack text-primary"></i> أسعار الموردين (عروض الأسعار)</h2></div>

<div class="card mb-4"><div class="card-body">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label" for="supplierId">المورد</label>
            <select id="supplierId" name="supplierId" asp-items="@ViewBag.Suppliers" class="form-select">
                <option value="">— الكل —</option>
            </select>
        </div>
        <div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> بحث</button></div>
    </form>
</div></div>

<div class="table-container">
    <table class="table table-hover mb-0">
        <caption class="visually-hidden">أسعار الموردين: المورد، الصنف، سعر الوحدة، التاريخ، ملاحظات</caption>
        <thead><tr><th scope="col">المورد</th><th scope="col">الصنف</th><th scope="col">سعر الوحدة</th><th scope="col">التاريخ</th><th scope="col">ملاحظات</th></tr></thead>
        <tbody>
            @foreach (var q in Model)
            {
                <tr>
                    <td>@(q.Supplier?.Name ?? "—")</td>
                    <td>@(q.Item?.Name ?? "—")</td>
                    <td>@Money.Format(q.UnitPrice)</td>
                    <td>@q.EffectiveDate.ToString("dd/MM/yyyy")</td>
                    <td>@(q.Notes ?? "—")</td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted">لا توجد أسعار مسجلة</td></tr>
            }
        </tbody>
    </table>
</div>
