@model IEnumerable<NewVixSmart.Web.Models.Accounting.GLAccount>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "مخطط الحسابات"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المحاسبة</span>
        <h2><i class="bi bi-journal-code" aria-hidden="true"></i> مخطط الحسابات</h2>
    </div>
    @if (await Perm.HasAsync("ChartOfAccounts.Create"))
    {
        <div class="ui-pagehead-actions">
            <a asp-action="Create" class="ui-btn ui-btn-pri"><i class="bi bi-plus-lg" aria-hidden="true"></i> حساب جديد</a>
        </div>
    }
</div>

<div class="ui-section ui-card ui-rise">
    <div class="card-body">
        <form method="get" class="ui-grid ui-grid-4 items-end">
            <div>
                <label class="form-label" for="accTypeFilter">النوع</label>
                <select name="type" id="accTypeFilter" class="form-select" data-auto-submit>
                    <option value="">كل الأنواع</option>
                    @foreach (var t in Enum.GetValues<NewVixSmart.Web.Models.Accounting.GLAccountType>())
                    {
                        <option value="@((int)t)" selected="@(ViewBag.TypeFilter == t)">@t.ToString()</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label" for="accActiveFilter">الحالة</label>
                <select name="active" id="accActiveFilter" class="form-select" data-auto-submit>
                    <option value="">الكل</option>
                    <option value="true" selected="@(ViewBag.ActiveFilter == true)">نشط</option>
                    <option value="false" selected="@(ViewBag.ActiveFilter == false)">معطّل</option>
                </select>
            </div>
            <div>
                <label class="form-label" for="accSearch">بحث في الحسابات</label>
                <input type="search" name="search" id="accSearch" value="@ViewBag.Search" class="ui-input" placeholder="بحث بالرمز أو الاسم">
            </div>
            <div>
                <button type="submit" class="ui-btn ui-btn-outline w-full"><i class="bi bi-funnel" aria-hidden="true"></i> تصفية</button>
            </div>
        </form>
    </div>
</div>

<div class="ui-section table-container ui-rise">
    <table class="table">
        <caption class="visually-hidden">مخطط الحسابات: الرمز، الاسم، النوع، الطبيعة، الرصيد (مدين/دائن)، الحالة</caption>
        <thead>
            <tr>
                <th scope="col">الرمز</th>
                <th scope="col">الاسم</th>
                <th scope="col">النوع</th>
                <th scope="col">الطبيعة</th>
                <th scope="col" class="text-start">الرصيد (مدين/دائن)</th>
                <th scope="col">الحالة</th>
                <th scope="col" class="text-center">إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @{
                var balancesMap = ViewBag.Balances as Dictionary<int, (decimal Debit, decimal Credit)> ?? new Dictionary<int, (decimal Debit, decimal Credit)>();
            }
            @foreach (var a in Model)
            {
                var bal = balancesMap.GetValueOrDefault(a.Id);
                <tr>
                    <td><code>@a.Code</code></td>
                    <td><strong>@a.Name</strong></td>
                    <td>@a.Type.ToString()</td>
                    <td>@(a.NormalBalance == NewVixSmart.Web.Models.Accounting.NormalBalance.Debit ? "مدين" : "دائن")</td>
                    <td class="num">@Money.Format(bal.Debit) / @Money.Format(bal.Credit)</td>
                    <td>
                        @if (a.IsActive)
                        { <span class="ui-badge ui-badge-ok">نشط</span> }
                        else
                        { <span class="ui-badge ui-badge-bad">معطّل</span> }
                    </td>
                    <td>
                        <div class="flex flex-wrap items-center justify-center gap-1">
                            @if (await Perm.HasAsync("ChartOfAccounts.Edit"))
                            {
                                <a asp-action="Edit" asp-route-id="@a.Id" class="ui-btn ui-btn-sm ui-btn-outline" aria-label="تعديل حساب @a.Code"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            }
                            @if (await Perm.HasAsync("ChartOfAccounts.Deactivate"))
                            {
                                <form asp-action="Deactivate" asp-route-id="@a.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="ui-btn ui-btn-sm @(a.IsActive ? "btn-outline-warning" : "btn-outline-success")" aria-label="@(a.IsActive ? "تعطيل حساب " + a.Code : "تنشيط حساب " + a.Code)">
                                        <i class="bi @(a.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i>
                                    </button>
                                </form>
                                <form asp-action="Delete" asp-route-id="@a.Id" method="post" data-confirm="حذف هذا الحساب نهائيًا؟" data-confirm-ok="حذف">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="ui-btn ui-btn-sm btn-del" aria-label="حذف حساب @a.Code"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">لا توجد حسابات بعد</td></tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pager")
