@model NewVixSmart.Web.Models.Accounting.GLAccount
@{ ViewData["Title"] = "تعديل الحساب"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المحاسبة</span>
        <h2><i class="bi bi-pencil" aria-hidden="true"></i> تعديل الحساب — @Model.Code</h2>
    </div>
</div>

@if (ViewBag.IsSystem == true)
{
    <div class="ui-alert ui-alert-warn ui-rise">حساب نظامي مُعرَّف بالبذرة — لا يمكن تغيير رمزه.</div>
}
@if (ViewBag.IsPosted == true)
{
    <div class="ui-alert ui-alert-warn ui-rise">هذا الحساب له قيود مرحلة — لا يمكن تغيير رمزه؛ يمكنك فقط تعديل الاسم أو التعطيل.</div>
}

<div class="ui-section ui-card ui-rise" style="max-width:640px">
    <div class="card-body">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            @if (Model.RowVersion is { Length: > 0 } accountRv)
            {
                <input type="hidden" name="RowVersion" value="@Convert.ToBase64String(accountRv)" />
            }
            <div class="mb-4">
                <label class="ui-label" for="Code">رمز الحساب</label>
                @{ var codeLocked = (ViewBag.IsPosted == true || ViewBag.IsSystem == true); }
                @if (codeLocked)
                {
                    <input asp-for="Code" class="ui-input" dir="ltr" required readonly />
                }
                else
                {
                    <input asp-for="Code" class="ui-input" dir="ltr" required />
                }
                @if (ViewBag.IsPosted == true || ViewBag.IsSystem == true)
                {
                    <div class="form-text text-danger">الرمز مقفل لأنه حساب مستخدم/نظامي</div>
                }
            </div>
            <div class="mb-4">
                <label class="ui-label" for="Name">اسم الحساب</label>
                <input asp-for="Name" class="ui-input" required />
            </div>
            <div class="mb-4">
                <label class="ui-label" for="Type">نوع الحساب</label>
                <select asp-for="Type" class="form-select">
                    @foreach (var t in Enum.GetValues<NewVixSmart.Web.Models.Accounting.GLAccountType>())
                    {
                        <option value="@((int)t)">@t.ToString()</option>
                    }
                </select>
            </div>
            <div class="mb-4">
                <label class="ui-label" for="NormalBalance">طبيعة الحساب</label>
                <select asp-for="NormalBalance" class="form-select">
                    <option value="1">مدين</option>
                    <option value="2">دائن</option>
                </select>
            </div>
            <div class="mb-4">
                <label class="ui-label" for="ParentAccountId">الحساب الأب (اختياري)</label>
                <select asp-for="ParentAccountId" class="form-select" asp-items="ViewBag.ParentList">
                    <option value="">—</option>
                </select>
            </div>
            <div class="mb-4 form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActive" />
                <label class="form-check-label" for="isActive">نشط</label>
            </div>
            <div class="ui-form-actions">
                <button type="submit" class="ui-btn ui-btn-pri"><i class="bi bi-check-lg" aria-hidden="true"></i> حفظ</button>
                <a asp-action="Index" class="ui-btn ui-btn-ghost">إلغاء</a>
            </div>
        </form>
    </div>
</div>
