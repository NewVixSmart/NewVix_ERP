@model NewVixSmart.Web.ViewModels.Sales.DeliveryOrderViewModel
@using NewVixSmart.Web.Models.Sales
@{ ViewData["Title"] = "أذن تسليم جديد"; }

<div class="page-header">
    <h2><i class="bi bi-truck text-primary"></i> أذن تسليم جديد</h2>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
}
@if (ViewBag.OrderLabel != null)
{
    <div class="alert alert-info my-3">أمر البيع المختار: <strong>@ViewBag.OrderLabel</strong> — الأسطر المعروضة هي المتبقي غير المسجّل في أذون أخرى.</div>
}
@if (ViewBag.InvoiceLabel != null)
{
    <div class="alert alert-info my-3">الفاتورة المختارة: <strong>@ViewBag.InvoiceLabel</strong> — تُشحن الكمية المتبقية دفعة واحدة أو جزء منها.</div>
}

<form asp-action="Create">
    <input type="hidden" name="Source" id="SourceField" value="@Model.Source" />

    <div class="card mb-3">
        <div class="card-header"><i class="bi bi-diagram-3"></i> مصدر الأذن</div>
        <div class="card-body">
            <fieldset class="row g-3">
                <legend class="visually-hidden">اختر مصدر أذن التسليم</legend>
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="sourceChoice" id="srcOrder" value="Order" @(Model.Source == "Order" ? "checked" : "") />
                        <label class="form-check-label" for="srcOrder">من أمر بيع</label>
                    </div>
                    <select asp-for="Delivery.SalesOrderId" asp-items="@Model.SalesOrders" class="form-select form-select-sm mt-2" id="salesOrderSelect" aria-label="اختر أمر البيع المرتبط" data-redirect="@Url.Action("Create", "DeliveryOrders")">
                        <option value="">-- اختر أمر بيع --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="sourceChoice" id="srcInvoice" value="Invoice" @(Model.Source == "Invoice" ? "checked" : "") />
                        <label class="form-check-label" for="srcInvoice">من فاتورة (المسار القديم)</label>
                    </div>
                    <select asp-for="Delivery.SaleInvoiceId" asp-items="@Model.Invoices" class="form-select form-select-sm mt-2" id="invoiceSelect" aria-label="اختر فاتورة البيع المرتبطة" data-redirect="@Url.Action("Create", "DeliveryOrders")">
                        <option value="">-- اختر فاتورة بيع --</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="sourceChoice" id="srcFree" value="Free" @(Model.Source != "Order" && Model.Source != "Invoice" ? "checked" : "") />
                        <label class="form-check-label" for="srcFree">إدخال حر (بدون أمر أو فاتورة)</label>
                    </div>
                    <select asp-for="Delivery.CustomerId" asp-items="@Model.Customers" class="form-select form-select-sm mt-2" id="customerSelect" aria-label="اختر العميل المستلم">
                        <option value="">-- اختر العميل --</option>
                    </select>
                </div>
            </fieldset>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Delivery.DeliveryDate" class="form-label"></label>
                    <input asp-for="Delivery.DeliveryDate" class="form-control" type="date" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Delivery.Carrier" class="form-label"></label>
                    <input asp-for="Delivery.Carrier" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Delivery.TrackingNumber" class="form-label"></label>
                    <input asp-for="Delivery.TrackingNumber" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Delivery.Notes" class="form-label"></label>
                    <textarea asp-for="Delivery.Notes" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header"><i class="bi bi-list-ul"></i> أصناف التسليم</div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0" id="itemsTable">
                    <caption class="visually-hidden">أصناف أذن التسليم مع الكمية والعدد المُسلَّم</caption>
                    <thead>
                        <tr>
                            <th scope="col" style="width:40%">الصنف</th>
                            <th scope="col" style="width:20%">العدد المسلّم</th>
                            <th scope="col" style="width:20%">الكمية المسلّمة</th>
                            <th scope="col" style="width:20%" class="text-center">حذف</th>
                        </tr>
                    </thead>
                    <tbody id="itemsBody">
                        @for (var idx = 0; idx < (Model.Items.Any() ? Model.Items.Count : 0); idx++)
                        {
                            var line = Model.Items[idx];
                            <tr>
                                <td>
                                    <input type="hidden" name="items[@idx].ItemId" value="@line.ItemId" />
                                    <strong>@(line.Item?.Name != null ? line.Item.Name : (Model.ItemsData.FirstOrDefault(i => i.Id == line.ItemId)?.Name ?? $"صنف #{line.ItemId}"))</strong>
                                </td>
                                <td><input name="items[@idx].Count" type="number" step="0.01" class="form-control form-control-sm count" value="@line.Count" aria-label="العدد المسلّم" /></td>
                                <td><input name="items[@idx].Quantity" type="number" step="0.01" class="form-control form-control-sm qty" value="@line.Quantity" aria-label="الكمية المسلّمة" /></td>
                                <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-row" aria-label="حذف السطر"><i class="bi bi-x"></i></button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer text-muted small">اختر صنفاً من قائمة الأصناف لإضافته. الكمية المعروضة هي المتبقية غير المسلّمة من المصدر.</div>
        <div class="card-body border-top">
            <div class="row g-2 align-items-end">
                <div class="col-md-8">
                    <label for="itemPicker" class="form-label">إضافة صنف</label>
                    <select id="itemPicker" class="form-select">
                        <option value="">-- اختر الصنف --</option>
                        @foreach (var it in Model.ItemsData)
                        {
                            <option value="@it.Id">@it.Name @(it.Code != null ? $"({it.Code})" : "")</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="button" id="addItemBtn" class="btn btn-outline-secondary w-100"><i class="bi bi-plus-lg"></i> إضافة</button>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ أذن التسليم</button>
        <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
    </div>
</form>

@section Scripts {
<script nonce="@Context.GetCspNonce()">
document.querySelectorAll('.remove-row').forEach(btn => {
    btn.addEventListener('click', function () { this.closest('tr').remove(); renumber(); });
});

const SourceField = document.getElementById('SourceField');
const radios = document.querySelectorAll('input[name="sourceChoice"]');
const orderSelect = document.getElementById('salesOrderSelect');
const invoiceSelect = document.getElementById('invoiceSelect');
const customerSelect = document.getElementById('customerSelect');
const createUrl = '@Url.Action("Create", "DeliveryOrders")';

function currentSource() {
    const checked = document.querySelector('input[name="sourceChoice"]:checked');
    return checked ? checked.value : 'Free';
}

function renumber() {
    document.querySelectorAll('#itemsBody tr').forEach(function (tr, i) {
        tr.querySelectorAll('input[name]').forEach(function (el) {
            el.name = el.name.replace(/items\[\d+\]/, 'items[' + i + ']');
        });
    });
}

function clearOtherSources(keep) {
    if (keep !== 'Order' && orderSelect) orderSelect.value = '';
    if (keep !== 'Invoice' && invoiceSelect) invoiceSelect.value = '';
    if (keep !== 'Free' && customerSelect) customerSelect.value = '';
}

radios.forEach(function (r) {
    r.addEventListener('change', function () {
        SourceField.value = r.value;
        clearOtherSources(r.value);
    });
});

if (orderSelect) {
    orderSelect.addEventListener('change', function () {
        if (orderSelect.value) {
            SourceField.value = 'Order';
            clearOtherSources('Order');
            location.href = createUrl + '?source=Order&salesOrderId=' + encodeURIComponent(orderSelect.value);
        }
    });
}

if (invoiceSelect) {
    invoiceSelect.addEventListener('change', function () {
        if (invoiceSelect.value) {
            SourceField.value = 'Invoice';
            clearOtherSources('Invoice');
            location.href = createUrl + '?source=Invoice&invoiceId=' + encodeURIComponent(invoiceSelect.value);
        }
    });
}

const picker = document.getElementById('itemPicker');
const addBtn = document.getElementById('addItemBtn');
if (picker && addBtn) {
    addBtn.addEventListener('click', function () {
        if (!picker.value) return;
        const opt = picker.selectedOptions[0];
        const body = document.getElementById('itemsBody');
        const idx = body.querySelectorAll('tr').length;
        const tr = document.createElement('tr');
        tr.innerHTML = '<td><input type="hidden" name="items[' + idx + '].ItemId" /><strong></strong></td>' +
            '<td><input name="items[' + idx + '].Count" type="number" step="0.01" value="0" class="form-control form-control-sm" aria-label="العدد المسلّم" /></td>' +
            '<td><input name="items[' + idx + '].Quantity" type="number" step="0.01" value="0" class="form-control form-control-sm" aria-label="الكمية المسلّمة" /></td>' +
            '<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-row" aria-label="حذف السطر"><i class="bi bi-x"></i></button></td>';
        tr.querySelector('input[name$=".ItemId"]').value = picker.value;
        tr.querySelector('strong').textContent = opt.textContent.trim();
        body.appendChild(tr);
        tr.querySelector('.remove-row').addEventListener('click', function () { tr.remove(); renumber(); });
        picker.value = '';
    });
}
</script>
}
