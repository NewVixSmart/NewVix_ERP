@model NewVixSmart.Web.ViewModels.Sales.DeliveryOrderViewModel
@using NewVixSmart.Web.Models.Sales
@{ ViewData["Title"] = "أذن تسليم جديد"; }
@{
    ViewData["LineItemColumns"] = 4;
    ViewData["ErrorKeysWithVisibleField"] = System.Array.Empty<string>();
    Func<int, string, IHtmlContent> fieldError = (index, field) =>
    {
        var key = "items[" + index + "]." + field;
        var failed = ViewData.ModelState.Any(entry =>
            entry.Key.Equals(key, StringComparison.OrdinalIgnoreCase) && entry.Value!.Errors.Count > 0);
        return failed
            ? Html.Raw(" aria-invalid=\"true\" aria-describedby=\"line-error-" + index + "\"")
            : Html.Raw(string.Empty);
    };
}

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المبيعات</span>
        <h2>أذن تسليم جديد</h2>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly" class="ui-alert ui-alert-bad ui-rise" role="alert" tabindex="-1"></div>
    @await Html.PartialAsync("_UnhandledFieldErrors")
}
@if (ViewBag.OrderLabel != null)
{
    <div class="ui-alert ui-alert-info my-4 ui-rise">أمر البيع المختار: <strong>@ViewBag.OrderLabel</strong> — الأسطر المعروضة هي المتبقي غير المسجّل في أذون أخرى.</div>
}
@if (ViewBag.InvoiceLabel != null)
{
    <div class="ui-alert ui-alert-info my-4 ui-rise">الفاتورة المختارة: <strong>@ViewBag.InvoiceLabel</strong> — تُشحن الكمية المتبقية دفعة واحدة أو جزء منها.</div>
}

<form asp-action="Create" class="ui-rise">
    <input type="hidden" name="Source" id="SourceField" value="@Model.Source" />

    <div class="ui-section ui-card">
        <div class="ui-card-head">
            <span class="ui-card-title"><i class="bi bi-diagram-3" aria-hidden="true"></i> مصدر الأذن</span>
        </div>
        <div class="card-body">
            <fieldset class="ui-grid ui-grid-2 md:ui-grid-4">
                <legend class="visually-hidden">اختر مصدر أذن التسليم</legend>
                <div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="sourceChoice" id="srcOrder" value="Order" @(Model.Source == "Order" ? "checked" : "") />
                        <label class="form-check-label" for="srcOrder">من أمر بيع</label>
                    </div>
                    <select asp-for="Delivery.SalesOrderId" asp-items="@Model.SalesOrders" class="ui-input ui-input-sm mt-2" id="salesOrderSelect" aria-label="اختر أمر البيع المرتبط" data-redirect="@Url.Action("Create", "DeliveryOrders")">
                        <option value="">-- اختر أمر بيع --</option>
                    </select>
                </div>
                <div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="sourceChoice" id="srcInvoice" value="Invoice" @(Model.Source == "Invoice" ? "checked" : "") />
                        <label class="form-check-label" for="srcInvoice">من فاتورة (المسار القديم)</label>
                    </div>
                    <select asp-for="Delivery.SaleInvoiceId" asp-items="@Model.Invoices" class="ui-input ui-input-sm mt-2" id="invoiceSelect" aria-label="اختر فاتورة البيع المرتبطة" data-redirect="@Url.Action("Create", "DeliveryOrders")">
                        <option value="">-- اختر فاتورة بيع --</option>
                    </select>
                </div>
                <div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="sourceChoice" id="srcFree" value="Free" @(Model.Source != "Order" && Model.Source != "Invoice" ? "checked" : "") />
                        <label class="form-check-label" for="srcFree">إدخال حر (بدون أمر أو فاتورة)</label>
                    </div>
                    <select asp-for="Delivery.CustomerId" asp-items="@Model.Customers" class="ui-input ui-input-sm mt-2" id="customerSelect" aria-label="اختر العميل المستلم">
                        <option value="">-- اختر العميل --</option>
                    </select>
                </div>
            </fieldset>
        </div>
    </div>

    <div class="ui-section ui-card">
        <div class="card-body">
            <div class="ui-grid ui-grid-2 md:ui-grid-4">
                <div>
                    <label asp-for="Delivery.DeliveryDate" class="ui-label"></label>
                    <input asp-for="Delivery.DeliveryDate" class="ui-input" type="date" />
                </div>
                <div>
                    <label asp-for="Delivery.Carrier" class="ui-label"></label>
                    <input asp-for="Delivery.Carrier" class="ui-input" />
                </div>
                <div>
                    <label asp-for="Delivery.TrackingNumber" class="ui-label"></label>
                    <input asp-for="Delivery.TrackingNumber" class="ui-input" />
                </div>
                <div class="col-span-2 md:col-span-4">
                    <label asp-for="Delivery.Notes" class="ui-label"></label>
                    <textarea asp-for="Delivery.Notes" class="ui-input" rows="2"></textarea>
                </div>
            </div>
        </div>
    </div>

    <div class="ui-section ui-card">
        <div class="ui-card-head">
            <span class="ui-card-title"><i class="bi bi-list-ul" aria-hidden="true"></i> أصناف التسليم</span>
        </div>
        <div class="table-container" style="max-height:none;border:0;border-radius:0">
            <table class="table mb-0" id="itemsTable">
                <caption class="visually-hidden">أصناف أذن التسليم مع الكمية والعدد المُسلَّم</caption>
                <thead>
                    <tr>
                        <th scope="col" style="width:40%">الصنف</th>
                        <th scope="col" style="width:20%">العدد المسلّم</th>
                        <th scope="col" style="width:20%">الكمية المسلّمة</th>
                        <th scope="col" style="width:20%" class="text-center">حذف</th>
                    </tr>
                </thead>
                <tbody id="itemsBody">
                    @for (var idx = 0; idx < (Model.Items.Any() ? Model.Items.Count : 0); idx++)
                    {
                        var line = Model.Items[idx];
                        <tr>
                            <td>
                                <input type="hidden" name="items[@idx].ItemId" value="@line.ItemId" />
                                <strong>@(Model.ItemsData.FirstOrDefault(i => i.Id == line.ItemId)?.Name ?? $"صنف #{line.ItemId}")</strong>
                            </td>
                            <td><input name="items[@idx].Count" type="number" step="0.0001" class="ui-input ui-input-sm count" value="@line.Count" aria-label="العدد المسلّم" @(fieldError(idx, "Count")) /></td>
                            <td><input name="items[@idx].Quantity" type="number" step="0.0001" class="ui-input ui-input-sm qty" value="@line.Quantity" aria-label="الكمية المسلّمة" @(fieldError(idx, "Quantity")) /></td>
                            <td class="text-center"><button type="button" class="ui-btn ui-btn-sm btn-del remove-row" aria-label="حذف السطر"><i class="bi bi-x" aria-hidden="true"></i></button></td>
                        </tr>
                        @await Html.PartialAsync("_LineItemErrors", idx)
                    }
                </tbody>
            </table>
        </div>
        <div class="ui-card-foot text-muted small">اختر صنفاً من قائمة الأصناف لإضافته. الكمية المعروضة هي المتبقية غير المسلّمة من المصدر.</div>
        <div class="card-body border-top">
            <div class="ui-grid ui-grid-2 md:ui-grid-3 items-end">
                <div class="md:col-span-2">
                    <label for="itemPicker" class="ui-label">إضافة صنف</label>
                    <select id="itemPicker" class="ui-input">
                        <option value="">-- اختر الصنف --</option>
                        @foreach (var it in Model.ItemsData)
                        {
                            <option value="@it.Id">@it.Name @(it.Code != null ? $"({it.Code})" : "")</option>
                        }
                    </select>
                </div>
                <div>
                    <button type="button" id="addItemBtn" class="ui-btn ui-btn-quiet w-full"><i class="bi bi-plus-lg" aria-hidden="true"></i> إضافة</button>
                </div>
            </div>
        </div>
    </div>

    <div class="ui-form-actions">
        <button type="submit" class="ui-btn ui-btn-pri"><i class="bi bi-check-lg" aria-hidden="true"></i> حفظ أذن التسليم</button>
        <a asp-action="Index" class="ui-btn ui-btn-quiet">إلغاء</a>
    </div>
</form>

@section Scripts {
<script nonce="@Context.GetCspNonce()">
document.querySelectorAll('.remove-row').forEach(btn => {
    btn.addEventListener('click', function () { this.closest('tr').remove(); renumber(); });
});

const SourceField = document.getElementById('SourceField');
const radios = document.querySelectorAll('input[name="sourceChoice"]');
const orderSelect = document.getElementById('salesOrderSelect');
const invoiceSelect = document.getElementById('invoiceSelect');
const customerSelect = document.getElementById('customerSelect');
const createUrl = '@Url.Action("Create", "DeliveryOrders")';

function currentSource() {
    const checked = document.querySelector('input[name="sourceChoice"]:checked');
    return checked ? checked.value : 'Free';
}

function renumber() {
    document.querySelectorAll('#itemsBody tr:not(.line-item-error)').forEach(function (tr, i) {
        tr.querySelectorAll('input[name]').forEach(function (el) {
            el.name = el.name.replace(/items\[\d+\]/, 'items[' + i + ']');
        });
    });
}

function clearOtherSources(keep) {
    if (keep !== 'Order' && orderSelect) orderSelect.value = '';
    if (keep !== 'Invoice' && invoiceSelect) invoiceSelect.value = '';
    if (keep !== 'Free' && customerSelect) customerSelect.value = '';
}

radios.forEach(function (r) {
    r.addEventListener('change', function () {
        SourceField.value = r.value;
        clearOtherSources(r.value);
    });
});

if (orderSelect) {
    orderSelect.addEventListener('change', function () {
        if (orderSelect.value) {
            SourceField.value = 'Order';
            clearOtherSources('Order');
            location.href = createUrl + '?source=Order&salesOrderId=' + encodeURIComponent(orderSelect.value);
        }
    });
}

if (invoiceSelect) {
    invoiceSelect.addEventListener('change', function () {
        if (invoiceSelect.value) {
            SourceField.value = 'Invoice';
            clearOtherSources('Invoice');
            location.href = createUrl + '?source=Invoice&invoiceId=' + encodeURIComponent(invoiceSelect.value);
        }
    });
}

const picker = document.getElementById('itemPicker');
const addBtn = document.getElementById('addItemBtn');
if (picker && addBtn) {
    addBtn.addEventListener('click', function () {
        if (!picker.value) return;
        const opt = picker.selectedOptions[0];
        const body = document.getElementById('itemsBody');
        const idx = body.querySelectorAll('tr:not(.line-item-error)').length;
        const tr = document.createElement('tr');
        tr.innerHTML = '<td><input type="hidden" name="items[' + idx + '].ItemId" /><strong></strong></td>' +
            '<td><input name="items[' + idx + '].Count" type="number" step="0.0001" value="0" class="form-control form-control-sm" aria-label="العدد المسلّم" /></td>' +
            '<td><input name="items[' + idx + '].Quantity" type="number" step="0.0001" value="0" class="form-control form-control-sm" aria-label="الكمية المسلّمة" /></td>' +
            '<td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-row" aria-label="حذف السطر"><i class="bi bi-x" aria-hidden="true"></i></button></td>';
        tr.querySelector('input[name$=".ItemId"]').value = picker.value;
        tr.querySelector('strong').textContent = opt.textContent.trim();
        body.appendChild(tr);
        tr.querySelector('.remove-row').addEventListener('click', function () { tr.remove(); renumber(); });
        picker.value = '';
    });
}
</script>
}
