@model IReadOnlyList<NewVixSmart.Web.Models.Sales.DeliveryOrder>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@using NewVixSmart.Web.Models.Sales
@{ ViewData["Title"] = "أذونات التسليم"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-truck text-primary"></i> أذونات التسليم</h2>
    @if (await Perm.HasAsync("DeliveryOrders.Create"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> أذن تسليم جديد</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button></div>
}

<ul class="nav nav-pills mb-3" aria-label="فلترة أذونات التسليم">
    <li class="nav-item"><a class="nav-link @(ViewBag.StatusFilter == null ? "active" : "")" asp-action="Index">الكل</a></li>
    @foreach (var st in Enum.GetValues<DeliveryOrderStatus>())
    {
        <li class="nav-item"><a class="nav-link @(ViewBag.StatusFilter as DeliveryOrderStatus? == st ? "active" : "")" asp-action="Index" asp-route-status="@st">@st.GetDisplayName()</a></li>
    }
</ul>

@if (!Model.Any())
{
    <div class="alert alert-info">لا توجد أذونات تسليم بعد.</div>
}
else
{
    <div class="table-container">
        <table class="table table-hover mb-0">
            <thead><tr><th scope="col">رقم الإذن</th><th scope="col">فاتورة البيع</th><th scope="col">العميل</th><th scope="col">تاريخ التسليم</th><th scope="col">الناقل</th><th scope="col">الحالة</th><th scope="col" class="text-center">إجراءات</th></tr></thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td><code>@d.DeliveryNumber</code></td>
                        <td>
                            @if (d.SaleInvoice != null)
                            {
                                <a asp-controller="Sales" asp-action="Details" asp-route-id="@d.SaleInvoice.PublicId">@d.SaleInvoice.InvoiceNumber</a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td><strong>@(d.Customer?.Name ?? "—")</strong></td>
                        <td>@d.DeliveryDate.ToString("dd/MM/yyyy")</td>
                        <td>@(d.Carrier ?? "—")</td>
                        <td><span class="badge @(d.Status switch { DeliveryOrderStatus.Delivered => "bg-success", DeliveryOrderStatus.Cancelled => "bg-danger", _ => "bg-warning text-dark" })">@d.Status.GetDisplayName()</span></td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@d.PublicId" class="btn btn-sm btn-outline-info" aria-label="عرض أذن التسليم @d.DeliveryNumber"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}