@model IReadOnlyList<NewVixSmart.Web.Models.Sales.DeliveryOrder>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@using NewVixSmart.Web.Models.Sales
@{ ViewData["Title"] = "أذونات التسليم"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المبيعات</span>
        <h2>أذونات التسليم</h2>
    </div>
    @if (await Perm.HasAsync("DeliveryOrders.Create"))
    {
        <div class="ui-pagehead-actions">
            <a asp-action="Create" class="ui-btn ui-btn-pri"><i class="bi bi-plus-lg" aria-hidden="true"></i> أذن تسليم جديد</a>
        </div>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="ui-alert ui-alert-ok ui-rise" role="alert" aria-live="polite"><i class="bi bi-check-circle" aria-hidden="true"></i> @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="ui-alert ui-alert-bad ui-rise" role="alert" aria-live="assertive"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @TempData["Error"]</div>
}

<ul class="nav nav-pills mb-4 ui-rise" aria-label="فلترة أذونات التسليم">
    <li><a class="nav-link @(ViewBag.StatusFilter == null ? "active" : "")" asp-action="Index">الكل</a></li>
    @foreach (var st in Enum.GetValues<DeliveryOrderStatus>())
    {
        <li><a class="nav-link @(ViewBag.StatusFilter as DeliveryOrderStatus? == st ? "active" : "")" asp-action="Index" asp-route-status="@st">@st.GetDisplayName()</a></li>
    }
</ul>

@if (!Model.Any())
{
    <div class="ui-alert ui-alert-info ui-rise">لا توجد أذونات تسليم بعد.</div>
}
else
{
    <div class="table-container ui-rise">
        <table class="table mb-0">
            <caption class="visually-hidden">قائمة أذونات التسليم: رقم الإذن، فاتورة البيع، العميل، تاريخ التسليم، الناقل، الحالة</caption>
            <thead><tr><th scope="col">رقم الإذن</th><th scope="col">فاتورة البيع</th><th scope="col">العميل</th><th scope="col">تاريخ التسليم</th><th scope="col">الناقل</th><th scope="col">الحالة</th><th scope="col" class="text-center">إجراءات</th></tr></thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td><code>@d.DeliveryNumber</code></td>
                        <td>
                            @if (d.SaleInvoice != null)
                            {
                                <a asp-controller="Sales" asp-action="Details" asp-route-id="@d.SaleInvoice.PublicId">@d.SaleInvoice.InvoiceNumber</a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td><strong>@(d.Customer?.Name ?? "—")</strong></td>
                        <td>@d.DeliveryDate.ToString("dd/MM/yyyy")</td>
                        <td>@(d.Carrier ?? "—")</td>
                        <td><span class="ui-badge @(d.Status switch { DeliveryOrderStatus.Delivered => "ui-badge-ok", DeliveryOrderStatus.Cancelled => "ui-badge-bad", _ => "ui-badge-warn" })">@d.Status.GetDisplayName()</span></td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@d.PublicId" class="ui-btn ui-btn-sm ui-btn-outline" aria-label="عرض أذن التسليم @d.DeliveryNumber"><i class="bi bi-eye" aria-hidden="true"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
