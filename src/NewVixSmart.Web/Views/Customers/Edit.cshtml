@model NewVixSmart.Web.Models.Sales.Customer
@{ ViewData["Title"] = "تعديل العميل"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">العملاء</span>
        <h2><i class="bi bi-pencil" aria-hidden="true"></i> تعديل: @Model.Name</h2>
    </div>
</div>

<div class="ui-section ui-card ui-rise">
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert" tabindex="-1"></div>
            <input type="hidden" asp-for="Id" />
            @if (Model.RowVersion is { Length: > 0 } customerRv)
            {
                <input type="hidden" name="RowVersion" value="@Convert.ToBase64String(customerRv)" />
            }
            <div class="ui-grid ui-grid-3 gap-3">
                <div class="ui-grid-span-3 sm:ui-grid-span-1">
                    <label asp-for="Name" class="ui-label"></label>
                    <input asp-for="Name" class="ui-input" />
                </div>
                <div class="ui-grid-span-3 sm:ui-grid-span-1">
                    <label asp-for="Code" class="ui-label"></label>
                    <input asp-for="Code" class="ui-input" />
                </div>
                <div class="ui-grid-span-3 sm:ui-grid-span-1">
                    <label asp-for="Phone" class="ui-label"></label>
                    <input asp-for="Phone" class="ui-input" />
                </div>
                <div class="ui-grid-span-3 sm:ui-grid-span-1">
                    <label asp-for="Email" class="ui-label"></label>
                    <input asp-for="Email" class="ui-input" />
                </div>
                <div class="ui-grid-span-3 sm:ui-grid-span-1">
                    <label asp-for="Address" class="ui-label"></label>
                    <input asp-for="Address" class="ui-input" />
                </div>
                <div class="ui-grid-span-3 sm:ui-grid-span-1">
                    <label asp-for="TaxNumber" class="ui-label"></label>
                    <input asp-for="TaxNumber" class="ui-input" />
                </div>
                <div class="ui-grid-span-3 sm:ui-grid-span-1">
                    <label asp-for="OpeningBalance" class="ui-label"></label>
                    <input asp-for="OpeningBalance" class="ui-input" type="number" step="0.01" />
                </div>
                <div class="ui-grid-span-3">
                    <label asp-for="Notes" class="ui-label"></label>
                    <textarea asp-for="Notes" class="ui-input" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4 flex gap-2">
                <button type="submit" class="ui-btn ui-btn-pri"><i class="bi bi-check-lg" aria-hidden="true"></i> حفظ</button>
                <a asp-action="Index" class="ui-btn ui-btn-ghost">إلغاء</a>
            </div>
        </form>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
