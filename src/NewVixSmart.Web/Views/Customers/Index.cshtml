@model IEnumerable<NewVixSmart.Web.Models.Sales.Customer>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "العملاء"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المبيعات</span>
        <h2><i class="bi bi-people" aria-hidden="true"></i> العملاء</h2>
    </div>
    @if (await Perm.HasAsync("Customers.Create"))
    {
        <div class="ui-pagehead-actions">
            <a asp-action="Create" class="ui-btn ui-btn-pri"><i class="bi bi-plus-lg" aria-hidden="true"></i> عميل جديد</a>
        </div>
    }
</div>

<div class="ui-section ui-card ui-rise">
    <div class="card-body">
        <form method="get" class="ui-grid ui-grid-2 items-center gap-3">
            <div class="ui-grid-span-2 sm:ui-grid-span-1 flex-1">
                <label class="visually-hidden" for="custSearch">بحث في العملاء</label>
                <input type="search" name="search" id="custSearch" value="@ViewBag.Search" class="ui-input" placeholder="بحث بالاسم أو الكود أو التليفون">
            </div>
            <div class="sm:justify-start">
                <button type="submit" class="ui-btn ui-btn-ghost"><i class="bi bi-search" aria-hidden="true"></i> بحث</button>
            </div>
        </form>
    </div>
</div>

<div class="ui-section table-container ui-rise">
    <table class="table">
        <caption class="visually-hidden">العملاء: الكود، اسم العميل، التليفون، العنوان، الرصيد</caption>
        <thead>
            <tr>
                <th scope="col">الكود</th>
                <th scope="col">اسم العميل</th>
                <th scope="col">التليفون</th>
                <th scope="col">العنوان</th>
                <th scope="col">الرصيد</th>
                <th scope="col" class="text-center">إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td><code>@(c.Code ?? "—")</code></td>
                    <td><strong>@c.Name</strong></td>
                    <td>@(c.Phone ?? "—")</td>
                    <td>@(c.Address ?? "—")</td>
                    <td class="num">@Money.Format(c.OpeningBalance)</td>
                    <td class="text-center">
                        <a asp-action="Ledger" asp-route-id="@c.Id" class="ui-btn ui-btn-sm ui-btn-ghost" aria-label="دفتر أستاذ العميل @c.Name"><i class="bi bi-journal-bookmark" aria-hidden="true"></i></a>
                        <a asp-action="PendingDeliveries" asp-route-id="@c.Id" class="ui-btn ui-btn-sm ui-btn-ghost" aria-label="تسليمات معلّقة للعميل @c.Name"><i class="bi bi-truck" aria-hidden="true"></i></a>
                        @if (await Perm.HasAsync("Customers.Edit"))
                        {
                            <a asp-action="Edit" asp-route-id="@c.Id" class="ui-btn ui-btn-sm ui-btn-ghost" aria-label="تعديل العميل @c.Name"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                        }
                        @if (await Perm.HasAsync("Customers.Delete"))
                        {
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="inline" data-confirm="هل أنت متأكد من حذف هذا العميل؟" data-confirm-ok="حذف">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="ui-btn ui-btn-sm ui-btn-danger" aria-label="حذف العميل @c.Name"><i class="bi bi-trash" aria-hidden="true"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pager")
