@model IEnumerable<NewVixSmart.Web.Models.Sales.Customer>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "العملاء"; }

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h2><i class="bi bi-people text-primary"></i> العملاء</h2>
    @if (await Perm.HasAsync("Customers.Create"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> عميل جديد</a>
    }
</div>

<div class="mb-3">
    <form method="get" class="row g-2">
        <div class="col-auto flex-grow-1">
            <label class="visually-hidden" for="custSearch">بحث في العملاء</label>
            <input type="search" name="search" id="custSearch" value="@ViewBag.Search" class="form-control" placeholder="بحث بالاسم أو الكود أو التليفون">
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search" aria-hidden="true"></i> بحث</button>
        </div>
    </form>
</div>

<div class="table-container">
    <table class="table table-hover mb-0">
        <thead><tr><th scope="col">الكود</th><th scope="col">اسم العميل</th><th scope="col">التليفون</th><th scope="col">العنوان</th><th scope="col">الرصيد</th><th scope="col" class="text-center">إجراءات</th></tr></thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td><code>@(c.Code ?? "—")</code></td>
                    <td><strong>@c.Name</strong></td>
                    <td>@(c.Phone ?? "—")</td>
                    <td>@(c.Address ?? "—")</td>
                    <td>@Money.Format(c.OpeningBalance)</td>
                    <td class="text-center">
                        <a asp-action="Ledger" asp-route-id="@c.Id" class="btn btn-sm btn-outline-success" aria-label="دفتر أستاذ العميل @c.Name"><i class="bi bi-journal-bookmark"></i></a>
                        <a asp-action="PendingDeliveries" asp-route-id="@c.Id" class="btn btn-sm btn-outline-info" aria-label="تسليمات معلّقة للعميل @c.Name"><i class="bi bi-truck"></i></a>
                        @if (await Perm.HasAsync("Customers.Edit"))
                        {
                            <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary" aria-label="تعديل العميل @c.Name"><i class="bi bi-pencil"></i></a>
                        }
                        @if (await Perm.HasAsync("Customers.Delete"))
                        {
                            <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline" data-confirm="هل أنت متأكد من حذف هذا العميل؟" data-confirm-ok="حذف">
                                <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="حذف العميل @c.Name"><i class="bi bi-trash"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pager")