@model NewVixSmart.Web.ViewModels.Sales.CustomerPendingDeliveriesViewModel
@{ ViewData["Title"] = $"تسليمات معلّقة - {Model.Customer?.Name ?? ""}"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">العملاء</span>
        <h2><i class="bi bi-truck" aria-hidden="true"></i> تسليمات معلّقة: @(Model.Customer?.Name ?? "—")</h2>
    </div>
    <div class="ui-pagehead-actions">
        <span class="ui-badge ui-badge-info">إجمالي غير المسلَّم: <span class="num">@Money.Format(Model.TotalValue)</span></span>
        <a asp-action="Ledger" asp-route-id="@Model.Customer?.Id" class="ui-btn ui-btn-outline"><i class="bi bi-journal-bookmark" aria-hidden="true"></i> كشف الحساب</a>
        <a asp-action="Index" class="ui-btn ui-btn-quiet"><i class="bi bi-arrow-right" aria-hidden="true"></i> رجوع</a>
    </div>
</div>

<div class="ui-alert ui-alert-info ui-rise" role="note">
    <i class="bi bi-info-circle" aria-hidden="true"></i>
    هذه الكميات متعاقد عليها في أوامر بيع معتمدة ولم تُسلَّم بعد.
    قيمتها <strong>لا تدخل</strong> في رصيد ذمم العميل؛ الرصيد يبقى محسوباً من الفواتير فقط.
</div>

@if (!Model.Lines.Any())
{
    <div class="ui-alert ui-alert-ok">
        <i class="bi bi-check2-circle" aria-hidden="true"></i> لا توجد التزامات تسليم معلّقة لهذا العميل — كل الكميات المتعاقد عليها سُلِّمت أو فُوترت.
    </div>
}
else
{
    <div class="table-container ui-rise">
        <table class="table">
            <caption class="visually-hidden">أصناف أوامر البيع الملتزم بها وغير المسلَّمة للعميل</caption>
            <thead><tr>
                <th scope="col">الأمر</th>
                <th scope="col">التاريخ</th>
                <th scope="col">المتوقع</th>
                <th scope="col">الصنف</th>
                <th scope="col">مطلوب</th>
                <th scope="col">مسلَّم</th>
                <th scope="col">مفوتر</th>
                <th scope="col">محجوز</th>
                <th scope="col">متبقٍ</th>
                <th scope="col">سعر الوحدة</th>
                <th scope="col">القيمة</th>
                <th scope="col">أذون التسليم</th>
            </tr></thead>
            <tbody>
                @foreach (var l in Model.Lines)
                {
                    <tr>
                        <th scope="row"><a asp-controller="SalesOrders" asp-action="Details" asp-route-id="@l.OrderPublicId">@l.OrderNumber</a></th>
                        <td>@l.OrderDate.ToString("dd/MM/yyyy")</td>
                        <td>@(l.ExpectedDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td>@l.ItemName</td>
                        <td class="num">@l.Quantity.ToString("N2") / @l.Count.ToString("N2")</td>
                        <td class="num">@l.DeliveredQty.ToString("N2") / @l.DeliveredCount.ToString("N2")</td>
                        <td class="num">@l.InvoicedQty.ToString("N2") / @l.InvoicedCount.ToString("N2")</td>
                        <td class="num">@l.ReservedQty.ToString("N2") / @l.ReservedCount.ToString("N2")</td>
                        <td class="fw-bold num">@l.PendingQty.ToString("N2") / @l.PendingCount.ToString("N2")</td>
                        <td class="num">@Money.Format(l.UnitPrice)</td>
                        <td class="num">@Money.Format(l.PendingValue)</td>
                        <td>@(string.IsNullOrWhiteSpace(l.DeliveryNoteNumbers) ? "—" : l.DeliveryNoteNumbers)</td>
                    </tr>
                }
            </tbody>
            <tfoot><tr class="fw-bold">
                <th scope="row" colspan="10">الإجمالي (@Model.Lines.Count سطراً)</th>
                <td class="num">@Money.Format(Model.TotalValue)</td>
                <td>—</td>
            </tr></tfoot>
        </table>
    </div>
    <p class="text-muted small mt-2 mb-0">الأرقام معروضة بالترتيب: كمية / عدد.</p>
}
