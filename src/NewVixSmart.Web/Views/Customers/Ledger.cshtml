@model NewVixSmart.Web.ViewModels.Sales.CustomerLedgerViewModel
@{ ViewData["Title"] = $"دفتر أستاذ - {Model.Customer?.Name ?? ""}"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-journal-bookmark text-primary"></i> كشف حساب: @(Model.Customer?.Name ?? "—")</h2>
    <div>
        <span class="badge @(Model.Balance >= 0 ? "bg-success" : "bg-danger") fs-6">الرصيد: @Money.Format(Model.Balance)</span>
        <a asp-action="PendingDeliveries" asp-route-id="@Model.Customer?.Id" class="btn btn-outline-primary">
            <i class="bi bi-truck"></i> تسليمات معلّقة (@Model.PendingLines.Count)
        </a>
        <a asp-action="LedgerXlsx" asp-route-id="@Model.Customer?.Id" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel"></i> تصدير Excel</a>
        <a asp-action="LedgerPdf" asp-route-id="@Model.Customer?.Id" class="btn btn-outline-danger"><i class="bi bi-file-earmark-pdf"></i> كشف PDF</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> رجوع</a>
    </div>
</div>

<div class="card mb-3"><div class="card-body py-2">
    <div class="row g-3 small">
        <div class="col"><span class="text-muted">رصيد افتتاحي:</span> <strong>@(Model.Customer != null ? Money.Format(Model.Customer.OpeningBalance) : "—")</strong></div>
        <div class="col"><span class="text-muted">إجمالي الفواتير:</span> <strong>@Money.Format(Model.InvoicesTotal)</strong></div>
        <div class="col"><span class="text-muted">إجمالي المقبوضات:</span> <strong>@Money.Format(Model.ReceiptsTotal)</strong></div>
        <div class="col"><span class="text-muted">إجمالي المرتجعات:</span> <strong>@Money.Format(Model.ReturnsTotal)</strong></div>
        <div class="col"><span class="text-muted">قيمة غير مسلَّم (غير محسوبة في الرصيد):</span> <strong>@Money.Format(Model.PendingValueTotal)</strong></div>
        <div class="col"><span class="text-muted">التواصل:</span> <strong>@(Model.Customer?.Phone ?? "—")</strong></div>
    </div>
</div></div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card"><div class="card-header"><i class="bi bi-cart-check"></i> فواتير البيع</div><div class="card-body p-0">
            <table class="table table-hover mb-0"><caption class="visually-hidden">فواتير البيع: رقم الفاتورة، التاريخ، المبلغ، المدفوع</caption><thead><tr><th scope="col">الفاتورة</th><th scope="col">التاريخ</th><th scope="col">المبلغ</th><th scope="col">المدفوع</th></tr></thead>
            <tbody>@foreach (var i in Model.Invoices) { <tr><td><code>@i.InvoiceNumber</code></td><td>@i.InvoiceDate.ToString("dd/MM/yyyy")</td><td>@Money.Format(i.NetAmount)</td><td>@Money.Format(i.PaidAmount)</td></tr> }</tbody></table>
        </div></div>
    </div>
    <div class="col-lg-6">
        <div class="card"><div class="card-header"><i class="bi bi-wallet2"></i> المدفوعات (المقبوضات)</div><div class="card-body p-0">
            <table class="table table-hover mb-0"><caption class="visually-hidden">المدفوعات (المقبوضات): رقم الإيصال، التاريخ، المبلغ، طريقة الدفع</caption><thead><tr><th scope="col">الإيصال</th><th scope="col">التاريخ</th><th scope="col">المبلغ</th><th scope="col">الطريقة</th></tr></thead>
            <tbody>@foreach (var p in Model.Payments) { <tr><td><code>@p.ReceiptNumber</code></td><td>@p.PaymentDate.ToString("dd/MM/yyyy")</td><td class="text-success fw-bold">@Money.Format(p.Amount)</td><td>@p.Method.GetDisplayName()</td></tr> }</tbody></table>
        </div></div>
    </div>
</div>

<div class="card mt-4"><div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-arrow-counterclockwise"></i> مرتجعات البيع</span>
    </div><div class="card-body p-0">
    <table class="table table-hover mb-0"><caption class="visually-hidden">مرتجعات البيع: رقم المرتجع، التاريخ، المبلغ</caption><thead><tr><th scope="col">المرتجع</th><th scope="col">التاريخ</th><th scope="col">المبلغ</th></tr></thead>
    <tbody>@foreach (var r in Model.Returns) { <tr><td><code>@r.ReturnNumber</code></td><td>@r.ReturnDate.ToString("dd/MM/yyyy")</td><td class="text-success fw-bold">-@Money.Format(decimal.Round(ReturnValuation.ReceivableBase(r.TotalAmount, r.SaleInvoice?.TotalAmount ?? 0m, r.SaleInvoice?.NetAmount ?? 0m), 2))</td></tr> } @if (!Model.Returns.Any()) { <tr><td colspan="3" class="text-center text-muted">لا توجد مردودات</td></tr> }</tbody></table>
</div></div>

<div class="card mt-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-truck"></i> تسليمات معلّقة (ملتزمة وغير مسلَّمة)</span>
        <a asp-action="PendingDeliveries" asp-route-id="@Model.Customer?.Id" class="btn btn-sm btn-outline-primary">التفاصيل</a>
    </div>
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table table-hover mb-0">
                <caption class="visually-hidden">الكميات المتعاقد عليها وغير المسلَّمة لهذا العميل</caption>
                <thead><tr>
                    <th scope="col">الأمر</th><th scope="col">الصنف</th><th scope="col">مطلوب</th>
                    <th scope="col">مسلَّم</th><th scope="col">مفوتر</th><th scope="col">محجوز</th>
                    <th scope="col">متبقٍ</th><th scope="col">القيمة</th>
                </tr></thead>
                <tbody>
                    @if (!Model.PendingLines.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted">لا توجد تسليمات معلّقة لهذا العميل</td></tr>
                    }
                    @foreach (var l in Model.PendingLines.Take(10))
                    {
                        <tr>
                            <th scope="row"><a asp-controller="SalesOrders" asp-action="Details" asp-route-id="@l.OrderPublicId">@l.OrderNumber</a></th>
                            <td>@l.ItemName</td>
                            <td>@l.Quantity.ToString("N2") / @l.Count.ToString("N2")</td>
                            <td>@l.DeliveredQty.ToString("N2") / @l.DeliveredCount.ToString("N2")</td>
                            <td>@l.InvoicedQty.ToString("N2") / @l.InvoicedCount.ToString("N2")</td>
                            <td>@l.ReservedQty.ToString("N2") / @l.ReservedCount.ToString("N2")</td>
                            <td class="fw-bold">@l.PendingQty.ToString("N2") / @l.PendingCount.ToString("N2")</td>
                            <td>@Money.Format(l.PendingValue)</td>
                        </tr>
                    }
                    @if (Model.PendingLines.Count > 10)
                    {
                        <tr><td colspan="8" class="text-center text-muted">و@(Model.PendingLines.Count - 10) سطراً آخر</td></tr>
                    }
                </tbody>
                @if (Model.PendingLines.Any())
                {
                    <tfoot><tr class="fw-bold">
                        <th scope="row" colspan="7">إجمالي قيمة غير المسلَّم (غير محسوبة في رصيد الذمم)</th>
                        <td>@Money.Format(Model.PendingValueTotal)</td>
                    </tr></tfoot>
                }
            </table>
        </div>
    </div>
</div>

@if (!Model.Invoices.Any() && !Model.Payments.Any() && !Model.Returns.Any() && !Model.PendingLines.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox" style="font-size:3rem;"></i>
        <p class="mt-2">لا توجد حركات على هذا العميل</p>
    </div>
}
