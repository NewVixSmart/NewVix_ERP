@model NewVixSmart.Web.ViewModels.Sales.CustomerLedgerViewModel
@{ ViewData["Title"] = $"دفتر أستاذ - {Model.Customer?.Name ?? ""}"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">العملاء</span>
        <h2><i class="bi bi-journal-bookmark" aria-hidden="true"></i> كشف حساب: @(Model.Customer?.Name ?? "—")</h2>
    </div>
    <div class="ui-pagehead-actions">
        <span class="ui-badge @(Model.Balance >= 0 ? "ui-badge-ok" : "ui-badge-bad")">الرصيد: <span class="num">@Money.Format(Model.Balance)</span></span>
        <a asp-action="PendingDeliveries" asp-route-id="@Model.Customer?.Id" class="ui-btn ui-btn-outline">
            <i class="bi bi-truck" aria-hidden="true"></i> تسليمات معلّقة (@Model.PendingLines.Count)
        </a>
        <a asp-action="LedgerXlsx" asp-route-id="@Model.Customer?.Id" class="ui-btn ui-btn-outline"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> تصدير Excel</a>
        <a asp-action="LedgerPdf" asp-route-id="@Model.Customer?.Id" class="ui-btn ui-btn-danger"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> كشف PDF</a>
        <a asp-action="Index" class="ui-btn ui-btn-quiet"><i class="bi bi-arrow-right" aria-hidden="true"></i> رجوع</a>
    </div>
</div>

<div class="ui-section ui-card ui-rise">
    <div class="card-body">
        <div class="ui-grid ui-grid-3 small">
            <div><span class="text-muted">رصيد افتتاحي:</span> <strong class="num">@(Model.Customer != null ? Money.Format(Model.Customer.OpeningBalance) : "—")</strong></div>
            <div><span class="text-muted">إجمالي الفواتير:</span> <strong class="num">@Money.Format(Model.InvoicesTotal)</strong></div>
            <div><span class="text-muted">إجمالي المقبوضات:</span> <strong class="num">@Money.Format(Model.ReceiptsTotal)</strong></div>
            <div><span class="text-muted">إجمالي المرتجعات:</span> <strong class="num">@Money.Format(Model.ReturnsTotal)</strong></div>
            <div><span class="text-muted">قيمة غير مسلَّم (غير محسوبة في الرصيد):</span> <strong class="num">@Money.Format(Model.PendingValueTotal)</strong></div>
            <div><span class="text-muted">التواصل:</span> <strong class="num">@(Model.Customer?.Phone ?? "—")</strong></div>
        </div>
    </div>
</div>

<div class="ui-grid ui-grid-2 ui-section">
    <div class="ui-card">
        <div class="card-header"><i class="bi bi-cart-check" aria-hidden="true"></i> فواتير البيع</div>
        <div class="card-body p-0">
            <div class="table-container">
                <table class="table">
                    <caption class="visually-hidden">فواتير البيع: رقم الفاتورة، التاريخ، المبلغ، المدفوع</caption>
                    <thead><tr><th scope="col">الفاتورة</th><th scope="col">التاريخ</th><th scope="col">المبلغ</th><th scope="col">المدفوع</th></tr></thead>
                    <tbody>@foreach (var i in Model.Invoices) { <tr><td><code>@i.InvoiceNumber</code></td><td>@i.InvoiceDate.ToString("dd/MM/yyyy")</td><td class="num">@Money.Format(i.NetAmount)</td><td class="num">@Money.Format(i.PaidAmount)</td></tr> }</tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="ui-card">
        <div class="card-header"><i class="bi bi-wallet2" aria-hidden="true"></i> المدفوعات (المقبوضات)</div>
        <div class="card-body p-0">
            <div class="table-container">
                <table class="table">
                    <caption class="visually-hidden">المدفوعات (المقبوضات): رقم الإيصال، التاريخ، المبلغ، طريقة الدفع</caption>
                    <thead><tr><th scope="col">الإيصال</th><th scope="col">التاريخ</th><th scope="col">المبلغ</th><th scope="col">الطريقة</th></tr></thead>
                    <tbody>@foreach (var p in Model.Payments) { <tr><td><code>@p.ReceiptNumber</code></td><td>@p.PaymentDate.ToString("dd/MM/yyyy")</td><td class="text-success fw-bold num">@Money.Format(p.Amount)</td><td>@p.Method.GetDisplayName()</td></tr> }</tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="ui-section ui-card">
    <div class="card-header">
        <span><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> مرتجعات البيع</span>
    </div>
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <caption class="visually-hidden">مرتجعات البيع: رقم المرتجع، التاريخ، المبلغ</caption>
                <thead><tr><th scope="col">المرتجع</th><th scope="col">التاريخ</th><th scope="col">المبلغ</th></tr></thead>
                <tbody>@foreach (var r in Model.Returns) { <tr><td><code>@r.ReturnNumber</code></td><td>@r.ReturnDate.ToString("dd/MM/yyyy")</td><td class="text-success fw-bold num">-@Money.Format(decimal.Round(ReturnValuation.ReceivableBase(r.TotalAmount, r.SaleInvoice?.TotalAmount ?? 0m, r.SaleInvoice?.NetAmount ?? 0m), 2))</td></tr> } @if (!Model.Returns.Any()) { <tr><td colspan="3" class="text-center text-muted">لا توجد مردودات</td></tr> }</tbody>
            </table>
        </div>
    </div>
</div>

<div class="ui-section ui-card">
    <div class="card-header">
        <span><i class="bi bi-truck" aria-hidden="true"></i> تسليمات معلّقة (ملتزمة وغير مسلَّمة)</span>
        <a asp-action="PendingDeliveries" asp-route-id="@Model.Customer?.Id" class="ui-btn ui-btn-sm ui-btn-outline">التفاصيل</a>
    </div>
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
                <caption class="visually-hidden">الكميات المتعاقد عليها وغير المسلَّمة لهذا العميل</caption>
                <thead><tr>
                    <th scope="col">الأمر</th><th scope="col">الصنف</th><th scope="col">مطلوب</th>
                    <th scope="col">مسلَّم</th><th scope="col">مفوتر</th><th scope="col">محجوز</th>
                    <th scope="col">متبقٍ</th><th scope="col">القيمة</th>
                </tr></thead>
                <tbody>
                    @if (!Model.PendingLines.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted">لا توجد تسليمات معلّقة لهذا العميل</td></tr>
                    }
                    @foreach (var l in Model.PendingLines.Take(10))
                    {
                        <tr>
                            <th scope="row"><a asp-controller="SalesOrders" asp-action="Details" asp-route-id="@l.OrderPublicId">@l.OrderNumber</a></th>
                            <td>@l.ItemName</td>
                            <td class="num">@l.Quantity.ToString("N2") / @l.Count.ToString("N2")</td>
                            <td class="num">@l.DeliveredQty.ToString("N2") / @l.DeliveredCount.ToString("N2")</td>
                            <td class="num">@l.InvoicedQty.ToString("N2") / @l.InvoicedCount.ToString("N2")</td>
                            <td class="num">@l.ReservedQty.ToString("N2") / @l.ReservedCount.ToString("N2")</td>
                            <td class="fw-bold num">@l.PendingQty.ToString("N2") / @l.PendingCount.ToString("N2")</td>
                            <td class="num">@Money.Format(l.PendingValue)</td>
                        </tr>
                    }
                    @if (Model.PendingLines.Count > 10)
                    {
                        <tr><td colspan="8" class="text-center text-muted">و@(Model.PendingLines.Count - 10) سطراً آخر</td></tr>
                    }
                </tbody>
                @if (Model.PendingLines.Any())
                {
                    <tfoot><tr class="fw-bold">
                        <th scope="row" colspan="7">إجمالي قيمة غير المسلَّم (غير محسوبة في رصيد الذمم)</th>
                        <td class="num">@Money.Format(Model.PendingValueTotal)</td>
                    </tr></tfoot>
                }
            </table>
        </div>
    </div>
</div>

@if (!Model.Invoices.Any() && !Model.Payments.Any() && !Model.Returns.Any() && !Model.PendingLines.Any())
{
    <div class="empty-state ui-rise">
        <div class="empty-icon"><i class="bi bi-inbox" aria-hidden="true"></i></div>
        <p class="text-muted">لا توجد حركات على هذا العميل</p>
    </div>
}
