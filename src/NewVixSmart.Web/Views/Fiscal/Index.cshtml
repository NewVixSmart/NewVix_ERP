@model NewVixSmart.Web.ViewModels.Accounting.FiscalCloseViewModel
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "الإقفال السنوي"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المحاسبة</span>
        <h2><i class="bi bi-lock" aria-hidden="true"></i> الإقفال السنوي</h2>
    </div>
    <form asp-action="Create" method="post" class="ui-pagehead-actions flex flex-wrap items-center gap-2">
        @Html.AntiForgeryToken()
        <label class="visually-hidden" for="fiscalYear">السنة المالية</label>
        <input type="number" name="year" min="2000" max="2100" value="@Model.NextYear" id="fiscalYear" class="ui-input" dir="ltr" style="width:120px" />
        <button type="submit" class="ui-btn ui-btn-pri"><i class="bi bi-plus-lg" aria-hidden="true"></i> إنشاء سنة مالية</button>
    </form>
</div>

<div class="ui-alert ui-alert-info ui-rise">
    <i class="bi bi-info-circle-fill mt-1" aria-hidden="true"></i>
    <div>
        <strong>كيف يعمل الإقفال؟</strong> عند إغلاق سنة مالية، تُرحَّل أرصدة حسابات الإيرادات والمصاريف إلى حساب تجميعي جديد
        «الأرباح المحتجزة / تجميع الإقفال» (3001) عبر قيود «إقفال سنوي»، ثم تُقفل السنة فيَسقط إدراج أي قيود جديدة بتاريخ يقع فيها.
        لا يُسمح بإغلاق سنة إلا إذا كانت أحدث سنة مالية مفتوحة — أُغلق الأقدم أولاً.
    </div>
</div>

<div class="ui-section ui-card ui-rise">
    <div class="card-header">
        <span class="ui-card-title"><i class="bi bi-calendar-event" aria-hidden="true"></i> السنين المالية</span>
    </div>
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table">
            <caption class="visually-hidden">السنين المالية وحالة كل سنة وعدد قيود الإقفال وصافي الدخل المجمّع</caption>
            <thead>
                <tr>
                    <th scope="col">السنة</th>
                    <th scope="col">الاسم</th>
                    <th scope="col">الحالة</th>
                    <th scope="col">تاريخ الإغلاق</th>
                    <th scope="col">أُغلقت بواسطة</th>
                    <th scope="col" class="text-center">قيود الإقفال</th>
                    <th scope="col" class="text-end">صافي الدخل المجمّع</th>
                    <th scope="col" class="text-center">إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td><strong>@row.Year</strong></td>
                        <td>@row.Name</td>
                        <td>
                            @if (row.IsClosed)
                            { <span class="ui-badge ui-badge-bad">مغلقة</span> }
                            else
                            { <span class="ui-badge ui-badge-ok">مفتوحة</span> }
                        </td>
                        <td>@(row.ClosedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td>@(row.ClosedById ?? "—")</td>
                        <td class="text-center"><span class="num">@row.CloseEntryCount</span></td>
                        <td class="text-end">
                            @if (row.IsClosed)
                            {
                                if (row.NetIncome >= 0)
                                { <span class="num text-success">@Money.Format(row.NetIncome)</span> }
                                else
                                { <span class="num text-danger">@Money.Format(row.NetIncome)</span> }
                            }
                            else
                            { <span class="text-muted">—</span> }
                        </td>
                        <td class="text-center">
                            <div class="flex flex-wrap items-center justify-center gap-1">
                                @if (row.IsClosed)
                                {
                                    @if (await Perm.HasAsync("FiscalClose.Reopen"))
                                    {
                                        <form asp-action="Reopen" asp-route-year="@row.Year" method="post"
                                              data-confirm="إعادة فتح سنة @row.Year ستحذف قيود الإقفال السنوي وتُعيد أرصدة الأرباح/الخسائر كما كانت، ما قد يُبطل التقارير السابقة. متابعة؟" data-confirm-ok="متابعة">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="ui-btn ui-btn-sm ui-btn-outline"><i class="bi bi-unlock" aria-hidden="true"></i> إعادة فتح</button>
                                        </form>
                                    }
                                }
                                else
                                {
                                    var isLatest = row.Year == Model.LatestYear;
                                    <form asp-action="Close" asp-route-year="@row.Year" method="post">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="ui-btn ui-btn-sm btn-outline-danger" @(isLatest ? "" : "disabled") title="@(isLatest ? "" : "أغلق السنة الأحدث أولاً")">
                                            <i class="bi bi-lock" aria-hidden="true"></i> إغلاق
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">لا توجد سنوات مالية بعد — أنشئ سنة مالية أولاً</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.Rows.Any(r => r.IsClosed))
{
    <div class="ui-alert ui-alert-warn ui-rise mt-3">
        <i class="bi bi-exclamation-triangle-fill mt-1" aria-hidden="true"></i>
        <div>إعادة فتح سنة مغلقة إجراء إداري حساس: حذف قيود «الإقفال السنوي» يُعيد أرصدة الإيرادات والمصاريف إلى ميزانيتها قبل الإقفال،
            ما يجعل التقارير السابقة غير صالحة لفترة تلك السنة. تُمنح «إعادة الفتح» للمدير فقط.</div>
    </div>
}
