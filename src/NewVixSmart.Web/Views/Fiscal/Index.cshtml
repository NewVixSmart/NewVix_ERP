@model NewVixSmart.Web.ViewModels.Accounting.FiscalCloseViewModel
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "الإقفال السنوي"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-lock text-primary"></i> الإقفال السنوي</h2>
    <form asp-action="Create" method="post" class="d-flex gap-2 align-items-center">
        @Html.AntiForgeryToken()
        <input type="number" name="year" min="2000" max="2100" value="@Model.NextYear" class="form-control" style="width: 120px" aria-label="السنة المالية" />
        <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> إنشاء سنة مالية</button>
    </form>
</div>

<div class="alert alert-info d-flex align-items-start gap-2">
    <i class="bi bi-info-circle-fill mt-1"></i>
    <div>
        <strong>كيف يعمل الإقفال؟</strong> عند إغلاق سنة مالية، تُرحَّل أرصدة حسابات الإيرادات والمصاريف إلى حساب تجميعي جديد
        «الأرباح المحتجزة / تجميع الإقفال» (3001) عبر قيود «إقفال سنوي»، ثم تُقفل السنة فيَسقط إدراج أي قيود جديدة بتاريخ يقع فيها.
        لا يُسمح بإغلاق سنة إلا إذا كانت أحدث سنة مالية مفتوحة — أُغلق الأقدم أولاً.
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-calendar-event"></i> السنين المالية</span>
    </div>
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th scope="col">السنة</th>
                    <th scope="col">الاسم</th>
                    <th scope="col">الحالة</th>
                    <th scope="col">تاريخ الإغلاق</th>
                    <th scope="col">أُغلقت بواسطة</th>
                    <th scope="col" class="text-center">قيود الإقفال</th>
                    <th scope="col" class="text-end">صافي الدخل المجمّع</th>
                    <th scope="col" class="text-center">إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td><strong>@row.Year</strong></td>
                        <td>@row.Name</td>
                        <td>
                            @if (row.IsClosed)
                            { <span class="badge bg-danger">مغلقة</span> }
                            else
                            { <span class="badge bg-success">مفتوحة</span> }
                        </td>
                        <td>@(row.ClosedAt?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td>@(row.ClosedById ?? "—")</td>
                        <td class="text-center">@row.CloseEntryCount</td>
                        <td class="text-end">
                            @if (row.IsClosed)
                            {
                                if (row.NetIncome >= 0)
                                { <span class="text-success">@row.NetIncome.ToString("N2")</span> }
                                else
                                { <span class="text-danger">@row.NetIncome.ToString("N2")</span> }
                            }
                            else
                            { <span class="text-muted">—</span> }
                        </td>
                        <td class="text-center">
                            @if (row.IsClosed)
                            {
                                @if (await Perm.HasAsync("FiscalClose.Reopen"))
                                {
                                    <form asp-action="Reopen" asp-route-year="@row.Year" method="post" class="d-inline"
                                          data-confirm="إعادة فتح سنة @row.Year ستحذف قيود الإقفال السنوي وتُعيد أرصدة الأرباح/الخسائر كما كانت، ما قد يُبطل التقارير السابقة. متابعة؟" data-confirm-ok="متابعة">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-warning"><i class="bi bi-unlock"></i> إعادة فتح</button>
                                    </form>
                                }
                            }
                            else
                            {
                                var isLatest = row.Year == Model.LatestYear;
                                <form asp-action="Close" asp-route-year="@row.Year" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" @(isLatest ? "" : "disabled") title="@(isLatest ? "" : "أغلق السنة الأحدث أولاً")">
                                        <i class="bi bi-lock"></i> إغلاق
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">لا توجد سنوات مالية بعد — أنشئ سنة مالية أولاً</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.Rows.Any(r => r.IsClosed))
{
    <div class="alert alert-warning d-flex align-items-start gap-2 mt-3 mb-0">
        <i class="bi bi-exclamation-triangle-fill mt-1"></i>
        <div>إعادة فتح سنة مغلقة إجراء إداري حساس: حذف قيود «الإقفال السنوي» يُعيد أرصدة الإيرادات والمصاريف إلى ميزانيتها قبل الإقفال،
            ما يجعل التقارير السابقة غير صالحة لفترة تلك السنة. تُمنح «إعادة الفتح» للمدير فقط.</div>
    </div>
}