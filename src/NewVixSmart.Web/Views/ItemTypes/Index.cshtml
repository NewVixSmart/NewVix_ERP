@model IEnumerable<NewVixSmart.Web.Models.Core.ItemType>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{
    ViewData["Title"] = "أنواع الأصناف";
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (!isAjax)
    {
        Layout = "_Layout";
    }
}
@if (!isAjax)
{
    <div class="page-header d-flex justify-content-between align-items-center">
        <h2><i class="bi bi-grid text-primary"></i> أنواع الأصناف</h2>
    </div>
}
<table class="table table-hover mb-0" id="itemTypesTable" data-load="true">
    <thead><tr><th scope="col">الاسم</th><th>الحالة</th><th class="text-center">إجراءات</th></tr></thead>
    <tbody>
        @foreach (var t in Model)
        {
            <tr>
                <td data-name="@t.Name">@t.Name</td>
                <td>@(t.IsActive ? "نشط" : "غير نشط")</td>
                <td class="text-center">
                    @if (await Perm.HasAsync("Items.Edit"))
                    {
                    <button type="button" class="btn btn-sm btn-outline-primary btn-edit" data-id="@t.Id" title="تعديل"><i class="bi bi-pencil"></i></button>
                    }
                    @if (await Perm.HasAsync("Items.Delete"))
                    {
                    <button type="button" class="btn btn-sm btn-outline-danger btn-del" data-id="@t.Id" title="حذف"><i class="bi bi-trash"></i></button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
