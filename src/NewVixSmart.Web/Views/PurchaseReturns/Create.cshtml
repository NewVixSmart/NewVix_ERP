@model NewVixSmart.Web.Models.Forms.PurchaseReturnFormModel
@{ ViewData["Title"] = "مرتجع شراء جديد"; }
@{
    ViewData["LineItemColumns"] = 6;
    ViewData["ErrorKeysWithVisibleField"] = new[] { "SupplierId" };
    Func<int, string, IHtmlContent> fieldError = (index, field) =>
    {
        var key = "items[" + index + "]." + field;
        var failed = ViewData.ModelState.Any(entry =>
            entry.Key.Equals(key, StringComparison.OrdinalIgnoreCase) && entry.Value!.Errors.Count > 0);
        return failed
            ? Html.Raw(" aria-invalid=\"true\" aria-describedby=\"line-error-" + index + "\"")
            : Html.Raw(string.Empty);
    };
}

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المشتريات</span>
        <h2><i class="bi bi-arrow-return-right text-primary" aria-hidden="true"></i> مرتجع شراء جديد</h2>
    </div>
</div>

<form asp-action="Create" id="returnForm">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert" tabindex="-1"></div>
    @await Html.PartialAsync("_UnhandledFieldErrors")

    <div class="ui-section ui-card ui-rise">
        <div class="card-body">
            <div class="ui-grid ui-grid-4 gap-3">
                <div>
                    <label asp-for="ReturnNumber" class="ui-label"></label>
                    <input asp-for="ReturnNumber" class="ui-input" readonly value="@ViewBag.NextNumber" />
                </div>
                <div>
                    <label asp-for="SupplierId" class="ui-label"></label>
                    <select asp-for="SupplierId" asp-items="@(ViewBag.Suppliers as SelectList)" class="form-select">
                        <option value="">-- اختر المورد --</option>
                    </select>
                    <span asp-validation-for="SupplierId" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="PurchaseInvoiceId" class="ui-label"></label>
                    <select asp-for="PurchaseInvoiceId" asp-items="@(ViewBag.PurchaseInvoices as SelectList)" class="form-select">
                        <option value="">-- الفاتورة الأصلية (اختياري) --</option>
                    </select>
                </div>
                <div>
                    <label asp-for="ReturnDate" class="ui-label"></label>
                    <input asp-for="ReturnDate" class="ui-input" type="date" />
                </div>
            </div>
        </div>
    </div>

    <div class="ui-section ui-card ui-rise">
        <div class="card-header"><i class="bi bi-list-ul" aria-hidden="true"></i> الأصناف المرتجعة للمورد</div>
        <div class="card-body p-0">
            <div class="table-container">
            <table class="table" id="itemsTable">
                <caption class="visually-hidden">الأصناف المرتجعة للمورد المُدخلة: الصنف، العدد، الكمية، سعر الوحدة، الإجمالي</caption>
                <thead>
                    <tr>
                        <th scope="col" style="width:25%">الصنف</th>
                        <th scope="col" style="width:15%">العدد</th>
                        <th scope="col" style="width:15%">الكمية</th>
                        <th scope="col" style="width:20%">سعر الوحدة</th>
                        <th scope="col" style="width:15%">الإجمالي</th>
                        <th scope="col" style="width:10%" class="text-center">حذف</th>
                    </tr>
                </thead>
                <tbody id="itemsBody">
                    <tr>
                        <td><select name="items[0].ItemId" class="form-select ui-select-sm item-select" aria-label="الصنف" @(fieldError(0, "ItemId"))>
                            <option value="">اختر صنف</option>
                            @foreach (var item in (List<NewVixSmart.Web.Models.Core.Item>)ViewBag.Items)
                            { <option value="@item.Id">@item.Name</option> }
                        </select></td>
                        <td><input name="items[0].Count" type="number" step="0.0001" class="form-control form-control-sm count" value="0" aria-label="العدد" @(fieldError(0, "Count")) /></td>
                        <td><input name="items[0].Quantity" type="number" step="0.0001" class="form-control form-control-sm qty" value="0" aria-label="الكمية" @(fieldError(0, "Quantity")) /></td>
                        <td><input name="items[0].UnitPrice" type="number" step="0.001" class="form-control form-control-sm price" value="0" aria-label="سعر الوحدة" @(fieldError(0, "UnitPrice")) /></td>
                        <td><span class="total fw-bold">0.00</span></td>
                        <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-row" aria-label="حذف السطر"><i class="bi bi-x" aria-hidden="true"></i></button></td>
                    </tr>
                    @await Html.PartialAsync("_LineItemErrors", 0)
                </tbody>
            </table>
            </div>
        </div>
        <div class="card-footer">
            <button type="button" class="ui-btn ui-btn-sm ui-btn-outline" id="addRow"><i class="bi bi-plus" aria-hidden="true"></i> إضافة صنف</button>
        </div>
    </div>

    <div class="ui-section ui-card ui-rise">
        <div class="card-body">
            <div class="ui-grid ui-grid-4 gap-3">
                <div>
                    <label class="ui-label" for="totalAmount">الإجمالي</label>
                    <input asp-for="TotalAmount" class="ui-input fw-bold" id="totalAmount" readonly />
                </div>
                <div class="md:col-span-3">
                    <label asp-for="Reason" class="ui-label"></label>
                    <textarea asp-for="Reason" class="ui-input" rows="1"></textarea>
                </div>
            </div>
            <div class="mt-4 flex gap-2">
                <button type="submit" name="submitAction" value="post" class="ui-btn ui-btn-pri"><i class="bi bi-check-lg" aria-hidden="true"></i> حفظ وترحيل</button>
                <button type="submit" name="submitAction" value="draft" class="ui-btn ui-btn-outline"><i class="bi bi-pencil-square" aria-hidden="true"></i> حفظ كمسودة</button>
                <a asp-action="Index" class="ui-btn ui-btn-quiet"><i class="bi bi-x-lg" aria-hidden="true"></i> إلغاء</a>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script nonce="@Context.GetCspNonce()">
    let rowIndex = 1;
    document.getElementById('addRow').addEventListener('click', function() {
        const tbody = document.getElementById('itemsBody');
        const firstRow = tbody.querySelector('tr');
        const options = firstRow?.querySelector('.item-select')?.innerHTML ?? '<option value="">—</option>';
        const tr = document.createElement('tr');
        tr.innerHTML = `<td><select name="items[${rowIndex}].ItemId" class="form-select ui-select-sm item-select" aria-label="الصنف">${options}</select></td>
            <td><input name="items[${rowIndex}].Count" type="number" step="0.0001" class="form-control form-control-sm count" value="0" aria-label="العدد" /></td>
            <td><input name="items[${rowIndex}].Quantity" type="number" step="0.0001" class="form-control form-control-sm qty" value="0" aria-label="الكمية" /></td>
            <td><input name="items[${rowIndex}].UnitPrice" type="number" step="0.001" class="form-control form-control-sm price" value="0" aria-label="سعر الوحدة" /></td>
            <td><span class="total fw-bold">0.00</span></td>
            <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-row" aria-label="حذف السطر"><i class="bi bi-x" aria-hidden="true"></i></button></td>`;
        tbody.appendChild(tr);
        rowIndex++;
        bindEvents();
    });

    function bindEvents() {
        document.querySelectorAll('.remove-row').forEach(btn => btn.onclick = function() { this.closest('tr').remove(); calculateTotals(); });
        document.querySelectorAll('.count, .qty, .price').forEach(inp => inp.oninput = calculateTotals);
    }

    function calculateTotals() {
        let total = 0;
        document.querySelectorAll('#itemsBody tr:not(.line-item-error)').forEach(tr => {
            const qty = parseFloat(tr.querySelector('.qty')?.value) || 0;
            const count = parseFloat(tr.querySelector('.count')?.value) || 0;
            const price = parseFloat(tr.querySelector('.price')?.value) || 0;
            const lineTotal = (qty > 0 ? qty : count) * price;
            tr.querySelector('.total').textContent = lineTotal.toFixed(2);
            total += lineTotal;
        });
        document.getElementById('totalAmount').value = total.toFixed(2);
    }

    bindEvents();
    calculateTotals();
</script>
}
