@model IEnumerable<NewVixSmart.Web.Models.Purchases.PurchaseReturn>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "مرتجعات الشراء"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-arrow-return-right text-primary"></i> مرتجعات الشراء</h2>
    @if (await Perm.HasAsync("PurchaseReturns.Create"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> مرتجع جديد</a>
    }
</div>

<div class="mb-3">
    <form method="get" class="row g-2">
        <div class="col-auto flex-grow-1">
            <label class="visually-hidden" for="prSearch">بحث في مرتجعات الشراء</label>
            <input type="search" name="search" id="prSearch" value="@ViewBag.Search" class="form-control" placeholder="بحث برقم المرتجع أو اسم المورد">
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search" aria-hidden="true"></i> بحث</button>
        </div>
    </form>
</div>

<div class="table-container">
    <table class="table table-hover mb-0">
        <thead><tr><th scope="col">رقم المرتجع</th><th scope="col">المورد</th><th scope="col">التاريخ</th><th scope="col">الإجمالي</th><th scope="col">الحالة</th><th scope="col" class="text-center">إجراء</th></tr></thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td><code>@r.ReturnNumber</code></td>
                    <td><strong>@(r.Supplier?.Name ?? "—")</strong></td>
                    <td>@r.ReturnDate.ToString("dd/MM/yyyy")</td>
                    <td class="fw-bold">@r.TotalAmount.ToString("N2") ج.م</td>
                    <td>
                        @if (r.Status == NewVixSmart.Web.Models.Accounting.ReturnStatus.Posted)
                        {
                            <span class="badge bg-success">مرحّل</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">مسودة</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-info" aria-label="عرض مرتجع الشراء @r.ReturnNumber"><i class="bi bi-eye"></i></a>
                        @if (r.Status == NewVixSmart.Web.Models.Accounting.ReturnStatus.Draft && await Perm.HasAsync("PurchaseReturns.Post"))
                        {
                            <form asp-action="Post" asp-route-id="@r.Id" method="post" class="d-inline" data-confirm="هل تريد ترحيل هذا المرتجع؟" data-confirm-ok="ترحيل">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-success" aria-label="ترحيل مرتجع الشراء @r.ReturnNumber"><i class="bi bi-check-circle"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pager")
