@model IEnumerable<NewVixSmart.Web.Models.Purchases.PurchaseReturn>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "مرتجعات الشراء"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المشتريات</span>
        <h2><i class="bi bi-arrow-return-right text-primary" aria-hidden="true"></i> مرتجعات الشراء</h2>
    </div>
    @if (await Perm.HasAsync("PurchaseReturns.Create"))
    {
        <div class="ui-pagehead-actions">
            <a asp-action="Create" class="ui-btn ui-btn-pri"><i class="bi bi-plus-lg" aria-hidden="true"></i> مرتجع جديد</a>
        </div>
    }
</div>

<div class="ui-section ui-card ui-rise">
    <div class="card-body">
        <form method="get" class="flex flex-wrap items-end gap-3">
            <div class="min-w-24 flex-1">
                <label class="visually-hidden" for="prSearch">بحث في مرتجعات الشراء</label>
                <input type="search" name="search" id="prSearch" value="@ViewBag.Search" class="ui-input" placeholder="بحث برقم المرتجع أو اسم المورد">
            </div>
            <div>
                <button type="submit" class="ui-btn ui-btn-outline"><i class="bi bi-search" aria-hidden="true"></i> بحث</button>
            </div>
        </form>
    </div>
</div>

<div class="ui-section table-container ui-rise">
    <table class="table mb-0">
        <caption class="visually-hidden">قائمة مرتجعات المشتريات: رقم المرتجع، المورد، التاريخ، الإجمالي، الحالة</caption>
        <thead><tr><th scope="col">رقم المرتجع</th><th scope="col">المورد</th><th scope="col">التاريخ</th><th scope="col">الإجمالي</th><th scope="col">الحالة</th><th scope="col" class="text-center">إجراء</th></tr></thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td><code>@r.ReturnNumber</code></td>
                    <td><strong>@(r.Supplier?.Name ?? "—")</strong></td>
                    <td>@r.ReturnDate.ToString("dd/MM/yyyy")</td>
                    <td class="num fw-bold">@Money.Format(r.TotalAmount)</td>
                    <td>
                        @if (r.Status == NewVixSmart.Web.Models.Accounting.ReturnStatus.Posted)
                        {
                            <span class="ui-badge ui-badge-ok">مرحّل</span>
                        }
                        else
                        {
                            <span class="ui-badge ui-badge-warn">مسودة</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@r.PublicId" class="ui-btn ui-btn-sm ui-btn-outline" aria-label="عرض مرتجع الشراء @r.ReturnNumber"><i class="bi bi-eye" aria-hidden="true"></i></a>
                        @if (r.Status == NewVixSmart.Web.Models.Accounting.ReturnStatus.Draft && await Perm.HasAsync("PurchaseReturns.Post"))
                        {
                            <form asp-action="Post" asp-route-id="@r.Id" method="post" class="inline-flex" data-confirm="هل تريد ترحيل هذا المرتجع؟" data-confirm-ok="ترحيل">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="ui-btn ui-btn-sm ui-btn-ok" aria-label="ترحيل مرتجع الشراء @r.ReturnNumber"><i class="bi bi-check-circle" aria-hidden="true"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pager")
