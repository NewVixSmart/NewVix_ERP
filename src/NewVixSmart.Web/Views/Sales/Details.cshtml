@model NewVixSmart.Web.Models.Sales.SaleInvoice
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = $"تفاصيل فاتورة بيع {Model.InvoiceNumber}"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المبيعات</span>
        <h2><i class="bi bi-eye" aria-hidden="true"></i> فاتورة بيع: @Model.InvoiceNumber</h2>
    </div>
    <div class="ui-pagehead-actions flex gap-2">
        @if (await Perm.HasAsync("DeliveryOrders.Create"))
        {
            <a asp-controller="DeliveryOrders" asp-action="Create" asp-route-invoiceId="@Model.Id" class="ui-btn ui-btn-ok"><i class="bi bi-truck" aria-hidden="true"></i> إنشاء أذن تسليم</a>
        }
        <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" rel="noopener noreferrer" class="ui-btn ui-btn-ghost"><i class="bi bi-printer" aria-hidden="true"></i> طباعة الفاتورة</a>
        <a asp-action="Index" class="ui-btn ui-btn-ghost"><i class="bi bi-arrow-right" aria-hidden="true"></i> رجوع</a>
    </div>
</div>

<div class="ui-section ui-card ui-rise">
    <div class="card-body">
        <div class="ui-grid ui-grid-4 gap-3">
            <div><strong>العميل:</strong> @(Model.Customer?.Name ?? "—")</div>
            <div><strong>التاريخ:</strong> @Model.InvoiceDate.ToString("dd/MM/yyyy")</div>
            <div><strong>الحالة:</strong> @(Model.IsPaid ? "مدفوعة" : "غير مدفوعة")</div>
            <div><strong>أنشأها:</strong> @(Model.CreatedBy ?? "—")</div>
        </div>
        <div class="ui-grid ui-grid-4 gap-3 mt-2">
            <div><strong>شروط الدفع:</strong> @Model.PaymentTerms.GetDisplayName()</div>
            <div><strong>تاريخ الاستحقاق:</strong> @(Model.DueDate?.ToString("dd/MM/yyyy") ?? "—")</div>
            <div class="ui-grid-span-2">
                <strong>أمر البيع:</strong>
                @if (Model.SalesOrder != null)
                {
                    <a asp-controller="SalesOrders" asp-action="Details" asp-route-id="@Model.SalesOrder.PublicId">@Model.SalesOrder.OrderNumber</a>
                }
                else
                {
                    <span>—</span>
                }
            </div>
        </div>
    </div>
</div>

<div class="ui-section table-container ui-rise">
    <table class="table">
        <caption class="visually-hidden">بنود فاتورة البيع رقم @Model.InvoiceNumber: الصنف، العدد، الكمية، سعر الوحدة، الإجمالي، الخصم</caption>
        <thead>
            <tr>
                <th scope="col">الصنف</th>
                <th scope="col">العدد</th>
                <th scope="col">الكمية</th>
                <th scope="col">سعر الوحدة</th>
                <th scope="col">الإجمالي</th>
                <th scope="col">الخصم</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Item.Name</td>
                    <td>@item.Count</td>
                    <td>@item.Quantity</td>
                    <td class="num">@Money.Format(item.UnitPrice)</td>
                    <td class="fw-bold num">@Money.Format(item.Total)</td>
                    <td class="num">@Money.Format(item.Discount)</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="ui-section ui-grid ui-grid-4 gap-3 ui-rise">
    <div class="ui-card text-center">
        <div class="card-body">
            <div class="text-muted small">الإجمالي</div>
            <h4 class="num">@Money.Format(Model.TotalAmount)</h4>
        </div>
    </div>
    <div class="ui-card text-center">
        <div class="card-body">
            <div class="text-muted small">الخصم</div>
            <h4 class="text-danger num">@Money.Format(Model.Discount)</h4>
        </div>
    </div>
    <div class="ui-card text-center">
        <div class="card-body">
            <div class="text-muted small">الضريبة</div>
            <h4 class="num">@Money.Format(Model.Tax)</h4>
        </div>
    </div>
    <div class="ui-card text-center">
        <div class="card-body">
            <div class="text-muted small">الصافي</div>
            <h4 class="text-success num">@Money.Format(Model.NetAmount)</h4>
        </div>
    </div>
</div>
