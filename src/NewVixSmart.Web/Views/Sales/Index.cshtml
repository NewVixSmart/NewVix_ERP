@model IEnumerable<NewVixSmart.Web.Models.Sales.SaleInvoice>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "فواتير البيع"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-cart-check text-primary"></i> فواتير البيع</h2>
    @if (await Perm.HasAsync("Sales.Create"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> فاتورة جديدة</a>
    }
</div>

<div class="mb-3">
    <form method="get" class="row g-2">
        <div class="col-auto flex-grow-1">
            <label class="visually-hidden" for="salesSearch">بحث في فواتير البيع</label>
            <input type="search" name="search" id="salesSearch" value="@ViewBag.Search" class="form-control" placeholder="بحث برقم الفاتورة أو اسم العميل">
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search" aria-hidden="true"></i> بحث</button>
        </div>
    </form>
</div>

<div class="table-container">
    <table class="table table-hover mb-0">
        <caption class="visually-hidden">قائمة فواتير البيع: رقم الفاتورة، العميل، التاريخ، الإجمالي، الخصم، الصافي، الاستحقاق، الحالة</caption>
        <thead><tr><th scope="col">رقم الفاتورة</th><th scope="col">العميل</th><th scope="col">التاريخ</th><th scope="col">الإجمالي</th><th scope="col">الخصم</th><th scope="col">الصافي</th><th scope="col">الاستحقاق</th><th scope="col">الحالة</th><th scope="col" class="text-center">إجراءات</th></tr></thead>
        <tbody>
            @foreach (var inv in Model)
            {
                <tr>
                    <td><code>@inv.InvoiceNumber</code></td>
                    <td>@(inv.Customer?.Name ?? "—")</td>
                    <td>@inv.InvoiceDate.ToString("dd/MM/yyyy")</td>
                    <td>@Money.Format(inv.TotalAmount)</td>
                    <td>@Money.Format(inv.Discount)</td>
                    <td class="fw-bold">@Money.Format(inv.NetAmount)</td>
                    <td>@inv.PaymentTerms.GetDisplayName()@(inv.DueDate.HasValue ? $" حتى {inv.DueDate.Value:dd/MM/yyyy}" : "")</td>
                    <td>@(inv.IsPaid ? "مدفوعة" : "غير مدفوعة")</td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@inv.PublicId" class="btn btn-sm btn-outline-info" aria-label="عرض فاتورة @inv.InvoiceNumber"><i class="bi bi-eye"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pager")
