@model IEnumerable<NewVixSmart.Web.Models.Sales.SaleInvoice>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "فواتير البيع"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المبيعات</span>
        <h2><i class="bi bi-cart-check" aria-hidden="true"></i> فواتير البيع</h2>
    </div>
    @if (await Perm.HasAsync("Sales.Create"))
    {
        <div class="ui-pagehead-actions">
            <a asp-action="Create" class="ui-btn ui-btn-pri"><i class="bi bi-plus-lg" aria-hidden="true"></i> فاتورة جديدة</a>
        </div>
    }
</div>

<div class="ui-section ui-card ui-rise">
    <div class="card-body">
        <form method="get" class="ui-grid ui-grid-2 items-center gap-3">
            <div class="ui-grid-span-2 sm:ui-grid-span-1 flex-1">
                <label class="visually-hidden" for="salesSearch">بحث في فواتير البيع</label>
                <input type="search" name="search" id="salesSearch" value="@ViewBag.Search" class="ui-input" placeholder="بحث برقم الفاتورة أو اسم العميل">
            </div>
            <div class="sm:justify-start">
                <button type="submit" class="ui-btn ui-btn-ghost"><i class="bi bi-search" aria-hidden="true"></i> بحث</button>
            </div>
        </form>
    </div>
</div>

<div class="ui-section table-container ui-rise">
    <table class="table" id="salesInvoicesTable">
        <caption class="visually-hidden">قائمة فواتير البيع: رقم الفاتورة، العميل، التاريخ، الإجمالي، الخصم، الصافي، الاستحقاق، الحالة</caption>
        <thead>
            <tr>
                <th scope="col">رقم الفاتورة</th>
                <th scope="col">العميل</th>
                <th scope="col">التاريخ</th>
                <th scope="col">الإجمالي</th>
                <th scope="col">الخصم</th>
                <th scope="col">الصافي</th>
                <th scope="col">الاستحقاق</th>
                <th scope="col">الحالة</th>
                <th scope="col" class="text-center">إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var inv in Model)
            {
                <tr>
                    <td><code>@inv.InvoiceNumber</code></td>
                    <td>@(inv.Customer?.Name ?? "—")</td>
                    <td>@inv.InvoiceDate.ToString("dd/MM/yyyy")</td>
                    <td class="num">@Money.Format(inv.TotalAmount)</td>
                    <td class="num">@Money.Format(inv.Discount)</td>
                    <td class="fw-bold num">@Money.Format(inv.NetAmount)</td>
                    <td>@inv.PaymentTerms.GetDisplayName()@(inv.DueDate.HasValue ? $" حتى {inv.DueDate.Value:dd/MM/yyyy}" : "")</td>
                    <td>@(inv.IsPaid ? "مدفوعة" : "غير مدفوعة")</td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@inv.PublicId" class="ui-btn ui-btn-sm ui-btn-ghost" aria-label="عرض فاتورة @inv.InvoiceNumber"><i class="bi bi-eye" aria-hidden="true"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pager")
