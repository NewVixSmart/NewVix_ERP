@model NewVixSmart.Web.ViewModels.Sales.SaleInvoiceViewModel
@using NewVixSmart.Web.Models.Accounting
@{ ViewData["Title"] = "فاتورة بيع جديدة"; }

<div class="page-header"><h2><i class="bi bi-cart-check text-primary"></i> فاتورة بيع جديدة</h2></div>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
}

<div class="alert alert-warning" role="note">
    <div class="fw-semibold"><i class="bi bi-exclamation-triangle"></i> هذا المسار يُرحّل الإيراد عند التسليم مباشرة</div>
    <p class="mb-2">
        الفاتورة المباشرة تُسجّل الإيراد والمخزون معاً لحظة الخصم، ولا تستخدم أذونات التسليم ولا الحجز المسبق.
        راجع الحساب والضريبة فقط.
    </p>
    <p class="mb-0">
        <strong>المسار الموصى به:</strong>
        أنشئ <a asp-controller="SalesOrders" asp-action="Create">أمر بيع</a>، ثم
        <a asp-controller="StockReservations" asp-action="Create">احجز الكمية</a>، ثم
        <a asp-controller="DeliveryOrders" asp-action="Create">أذن تسليم</a>، وأخيراً
        <a asp-controller="SalesOrders" asp-action="Index">فاتورة التسليمات</a> —
        بحيث يتحقق الإيراد والتكلفة لحظة التسليم الفعلي.
    </p>
</div>

<form asp-action="Create" id="invoiceForm" data-loading-submit data-loading-text="جاري الحفظ...">
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Invoice.InvoiceNumber" class="form-label"></label>
                    <input asp-for="Invoice.InvoiceNumber" class="form-control" readonly />
                </div>
                <div class="col-md-3">
                    <label asp-for="Invoice.CustomerId" class="form-label"></label>
                    <select asp-for="Invoice.CustomerId" asp-items="@Model.Customers" class="form-select">
                        <option value="">-- اختر العميل --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label asp-for="Invoice.InvoiceDate" class="form-label"></label>
                    <input asp-for="Invoice.InvoiceDate" class="form-control" type="date" />
                </div>
                <div class="col-md-3">
                    <label class="form-label d-block">&nbsp;</label>
                    <div class="alert alert-info py-1 px-2 mb-0 small">فاتورة غير مسدّدة؛ أذن التسليم هو ما يُرحّل المخزون والأستاذ</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="currencySelect">العملة</label>
                    <select asp-for="Invoice.CurrencyId" asp-items="@Model.Currencies" class="form-select" id="currencySelect">
                        <option value="">-- العملة --</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="exchangeRate">سعر الصرف</label>
                    <input asp-for="Invoice.ExchangeRate" class="form-control" type="number" step="any" id="exchangeRate" />
                    <small class="text-muted">للعرض فقط؛ حسابات الأستاذ بالعملة الأساسية</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header"><i class="bi bi-list-ul"></i> أصناف الفاتورة</div>
        <div class="card-body p-0">
            <table class="table table-hover mb-0" id="itemsTable">
                <thead>
                    <tr>
                        <th scope="col" style="width:25%">الصنف</th>
                        <th scope="col" style="width:15%">العدد</th>
                        <th scope="col" style="width:15%">الكمية</th>
                        <th scope="col" style="width:15%">سعر الوحدة</th>
                        <th scope="col" style="width:20%">الإجمالي</th>
                        <th scope="col" style="width:10%" class="text-center">حذف</th>
                    </tr>
                </thead>
                <tbody id="itemsBody">
                    @for (var idx = 0; idx < (Model.Items.Any() ? Model.Items.Count : 1); idx++)
                    {
                        var line = idx < Model.Items.Count ? Model.Items[idx] : null;
                        <tr>
                            <td>
                                @if (line != null)
                                {
                                    <input type="hidden" name="items[@idx].Id" value="@line.Id" />
                                }
                                <select name="items[@idx].ItemId" class="form-select form-select-sm item-select" aria-label="الصنف">
                                    <option value="">اختر صنف</option>
                                    @foreach (var item in Model.ItemsData)
                                    { <option value="@item.Id" data-price="@item.SalePrice" data-count="@item.CurrentCount" data-qty="@item.CurrentQuantity" selected="@(line?.ItemId == item.Id)">@item.Name</option> }
                                </select>
                                <small class="stock-note" hidden></small>
                            </td>
                            <td><input name="items[@idx].Count" type="number" step="0.01" class="form-control form-control-sm count" value="@(line?.Count ?? 0)" aria-label="العدد" /></td>
                            <td><input name="items[@idx].Quantity" type="number" step="0.01" class="form-control form-control-sm qty" value="@(line?.Quantity ?? 0)" aria-label="الكمية" /></td>
                            <td><input name="items[@idx].UnitPrice" type="number" step="0.01" class="form-control form-control-sm price" value="@(line?.UnitPrice ?? 0)" aria-label="سعر الوحدة" /></td>
                            <td><span class="total fw-bold">0.00</span></td>
                            <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-row" aria-label="حذف السطر"><i class="bi bi-x"></i></button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            <button type="button" class="btn btn-sm btn-outline-primary" id="addRow"><i class="bi bi-plus"></i> إضافة صنف</button>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-3"><label class="form-label" for="totalAmount">المبلغ الإجمالي</label><input asp-for="Invoice.TotalAmount" class="form-control" id="totalAmount" readonly />
            <span asp-validation-for="Invoice.TotalAmount" class="text-danger small"></span></div>
        <div class="col-md-3"><label class="form-label" for="paymentTerms">شروط الدفع</label>
            <select asp-for="Invoice.PaymentTerms" class="form-select" id="paymentTerms">
                <option value="0" selected="@(Model.Invoice.PaymentTerms == InvoicePaymentTerms.OnReceipt)">عند الاستلام (بدون تاريخ استحقاق)</option>
                <option value="1" selected="@(Model.Invoice.PaymentTerms == InvoicePaymentTerms.Net7)">7 أيام</option>
                <option value="2" selected="@(Model.Invoice.PaymentTerms == InvoicePaymentTerms.Net15)">15 يوم</option>
                <option value="3" selected="@(Model.Invoice.PaymentTerms == InvoicePaymentTerms.Net30)">30 يوم</option>
                <option value="4" selected="@(Model.Invoice.PaymentTerms == InvoicePaymentTerms.Net60)">60 يوم</option>
                <option value="5" selected="@(Model.Invoice.PaymentTerms == InvoicePaymentTerms.OpenTerm)">آجل مفتوح (بدون تاريخ استحقاق)</option>
            </select></div>
        <div class="col-md-3"><label class="form-label" for="dueDate">تاريخ الاستحقاق</label><input asp-for="Invoice.DueDate" class="form-control" type="date" id="dueDate" /></div>
        <div class="col-md-3"><label class="form-label" for="netAmount">المبلغ الصافي</label><input asp-for="Invoice.NetAmount" class="form-control fw-bold" id="netAmount" readonly /></div>
    </div>
    <div class="row g-3 mt-1">
        <div class="col-md-3"><label class="form-label" for="discount">الخصم</label><input asp-for="Invoice.Discount" class="form-control" type="number" step="0.01" id="discount" value="@Model.Invoice.Discount" /></div>
        <div class="col-md-3"><label class="form-label" for="discount2">خصم إضافي 2</label><input asp-for="Invoice.Discount2" class="form-control" type="number" step="0.01" id="discount2" /></div>
        <div class="col-md-3"><label class="form-label" for="discount3">خصم إضافي 3</label><input asp-for="Invoice.Discount3" class="form-control" type="number" step="0.01" id="discount3" /></div>
        <div class="col-md-3"><label class="form-label" for="tax">الضريبة</label><input asp-for="Invoice.Tax" class="form-control" type="number" step="0.01" id="tax" value="@Model.Invoice.Tax" /></div>
    </div>
    <div class="col-12 mt-2"><label asp-for="Invoice.Notes" class="form-label"></label><textarea asp-for="Invoice.Notes" class="form-control" rows="2"></textarea></div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ الفاتورة</button>
        <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
    </div>
</form>

@section Scripts {
<script nonce="@Context.GetCspNonce()">
function escapeHtml(str) {
    return String(str == null ? '' : str)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

let rowIndex = @(Model.Items.Any() ? Model.Items.Count : 1);
document.getElementById('addRow').addEventListener('click', function() {
    const tbody = document.getElementById('itemsBody');
    const items = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.ItemsData.Select(i => new { i.Id, i.Name, i.SalePrice, i.CurrentCount, i.CurrentQuantity }),
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default }));
    let options = '<option value="">اختر صنف</option>';
    items.forEach(i => { options += `<option value="${i.id}" data-price="${i.salePrice}" data-count="${i.currentCount}" data-qty="${i.currentQuantity}">${escapeHtml(i.name)}</option>`; });
    const tr = document.createElement('tr');
    tr.classList.add('row-in');
    tr.innerHTML = `<td><select name="items[${rowIndex}].ItemId" class="form-select form-select-sm item-select" aria-label="الصنف">${options}</select><small class="stock-note" hidden></small></td>
        <td><input name="items[${rowIndex}].Count" type="number" step="0.01" class="form-control form-control-sm count" value="0" aria-label="العدد" /></td>
        <td><input name="items[${rowIndex}].Quantity" type="number" step="0.01" class="form-control form-control-sm qty" value="0" aria-label="الكمية" /></td>
        <td><input name="items[${rowIndex}].UnitPrice" type="number" step="0.01" class="form-control form-control-sm price" value="0" aria-label="سعر الوحدة" /></td>
        <td><span class="total fw-bold">0.00</span></td>
        <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-row" aria-label="حذف السطر"><i class="bi bi-x"></i></button></td>`;
    tbody.appendChild(tr);
    rowIndex++;
    bindEvents();
    setTimeout(() => tr.classList.remove('row-in'), 240);
});

function bindEvents() {
    document.querySelectorAll('.remove-row').forEach(btn => {
        if (btn.dataset.boundRow) return;
        btn.dataset.boundRow = 'true';
        btn.addEventListener('click', function() {
            const tr = this.closest('tr');
            const reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (reduced) { tr.remove(); calculateTotals(); return; }
            tr.classList.add('row-out');
            setTimeout(() => { if (tr.parentNode) tr.parentNode.removeChild(tr); calculateTotals(); }, 180);
        });
    });
    document.querySelectorAll('.item-select').forEach(sel => {
        if (sel.dataset.boundItem) return;
        sel.dataset.boundItem = 'true';
        sel.addEventListener('change', function() {
            const price = this.options[this.selectedIndex].dataset.price || 0;
            this.closest('tr').querySelector('.price').value = parseFloat(price).toFixed(2);
            calculateTotals();
        });
    });
    document.querySelectorAll('.qty, .count, .price').forEach(inp => {
        if (inp.dataset.boundCalc) return;
        inp.dataset.boundCalc = 'true';
        inp.addEventListener('input', calculateTotals);
    });
}

function calculateTotals() {
    let total = 0;
    document.querySelectorAll('#itemsBody tr').forEach(tr => {
        const qty = parseFloat(tr.querySelector('.qty')?.value) || 0;
        const count = parseFloat(tr.querySelector('.count')?.value) || 0;
        const price = parseFloat(tr.querySelector('.price')?.value) || 0;
        const lineTotal = (qty > 0 ? qty : count) * price;
        tr.querySelector('.total').textContent = lineTotal.toFixed(2);
        total += lineTotal;

        const sel = tr.querySelector('.item-select');
        const note = tr.querySelector('.stock-note');
        let warn = '';
        if (sel && sel.selectedIndex > 0) {
            const opt = sel.options[sel.selectedIndex];
            const availCount = parseFloat(opt.dataset.count) || 0;
            const availQty = parseFloat(opt.dataset.qty) || 0;
            if (count > availCount) warn = 'العدد المطلوب (' + count + ') أكبر من المتاح (' + availCount + ')';
            if (qty > availQty) warn += (warn ? ' - ' : '') + 'الكمية المطلوبة (' + qty + ') أكبر من المتاح (' + availQty + ')';
            tr.querySelector('.qty').title = warn || '';
        }
        if (note) {
            note.textContent = warn;
            note.hidden = !warn;
        }
        tr.classList.toggle('row-stock-warn', !!warn);
    });
    document.getElementById('totalAmount').value = total.toFixed(2);
    const discount = parseFloat(document.getElementById('discount').value) || 0;
    const discount2 = parseFloat(document.getElementById('discount2').value) || 0;
    const discount3 = parseFloat(document.getElementById('discount3').value) || 0;
    const tax = parseFloat(document.getElementById('tax').value) || 0;
    const net = document.getElementById('netAmount');
    net.value = (total - discount - discount2 - discount3 + tax).toFixed(2);
    net.classList.remove('pulse-change');
    void net.offsetWidth;
    net.classList.add('pulse-change');
}

bindEvents();
document.getElementById('discount').addEventListener('input', calculateTotals);
document.getElementById('discount2').addEventListener('input', calculateTotals);
document.getElementById('discount3').addEventListener('input', calculateTotals);
document.getElementById('tax').addEventListener('input', calculateTotals);
calculateTotals();
</script>
}