@model NewVixSmart.Web.ViewModels.Users.CreateUserViewModel
@{
    ViewData["Title"] = "مستخدم جديد";
}

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المستخدمون</span>
        <h2><i class="bi bi-person-plus" aria-hidden="true"></i> إنشاء مستخدم جديد</h2>
    </div>
</div>

<div class="ui-section ui-card ui-rise" style="max-width: 560px;">
    <div class="card-body">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4" role="alert" tabindex="-1"></div>
            <div class="mb-4">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control ui-input" autocomplete="off" />
                <span asp-validation-for="Username" class="text-danger small" aria-invalid="true"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control ui-input" type="password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger small" aria-invalid="true"></span>
                <div class="form-text">6 أحرف على الأقل مع رقم.</div>
            </div>
            <div class="mb-4">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" asp-items="ViewBag.Roles" class="form-select ui-input">
                    <option value="Warehouse">أمين مخزن</option>
                    <option value="Accountant">محاسب</option>
                    <option value="Admin">مدير نظام</option>
                </select>
                <div class="form-text">سيمنح المستخدم تلقائيًا الصلاحيات الافتراضية لأدوار المحاسب وأمين المخزن، ويمكن تعديلها بعد الإنشاء.</div>
            </div>
            <div class="flex gap-2">
                <button type="submit" class="ui-btn ui-btn-pri"><i class="bi bi-check-lg" aria-hidden="true"></i> إنشاء</button>
                <a asp-action="Index" class="ui-btn ui-btn-ghost">إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
