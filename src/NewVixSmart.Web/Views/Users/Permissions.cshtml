@model NewVixSmart.Web.ViewModels.Users.UserPermissionViewModel
@using NewVixSmart.Web.Services
@{
    ViewData["Title"] = $"صلاحيات - {Model.UserName}";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-toggles text-primary" aria-hidden="true"></i> صلاحيات المستخدم: @Model.UserName</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right" aria-hidden="true"></i> رجوع</a>
</div>

@if (Model.IsAdmin)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle" aria-hidden="true"></i> هذا المستخدم من مديري النظام (Admin) ويملك <strong>كل الصلاحيات تلقائيًا</strong> دون حاجة لضبط مصفوفة.
    </div>
}
else
{
    <div class="alert alert-light border small">
        <i class="bi bi-info-circle" aria-hidden="true"></i> منح <strong>أي إجراء</strong> في وحدة يفتح تلقائيًا <strong>رؤية</strong> الصفحة في القائمة الجانبية.
        صلاحيات المدير لا تخضع لهذا الجدول.
    </div>

    <form asp-action="Permissions" asp-route-id="@Model.UserId" method="post">
        @* مجموعةُ الصلاحيات كما عُرضت، فيقارنها الخادم بالمحفوظ قبل الحذف وإعادة البناء. *@
        <input type="hidden" name="renderedKeys" value="@Model.RenderedKeys" />
        <div class="table-container">
            <table class="table table-hover mb-0 align-middle">
                <caption class="visually-hidden">مصفوفة صلاحيات المستخدم: الواجهة ثم الإجراءات القابلة للتفعيل</caption>
                <thead>
                    <tr>
                        <th scope="col" style="min-width: 220px;">الوحدة</th>
                        <th scope="col">الإجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model.Modules)
                    {
                        <tr>
                            <td><strong>@m.TitleAr</strong></td>
                            <td>
                                <div class="d-flex flex-wrap gap-3">
                                    @foreach (var act in PermissionCatalog.ActionsFor(m.Key))
                                    {
                                        var key = PermissionCatalog.Key(m.Key, act);
                                        var label = act switch
                                        {
                                            PermissionCatalog.View => "عرض",
                                            PermissionCatalog.Create => "إضافة",
                                            PermissionCatalog.Edit => "تعديل",
                                            PermissionCatalog.Delete => "حذف",
                                            PermissionCatalog.Approve => "اعتماد",
                                            PermissionCatalog.Receive => "استلام",
                                            PermissionCatalog.Post => "ترحيل",
                                            "Convert" => "تحويل",
                                            "Deliver" => "تسليم",
                                            "Deactivate" => "إيقاف",
                                            "Manage" => "إدارة",
                                            "Dashboard" => "لوحة",
                                            "Export" => "تصدير",
                                            "Import" => "استيراد",
                                            "Close" => "إقفال",
                                            "Reopen" => "إعادة فتح",
                                            "SalesCreate" => "مبيعات",
                                            "AdjustmentCreate" => "جرد",
                                            _ => act
                                        };
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="perm" value="@key" id="@key"
                                                   @(m.HasAction(act) ? "checked" : "") />
                                            <label class="form-check-label small text-muted" for="@key">@label</label>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> حفظ الصلاحيات</button>
            <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
        </div>
    </form>
}
