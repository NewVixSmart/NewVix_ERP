@model IEnumerable<NewVixSmart.Web.ViewModels.Users.UserListItemViewModel>
@{
    ViewData["Title"] = "المستخدمون والصلاحيات";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-person-gear text-primary" aria-hidden="true"></i> المستخدمون والصلاحيات</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> مستخدم جديد</a>
</div>

<div class="table-container">
    <table class="table table-hover mb-0">
        <caption class="visually-hidden">قائمة المستخدمين وأدوارهم وعدد صلاحياتهم وحالة كل حساب</caption>
        <thead>
            <tr>
                <th scope="col">اسم المستخدم</th>
                <th scope="col">الدور</th>
                <th scope="col">عدد الصلاحيات</th>
                <th scope="col">الحالة</th>
                <th scope="col" class="text-center">الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>
                        <strong>@u.UserName</strong>
                        @if (u.IsAdmin)
                        {
                            <span class="badge bg-dark ms-2">مدير النظام</span>
                        }
                    </td>
                    <td>
                        @foreach (var r in u.DisplayRoles)
                        {
                            <span class="badge bg-secondary me-1">@NewVixSmart.Web.ViewModels.Users.UserRoleLabels.DisplayName(r)</span>
                        }
                        @if (u.DisplayRoles.Count == 0)
                        {
                            <span class="text-muted">بدون دور</span>
                        }
                    </td>
                    <td>
                        @if (u.IsAdmin)
                        {
                            <span class="badge bg-success">كامل (تلقائي)</span>
                        }
                        else
                        {
                            <span class="badge bg-info text-dark">@u.PermissionCount إجراء</span>
                        }
                    </td>
                    <td>
                        @if (u.IsDeactivated)
                        {
                            <span class="badge bg-danger">مُبطَل</span>
                        }
                        else
                        {
                            <span class="badge bg-success">نشط</span>
                        }
                    </td>
                    <td class="text-center">
                        <div class="d-inline-flex gap-1 flex-wrap justify-content-center">
                            @if (!u.IsAdmin)
                            {
                                <a asp-action="Permissions" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary" aria-label="إدارة صلاحيات @u.UserName">
                                    <i class="bi bi-toggles" aria-hidden="true"></i> صلاحيات
                                </a>
                            }
                            @if (u.Id == currentUserId)
                            {
                                <button type="button" class="btn btn-sm btn-outline-secondary" disabled
                                        title="لا يمكنك إبطال حسابك بنفسك">
                                    <i class="bi bi-person-slash" aria-hidden="true"></i> @(!u.IsDeactivated ? "إبطال" : "إعادة تفعيل")
                                </button>
                            }
                            else
                            {
                                <form asp-action="ToggleDeactivated" asp-route-id="@u.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(u.IsDeactivated ? "btn-outline-success" : "btn-outline-danger")"
                                            aria-label="@(u.IsDeactivated ? "إعادة تفعيل حساب " : "إبطال حساب ") @u.UserName">
                                        <i class="bi bi-person-slash" aria-hidden="true"></i> @(!u.IsDeactivated ? "إبطال" : "إعادة تفعيل")
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
