@model IEnumerable<NewVixSmart.Web.ViewModels.Users.UserListItemViewModel>
@{
    ViewData["Title"] = "المستخدمون والصلاحيات";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">الحسابات والصلاحيات</span>
        <h2><i class="bi bi-person-gear" aria-hidden="true"></i> المستخدمون والصلاحيات</h2>
    </div>
    <div class="ui-pagehead-actions">
        <a asp-action="Create" class="ui-btn ui-btn-pri"><i class="bi bi-plus-lg" aria-hidden="true"></i> مستخدم جديد</a>
    </div>
</div>

<div class="table-container ui-rise">
    <table class="table" id="usersTable">
        <caption class="visually-hidden">قائمة المستخدمين وأدوارهم وعدد صلاحياتهم وحالة كل حساب</caption>
        <thead>
            <tr>
                <th scope="col">اسم المستخدم</th>
                <th scope="col">الدور</th>
                <th scope="col">عدد الصلاحيات</th>
                <th scope="col">الحالة</th>
                <th scope="col" class="text-center">الإجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td>
                        <strong>@u.UserName</strong>
                        @if (u.IsAdmin)
                        {
                            <span class="ui-badge ui-badge-mute ms-2">مدير النظام</span>
                        }
                    </td>
                    <td>
                        @foreach (var r in u.DisplayRoles)
                        {
                            <span class="ui-badge ui-badge-soft me-1">@NewVixSmart.Web.ViewModels.Users.UserRoleLabels.DisplayName(r)</span>
                        }
                        @if (u.DisplayRoles.Count == 0)
                        {
                            <span class="text-muted">بدون دور</span>
                        }
                    </td>
                    <td>
                        @if (u.IsAdmin)
                        {
                            <span class="ui-badge ui-badge-ok">كامل (تلقائي)</span>
                        }
                        else
                        {
                            <span class="ui-badge ui-badge-info">@u.PermissionCount إجراء</span>
                        }
                    </td>
                    <td>
                        @if (u.IsDeactivated)
                        {
                            <span class="ui-badge ui-badge-bad">مُبطَل</span>
                        }
                        else
                        {
                            <span class="ui-badge ui-badge-ok">نشط</span>
                        }
                    </td>
                    <td class="text-center">
                        <div class="inline-flex gap-1 flex-wrap justify-center">
                            @if (!u.IsAdmin)
                            {
                                <a asp-action="Permissions" asp-route-id="@u.Id" class="ui-btn ui-btn-sm ui-btn-ghost" aria-label="إدارة صلاحيات @u.UserName">
                                    <i class="bi bi-toggles" aria-hidden="true"></i> صلاحيات
                                </a>
                            }
                            @if (u.Id == currentUserId)
                            {
                                <button type="button" class="ui-btn ui-btn-sm ui-btn-ghost" disabled
                                        title="لا يمكنك إبطال حسابك بنفسك">
                                    <i class="bi bi-person-slash" aria-hidden="true"></i> @(!u.IsDeactivated ? "إبطال" : "إعادة تفعيل")
                                </button>
                            }
                            else
                            {
                                <form asp-action="ToggleDeactivated" asp-route-id="@u.Id" method="post" class="inline-flex">
                                    <button type="submit" class="ui-btn ui-btn-sm @(u.IsDeactivated ? "ui-btn-ok" : "ui-btn-bad")"
                                            aria-label="@(u.IsDeactivated ? "إعادة تفعيل حساب " : "إبطال حساب ") @u.UserName">
                                        <i class="bi bi-person-slash" aria-hidden="true"></i> @(!u.IsDeactivated ? "إبطال" : "إعادة تفعيل")
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
