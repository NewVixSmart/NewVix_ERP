@model IReadOnlyList<NewVixSmart.Web.Models.Stock.StockReservation>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@using NewVixSmart.Web.Models.Stock
@using NewVixSmart.Web.Extensions
@{ ViewData["Title"] = "حجوزات المخزون"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المخزون</span>
        <h2><i class="bi bi-bookmark-check" aria-hidden="true"></i> حجوزات المخزون</h2>
    </div>
    @if (await Perm.HasAsync("StockReservations.Create"))
    {
        <div class="ui-pagehead-actions">
            <a asp-action="Create" class="ui-btn ui-btn-pri"><i class="bi bi-plus-lg" aria-hidden="true"></i> حجز جديد</a>
        </div>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="ui-alert ui-alert-ok ui-rise" role="status" aria-live="polite">
        <i class="bi bi-check-circle" aria-hidden="true"></i>
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="ui-alert ui-alert-bad ui-rise" role="alert">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        <span>@TempData["Error"]</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="إغلاق"></button>
    </div>
}

<nav class="flex flex-wrap items-center gap-2 mb-4" aria-label="فلترة حجوزات المخزون">
    <a class="ui-btn ui-btn-sm @(ViewBag.StatusFilter == null ? "ui-btn-pri" : "ui-btn-quiet")" asp-action="Index">الكل</a>
    @foreach (var st in Enum.GetValues<StockReservationStatus>())
    {
        <a class="ui-btn ui-btn-sm @(ViewBag.StatusFilter as StockReservationStatus? == st ? "ui-btn-pri" : "ui-btn-quiet")" asp-action="Index" asp-route-status="@st">@st.GetDisplayName()</a>
    }
</nav>

@if (!Model.Any())
{
    <div class="empty-state ui-rise">
        <div class="empty-icon"><i class="bi bi-inbox" aria-hidden="true"></i></div>
        <strong>لا توجد حجوزات بعد</strong>
        <p class="text-muted">ابدأ بإنشاء حجز مخزون جديد ليظهر هنا مباشرة.</p>
    </div>
}
else
{
    <div class="table-container ui-rise">
        <table class="table">
            <caption class="visually-hidden">قائمة حجوزات المخزون مع الحالة والكميات المحجوزة</caption>
            <thead>
                <tr>
                    <th scope="col">رقم الحجز</th>
                    <th scope="col">أمر البيع</th>
                    <th scope="col">العميل</th>
                    <th scope="col">عدد الأصناف</th>
                    <th scope="col">الكمية</th>
                    <th scope="col">العدد</th>
                    <th scope="col">الحالة</th>
                    <th scope="col">أُنشئ</th>
                    <th scope="col" class="text-center">إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <th scope="row"><code>@r.ReservationNumber</code></th>
                        <td>
                            @if (r.SalesOrder != null)
                            {
                                <a asp-controller="SalesOrders" asp-action="Details" asp-route-id="@r.SalesOrder.PublicId">@r.SalesOrder.OrderNumber</a>
                            }
                            else
                            {
                                <span>حجز مستقل</span>
                            }
                        </td>
                        <td>@(r.Customer?.Name ?? "—")</td>
                        <td class="num">@r.Items.Count</td>
                        <td class="num">@r.TotalQuantity.ToString("N2")</td>
                        <td class="num">@r.TotalCount.ToString("N2")</td>
                        <td><span class="ui-badge @(r.Status switch { StockReservationStatus.Released => "ui-badge-mute", StockReservationStatus.Consumed => "ui-badge-ok", _ => "ui-badge-warn" })">@r.Status.GetDisplayName()</span></td>
                        <td class="num">@r.CreatedAt.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@r.PublicId" class="ui-btn ui-btn-sm ui-btn-outline" aria-label="عرض الحجز @r.ReservationNumber"><i class="bi bi-eye" aria-hidden="true"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
