@model IReadOnlyList<NewVixSmart.Web.Services.BackupFileInfo>
@inject NewVixSmart.Web.Services.IBackupService Backup
@{ ViewData["Title"] = "النسخ الاحتياطي والاستعادة"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">الإعدادات</span>
        <h2><i class="bi bi-database" aria-hidden="true"></i> النسخ الاحتياطي والاستعادة</h2>
    </div>
</div>

<p class="text-muted mb-4">أنشئ نسخًا احتياطية كاملة لقاعدة البيانات، واستعدها عند الحاجة، أو أعد ضبط النظام بالكامل.</p>

<div class="ui-grid ui-grid-3">
    <div class="ui-card ui-rise">
        <div class="ui-card-head"><i class="bi bi-plus-circle" aria-hidden="true"></i> إنشاء نسخة احتياطية</div>
        <div class="ui-card-body">
            <p>تُحفظ النسخة كملف <code>.bak</code> في مجلد Backups داخل التطبيق.</p>
            <form asp-action="Create" method="post" data-loading-submit data-loading-text="جارٍ إنشاء النسخة...">
                @Html.AntiForgeryToken()
                <button type="submit" class="ui-btn ui-btn-pri"><i class="bi bi-database-add" aria-hidden="true"></i> إنشاء نسخة احتياطية الآن</button>
            </form>
            <div class="mt-3 small text-muted flex items-center gap-1">
                <i class="bi bi-folder2-open" aria-hidden="true"></i>
                <span dir="ltr">@Backup.BackupDirectory</span>
            </div>
        </div>
    </div>

    <div class="ui-card ui-rise md:col-span-2">
        <div class="ui-card-head"><i class="bi bi-archive" aria-hidden="true"></i> النسخ الاحتياطية المتاحة</div>
        <div class="ui-card-body p-0">
            <div class="table-container" style="max-height:none;border:0;border-radius:0">
                <table class="table">
                    <caption class="visually-hidden">النسخ الاحتياطية المتاحة</caption>
                    <thead>
                        <tr>
                            <th scope="col">اسم الملف</th>
                            <th scope="col">الحجم</th>
                            <th scope="col">تاريخ الإنشاء</th>
                            <th scope="col" class="text-center">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model)
                        {
                            var sizeText = f.LengthBytes < 1024 * 1024
                                ? Math.Round(f.LengthBytes / 1024d, 1) + " KB"
                                : Math.Round(f.LengthBytes / 1024d / 1024d, 2) + " MB";
                            <tr>
                                <td dir="ltr" class="text-start"><code>@f.FileName</code></td>
                                <td class="num">@sizeText</td>
                                <td class="num">@f.CreatedAtUtc.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                                <td class="text-center">
                                    <div class="flex flex-wrap items-center justify-center gap-1">
                                        <a asp-action="Download" asp-route-fileName="@f.FileName" class="ui-btn ui-btn-sm ui-btn-quiet" aria-label="تنزيل @f.FileName"><i class="bi bi-download" aria-hidden="true"></i></a>
                                        <form asp-action="Restore" method="post" data-confirm="سيتم استبدال قاعدة البيانات الحالية بهذه النسخة. متابعة؟" data-confirm-ok="استعادة" data-loading-submit data-loading-text="جارٍ الاستعادة...">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="fileName" value="@f.FileName" />
                                            <button type="submit" class="ui-btn ui-btn-sm ui-btn-outline" aria-label="استعادة @f.FileName"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>
                                        </form>
                                        <form asp-action="Delete" method="post" data-confirm="حذف هذه النسخة الاحتياطية نهائيًا؟" data-confirm-ok="حذف" data-loading-submit data-loading-text="جارٍ الحذف...">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="fileName" value="@f.FileName" />
                                            <button type="submit" class="ui-btn ui-btn-sm ui-btn-danger" aria-label="حذف @f.FileName"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Any())
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="bi bi-inbox" aria-hidden="true"></i></div>
                    <strong>لا توجد نسخ احتياطية بعد</strong>
                    <p class="text-muted">أنشئ أول نسخة احتياطية لحماية بياناتك.</p>
                </div>
            }
        </div>
    </div>
</div>

<section class="ui-card ui-rise border-2 border-bad mt-4" aria-labelledby="dangerZoneTitle">
    <div class="ui-card-head bg-bad text-white" id="dangerZoneTitle"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i> منطقة الخطر — إعادة ضبط النظام</div>
    <div class="ui-card-body">
        <p>تحذير شديد: حذف كامل لكل بيانات النظام (الأصناف، المبيعات، المشتريات، الأصول/القيود، العملاء، الموردين، المستخدمين ما عدا admin، الإعدادات، والبيانات التجريبية). لا يمكن التراجع.</p>
        <form asp-action="Reset" method="post" data-confirm="متأكد؟ سيفقد كل شيء وسيُحذف نهائيًا." data-confirm-ok="نعم، احذف كل شيء" data-loading-submit data-loading-text="جارٍ إعادة الضبط...">
            @Html.AntiForgeryToken()
            <div class="flex flex-wrap items-center gap-2">
                <div>
                    <label for="confirmText" class="ui-label mb-1">اكتب كلمة التأكيد <strong>حذف نهائي</strong> للمتابعة</label>
                    <input type="text" name="confirmText" id="confirmText" class="ui-input ui-input-sm w-auto" placeholder="حذف نهائي" autocomplete="off" required aria-describedby="confirmHelp" />
                    <small id="confirmHelp" class="form-text text-muted">هذا الإجراء نهائي ولا يمكن التراجع عنه.</small>
                </div>
                <button type="submit" class="ui-btn ui-btn-danger"><i class="bi bi-trash3" aria-hidden="true"></i> إعادة ضبط النظام بالكامل</button>
            </div>
        </form>
    </div>
</section>
