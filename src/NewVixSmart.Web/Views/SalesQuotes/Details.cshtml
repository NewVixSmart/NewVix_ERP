@model NewVixSmart.Web.Models.Sales.SaleQuote
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = $"تفاصيل عرض سعر {Model.QuoteNumber}"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المبيعات</span>
        <h2><i class="bi bi-receipt-cutoff" aria-hidden="true"></i> عرض سعر: @Model.QuoteNumber</h2>
    </div>
    <div class="ui-pagehead-actions flex gap-2">
        <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" rel="noopener" class="ui-btn ui-btn-ghost"><i class="bi bi-printer" aria-hidden="true"></i> نسخة للعميل / طباعة</a>
        <a asp-action="Pdf" asp-route-id="@Model.Id" class="ui-btn ui-btn-ghost"><i class="bi bi-filetype-pdf" aria-hidden="true"></i> تحميل PDF</a>
        @if (Model.Status == NewVixSmart.Web.Models.Sales.SaleQuoteStatus.Draft && await Perm.HasAsync("SalesQuotes.Convert"))
        {
            <form asp-action="Convert" asp-route-id="@Model.Id" method="post" class="d-inline" data-confirm="هل تريد تحويل هذا العرض إلى أمر بيع؟ لن تُرحّل فاتورة أو مخزون الآن" data-confirm-ok="تحويل">
                @Html.AntiForgeryToken()
                <button type="submit" class="ui-btn ui-btn-ok"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> تحويل إلى أمر بيع</button>
            </form>
        }
        <a asp-action="Index" class="ui-btn ui-btn-ghost"><i class="bi bi-arrow-right" aria-hidden="true"></i> رجوع</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="ui-alert ui-alert-ok ui-rise alert-dismissible" role="alert">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="ui-alert ui-alert-bad ui-rise alert-dismissible" role="alert">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button></div>
}

<div class="ui-section ui-card ui-rise">
    <div class="card-body">
        <div class="ui-grid ui-grid-5 gap-3">
            <div>
                <strong>الحالة:</strong>
                @if (Model.Status == NewVixSmart.Web.Models.Sales.SaleQuoteStatus.Converted)
                {
                    <span class="ui-badge ui-badge-ok">محوّل</span>
                    <small class="text-muted d-block">@Model.ConvertedBy — @Model.ConvertedAt?.ToString("dd/MM/yyyy HH:mm")</small>
                }
                else if (Model.Status == NewVixSmart.Web.Models.Sales.SaleQuoteStatus.Cancelled)
                {
                    <span class="ui-badge ui-badge-mute">ملغي</span>
                }
                else if (Model.Status == NewVixSmart.Web.Models.Sales.SaleQuoteStatus.Converting)
                {
                    <span class="ui-badge ui-badge-warn">جارٍ التحويل</span>
                }
                else
                {
                    <span class="ui-badge ui-badge-warn">مسودة</span>
                }
            </div>
            <div><strong>العميل:</strong> @(Model.Customer?.Name ?? "—")</div>
            <div><strong>تاريخ العرض:</strong> @Model.QuoteDate.ToString("dd/MM/yyyy")</div>
            <div><strong>صالح حتى:</strong> @(Model.ValidUntil?.ToString("dd/MM/yyyy") ?? "—")</div>
            <div><strong>أنشأها:</strong> @(Model.CreatedBy ?? "—")</div>
        </div>
        <div class="ui-grid ui-grid-2 gap-3 mt-2">
            <div>
                <strong>أمر البيع:</strong>
                @if (Model.Status == NewVixSmart.Web.Models.Sales.SaleQuoteStatus.Converted && Model.SalesOrder != null)
                {
                    <a asp-controller="SalesOrders" asp-action="Details" asp-route-id="@Model.SalesOrder.PublicId">@Model.SalesOrder.OrderNumber</a>
                }
                else
                {
                    <span>—</span>
                }
            </div>
            <div>
                <strong>عرض المورد المرجعي:</strong>
                @if (Model.SupplierQuote != null)
                {
                    <text>مرتبط بعرض المورد #@Model.SupplierQuote.Id</text> <span>— @(Model.SupplierQuote.Supplier?.Name ?? "—")</span>
                }
                else
                {
                    <span>—</span>
                }
            </div>
        </div>
    </div>
</div>

<div class="ui-section table-container ui-rise">
    <table class="table">
        <caption class="visually-hidden">أصناف عرض السعر: الصنف، العدد، الكمية، سعر الوحدة، الإجمالي</caption>
        <thead>
            <tr>
                <th scope="col">الصنف</th>
                <th scope="col">العدد</th>
                <th scope="col">الكمية</th>
                <th scope="col">سعر الوحدة</th>
                <th scope="col">الإجمالي</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@(item.Item?.Name ?? "—")</td>
                    <td>@item.Count</td>
                    <td>@item.Quantity</td>
                    <td class="num">@Money.Format(item.UnitPrice)</td>
                    <td class="fw-bold num">@Money.Format(item.Total)</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="ui-section ui-grid ui-grid-4 gap-3 ui-rise">
    <div class="ui-card text-center">
        <div class="card-body">
            <div class="text-muted small">الإجمالي</div>
            <h4 class="num">@Money.Format(Model.TotalAmount)</h4>
        </div>
    </div>
    <div class="ui-card text-center">
        <div class="card-body">
            <div class="text-muted small">الخصم</div>
            <h4 class="text-danger num">@Money.Format(Model.Discount)</h4>
        </div>
    </div>
    <div class="ui-card text-center">
        <div class="card-body">
            <div class="text-muted small">الضريبة</div>
            <h4 class="num">@Money.Format(Model.Tax)</h4>
        </div>
    </div>
    <div class="ui-card text-center">
        <div class="card-body">
            <div class="text-muted small">الصافي</div>
            <h4 class="text-success num">@Money.Format(Model.NetAmount)</h4>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Notes))
{
    <div class="ui-section ui-card ui-rise"><div class="card-body"><strong>ملاحظات:</strong> @Model.Notes</div></div>
}
