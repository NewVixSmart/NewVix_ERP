@model NewVixSmart.Web.ViewModels.Sales.SaleQuoteViewModel
@{ ViewData["Title"] = "عرض سعر جديد"; }
@{
    ViewData["LineItemColumns"] = 6;
    ViewData["ErrorKeysWithVisibleField"] = new[] { "Quote.CustomerId", "Quote.TotalAmount" };
    Func<int, string, IHtmlContent> fieldError = (index, field) =>
    {
        var key = "items[" + index + "]." + field;
        var failed = ViewData.ModelState.Any(entry =>
            entry.Key.Equals(key, StringComparison.OrdinalIgnoreCase) && entry.Value!.Errors.Count > 0);
        return failed
            ? Html.Raw(" aria-invalid=\"true\" aria-describedby=\"line-error-" + index + "\"")
            : Html.Raw(string.Empty);
    };
}

<div class="page-header"><h2><i class="bi bi-receipt-cutoff text-primary"></i> عرض سعر جديد</h2></div>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" tabindex="-1"></div>
    @await Html.PartialAsync("_UnhandledFieldErrors")
}

<form asp-action="Create" id="quoteForm">
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label asp-for="Quote.QuoteNumber" class="form-label"></label>
                    <input asp-for="Quote.QuoteNumber" class="form-control" readonly />
                </div>
                <div class="col-md-3">
                    <label asp-for="Quote.CustomerId" class="form-label"></label>
                    <select asp-for="Quote.CustomerId" asp-items="@Model.Customers" class="form-select">
                        <option value="">-- اختر العميل --</option>
                    </select>
                    <span asp-validation-for="Quote.CustomerId" class="text-danger small"></span>
                </div>
                <div class="col-md-2">
                    <label asp-for="Quote.QuoteDate" class="form-label"></label>
                    <input asp-for="Quote.QuoteDate" class="form-control" type="date" />
                </div>
                <div class="col-md-2">
                    <label asp-for="Quote.ValidUntil" class="form-label"></label>
                    <input asp-for="Quote.ValidUntil" class="form-control" type="date" />
                </div>
                <div class="col-md-3">
                    <label asp-for="Quote.SupplierQuoteId" class="form-label"></label>
                    <select asp-for="Quote.SupplierQuoteId" asp-items="@Model.SupplierQuotes" class="form-select">
                        <option value="">لا يوجد</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header"><i class="bi bi-list-ul"></i> أصناف العرض</div>
        @if (!ViewData.ModelState.IsValid && !Model.Items.Any())
        {
            <div class="card-body pb-0">@await Html.PartialAsync("_NoLineItemsNotice")</div>
        }
        <div class="card-body p-0">
            <table class="table table-hover mb-0" id="itemsTable">
                <caption class="visually-hidden">أصناف عرض السعر المُدخلة: الصنف، العدد، الكمية، سعر الوحدة، الإجمالي</caption>
                <thead>
                    <tr>
                        <th scope="col" style="width:25%">الصنف</th>
                        <th scope="col" style="width:15%">العدد</th>
                        <th scope="col" style="width:15%">الكمية</th>
                        <th scope="col" style="width:15%">سعر الوحدة</th>
                        <th scope="col" style="width:20%">الإجمالي</th>
                        <th scope="col" style="width:10%" class="text-center">حذف</th>
                    </tr>
                </thead>
                <tbody id="itemsBody">
                    @for (var idx = 0; idx < (Model.Items.Any() ? Model.Items.Count : 1); idx++)
                    {
                        var line = idx < Model.Items.Count ? Model.Items[idx] : null;
                        <tr>
                            <td>
                                <select name="items[@idx].ItemId" class="form-select form-select-sm item-select" aria-label="الصنف" @(fieldError(idx, "ItemId"))>
                                    <option value="">اختر صنف</option>
                                    @foreach (var item in Model.ItemsData)
                                    { <option value="@item.Id" data-price="@item.SalePrice" data-count="@item.CurrentCount" data-qty="@item.CurrentQuantity" selected="@(line?.ItemId == item.Id)">@item.Name</option> }
                                </select>
                            </td>
                            <td><input name="items[@idx].Count" type="number" step="0.0001" class="form-control form-control-sm count" value="@(line?.Count ?? 0)" aria-label="العدد" @(fieldError(idx, "Count")) /></td>
                            <td><input name="items[@idx].Quantity" type="number" step="0.0001" class="form-control form-control-sm qty" value="@(line?.Quantity ?? 0)" aria-label="الكمية" @(fieldError(idx, "Quantity")) /></td>
                            <td><input name="items[@idx].UnitPrice" type="number" step="0.001" class="form-control form-control-sm price" value="@(line?.UnitPrice ?? 0)" aria-label="سعر الوحدة" @(fieldError(idx, "UnitPrice")) /></td>
                            <td><span class="total fw-bold">0.00</span></td>
                            <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-row" aria-label="حذف السطر"><i class="bi bi-x"></i></button></td>
                        </tr>
                        @await Html.PartialAsync("_LineItemErrors", idx)
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer">
            <button type="button" class="btn btn-sm btn-outline-primary" id="addRow"><i class="bi bi-plus"></i> إضافة صنف</button>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-md-3"><label class="form-label" for="totalAmount">الإجمالي</label><input asp-for="Quote.TotalAmount" class="form-control" id="totalAmount" readonly />
            <span asp-validation-for="Quote.TotalAmount" class="text-danger small"></span></div>
        <div class="col-md-3"><label class="form-label" for="discount">الخصم</label><input asp-for="Quote.Discount" class="form-control" type="number" step="0.01" id="discount" value="@Model.Quote.Discount" /></div>
        <div class="col-md-3"><label class="form-label" for="tax">الضريبة</label><input asp-for="Quote.Tax" class="form-control" type="number" step="0.01" id="tax" value="@Model.Quote.Tax" /></div>
        <div class="col-md-3"><label class="form-label" for="netAmount">المبلغ الصافي</label><input asp-for="Quote.NetAmount" class="form-control fw-bold" id="netAmount" readonly /></div>
    </div>
    <div class="col-12 mt-2"><label asp-for="Quote.Notes" class="form-label"></label><textarea asp-for="Quote.Notes" class="form-control" rows="2"></textarea></div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ عرض السعر</button>
        <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
    </div>
</form>

@section Scripts {
<script nonce="@Context.GetCspNonce()">
function escapeHtml(str) {
    return String(str == null ? '' : str)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

let rowIndex = @(Model.Items.Any() ? Model.Items.Count : 1);
document.getElementById('addRow').addEventListener('click', function() {
    const tbody = document.getElementById('itemsBody');
    const items = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.ItemsData.Select(i => new { i.Id, i.Name, i.SalePrice, i.CurrentCount, i.CurrentQuantity }),
        new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default }));
    let options = '<option value="">اختر صنف</option>';
    items.forEach(i => { options += `<option value="${i.id}" data-price="${i.salePrice}" data-count="${i.currentCount}" data-qty="${i.currentQuantity}">${escapeHtml(i.name)}</option>`; });
    const tr = document.createElement('tr');
    tr.innerHTML = `<td><select name="items[${rowIndex}].ItemId" class="form-select form-select-sm item-select" aria-label="الصنف">${options}</select></td>
        <td><input name="items[${rowIndex}].Count" type="number" step="0.0001" class="form-control form-control-sm count" value="0" aria-label="العدد" /></td>
        <td><input name="items[${rowIndex}].Quantity" type="number" step="0.0001" class="form-control form-control-sm qty" value="0" aria-label="الكمية" /></td>
        <td><input name="items[${rowIndex}].UnitPrice" type="number" step="0.001" class="form-control form-control-sm price" value="0" aria-label="سعر الوحدة" /></td>
        <td><span class="total fw-bold">0.00</span></td>
        <td class="text-center"><button type="button" class="btn btn-sm btn-outline-danger remove-row" aria-label="حذف السطر"><i class="bi bi-x"></i></button></td>`;
    tbody.appendChild(tr);
    rowIndex++;
    bindEvents();
});

function bindEvents() {
    document.querySelectorAll('.remove-row').forEach(btn => {
        if (btn.dataset.boundRow) return;
        btn.dataset.boundRow = 'true';
        btn.addEventListener('click', function() { this.closest('tr').remove(); calculateTotals(); });
    });
    document.querySelectorAll('.item-select').forEach(sel => {
        if (sel.dataset.boundItem) return;
        sel.dataset.boundItem = 'true';
        sel.addEventListener('change', function() {
            const price = this.options[this.selectedIndex].dataset.price || 0;
            this.closest('tr').querySelector('.price').value = parseFloat(price).toFixed(2);
            calculateTotals();
        });
    });
    document.querySelectorAll('.qty, .count, .price').forEach(inp => {
        if (inp.dataset.boundCalc) return;
        inp.dataset.boundCalc = 'true';
        inp.addEventListener('input', calculateTotals);
    });
}

function calculateTotals() {
    let total = 0;
    document.querySelectorAll('#itemsBody tr:not(.line-item-error)').forEach(tr => {
        const qty = parseFloat(tr.querySelector('.qty')?.value) || 0;
        const count = parseFloat(tr.querySelector('.count')?.value) || 0;
        const price = parseFloat(tr.querySelector('.price')?.value) || 0;
        const lineTotal = (qty > 0 ? qty : count) * price;
        tr.querySelector('.total').textContent = lineTotal.toFixed(2);
        total += lineTotal;

        const sel = tr.querySelector('.item-select');
        if (sel && sel.selectedIndex > 0) {
            const opt = sel.options[sel.selectedIndex];
            const availCount = parseFloat(opt.dataset.count) || 0;
            const availQty = parseFloat(opt.dataset.qty) || 0;
            let warn = '';
            if (count > availCount) warn = ' ⚠ العدد المطلوب أكبر من المخزون (' + availCount + ')';
            if (qty > availQty) warn += (warn ? ' و' : ' ⚠') + ' الكمية المطلوبة أكبر من المخزون (' + availQty + ')';
            tr.querySelector('.qty').title = warn || '';
        }
    });
    document.getElementById('totalAmount').value = total.toFixed(2);
    const discount = parseFloat(document.getElementById('discount').value) || 0;
    const tax = parseFloat(document.getElementById('tax').value) || 0;
    document.getElementById('netAmount').value = (total - discount + tax).toFixed(2);
}

bindEvents();
document.getElementById('discount').addEventListener('input', calculateTotals);
document.getElementById('tax').addEventListener('input', calculateTotals);
calculateTotals();
</script>
}
