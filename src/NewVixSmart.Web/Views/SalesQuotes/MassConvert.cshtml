@model IReadOnlyList<NewVixSmart.Web.Models.Sales.SaleQuote>
@{ ViewData["Title"] = "تحويل جماعي لعروض الأسعار"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-arrow-repeat text-primary"></i> شاشة التحويل الجماعي</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> رجوع</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button></div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">لا توجد عروض أسعار مسودة قابلة للتحويل.</div>
}
else
{
    <form asp-action="MassConvert" method="post" data-confirm="هل تريد تحويل العروض المحددة إلى فواتير بيع وترحيل المخزون؟" data-confirm-ok="تحويل">
        @Html.AntiForgeryToken()
        <div class="table-container">
            <table class="table table-hover mb-0">
                <caption class="visually-hidden">قائمة عروض الأسعار المسودة القابلة للتحويل إلى فواتير بيع</caption>
                <thead>
                    <tr>
                        <th scope="col" class="text-center"><input type="checkbox" id="selectAll" aria-label="تحديد الكل" /></th>
                        <th scope="col">رقم العرض</th>
                        <th scope="col">العميل</th>
                        <th scope="col">التاريخ</th>
                        <th scope="col">صالح حتى</th>
                        <th scope="col">الصافي</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model)
                    {
                        <tr>
                            <td class="text-center"><input type="checkbox" name="ids" class="mass-convert-check" value="@q.Id" aria-label="تحديد عرض السعر @q.QuoteNumber" /></td>
                            <td><code>@q.QuoteNumber</code></td>
                            <td><strong>@(q.Customer?.Name ?? "—")</strong></td>
                            <td>@q.QuoteDate.ToString("dd/MM/yyyy")</td>
                            <td>@(q.ValidUntil?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="fw-bold">@q.NetAmount.ToString("N2") ج.م</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-success"><i class="bi bi-arrow-repeat"></i> تحويل المحدد إلى فواتير بيع</button>
        </div>
    </form>
}