@model IReadOnlyList<NewVixSmart.Web.Models.Sales.SaleQuote>
@{ ViewData["Title"] = "تحويل جماعي لعروض الأسعار"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المبيعات</span>
        <h2><i class="bi bi-arrow-repeat" aria-hidden="true"></i> شاشة التحويل الجماعي</h2>
    </div>
    <div class="ui-pagehead-actions">
        <a asp-action="Index" class="ui-btn ui-btn-ghost"><i class="bi bi-arrow-right" aria-hidden="true"></i> رجوع</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="ui-alert ui-alert-ok ui-rise alert-dismissible" role="alert">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="ui-alert ui-alert-bad ui-rise alert-dismissible" role="alert">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button></div>
}

@if (!Model.Any())
{
    <div class="ui-alert ui-alert-info ui-rise">لا توجد عروض أسعار مسودة قابلة للتحويل.</div>
}
else
{
    <form asp-action="MassConvert" method="post" data-confirm="هل تريد تحويل العروض المحددة إلى فواتير بيع؟" data-confirm-ok="تحويل">
        @Html.AntiForgeryToken()
        <div class="ui-section table-container ui-rise">
            <table class="table">
                <caption class="visually-hidden">قائمة عروض الأسعار المسودة القابلة للتحويل إلى فواتير بيع</caption>
                <thead>
                    <tr>
                        <th scope="col" class="text-center"><input type="checkbox" id="selectAll" aria-label="تحديد الكل" /></th>
                        <th scope="col">رقم العرض</th>
                        <th scope="col">العميل</th>
                        <th scope="col">التاريخ</th>
                        <th scope="col">صالح حتى</th>
                        <th scope="col">الصافي</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model)
                    {
                        <tr>
                            <td class="text-center"><input type="checkbox" name="ids" class="mass-convert-check" value="@q.Id" aria-label="تحديد عرض السعر @q.QuoteNumber" /></td>
                            <td><code>@q.QuoteNumber</code></td>
                            <td><strong>@(q.Customer?.Name ?? "—")</strong></td>
                            <td>@q.QuoteDate.ToString("dd/MM/yyyy")</td>
                            <td>@(q.ValidUntil?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="fw-bold num">@Money.Format(q.NetAmount)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="ui-section ui-rise">
            <button type="submit" class="ui-btn ui-btn-ok"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> تحويل المحدد إلى فواتير بيع</button>
        </div>
    </form>
}
