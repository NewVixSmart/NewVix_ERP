@model NewVixSmart.Web.ViewModels.Accounting.ShipmentFormViewModel
@{
    ViewData["Title"] = "تعديل الشحنة";
    var isSale = Model.Shipment.InvoiceType == NewVixSmart.Web.Models.Accounting.ShipmentInvoiceType.Sale;
}

<div class="page-header"><h2><i class="bi bi-truck text-primary"></i> تعديل الشحنة</h2></div>

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Shipment.Id">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <p><strong>رقم الشحنة:</strong> <code>@Model.Shipment.ShipmentNumber</code></p>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="Shipment.InvoiceType" class="form-label"></label>
                    <select asp-for="Shipment.InvoiceType" class="form-select" id="invoiceType">
                        <option value="1">بيع</option>
                        <option value="2">شراء</option>
                    </select>
                </div>
                <div class="col-md-8" id="saleRow">
                    <label asp-for="Shipment.SaleInvoiceId" class="form-label"></label>
                    <select asp-for="Shipment.SaleInvoiceId" asp-items="@Model.SaleInvoices" class="form-select">
                        <option value="">— اختر فاتورة بيع —</option>
                    </select>
                    <span asp-validation-for="Shipment.SaleInvoiceId" class="text-danger small"></span>
                </div>
                <div class="col-md-8" id="purchaseRow" style="@(isSale ? "display:none" : "")">
                    <label asp-for="Shipment.PurchaseInvoiceId" class="form-label"></label>
                    <select asp-for="Shipment.PurchaseInvoiceId" asp-items="@Model.PurchaseInvoices" class="form-select">
                        <option value="">— اختر فاتورة شراء —</option>
                    </select>
                    <span asp-validation-for="Shipment.PurchaseInvoiceId" class="text-danger small"></span>
                </div>
                <div class="col-md-4" id="customerRow">
                    <label asp-for="Shipment.CustomerId" class="form-label"></label>
                    <select asp-for="Shipment.CustomerId" asp-items="@Model.Customers" class="form-select">
                        <option value="">— بدون —</option>
                    </select>
                </div>
                <div class="col-md-4" id="supplierRow" style="@(isSale ? "display:none" : "")">
                    <label asp-for="Shipment.SupplierId" class="form-label"></label>
                    <select asp-for="Shipment.SupplierId" asp-items="@Model.Suppliers" class="form-select">
                        <option value="">— بدون —</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Shipment.Carrier" class="form-label"></label>
                    <input asp-for="Shipment.Carrier" class="form-control" maxlength="100" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Shipment.TrackingNumber" class="form-label"></label>
                    <input asp-for="Shipment.TrackingNumber" class="form-control" maxlength="100" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Shipment.ShipDate" class="form-label"></label>
                    <input asp-for="Shipment.ShipDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="Shipment.Status" class="form-label"></label>
                    <select asp-for="Shipment.Status" class="form-select">
                        <option value="0">قيد التحضير</option>
                        <option value="1">تم الشحن</option>
                        <option value="2">تم التسليم</option>
                        <option value="3">ملغي</option>
                    </select>
                </div>
                <div class="col-12">
                    <label asp-for="Shipment.Notes" class="form-label"></label>
                    <textarea asp-for="Shipment.Notes" class="form-control" rows="3" maxlength="500"></textarea>
                </div>
            </div>
            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
                <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-lg"></i> إلغاء</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@Context.GetCspNonce()">
        document.getElementById('invoiceType').addEventListener('change', function() {
            var sale = this.value === '1';
            document.getElementById('saleRow').style.display = sale ? '' : 'none';
            document.getElementById('customerRow').style.display = sale ? '' : 'none';
            document.getElementById('purchaseRow').style.display = sale ? 'none' : '';
            document.getElementById('supplierRow').style.display = sale ? 'none' : '';
        });
    </script>
}
