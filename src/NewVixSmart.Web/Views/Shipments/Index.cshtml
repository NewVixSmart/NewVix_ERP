@model IEnumerable<NewVixSmart.Web.Models.Accounting.Shipment>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "الشحنات"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-truck text-primary"></i> الشحنات</h2>
    @if (await Perm.HasAsync("Shipments.Create"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> شحنة جديدة</a>
    }
</div>

<div class="table-container">
    <table class="table table-hover mb-0">
        <thead><tr><th scope="col">رقم الشحنة</th><th scope="col">النوع</th><th scope="col">المرتبطة</th><th scope="col">الناقل</th><th scope="col">التتبع</th><th scope="col">تاريخ الشحن</th><th scope="col">الحالة</th><th scope="col" class="text-center">إجراءات</th></tr></thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td><code>@s.ShipmentNumber</code></td>
                    <td>@(s.InvoiceType == NewVixSmart.Web.Models.Accounting.ShipmentInvoiceType.Sale ? "بيع" : "شراء")</td>
                    <td>
                        @if (s.SaleInvoice != null) { <span class="badge bg-info text-dark">بيع @s.SaleInvoice.InvoiceNumber</span> }
                        @if (s.PurchaseInvoice != null) { <span class="badge bg-secondary">شراء @s.PurchaseInvoice.InvoiceNumber</span> }
                    </td>
                    <td>@(s.Carrier ?? "—")</td>
                    <td>@(s.TrackingNumber ?? "—")</td>
                    <td>@(s.ShipDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td>
                        @switch (s.Status)
                        {
                            case NewVixSmart.Web.Models.Accounting.ShipmentStatus.Preparing: <span class="badge bg-warning text-dark">قيد التحضير</span> break;
                            case NewVixSmart.Web.Models.Accounting.ShipmentStatus.Shipped: <span class="badge bg-primary">تم الشحن</span> break;
                            case NewVixSmart.Web.Models.Accounting.ShipmentStatus.Delivered: <span class="badge bg-success">تم التسليم</span> break;
                            case NewVixSmart.Web.Models.Accounting.ShipmentStatus.Cancelled: <span class="badge bg-danger">ملغي</span> break;
                        }
                    </td>
                    <td class="text-center">
                        @if (await Perm.HasAsync("Shipments.Edit"))
                        {
                            <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary" aria-label="تعديل شحنة @s.ShipmentNumber"><i class="bi bi-pencil"></i></a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
