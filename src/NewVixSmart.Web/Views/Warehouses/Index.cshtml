@model IEnumerable<NewVixSmart.Web.Models.Stock.Warehouse>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "المستودعات"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-building text-primary" aria-hidden="true"></i> المستودعات</h2>
    @if (await Perm.HasAsync("Warehouses.Create"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> مستودع جديد</a>
    }
</div>

<div class="table-container">
    <table class="table table-hover mb-0">
        <caption class="visually-hidden">المستودعات: الرمز، الاسم، الحالة، تاريخ الإنشاء</caption>
        <thead>
            <tr>
                <th scope="col">الرمز</th>
                <th scope="col">الاسم</th>
                <th scope="col">الحالة</th>
                <th scope="col">تاريخ الإنشاء</th>
                <th scope="col" class="text-center">إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var w in Model)
            {
                <tr>
                    <td><code>@w.Code</code></td>
                    <td><strong>@w.Name</strong></td>
                    <td>
                        @if (w.IsActive)
                        { <span class="badge-stock-ok px-2 py-1 rounded">نشط</span> }
                        else
                        { <span class="badge-stock-low px-2 py-1 rounded">غير نشط</span> }
                    </td>
                    <td>@w.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td class="text-center d-flex gap-1 justify-content-center">
                        @if (await Perm.HasAsync("Warehouses.Edit"))
                        {
                            <a asp-action="Edit" asp-route-id="@w.Id" class="btn btn-sm btn-outline-primary" title="تعديل" aria-label="تعديل المستودع @w.Name"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                        }
                        @if (await Perm.HasAsync("Warehouses.Delete"))
                        {
                            <form asp-action="Delete" asp-route-id="@w.Id" method="post" class="d-inline" data-confirm="حذف هذا المستودع؟" data-confirm-ok="حذف">
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف" aria-label="حذف المستودع @w.Name"><i class="bi bi-trash" aria-hidden="true"></i></button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
