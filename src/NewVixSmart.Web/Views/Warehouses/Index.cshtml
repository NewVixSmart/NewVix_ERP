@model IEnumerable<NewVixSmart.Web.Models.Stock.Warehouse>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "المستودعات"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المخزون</span>
        <h2>المستودعات</h2>
    </div>
    @if (await Perm.HasAsync("Warehouses.Create"))
    {
        <div class="ui-pagehead-actions">
            <a asp-action="Create" class="ui-btn ui-btn-pri"><i class="bi bi-plus-lg" aria-hidden="true"></i> مستودع جديد</a>
        </div>
    }
</div>

<div class="table-container ui-rise">
    <table class="table">
        <caption class="visually-hidden">المستودعات: الرمز، الاسم، الحالة، تاريخ الإنشاء</caption>
        <thead>
            <tr>
                <th scope="col">الرمز</th>
                <th scope="col">الاسم</th>
                <th scope="col">الحالة</th>
                <th scope="col">تاريخ الإنشاء</th>
                <th scope="col" class="text-center">إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var w in Model)
            {
                <tr>
                    <td><code>@w.Code</code></td>
                    <td><strong>@w.Name</strong></td>
                    <td>
                        @if (w.IsActive)
                        {
                            <span class="ui-badge ui-badge-ok">نشط</span>
                        }
                        else
                        {
                            <span class="ui-badge ui-badge-mute">غير نشط</span>
                        }
                    </td>
                    <td>@w.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td>
                        <div class="flex flex-wrap items-center justify-center gap-1">
                            @if (await Perm.HasAsync("Warehouses.Edit"))
                            {
                                <a asp-action="Edit" asp-route-id="@w.Id" class="ui-btn ui-btn-sm btn-edit" title="تعديل" aria-label="تعديل المستودع @w.Name"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            }
                            @if (await Perm.HasAsync("Warehouses.Delete"))
                            {
                                <form asp-action="Delete" asp-route-id="@w.Id" method="post" class="d-inline" data-confirm="حذف هذا المستودع؟" data-confirm-ok="حذف">
                                    <button type="submit" class="ui-btn ui-btn-sm btn-del" title="حذف" aria-label="حذف المستودع @w.Name"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
