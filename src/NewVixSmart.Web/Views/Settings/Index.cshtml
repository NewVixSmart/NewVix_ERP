@model NewVixSmart.Web.ViewModels.Core.SettingsViewModel
@{ ViewData["Title"] = "الإعدادات"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">النظام</span>
        <h2><i class="bi bi-gear" aria-hidden="true"></i> الإعدادات</h2>
    </div>
    <div class="ui-pagehead-actions">
        <a asp-action="Printing" class="ui-btn ui-btn-ghost ui-btn-sm"><i class="bi bi-printer" aria-hidden="true"></i> إعدادات الطباعة</a>
        <a asp-action="Branding" class="ui-btn ui-btn-ghost ui-btn-sm"><i class="bi bi-palette" aria-hidden="true"></i> العلامة التجارية والمظهر</a>
    </div>
</div>

<div class="ui-grid ui-grid-2 ui-rise">
    <div class="ui-section">
        <div class="ui-card">
            <div class="card-header justify-between items-center">
                <span><i class="bi bi-rulers" aria-hidden="true"></i> وحدات القياس</span>
                <button type="button" class="ui-btn ui-btn-sm ui-btn-pri" data-bs-toggle="modal" data-bs-target="#addUnitModal"><i class="bi bi-plus-lg" aria-hidden="true"></i> وحدة جديدة</button>
            </div>
            <div class="card-body p-0">
                <div class="table-container">
                    <table class="table">
                        <caption class="visually-hidden">وحدات القياس: الاسم، الاختصار، الوحدة الفرعية، الحالة</caption>
                        <thead><tr><th scope="col">الاسم</th><th scope="col">الاختصار</th><th scope="col">الوحدة الفرعية</th><th scope="col">الحالة</th><th scope="col" class="text-center">إجراءات</th></tr></thead>
                        <tbody>
                            @foreach (var u in Model.Units)
                            {
                                <tr>
                                    <td><strong>@u.Name</strong></td>
                                    <td>@(u.ShortName ?? "—")</td>
                                    <td>
                                        @if (u.SubUnits > 0) { @($"{u.SubUnits.Value} × {Model.Units.FirstOrDefault(p => p.Id == u.ParentUnitId)?.Name}") }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td>
                                        @if (u.IsActive)
                                        { <span class="ui-badge ui-badge-ok">نشط</span> }
                                        else
                                        { <span class="ui-badge ui-badge-bad">معطل</span> }
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="ui-btn ui-btn-sm ui-btn-ghost btn-edit-unit" data-id="@u.Id" data-name="@u.Name" data-short="@u.ShortName" data-sub="@u.SubUnits" data-parent="@u.ParentUnitId" data-active="@u.IsActive.ToString().ToLower()" data-rowversion="@(u.RowVersion is null ? string.Empty : Convert.ToBase64String(u.RowVersion))" aria-label="تعديل وحدة @u.Name"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                        <form asp-action="DeleteUnit" asp-route-id="@u.Id" method="post" class="inline-flex" data-confirm="حذف هذه الوحدة؟" data-confirm-ok="حذف">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="ui-btn ui-btn-sm ui-btn-bad" aria-label="حذف وحدة @u.Name"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Units.Any())
                            {
                                <tr><td colspan="5" class="text-center text-muted py-4">لا توجد وحدات بعد</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="flex flex-col gap-4">
        <div class="ui-card">
            <div class="card-header justify-between items-center">
                <span><i class="bi bi-tags" aria-hidden="true"></i> التصنيفات الرئيسية</span>
                <a asp-controller="Categories" asp-action="Index" class="ui-btn ui-btn-sm ui-btn-ghost">إدارة</a>
            </div>
            <div class="card-body p-0">
                <div class="flex flex-col divide-y divide-[color:var(--color-line)]">
                    @foreach (var c in Model.Categories)
                    {
                        <div class="flex justify-between items-center px-4 py-2.5">
                            <span>@c.Name</span>
                            <div class="flex items-center gap-2">
                                <span class="ui-badge ui-badge-soft">@c.Items.Count صنف</span>
                                @if (!c.IsActive) { <span class="ui-badge ui-badge-warn">معطل</span> }
                            </div>
                        </div>
                    }
                    @if (!Model.Categories.Any())
                    {
                        <div class="px-4 py-4 text-center text-muted">لا توجد تصنيفات</div>
                    }
                </div>
            </div>
        </div>
        <div class="ui-card">
            <div class="card-header justify-between items-center">
                <span><i class="bi bi-grid" aria-hidden="true"></i> أنواع الأصناف</span>
                <a asp-controller="ItemTypes" asp-action="Index" class="ui-btn ui-btn-sm ui-btn-ghost">إدارة</a>
            </div>
            <div class="card-body p-0">
                <div class="flex flex-col divide-y divide-[color:var(--color-line)]">
                    @foreach (var t in Model.ItemTypes)
                    {
                        <div class="flex justify-between items-center px-4 py-2.5">
                            <span>@t.Name</span>
                            <div class="flex items-center gap-2">
                                <span class="ui-badge ui-badge-soft">@t.Items.Count صنف</span>
                                @if (!t.IsActive) { <span class="ui-badge ui-badge-warn">معطل</span> }
                            </div>
                        </div>
                    }
                    @if (!Model.ItemTypes.Any())
                    {
                        <div class="px-4 py-4 text-center text-muted">لا توجد أنواع</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<div class="ui-section ui-rise">
    <div class="ui-card">
        <div class="card-header justify-between items-center">
            <span><i class="bi bi-diagram-3" aria-hidden="true"></i> الفروع</span>
            <button type="button" class="ui-btn ui-btn-sm ui-btn-pri" data-bs-toggle="modal" data-bs-target="#addBranchModal"><i class="bi bi-plus-lg" aria-hidden="true"></i> فرع جديد</button>
        </div>
        <div class="card-body p-0">
            <div class="table-container">
                <table class="table">
                    <caption class="visually-hidden">الفروع: الرمز، الاسم، العنوان، الحالة</caption>
                    <thead><tr><th scope="col">الرمز</th><th scope="col">الاسم</th><th scope="col">العنوان</th><th scope="col">الحالة</th><th scope="col" class="text-center">إجراءات</th></tr></thead>
                    <tbody>
                        @foreach (var b in Model.Branches)
                        {
                            <tr>
                                <td><strong>@b.Code</strong></td>
                                <td>@b.Name @if (Model.CurrentBranchId == b.Id) { <span class="ui-badge ui-badge-ok">الحالي</span> }</td>
                                <td>@(b.Address ?? "—")</td>
                                <td>@(b.IsActive ? "نشط" : "معطل")</td>
                                <td class="text-center">
                                    <button type="button" class="ui-btn ui-btn-sm ui-btn-ghost btn-edit-branch" data-id="@b.Id" data-code="@b.Code" data-name="@b.Name" data-address="@b.Address" data-phone="@b.Phone" data-active="@b.IsActive.ToString().ToLower()" data-rowversion="@(b.RowVersion is null ? string.Empty : Convert.ToBase64String(b.RowVersion))" aria-label="تعديل فرع @b.Code"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                    @if (Model.CurrentBranchId != b.Id)
                                    {
                                        <form asp-action="SetCurrentBranch" method="post" class="inline-flex" data-confirm="التعامل مع @b.Name كفرع حالي؟" data-confirm-ok="تعيين">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="branchId" value="@b.Id" />
                                            <button type="submit" class="ui-btn ui-btn-sm ui-btn-ok" aria-label="تعيين @b.Name كفرع حالي"><i class="bi bi-check2" aria-hidden="true"></i></button>
                                        </form>
                                    }
                                    <form asp-action="DeleteBranch" asp-route-id="@b.Id" method="post" class="inline-flex" data-confirm="حذف هذا الفرع؟" data-confirm-ok="حذف">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="ui-btn ui-btn-sm ui-btn-bad" aria-label="حذف فرع @b.Code"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Branches.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">لا توجد فروع بعد</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addUnitModal" tabindex="-1" aria-labelledby="addUnitModalTitle">
    <div class="modal-dialog">
        <form asp-action="AddUnit" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header"><h5 class="modal-title" id="addUnitModalTitle">وحدة قياس جديدة</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label" for="addUnitName">اسم الوحدة</label><input name="Name" id="addUnitName" class="form-control" required maxlength="50" /></div>
                <div class="mb-3"><label class="form-label" for="addUnitShort">الاختصار</label><input name="ShortName" id="addUnitShort" class="form-control" maxlength="20" placeholder="مثل: كجم" /></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> حفظ</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="editUnitModal" tabindex="-1" aria-labelledby="editUnitModalTitle">
    <div class="modal-dialog">
        <form asp-action="UpdateUnit" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="editUnitId" />
            <input type="hidden" name="RowVersion" id="editUnitRowVersion" />
            <div class="modal-header"><h5 class="modal-title" id="editUnitModalTitle">تعديل الوحدة</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label" for="editUnitName">اسم الوحدة</label><input name="Name" id="editUnitName" class="form-control" required maxlength="50" /></div>
                <div class="mb-3"><label class="form-label" for="editUnitShort">الاختصار</label><input name="ShortName" id="editUnitShort" class="form-control" maxlength="20" /></div>
                <div class="row g-3">
                    <div class="col-6">
                        <label class="form-label" for="editUnitSub">الوحدات الفرعية</label>
                        <input type="number" name="SubUnits" id="editUnitSub" class="form-control" min="0" value="0" />
                    </div>
                    <div class="col-6">
                        <label class="form-label" for="editUnitParent">الوحدة الأم</label>
                        <select name="ParentUnitId" id="editUnitParent" class="form-select">
                            <option value="">— بدون —</option>
                            @foreach (var u in Model.SelectableUnits)
                            {
                                <option value="@u.Id" data-parent-of="@u.ParentUnitId">@u.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="form-check form-switch mt-3">
                    <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="editUnitActive" checked />
                    <label class="form-check-label" for="editUnitActive">نشطة</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> حفظ</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="addBranchModal" tabindex="-1" aria-labelledby="addBranchModalTitle">
    <div class="modal-dialog">
        <form asp-action="AddBranch" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header"><h5 class="modal-title" id="addBranchModalTitle">فرع جديد</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label" for="addBranchCode">رمز الفرع</label><input name="Code" id="addBranchCode" class="form-control" required maxlength="50" placeholder="مثل: BR-003" /></div>
                <div class="mb-3"><label class="form-label" for="addBranchName">اسم الفرع</label><input name="Name" id="addBranchName" class="form-control" required maxlength="200" /></div>
                <div class="mb-3"><label class="form-label" for="addBranchAddress">العنوان</label><input name="Address" id="addBranchAddress" class="form-control" maxlength="300" /></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> حفظ</button>
            </div>
        </form>
    </div>
</div>

<div class="modal fade" id="editBranchModal" tabindex="-1" aria-labelledby="editBranchModalTitle">
    <div class="modal-dialog">
        <form asp-action="UpdateBranch" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" id="editBranchId" />
            <input type="hidden" name="RowVersion" id="editBranchRowVersion" />
            <div class="modal-header"><h5 class="modal-title" id="editBranchModalTitle">تعديل الفرع</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button></div>
            <div class="modal-body">
                <div class="mb-3"><label class="form-label" for="editBranchCode">رمز الفرع</label><input name="Code" id="editBranchCode" class="form-control" required maxlength="50" /></div>
                <div class="mb-3"><label class="form-label" for="editBranchName">اسم الفرع</label><input name="Name" id="editBranchName" class="form-control" required maxlength="200" /></div>
                <div class="mb-3"><label class="form-label" for="editBranchAddress">العنوان</label><input name="Address" id="editBranchAddress" class="form-control" maxlength="300" /></div>
                <div class="mb-3"><label class="form-label" for="editBranchPhone">الهاتف</label><input name="Phone" id="editBranchPhone" class="form-control" maxlength="20" /></div>
                <div class="form-check form-switch">
                    <input type="checkbox" name="IsActive" value="true" class="form-check-input" id="editBranchActive" checked />
                    <label class="form-check-label" for="editBranchActive">نشط</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg" aria-hidden="true"></i> حفظ</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script nonce="@Context.GetCspNonce()">
        document.querySelectorAll('.btn-edit-unit').forEach(btn => btn.addEventListener('click', function() {
            document.getElementById('editUnitId').value = this.dataset.id;
            document.getElementById('editUnitName').value = this.dataset.name;
            document.getElementById('editUnitShort').value = this.dataset.short || '';
            document.getElementById('editUnitSub').value = this.dataset.sub || 0;
            const parent = document.getElementById('editUnitParent');
            parent.value = (this.dataset.parent && this.dataset.parent !== '') ? this.dataset.parent : '';
            document.getElementById('editUnitActive').checked = this.dataset.active === 'true';
            document.getElementById('editUnitRowVersion').value = this.dataset.rowversion || '';
            new bootstrap.Modal(document.getElementById('editUnitModal')).show();
        }));

        document.querySelectorAll('.btn-edit-branch').forEach(btn => btn.addEventListener('click', function() {
            document.getElementById('editBranchId').value = this.dataset.id;
            document.getElementById('editBranchCode').value = this.dataset.code;
            document.getElementById('editBranchName').value = this.dataset.name;
            document.getElementById('editBranchAddress').value = this.dataset.address || '';
            document.getElementById('editBranchPhone').value = this.dataset.phone || '';
            document.getElementById('editBranchActive').checked = this.dataset.active === 'true';
            document.getElementById('editBranchRowVersion').value = this.dataset.rowversion || '';
            new bootstrap.Modal(document.getElementById('editBranchModal')).show();
        }));
    </script>
}
