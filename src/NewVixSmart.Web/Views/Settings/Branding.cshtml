@model NewVixSmart.Web.ViewModels.Core.BrandingViewModel
@{
    ViewData["Title"] = "العلامة التجارية والمظهر";
}
<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">العلامة التجارية</span>
        <h2><i class="bi bi-palette" aria-hidden="true"></i> العلامة التجارية والمظهر</h2>
    </div>
    <div class="ui-pagehead-actions">
        <a asp-action="Index" class="ui-btn ui-btn-ghost ui-btn-sm"><i class="bi bi-arrow-right" aria-hidden="true"></i> العودة للإعدادات</a>
    </div>
</div>

<form asp-action="SaveBranding" method="post" enctype="multipart/form-data" class="ui-grid ui-grid-2 ui-rise" data-loading-submit data-loading-text="جاري الحفظ...">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger" role="alert" tabindex="-1"></div>
    @if (Model.RowVersion is { Length: > 0 } brandingRv)
    {
        <input type="hidden" name="RowVersion" value="@Convert.ToBase64String(brandingRv)" />
    }

    <div class="ui-section">
        <div class="ui-card h-full">
            <div class="card-header">
                <i class="bi bi-building" aria-hidden="true"></i> بيانات الشركة
            </div>
            <div class="card-body">
                <div class="mb-4">
                    <label asp-for="CompanyName" class="form-label"></label>
                    <input asp-for="CompanyName" class="form-control ui-input" />
                    <span asp-validation-for="CompanyName" class="text-danger small" aria-invalid="true"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Tagline" class="form-label"></label>
                    <input asp-for="Tagline" class="form-control ui-input" placeholder="Smart Solutions" />
                </div>
                <div class="mb-4">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control ui-input" />
                </div>
                <div class="ui-grid ui-grid-2 gap-4">
                    <div>
                        <label asp-for="Phone" class="form-label"></label>
                        <input asp-for="Phone" class="form-control ui-input" />
                    </div>
                    <div>
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control ui-input" />
                    </div>
                </div>
                <div class="mt-4">
                    <label asp-for="TaxNumber" class="form-label"></label>
                    <input asp-for="TaxNumber" class="form-control ui-input" />
                </div>
            </div>
        </div>
    </div>

    <div class="ui-section">
        <div class="ui-card h-full">
            <div class="card-header">
                <i class="bi bi-image" aria-hidden="true"></i> شعار الشركة
            </div>
            <div class="card-body">
                @if (Model.HasLogo)
                {
                    <div class="flex items-center gap-3 mb-4">
                        <img class="brand-logo" style="width:72px;height:72px;" src="@Model.LogoDataUri" alt="@Model.CompanyName" />
                        <div>
                            <div class="font-semibold">الشعار الحالي</div>
                            <small class="text-muted block">@(Model.LogoFileName ?? "شعار مرفوع") — يظهر في الشريط الجانبي، صفحة الدخول، الفواتير، والطباعة.</small>
                        </div>
                    </div>
                }
                else
                {
                    <div class="ui-alert ui-alert-info small" role="status">لم يتم رفع شعار بعد. سيُستخدم الحرف الأول من اسم الشركة كشعار مبدئي.</div>
                }
                <div class="mb-4">
                    <label asp-for="LogoFile" class="form-label">رفع شعار جديد</label>
                    <input asp-for="LogoFile" class="form-control ui-input" type="file" accept="image/png,image/jpeg,image/webp" />
                    <small class="text-muted">صيغ PNG أو SVG أو JPEG أو WEBP بحد أقصى 2 ميجابايت.</small>
                </div>
                @if (Model.HasLogo)
                {
                    <div class="form-check">
                        <input asp-for="RemoveLogo" class="form-check-input" />
                        <label asp-for="RemoveLogo" class="form-check-label">إزالة الشعار الحالي</label>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="ui-section" style="grid-column: 1 / -1;">
        <div class="ui-card">
            <div class="card-header">
                <i class="bi bi-palette2" aria-hidden="true"></i> لوحة ألوان النظام
            </div>
            <div class="card-body">
                <p class="text-muted small mb-4">اختر لوحة جاهزة تناسب هوية شركتك أو خصّص الألوان يدويًا. ستُطبَّق فورًا على كامل النظام (الأزرار، الشريط الجانبي، التقارير، الطباعة...).</p>

                <input type="hidden" asp-for="SelectedPreset" />

                <div class="ui-grid ui-grid-4 gap-2 mb-4">
                    @foreach (var preset in Model.Presets)
                    {
                        <div>
                            <label class="preset-card @(Model.SelectedPreset == preset.Id ? "selected" : "")">
                                <input type="radio" name="presetRadio" value="@preset.Id"
                                       class="hidden"
                                       data-primary="@preset.Primary"
                                       data-accent="@preset.Accent"
                                       data-sidebar="@preset.SidebarBg"
                                       data-page="@preset.PageBg"
                                       @(Model.SelectedPreset == preset.Id ? "checked" : "") />
                                <span class="preset-name">@preset.NameAr</span>
                                <span class="preset-swatches" aria-hidden="true">
                                    <span style="background:@preset.Primary"></span>
                                    <span style="background:@preset.Accent"></span>
                                    <span style="background:@preset.SidebarBg"></span>
                                    <span style="background:@preset.PageBg"></span>
                                </span>
                            </label>
                        </div>
                    }
                    @if (string.IsNullOrEmpty(Model.SelectedPreset))
                    {
                        <div style="grid-column: 1 / -1;">
                            <div class="form-check">
                                <input type="radio" name="presetRadio" value="" id="presetCustom" class="form-check-input" checked />
                                <label class="form-check-label" for="presetCustom">ألوان مخصصة</label>
                            </div>
                        </div>
                    }
                </div>

                <div class="ui-grid ui-grid-4 gap-3 mb-4">
                    <div>
                        <label class="form-label" for="PrimaryHex">اللون الأساسي</label>
                        <div class="input-group">
                            <input asp-for="Primary" type="color" class="form-control" title="اللون الأساسي" aria-hidden="true" tabindex="-1" />
                            <input id="PrimaryHex" name="Primary" type="text" class="form-control ui-input" placeholder="#1570ef" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label" for="AccentHex">لون التمييز</label>
                        <div class="input-group">
                            <input asp-for="Accent" type="color" class="form-control" title="لون التمييز" aria-hidden="true" tabindex="-1" />
                            <input id="AccentHex" name="Accent" type="text" class="form-control ui-input" placeholder="#53b1fd" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label" for="SidebarBgHex">لون الشريط الجانبي</label>
                        <div class="input-group">
                            <input asp-for="SidebarBg" type="color" class="form-control" title="لون الشريط الجانبي" aria-hidden="true" tabindex="-1" />
                            <input id="SidebarBgHex" name="SidebarBg" type="text" class="form-control ui-input" placeholder="#0d1b35" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label" for="PageBgHex">لون خلفية الصفحات</label>
                        <div class="input-group">
                            <input asp-for="PageBg" type="color" class="form-control" title="لون خلفية الصفحات" aria-hidden="true" tabindex="-1" />
                            <input id="PageBgHex" name="PageBg" type="text" class="form-control ui-input" placeholder="#f8f8fa" />
                        </div>
                    </div>
                </div>

                <div class="border border-line rounded-lg overflow-hidden">
                    <div class="flex" id="themePreview">
                        <div class="p-3 flex-grow" id="prevPage" style="background:var(--color-bg-page);" role="img" aria-label="معاينة لوحة الألوان">
                            <span class="badge rounded-pill" id="prevPrimary" style="background:var(--color-primary);color:var(--fg-on-accent);">زر أساسي</span>
                            <span class="badge rounded-pill" id="prevAccent" style="background:var(--color-gold);color:var(--color-code-on-primary);">لمسة سماوية</span>
                            <div class="rounded-md p-2 mt-2 small" id="prevSidebar" style="background:var(--color-sidebar-bg);color:var(--color-sidebar-text);border:1px solid var(--color-sidebar-hairline);">شريط جانبي — نص</div>
                        </div>
                    </div>
                    <div class="bg-[var(--color-bg-page)] border-t border-line small text-muted p-2">معاينة حية — احرص على تباين مناسب للنصوص (4.5:1 على الأقل).</div>
                </div>
            </div>
            <div class="card-footer text-end">
                <button type="submit" class="ui-btn ui-btn-pri"><i class="bi bi-check-circle" aria-hidden="true"></i> حفظ العلامة التجارية</button>
            </div>
        </div>
    </div>
</form>

<script nonce="@Context.GetCspNonce()">
    (function () {
        function isLight(hex) {
            var c = hex.replace('#', '');
            if (c.length === 3) c = c[0] + c[0] + c[1] + c[1] + c[2] + c[2];
            var r = parseInt(c.slice(0, 2), 16) / 255, g = parseInt(c.slice(2, 4), 16) / 255, b = parseInt(c.slice(4, 6), 16) / 255;
            function lin(v) { return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); }
            return (0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b)) > 0.55;
        }
        function contrastTextOn(hex) {
            var c = hex.replace('#', '');
            if (c.length === 3) c = c[0] + c[0] + c[1] + c[1] + c[2] + c[2];
            var r = parseInt(c.slice(0, 2), 16) / 255, g = parseInt(c.slice(2, 4), 16) / 255, b = parseInt(c.slice(4, 6), 16) / 255;
            function lin(v) { return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); }
            function lum(x) { return 0.2126 * lin(x[0]) + 0.7152 * lin(x[1]) + 0.0722 * lin(x[2]); }
            var l = lum([r, g, b]);
            function ratio(a, c2) { var hi = Math.max(a, c2), lo = Math.min(a, c2); return (hi + 0.05) / (lo + 0.05); }
            var darkInk = { c: '#0d1b35', l: lum([13 / 255, 27 / 255, 53 / 255]) };
            var whiteInk = { c: '#ffffff', l: 1 };
            var rd = ratio(l, darkInk.l), rw = ratio(l, whiteInk.l);
            if (rd >= 4.5) return darkInk.c;
            if (rw >= 4.5) return whiteInk.c;
            return rd >= rw ? darkInk.c : whiteInk.c;
        }
        function pick(el) { return document.getElementById(el); }
        var primary = pick('Primary'), accent = pick('Accent'), sidebar = pick('SidebarBg'), page = pick('PageBg');
        function syncTextFromColor(colorEl, textEl) {
            textEl.value = colorEl.value;
        }
        function apply() {
            var p = primary.value, a = accent.value, s = sidebar.value;
            document.getElementById('prevPrimary').style.background = p;
            document.getElementById('prevPrimary').style.color = contrastTextOn(p);
            document.getElementById('prevAccent').style.background = a;
            document.getElementById('prevAccent').style.color = contrastTextOn(a);
            document.getElementById('prevSidebar').style.background = s;
            document.getElementById('prevSidebar').style.color = isLight(s) ? '#0e1620' : '#cbd5e1';
            document.getElementById('prevPage').style.background = page.value;
        }
        function wire(el) {
            var color = el.parentElement.querySelector('input[type=color]');
            var text = el.parentElement.querySelector('input[type=text]');
            if (!color || !text) { apply(); return; }
            syncTextFromColor(color, text);
            color.addEventListener('input', function () { syncTextFromColor(color, text); apply(); });
            text.addEventListener('input', function () { if (/^#[0-9a-fA-F]{6}$/.test(text.value)) { color.value = text.value; apply(); } });
        }
        [primary, accent, sidebar, page].forEach(wire);
        document.querySelectorAll('input[name="presetRadio"]').forEach(function (r) {
            r.addEventListener('change', function () {
                if (!r.checked) return;
                document.getElementById('SelectedPreset').value = r.value || '';
                if (!r.value) return;
                primary.value = r.dataset.primary; accent.value = r.dataset.accent;
                sidebar.value = r.dataset.sidebar; page.value = r.dataset.page;
                [primary, accent, sidebar, page].forEach(wire);
                document.querySelectorAll('.preset-card').forEach(function (c) { c.classList.toggle('selected', c.querySelector('input').checked); });
            });
        });
        apply();
    })();
</script>
