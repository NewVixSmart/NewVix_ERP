@model List<(NewVixSmart.Web.Models.Accounting.BudgetYear Year, int LineCount, bool FiscalClosed)>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "الميزانيات السنوية"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المحاسبة</span>
        <h2><i class="bi bi-calendar3" aria-hidden="true"></i> الميزانيات السنوية</h2>
    </div>
    @if (await Perm.HasAsync("Budgets.Manage"))
    {
        <form method="post" asp-action="Create" class="ui-pagehead-actions flex flex-wrap items-center gap-2">
            @Html.AntiForgeryToken()
            <label class="visually-hidden" for="budgetYear">السنة</label>
            <input type="number" name="year" min="2000" max="2100" value="@DateTime.Today.Year" id="budgetYear" class="ui-input" dir="ltr" style="max-width:140px" />
            <button type="submit" class="ui-btn ui-btn-pri"><i class="bi bi-plus-lg" aria-hidden="true"></i> ميزانية جديدة</button>
        </form>
    }
</div>

<div class="ui-section table-container ui-rise">
    <table class="table">
        <caption class="visually-hidden">الميزانيات السنوية</caption>
        <thead>
            <tr>
                <th scope="col">السنة</th>
                <th scope="col">عدد بنود الميزانية</th>
                <th scope="col">الحالة</th>
                <th scope="col">الإقفال المالي</th>
                <th scope="col" class="text-center">إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (y, lineCount, fiscalClosed) in Model)
            {
                <tr>
                    <td><strong>@y.Year</strong></td>
                    <td class="num">@lineCount</td>
                    <td>
                        @if (y.IsActive)
                        { <span class="ui-badge ui-badge-ok">نشط</span> }
                        else
                        { <span class="ui-badge ui-badge-bad">غير نشط</span> }
                    </td>
                    <td>
                        @if (fiscalClosed)
                        { <span class="ui-badge ui-badge-bad">مغلقة — للعرض فقط</span> }
                        else
                        { <span class="ui-badge ui-badge-ok">مفتوحة</span> }
                    </td>
                    <td class="text-center">
                        <div class="flex flex-wrap items-center justify-center gap-1">
                            @if (await Perm.HasAsync("Budgets.Manage"))
                            {
                                <a asp-action="Manage" asp-route-year="@y.Year" class="ui-btn ui-btn-sm ui-btn-outline"><i class="bi bi-pencil" aria-hidden="true"></i> إدارة</a>
                                <form asp-action="ToggleActive" asp-route-id="@y.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="ui-btn ui-btn-sm ui-btn-ghost" aria-label="@(y.IsActive ? "إلغاء تنشيط ميزانية " + y.Year : "تنشيط ميزانية " + y.Year)">
                                        <i class="bi @(y.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-4">لا توجد ميزانيات بعد</td></tr>
            }
        </tbody>
    </table>
</div>
