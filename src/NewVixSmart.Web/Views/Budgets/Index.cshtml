@model List<(NewVixSmart.Web.Models.Accounting.BudgetYear Year, int LineCount, bool FiscalClosed)>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "الميزانيات السنوية"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-calendar3 text-primary" aria-hidden="true"></i> الميزانيات السنوية</h2>
    @if (await Perm.HasAsync("Budgets.Manage"))
    {
        <form method="post" asp-action="Create" class="d-flex gap-2">
            @Html.AntiForgeryToken()
            <label class="visually-hidden" for="budgetYear">السنة</label>
            <input type="number" name="year" min="2000" max="2100" value="@DateTime.Today.Year" id="budgetYear" class="form-control" style="max-width:140px" />
            <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> ميزانية جديدة</button>
        </form>
    }
</div>

<div class="table-container">
    <table class="table table-hover mb-0">
        <caption class="visually-hidden">الميزانيات السنوية</caption>
        <thead>
            <tr>
                <th scope="col">السنة</th>
                <th scope="col">عدد بنود الميزانية</th>
                <th scope="col">الحالة</th>
                <th scope="col">الإقفال المالي</th>
                <th scope="col" class="text-center">إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var (y, lineCount, fiscalClosed) in Model)
            {
                <tr>
                    <td><strong>@y.Year</strong></td>
                    <td>@lineCount</td>
                    <td>
                        @if (y.IsActive)
                        { <span class="badge-stock-ok px-2 py-1 rounded">نشط</span> }
                        else
                        { <span class="badge-stock-low px-2 py-1 rounded">غير نشط</span> }
                    </td>
                    <td>
                        @if (fiscalClosed)
                        { <span class="badge-stock-low px-2 py-1 rounded">مغلقة — للعرض فقط</span> }
                        else
                        { <span class="badge-stock-ok px-2 py-1 rounded">مفتوحة</span> }
                    </td>
                    <td class="text-center d-flex gap-1 justify-content-center">
                        @if (await Perm.HasAsync("Budgets.Manage"))
                        {
                            <a asp-action="Manage" asp-route-year="@y.Year" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil" aria-hidden="true"></i> إدارة</a>
                            <form asp-action="ToggleActive" asp-route-id="@y.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary" aria-label="@(y.IsActive ? "إلغاء تنشيط ميزانية " + y.Year : "تنشيط ميزانية " + y.Year)">
                                    <i class="bi @(y.IsActive ? "bi-pause-circle" : "bi-play-circle")" aria-hidden="true"></i>
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted py-4">لا توجد ميزانيات بعد</td></tr>
            }
        </tbody>
    </table>
</div>
