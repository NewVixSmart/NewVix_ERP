@model List<NewVixSmart.Web.Controllers.BudgetLineVm>
@{ ViewData["Title"] = $"إدارة ميزانية سنة {ViewBag.Year}"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المحاسبة</span>
        <h2><i class="bi bi-pencil-square" aria-hidden="true"></i> إدارة ميزانية سنة @ViewBag.Year</h2>
    </div>
    <div class="ui-pagehead-actions">
        <a asp-action="Index" class="ui-btn ui-btn-ghost"><i class="bi bi-arrow-right" aria-hidden="true"></i> عودة</a>
    </div>
</div>

@if (ViewBag.FiscalClosed == true)
{
    <div class="ui-alert ui-alert-warn ui-rise">السنة المالية @ViewBag.Year مغلقة — يمكنك عرض الميزانية فقط، ولا يمكن تعديلها.</div>
}
@if (!Model.Any())
{
    <div class="ui-alert ui-alert-info ui-rise">لا توجد حسابات P&amp;L نشطة قابلة للميزنة.</div>
}

<form asp-action="Manage" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="year" value="@ViewBag.Year" />
    <div class="ui-section table-container ui-rise">
        <table class="table">
            <caption class="visually-hidden">بنود الميزانية</caption>
            <thead>
                <tr>
                    <th scope="col">الرمز</th>
                    <th scope="col">اسم الحساب</th>
                    <th scope="col">النوع</th>
                    <th scope="col" style="width:220px">المبلغ السنوي</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Count; i++)
                {
                    <tr>
                        <td><code>@Model[i].Code</code></td>
                        <td><strong>@Model[i].Name</strong></td>
                        <td>@Model[i].Type.ToString()</td>
                        <td>
                            <input type="hidden" name="lines[@i].AccountId" value="@Model[i].AccountId" />
                            <input type="hidden" name="lines[@i].Code" value="@Model[i].Code" />
                            <input type="hidden" name="lines[@i].Name" value="@Model[i].Name" />
                            <input type="hidden" name="lines[@i].Type" value="@((int)Model[i].Type)" />
                            @if (Model[i].RowVersion is { Length: > 0 } budgetLineRv)
                            {
                                <input type="hidden" name="lines[@i].RowVersion" value="@Convert.ToBase64String(budgetLineRv)" />
                            }
                            <input type="number" name="lines[@i].AnnualAmount" value="@Model[i].AnnualAmount" step="0.01" min="0"
                                   class="ui-input" dir="ltr" aria-label="المبلغ السنوي لحساب @Model[i].Name" @(ViewBag.FiscalClosed == true ? "disabled" : "") />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (ViewBag.FiscalClosed != true && Model.Any())
    {
        <div class="ui-form-actions">
            <button type="submit" class="ui-btn ui-btn-pri"><i class="bi bi-check-lg" aria-hidden="true"></i> حفظ الميزانية</button>
        </div>
    }
</form>
