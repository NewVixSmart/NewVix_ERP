@model NewVixSmart.Web.Models.Purchases.PurchaseInvoice
@{ ViewData["Title"] = $"تفاصيل فاتورة شراء {Model.InvoiceNumber}"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-eye text-primary"></i> فاتورة شراء: @Model.InvoiceNumber</h2>
    <div class="d-flex gap-2">
        <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" rel="noopener noreferrer" class="btn btn-outline-success"><i class="bi bi-printer"></i> طباعة الفاتورة</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> رجوع</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3"><strong>المورد:</strong> @(Model.Supplier?.Name ?? "—")</div>
            <div class="col-md-3"><strong>التاريخ:</strong> @Model.InvoiceDate.ToString("dd/MM/yyyy")</div>
            <div class="col-md-3"><strong>رقم طلب الشراء:</strong> @(Model.OrderReference ?? "—")</div>
            <div class="col-md-3"><strong>الحالة:</strong> @(Model.IsPaid ? "مدفوعة" : "غير مدفوعة")</div>
        </div>
        <div class="row mt-2">
            <div class="col-md-3"><strong>أنشأها:</strong> @(Model.CreatedBy ?? "—")</div>
            <div class="col-md-3"><strong>شروط الدفع:</strong> @Model.PaymentTerms.GetDisplayName()</div>
            <div class="col-md-3"><strong>تاريخ الاستحقاق:</strong> @(Model.DueDate?.ToString("dd/MM/yyyy") ?? "—")</div>
        </div>
    </div>
</div>

<div class="table-container mb-4">
    <table class="table mb-0">
        <caption class="visually-hidden">أصناف فاتورة الشراء: الصنف، العدد، الكمية، سعر الوحدة، الإجمالي، الخصم</caption>
        <thead><tr><th scope="col">الصنف</th><th scope="col">العدد</th><th scope="col">الكمية</th><th scope="col">سعر الوحدة</th><th scope="col">الإجمالي</th><th scope="col">الخصم</th></tr></thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Item.Name</td>
                    <td>@item.Count</td>
                    <td>@item.Quantity</td>
                    <td>@Money.Format(item.UnitPrice)</td>
                    <td class="fw-bold">@Money.Format(item.Total)</td>
                    <td>@Money.Format(item.Discount)</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="row g-3">
    <div class="col-md-3"><div class="card text-center"><div class="card-body"><div class="text-muted small">الإجمالي</div><h4>@Money.Format(Model.TotalAmount)</h4></div></div></div>
    <div class="col-md-3"><div class="card text-center"><div class="card-body"><div class="text-muted small">الخصم</div><h4 class="text-danger">@Money.Format(Model.Discount)</h4></div></div></div>
    <div class="col-md-3"><div class="card text-center"><div class="card-body"><div class="text-muted small">الضريبة</div><h4>@Money.Format(Model.Tax)</h4></div></div></div>
    <div class="col-md-3"><div class="card text-center bg-primary text-white"><div class="card-body"><div class="small">الصافي</div><h4>@Money.Format(Model.NetAmount)</h4></div></div></div>
</div>
