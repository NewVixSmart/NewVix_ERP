@model IReadOnlyList<NewVixSmart.Web.Models.Purchases.PurchaseOrder>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@using NewVixSmart.Web.Models.Purchases
@{ ViewData["Title"] = "أوامر الشراء"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المشتريات</span>
        <h2><i class="bi bi-clipboard-check text-primary" aria-hidden="true"></i> أوامر الشراء</h2>
    </div>
    @if (await Perm.HasAsync("PurchaseOrders.Create"))
    {
        <div class="ui-pagehead-actions">
            <a asp-action="Create" class="ui-btn ui-btn-pri"><i class="bi bi-plus-lg" aria-hidden="true"></i> أمر شراء جديد</a>
        </div>
    }
</div>

<div class="ui-section ui-card ui-rise">
    <div class="card-body">
        <form method="get" class="flex flex-wrap items-end gap-3">
            <div class="min-w-24 flex-1">
                <label class="visually-hidden" for="statusFilter">الحالة</label>
                <select name="status" id="statusFilter" class="form-select" data-auto-submit>
                    <option value="">كل الحالات</option>
                    @foreach (var s in Enum.GetValues<PurchaseOrderStatus>())
                    {
                        <option value="@((int)s)" selected="@(ViewBag.StatusFilter == s)">@s.GetDisplayName()</option>
                    }
                </select>
            </div>
            <div><button class="ui-btn ui-btn-outline" type="submit"><i class="bi bi-funnel" aria-hidden="true"></i> تصفية</button></div>
        </form>
    </div>
</div>

<div class="table-container ui-rise">
    <table class="table mb-0">
        <caption class="visually-hidden">قائمة أوامر الشراء: رقم الأمر، المورد، التاريخ، المتوقع، الحالة، المستلم</caption>
        <thead><tr><th scope="col">رقم الأمر</th><th scope="col">المورد</th><th scope="col">التاريخ</th><th scope="col">المتوقع</th><th scope="col">الحالة</th><th scope="col">المستلم</th><th scope="col" class="text-center">إجراءات</th></tr></thead>
        <tbody>
            @foreach (var order in Model)
            {
                var t = OrderProgress.Summarize(order);
                <tr>
                    <td><code>@order.OrderNumber</code></td>
                    <td>@(order.Supplier?.Name ?? "—")</td>
                    <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                    <td>@(order.ExpectedDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                    <td><span class="ui-badge @(order.Status switch { PurchaseOrderStatus.Approved => "ui-badge-ok", PurchaseOrderStatus.Received => "ui-badge-info", PurchaseOrderStatus.PartiallyReceived => "ui-badge-warn", PurchaseOrderStatus.Cancelled => "ui-badge-bad", _ => "ui-badge-mute" })">@order.Status.GetDisplayName()</span></td>
                    <td>@t.ReceivedQuantity.ToString("N0") / @t.OrderedQuantity.ToString("N0")</td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@order.PublicId" class="ui-btn ui-btn-sm ui-btn-outline" aria-label="عرض أمر الشراء @order.OrderNumber"><i class="bi bi-eye" aria-hidden="true"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
