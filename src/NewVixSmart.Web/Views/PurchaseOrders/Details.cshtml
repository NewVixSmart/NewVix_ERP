@model NewVixSmart.Web.Models.Purchases.PurchaseOrder
@inject NewVixSmart.Web.Services.IPermissionService Perm
@using NewVixSmart.Web.Models.Purchases
@{ ViewData["Title"] = $"أمر شراء {Model.OrderNumber}"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-eye text-primary"></i> أمر شراء: @Model.OrderNumber</h2>
    <div class="d-flex gap-2">
        @if (await Perm.HasAsync("PurchaseOrders.Approve") && Model.Status == PurchaseOrderStatus.Draft)
        {
            <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle"></i> اعتماد</button>
            </form>
        }
        @if (await Perm.HasAsync("PurchaseOrders.Receive") && (Model.Status == PurchaseOrderStatus.Approved || Model.Status == PurchaseOrderStatus.PartiallyReceived))
        {
            <a asp-action="Receive" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-box-arrow-in-down"></i> استلام</a>
        }
        @if (await Perm.HasAsync("PurchaseOrders.Receive") && (Model.Status == PurchaseOrderStatus.Approved || Model.Status == PurchaseOrderStatus.PartiallyReceived) && Model.Items.Any(i => i.ReceivedQty > 0 || i.ReceivedCount > 0))
        {
            <form asp-action="CreateInvoice" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-primary"><i class="bi bi-receipt"></i> تحويل إلى فاتورة</button>
            </form>
        }
        @if (await Perm.HasAsync("PurchaseOrders.Edit") && Model.Status == PurchaseOrderStatus.Draft)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i> تعديل</a>
        }
        @if (await Perm.HasAsync("PurchaseOrders.Approve") && Model.Status != PurchaseOrderStatus.Cancelled && Model.Status != PurchaseOrderStatus.Received)
        {
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-circle"></i> إلغاء</button>
            </form>
        }
        <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" rel="noopener" class="btn btn-outline-primary"><i class="bi bi-printer"></i> طباعة</a>
        <a asp-action="Pdf" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-filetype-pdf"></i> تحميل PDF</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> رجوع</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3"><strong>المورد:</strong> @(Model.Supplier?.Name ?? "—")</div>
            <div class="col-md-3"><strong>تاريخ الأمر:</strong> @Model.OrderDate.ToString("dd/MM/yyyy")</div>
            <div class="col-md-3"><strong>المتوقع:</strong> @(Model.ExpectedDate?.ToString("dd/MM/yyyy") ?? "—")</div>
            <div class="col-md-3"><strong>الحالة:</strong> <span class="badge @(Model.Status switch { PurchaseOrderStatus.Approved => "bg-success", PurchaseOrderStatus.Received => "bg-info", PurchaseOrderStatus.PartiallyReceived => "bg-warning", PurchaseOrderStatus.Cancelled => "bg-danger", _ => "bg-secondary" })">@Model.Status.GetDisplayName()</span></div>
        </div>
        <div class="row mt-2">
            <div class="col-md-3"><strong>أنشأها:</strong> @(Model.CreatedBy ?? "—")</div>
            <div class="col-md-6"><strong>ملاحظات:</strong> @(Model.Notes ?? "—")</div>
        </div>
    </div>
</div>

<div class="table-container mb-4">
    <table class="table mb-0">
        <thead><tr><th scope="col">الصنف</th><th>العدد المطلوب</th><th>الكمية المطلوبة</th><th>سعر الوحدة</th><th>الإجمالي</th><th>المستلم عدد</th><th>المستلم كمية</th></tr></thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Item.Name</td>
                    <td>@item.Count</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("N2")</td>
                    <td class="fw-bold">@item.Total.ToString("N2")</td>
                    <td>@item.ReceivedCount</td>
                    <td>@item.ReceivedQty</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="row g-3">
    <div class="col-md-4"><div class="card text-center"><div class="card-body"><div class="text-muted small">الإجمالي</div><h4>@Model.Items.Sum(i => i.Total).ToString("N2")</h4></div></div></div>
</div>
