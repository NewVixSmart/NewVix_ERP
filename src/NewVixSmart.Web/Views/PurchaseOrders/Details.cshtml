@model NewVixSmart.Web.Models.Purchases.PurchaseOrder
@inject NewVixSmart.Web.Services.IPermissionService Perm
@using NewVixSmart.Web.Models.Purchases
@{ ViewData["Title"] = $"أمر شراء {Model.OrderNumber}"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المشتريات</span>
        <h2><i class="bi bi-eye text-primary" aria-hidden="true"></i> أمر شراء: @Model.OrderNumber</h2>
    </div>
    <div class="ui-pagehead-actions">
        @if (await Perm.HasAsync("PurchaseOrders.Approve") && Model.Status == PurchaseOrderStatus.Draft)
        {
            <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="inline-flex">
                <button type="submit" class="ui-btn ui-btn-ok"><i class="bi bi-check2-circle" aria-hidden="true"></i> اعتماد</button>
            </form>
        }
        @if (await Perm.HasAsync("PurchaseOrders.Receive") && (Model.Status == PurchaseOrderStatus.Approved || Model.Status == PurchaseOrderStatus.PartiallyReceived))
        {
            <a asp-action="Receive" asp-route-id="@Model.Id" class="ui-btn ui-btn-pri"><i class="bi bi-box-arrow-in-down" aria-hidden="true"></i> استلام</a>
        }
        @if (await Perm.HasAsync("PurchaseOrders.Receive") && (Model.Status == PurchaseOrderStatus.Approved || Model.Status == PurchaseOrderStatus.PartiallyReceived) && OrderProgress.HasReceived(Model))
        {
            <form asp-action="CreateInvoice" asp-route-id="@Model.Id" method="post" class="inline-flex">
                <button type="submit" class="ui-btn ui-btn-outline"><i class="bi bi-receipt" aria-hidden="true"></i> تحويل إلى فاتورة</button>
            </form>
        }
        @if (await Perm.HasAsync("PurchaseOrders.Edit") && Model.Status == PurchaseOrderStatus.Draft)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="ui-btn ui-btn-quiet"><i class="bi bi-pencil" aria-hidden="true"></i> تعديل</a>
        }
        @if (await Perm.HasAsync("PurchaseOrders.Approve") && Model.Status != PurchaseOrderStatus.Cancelled && Model.Status != PurchaseOrderStatus.Received)
        {
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="inline-flex">
                <button type="submit" class="ui-btn ui-btn-danger"><i class="bi bi-x-circle" aria-hidden="true"></i> إلغاء</button>
            </form>
        }
        <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" rel="noopener" class="ui-btn ui-btn-quiet"><i class="bi bi-printer" aria-hidden="true"></i> طباعة</a>
        <a asp-action="Pdf" asp-route-id="@Model.Id" class="ui-btn ui-btn-quiet"><i class="bi bi-filetype-pdf" aria-hidden="true"></i> تحميل PDF</a>
        <a asp-action="Index" class="ui-btn ui-btn-quiet"><i class="bi bi-arrow-right" aria-hidden="true"></i> رجوع</a>
    </div>
</div>

<div class="ui-section ui-card ui-rise">
    <div class="card-body">
        <div class="ui-grid ui-grid-4 gap-3">
            <div><strong>المورد:</strong> @(Model.Supplier?.Name ?? "—")</div>
            <div><strong>تاريخ الأمر:</strong> @Model.OrderDate.ToString("dd/MM/yyyy")</div>
            <div><strong>المتوقع:</strong> @(Model.ExpectedDate?.ToString("dd/MM/yyyy") ?? "—")</div>
            <div><strong>الحالة:</strong> <span class="ui-badge @(Model.Status switch { PurchaseOrderStatus.Approved => "ui-badge-ok", PurchaseOrderStatus.Received => "ui-badge-info", PurchaseOrderStatus.PartiallyReceived => "ui-badge-warn", PurchaseOrderStatus.Cancelled => "ui-badge-bad", _ => "ui-badge-mute" })">@Model.Status.GetDisplayName()</span></div>
        </div>
        <div class="ui-grid ui-grid-4 gap-3 mt-3">
            <div><strong>أنشأها:</strong> @(Model.CreatedBy ?? "—")</div>
            <div class="md:col-span-2"><strong>ملاحظات:</strong> @(Model.Notes ?? "—")</div>
        </div>
    </div>
</div>

<div class="ui-section table-container ui-rise">
    <table class="table mb-0">
        <caption class="visually-hidden">أصناف أمر الشراء: الصنف، العدد المطلوب، الكمية المطلوبة، سعر الوحدة، الإجمالي، المستلم عدد، المستلم كمية</caption>
        <thead><tr><th scope="col">الصنف</th><th scope="col">العدد المطلوب</th><th scope="col">الكمية المطلوبة</th><th scope="col">سعر الوحدة</th><th scope="col">الإجمالي</th><th scope="col">المستلم عدد</th><th scope="col">المستلم كمية</th></tr></thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Item.Name</td>
                    <td>@item.Count</td>
                    <td>@item.Quantity</td>
                    <td>@Money.Format(item.UnitPrice)</td>
                    <td class="fw-bold">@Money.Format(item.Total)</td>
                    <td>@item.ReceivedCount</td>
                    <td>@item.ReceivedQty</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="ui-section ui-grid ui-grid-3 gap-3 ui-rise">
    <div class="ui-card text-center">
        <div class="card-body">
            <div class="ui-stat-label">الإجمالي</div>
            <div class="ui-stat-value num">@Money.Format(OrderProgress.Summarize(Model).Total)</div>
        </div>
    </div>
</div>
