@model NewVixSmart.Web.ViewModels.Batch.BatchIndexViewModel
@{
    ViewData["Title"] = "العمليات الجماعية";
}

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">العمليات الجماعية</span>
        <h2><i class="bi bi-collection" aria-hidden="true"></i> العمليات الجماعية</h2>
    </div>
</div>

<div class="ui-grid ui-grid-2 mb-4">
    <div class="ui-card ui-rise">
        <div class="ui-card-body text-center">
            <h3 class="ui-card-title"><i class="bi bi-receipt" aria-hidden="true"></i> مبيعات جماعية</h3>
            <p class="text-muted small">أنشئ عدة فواتير بيع في طلب واحد — لكل فاتورة نصف دفع، بنفس شروط الدفع وبالجنيه المصري.</p>
            <a asp-action="Sales" class="ui-btn ui-btn-pri">فاتورة بيع جماعية جديدة</a>
        </div>
    </div>
    <div class="ui-card ui-rise">
        <div class="ui-card-body text-center">
            <h3 class="ui-card-title"><i class="bi bi-clipboard-check" aria-hidden="true"></i> جرد جماعي</h3>
            <p class="text-muted">جرد عدة أصناف دفعة واحدة — أدخل العدد والكمية الجديدة واعرض الفرق قبل الحفظ.</p>
            <a asp-action="Adjustment" class="ui-btn ui-btn-ok">جرد جماعي جديد</a>
        </div>
    </div>
</div>

<div class="ui-grid ui-grid-2">
    <div class="ui-card ui-rise">
        <div class="ui-card-head"><i class="bi bi-receipt" aria-hidden="true"></i> آخر فواتير البيع</div>
        <div class="table-container" style="max-height:none;border:0;border-radius:0">
            @if (Model.RecentSales.Any())
            {
                <table class="table">
                    <caption class="visually-hidden">آخر فواتير البيع: الرقم، العميل، التاريخ، الصافي</caption>
                    <thead>
                        <tr><th scope="col">الرقم</th><th scope="col">العميل</th><th scope="col">التاريخ</th><th scope="col" class="text-start">الصافي</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.RecentSales)
                        {
                            <tr>
                                <td class="fw-bold">@s.InvoiceNumber</td>
                                <td>@(s.Customer?.Name ?? "—")</td>
                                <td class="small num">@s.InvoiceDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-start num">@Money.Format(s.NetAmount)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted small p-3 mb-0"><i class="bi bi-info-circle" aria-hidden="true"></i> لا توجد فواتير بيع بعد.</p>
            }
        </div>
    </div>
    <div class="ui-card ui-rise">
        <div class="ui-card-head"><i class="bi bi-clipboard-data" aria-hidden="true"></i> آخر حركات الجرد</div>
        <div class="table-container" style="max-height:none;border:0;border-radius:0">
            @if (Model.RecentAdjustments.Any())
            {
                <table class="table">
                    <caption class="visually-hidden">آخر حركات الجرد: المرجع، الصنف، التاريخ، عدد / كمية</caption>
                    <thead>
                        <tr><th scope="col">المرجع</th><th scope="col">الصنف</th><th scope="col">التاريخ</th><th scope="col" class="text-start">عدد / كمية</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.RecentAdjustments)
                        {
                            <tr>
                                <td class="fw-bold">@a.ReferenceNumber</td>
                                <td>@(a.Item?.Name ?? "—")</td>
                                <td class="small num">@a.AdjustmentDate.ToString("yyyy-MM-dd")</td>
                                <td class="text-start num">@a.NewCount.ToString("N2") / @a.NewQuantity.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted small p-3 mb-0"><i class="bi bi-info-circle" aria-hidden="true"></i> لا توجد حركات جرد بعد.</p>
            }
        </div>
    </div>
</div>
