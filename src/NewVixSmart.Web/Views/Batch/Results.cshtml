@model NewVixSmart.Web.ViewModels.Batch.BatchResultsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">العمليات الجماعية</span>
        <h2><i class="bi bi-clipboard-check" aria-hidden="true"></i> @Model.Title</h2>
    </div>
</div>

<div class="ui-alert @(Model.FailCount == 0 ? "ui-alert-ok" : "ui-alert-warn") ui-rise flex-wrap items-center justify-between gap-3" role="status">
    <div>
        <strong>نجحت @Model.SuccessCount</strong> من أصل <strong>@Model.Results.Count</strong> عملية
        @if (Model.FailCount > 0)
        {
            <span class="ms-2 text-danger">— فشلت @Model.FailCount</span>
        }
    </div>
    <a asp-controller="Batch" asp-action="@Model.BackAction" class="ui-btn ui-btn-sm ui-btn-quiet">
        <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> عملية جديدة
    </a>
</div>

<div class="ui-section ui-card ui-rise">
    <div class="table-container" style="max-height:none;border:0;border-radius:0">
        <table class="table">
            <caption class="visually-hidden">نتائج العملية: رقم السطر، نوع المستند، رقم المستند، الحالة، الخطأ أو الملاحظة</caption>
            <thead>
                <tr>
                    <th scope="col" style="width:8%">#</th>
                    <th scope="col" style="width:20%">نوع المستند</th>
                    <th scope="col" style="width:25%">رقم المستند</th>
                    <th scope="col" style="width:15%">الحالة</th>
                    <th scope="col">الخطأ / ملاحظة</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Results)
                {
                    <tr>
                        <td class="num">@r.Sequence</td>
                        <td>@r.DocType</td>
                        <td class="fw-bold">@(r.DocumentNumber ?? "—")</td>
                        <td>
                            @if (r.Success)
                            {
                                <span class="ui-badge ui-badge-ok">نجحت</span>
                            }
                            else
                            {
                                <span class="ui-badge ui-badge-bad">فشلت</span>
                            }
                        </td>
                        <td class="small">@(r.Error ?? "تم الترحيل بنجاح")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
