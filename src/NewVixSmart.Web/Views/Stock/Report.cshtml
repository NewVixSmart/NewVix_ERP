@model NewVixSmart.Web.ViewModels.Stock.StockReportViewModel
@{
    ViewData["Title"] = "تقرير المخزون الكامل";
}

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المخزون</span>
        <h2><i class="bi bi-clipboard2-data" aria-hidden="true"></i> تقرير المخزون الكامل</h2>
    </div>
    <div class="ui-pagehead-actions">
        <a asp-controller="Reports" asp-action="ExportItemsXlsx" class="ui-btn ui-btn-ok"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> تصدير الأصناف</a>
        <a asp-controller="Reports" asp-action="ExportStockXlsx" class="ui-btn ui-btn-outline"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> لقطة المخزون</a>
    </div>
</div>

<div class="ui-section ui-card ui-rise">
    <div class="card-body">
        <form method="get" class="ui-grid ui-grid-3 items-end">
            <div>
                <label class="form-label" for="categoryFilter">التصنيف</label>
                <select name="categoryId" id="categoryFilter" class="form-select">
                    <option value="">الكل</option>
                    @foreach (var c in Model.Categories)
                    { <option value="@c.Id" selected="@(Model.CategoryId?.ToString() == c.Id.ToString())">@c.Name</option> }
                </select>
            </div>
            <div>
                <div class="form-check">
                    <input type="checkbox" name="lowOnly" value="true" class="form-check-input" id="lowOnly" checked="@(Model.LowOnly)" />
                    <label class="form-check-label" for="lowOnly">فقط المخزون المنخفض</label>
                </div>
            </div>
            <div><button type="submit" class="ui-btn ui-btn-outline w-full"><i class="bi bi-search" aria-hidden="true"></i> تصفية</button></div>
        </form>
    </div>
</div>

<div class="ui-grid ui-grid-4 mb-4 ui-rise">
    <div class="ui-stat">
        <span class="ui-stat-label">عدد الأصناف</span>
        <span class="ui-stat-value">@Model.TotalItems</span>
    </div>
    <div class="ui-stat">
        <span class="ui-stat-label">أصناف منخفضة</span>
        <span class="ui-stat-value text-danger">@Model.LowItems</span>
    </div>
    <div class="ui-stat">
        <span class="ui-stat-label">إجمالي الكمية</span>
        <span class="ui-stat-value">@Model.TotalQuantity.ToString("N2")</span>
    </div>
    <div class="ui-stat">
        <span class="ui-stat-label">قيمة المخزون (بسعر الشراء)</span>
        <span class="ui-stat-value text-success">@Money.Format(Model.TotalValue)</span>
    </div>
</div>

<div class="table-container ui-rise">
    <table class="table">
        <caption class="visually-hidden">تقرير المخزون: رصيد كل صنف وحدوده الدنيا وقيمته بسعر الشراء</caption>
        <thead><tr><th scope="col">الكود</th><th scope="col">الصنف</th><th scope="col">النوع</th><th scope="col">التصنيف</th><th scope="col">الرصيد الحالي</th><th scope="col">الحد الأدنى</th><th scope="col">الحالة</th><th scope="col">القيمة</th></tr></thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                bool low = (item.CurrentCount <= item.MinCount && item.MinCount > 0) || (item.CurrentQuantity <= item.MinQuantity && item.MinQuantity > 0);
                <tr>
                    <td><code>@(item.Code ?? "—")</code></td>
                    <td><strong>@item.Name</strong></td>
                    <td>
                        <span class="ui-badge ui-badge-info">@(item.ItemType?.Name ?? "—")</span>
                    </td>
                    <td><span class="ui-badge ui-badge-mute">@item.Category.Name</span></td>
                    <td>
                        <span class="num">@item.CurrentCount.ToString("N2")</span> @(item.CountUnit?.ShortName ?? item.CountUnit?.Name ?? "")<br/>
                        <small class="text-muted"><span class="num">@item.CurrentQuantity.ToString("N2")</span> @(item.QuantityUnit?.ShortName ?? item.QuantityUnit?.Name ?? "")</small>
                    </td>
                    <td>
                        <span class="num">@item.MinCount.ToString("N2")</span><br/>
                        <small class="text-muted"><span class="num">@item.MinQuantity.ToString("N2")</span></small>
                    </td>
                    <td>
                        @if (low)
                        { <span class="ui-badge ui-badge-bad">منخفض</span> }
                        else
                        { <span class="ui-badge ui-badge-ok">كافٍ</span> }
                    </td>
                    <td class="fw-bold num">@(Money.Format((item.QuantityUnitId.HasValue || item.CurrentQuantity > 0) ? item.CurrentQuantity * item.PurchasePrice : item.CurrentCount * item.PurchasePrice))</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Items.Any())
{
    <div class="empty-state ui-rise">
        <div class="empty-icon"><i class="bi bi-inbox" aria-hidden="true"></i></div>
        <strong>لا توجد أصناف مطابقة</strong>
    </div>
}
