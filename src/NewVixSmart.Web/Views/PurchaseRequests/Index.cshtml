@model IReadOnlyList<NewVixSmart.Web.Models.Purchases.SupplierQuote>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "طلبات عرض سعر"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المشتريات</span>
        <h2><i class="bi bi-envelope-open text-primary" aria-hidden="true"></i> طلبات عرض سعر</h2>
    </div>
    @if (await Perm.HasAsync("PurchaseRequests.Create"))
    {
        <div class="ui-pagehead-actions">
            <a asp-action="Create" class="ui-btn ui-btn-pri"><i class="bi bi-plus-lg" aria-hidden="true"></i> تسجيل عرض سعر</a>
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="ui-section empty-state ui-rise">لا توجد عروض أسعار مسجلة بعد.</div>
}
else
{
    <div class="ui-section table-container ui-rise">
        <table class="table mb-0">
            <caption class="visually-hidden">طلبات عرض السعر المسجلة: المورد، الصنف، سعر الوحدة، التاريخ، ملاحظات</caption>
            <thead><tr><th scope="col">المورد</th><th scope="col">الصنف</th><th scope="col">سعر الوحدة</th><th scope="col">التاريخ</th><th scope="col">ملاحظات</th><th scope="col" class="text-center">إجراءات</th></tr></thead>
            <tbody>
                @foreach (var q in Model)
                {
                    <tr>
                        <td>@q.Supplier.Name</td>
                        <td>@q.Item.Name</td>
                        <td class="num fw-bold">@Money.Format(q.UnitPrice)</td>
                        <td>@q.EffectiveDate.ToString("dd/MM/yyyy")</td>
                        <td>@(q.Notes ?? "—")</td>
                        <td class="text-center">
                            @if (await Perm.HasAsync("PurchaseOrders.Create"))
                            {
                                <a asp-controller="PurchaseOrders" asp-action="Create" asp-route-fromQuoteId="@q.Id" class="ui-btn ui-btn-sm ui-btn-outline"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> تحويل إلى أمر شراء</a>
                            }
                            @if (await Perm.HasAsync("PurchaseRequests.Delete"))
                            {
                                <form asp-action="Remove" asp-route-id="@q.Id" method="post" class="inline-flex" data-confirm-delete>
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="ui-btn ui-btn-sm ui-btn-danger" aria-label="حذف عرض سعر الصنف @q.Item.Name من المورد @q.Supplier.Name"><i class="bi bi-trash" aria-hidden="true"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
<script nonce="@Context.GetCspNonce()">
document.querySelectorAll('form[data-confirm-delete]').forEach(form => {
    form.addEventListener('submit', function(e) {
        if (!confirm('هل أنت متأكد من حذف عرض السعر؟')) {
            e.preventDefault();
        }
    });
});
</script>
}
