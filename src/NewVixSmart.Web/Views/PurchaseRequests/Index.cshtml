@model IReadOnlyList<NewVixSmart.Web.Models.Purchases.SupplierQuote>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "طلبات عرض سعر"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-envelope-open text-primary"></i> طلبات عرض سعر</h2>
    @if (await Perm.HasAsync("PurchaseRequests.Create"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> تسجيل عرض سعر</a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">لا توجد عروض أسعار مسجلة بعد.</div>
}
else
{
    <div class="table-container">
        <table class="table table-hover mb-0">
            <caption class="visually-hidden">طلبات عرض السعر المسجلة: المورد، الصنف، سعر الوحدة، التاريخ، ملاحظات</caption>
            <thead><tr><th scope="col">المورد</th><th scope="col">الصنف</th><th scope="col">سعر الوحدة</th><th scope="col">التاريخ</th><th scope="col">ملاحظات</th><th scope="col" class="text-center">إجراءات</th></tr></thead>
            <tbody>
                @foreach (var q in Model)
                {
                    <tr>
                        <td>@q.Supplier.Name</td>
                        <td>@q.Item.Name</td>
                        <td class="fw-bold">@Money.Format(q.UnitPrice)</td>
                        <td>@q.EffectiveDate.ToString("dd/MM/yyyy")</td>
                        <td>@(q.Notes ?? "—")</td>
                        <td class="text-center">
                            @if (await Perm.HasAsync("PurchaseOrders.Create"))
                            {
                                <a asp-controller="PurchaseOrders" asp-action="Create" asp-route-fromQuoteId="@q.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-arrow-repeat"></i> تحويل إلى أمر شراء</a>
                            }
                            @if (await Perm.HasAsync("PurchaseRequests.Delete"))
                            {
                                <form asp-action="Remove" asp-route-id="@q.Id" method="post" class="d-inline" data-confirm-delete>
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="حذف عرض سعر الصنف @q.Item.Name من المورد @q.Supplier.Name"><i class="bi bi-trash"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
<script nonce="@Context.GetCspNonce()">
document.querySelectorAll('form[data-confirm-delete]').forEach(form => {
    form.addEventListener('submit', function(e) {
        if (!confirm('هل أنت متأكد من حذف عرض السعر؟')) {
            e.preventDefault();
        }
    });
});
</script>
}
