@model NewVixSmart.Web.Models.Purchases.SupplierQuote
@{ ViewData["Title"] = "تسجيل عرض سعر"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المشتريات</span>
        <h2><i class="bi bi-envelope-open text-primary" aria-hidden="true"></i> تسجيل عرض سعر</h2>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="ModelOnly" class="ui-alert ui-alert-bad ui-rise" role="alert" tabindex="-1"></div>
}

<form asp-action="Create" method="post">
    <div class="ui-section ui-card ui-rise">
        <div class="card-body">
            <div class="ui-grid ui-grid-2 gap-3">
                <div>
                    <label asp-for="SupplierId" class="ui-label"></label>
                    <select asp-for="SupplierId" asp-items="@(ViewBag.Suppliers as IEnumerable<SelectListItem>)" class="form-select">
                        <option value="">-- اختر المورد --</option>
                    </select>
                    <span asp-validation-for="SupplierId" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="ItemId" class="ui-label"></label>
                    <select asp-for="ItemId" asp-items="@(new SelectList(ViewBag.ItemsData as List<NewVixSmart.Web.Models.Core.Item>, "Id", "Name"))" class="form-select">
                        <option value="">-- اختر الصنف --</option>
                    </select>
                    <span asp-validation-for="ItemId" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="UnitPrice" class="ui-label"></label>
                    <input asp-for="UnitPrice" class="ui-input" type="number" step="0.001" />
                    <span asp-validation-for="UnitPrice" class="text-danger small"></span>
                </div>
                <div>
                    <label asp-for="EffectiveDate" class="ui-label"></label>
                    <input asp-for="EffectiveDate" class="ui-input" type="date" />
                </div>
                <div class="md:col-span-2">
                    <label asp-for="Notes" class="ui-label"></label>
                    <textarea asp-for="Notes" class="ui-input" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4 flex gap-2">
                <button type="submit" class="ui-btn ui-btn-pri"><i class="bi bi-check-lg" aria-hidden="true"></i> حفظ</button>
                <a asp-action="Index" class="ui-btn ui-btn-quiet">إلغاء</a>
            </div>
        </div>
    </div>
</form>
