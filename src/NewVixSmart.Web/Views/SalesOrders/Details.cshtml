@model NewVixSmart.Web.Models.Sales.SalesOrder
@inject NewVixSmart.Web.Services.IPermissionService Perm
@using NewVixSmart.Web.Models.Sales
@using NewVixSmart.Web.Models.Stock
@using NewVixSmart.Web.Extensions
@{ ViewData["Title"] = $"أمر بيع {Model.OrderNumber}"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-eye text-primary"></i> أمر بيع: @Model.OrderNumber</h2>
    <div class="d-flex gap-2">
        @if (await Perm.HasAsync("SalesOrders.Approve") && Model.Status == SalesOrderStatus.Draft)
        {
            <form asp-action="Approve" asp-route-id="@Model.Id" method="post" class="d-inline" data-confirm="تتم فوترة أمر البيع المعتمد؟">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle"></i> اعتماد</button>
            </form>
        }
        @if (await Perm.HasAsync("SalesOrders.Convert") && (Model.Status == SalesOrderStatus.Approved || Model.Status == SalesOrderStatus.PartiallyInvoiced))
        {
            <form asp-action="CreateInvoice" asp-route-id="@Model.Id" method="post" class="d-inline" data-confirm="إنشاء فاتورة من الكميات المسلَّمة غير المفوترة فقط. هل تريد المتابعة؟">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary"><i class="bi bi-receipt"></i> فاتورة التسليمات</button>
            </form>
        }
        @if (await Perm.HasAsync("SalesOrders.Edit") && Model.Status == SalesOrderStatus.Draft)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="bi bi-pencil"></i> تعديل</a>
        }
        @if (await Perm.HasAsync("SalesOrders.Approve") && Model.Status != SalesOrderStatus.Cancelled && Model.Status != SalesOrderStatus.Invoiced)
        {
            <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-circle"></i> إلغاء</button>
            </form>
        }
        <a asp-action="Print" asp-route-id="@Model.Id" target="_blank" rel="noopener" class="btn btn-outline-primary"><i class="bi bi-printer"></i> طباعة</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> رجوع</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-3"><strong>العميل:</strong> @(Model.Customer?.Name ?? "—")</div>
            <div class="col-md-3"><strong>تاريخ الأمر:</strong> @Model.OrderDate.ToString("dd/MM/yyyy")</div>
            <div class="col-md-3"><strong>المتوقع:</strong> @(Model.ExpectedDate?.ToString("dd/MM/yyyy") ?? "—")</div>
            <div class="col-md-3"><strong>الحالة:</strong> <span class="badge @(Model.Status switch { SalesOrderStatus.Approved => "bg-success", SalesOrderStatus.Invoiced => "bg-info", SalesOrderStatus.PartiallyInvoiced => "bg-warning", SalesOrderStatus.Cancelled => "bg-danger", _ => "bg-secondary" })">@Model.Status.GetDisplayName()</span></div>
        </div>
        <div class="row mt-2">
            <div class="col-md-3"><strong>عرض السعر المصدر:</strong>
                @if (Model.SaleQuoteId.HasValue)
                {
                    <a asp-controller="SalesQuotes" asp-action="Details" asp-route-id="@Model.SaleQuote!.PublicId">عرض #@Model.SaleQuoteId.Value</a>
                }
                else
                {
                    <span>—</span>
                }
            </div>
            <div class="col-md-3"><strong>أنشأها:</strong> @(Model.CreatedBy ?? "—")</div>
            <div class="col-md-3"><strong>ملاحظات:</strong> @(Model.Notes ?? "—")</div>
        </div>
    </div>
</div>

<div class="table-container mb-4">
    <table class="table mb-0">
        <caption class="visually-hidden">أصناف أمر البيع مع الكميات المحجوزة والمسلّمة والمفوترة</caption>
        <thead><tr><th scope="col">الصنف</th><th scope="col">العدد المطلوب</th><th scope="col">الكمية المطلوبة</th><th scope="col">سعر الوحدة</th><th scope="col">الإجمالي</th><th scope="col">المحجوز</th><th scope="col">المفوتر عدد</th><th scope="col">المفوتر كمية</th><th scope="col">المسلَّم غير المفوتر</th><th scope="col">التقدّم</th></tr></thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                var ordered = OrderProgress.OrderedForDisplay(item);
                var delivered = OrderProgress.DeliveredForDisplay(item);
                var reserved = OrderProgress.ReservedForDisplay(item);
                var progress = OrderProgress.InvoicingPercent(item);
                <tr>
                    <th scope="row">@item.Item.Name</th>
                    <td>@item.Count.ToString("N2")</td>
                    <td>@item.Quantity.ToString("N2")</td>
                    <td>@Money.Format(item.UnitPrice)</td>
                    <td class="fw-bold">@Money.Format(item.Total)</td>
                    <td>@reserved.ToString("N2")</td>
                    <td>@item.InvoicedCount.ToString("N2")</td>
                    <td>@item.InvoicedQty.ToString("N2")</td>
                    <td>@item.UninvoicedQty.ToString("N2") / @item.UninvoicedCount.ToString("N2")</td>
                    <td style="min-width:120px">
                        <div class="progress" role="progressbar" aria-label="@($"نسبة الفوترة للصنف {item.Item.Name}")" aria-valuenow="@((int)progress)" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar bg-success" style="width:@($"{progress}%")">@($"{progress}%")</div>
                        </div>
                        <div class="small text-muted">مسلَّم @delivered.ToString("N2") من @ordered.ToString("N2")</div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="card mb-4">
    <div class="card-header"><i class="bi bi-bookmark-check"></i> الحجز</div>
    <div class="card-body">
        @{
            var reservation = ViewBag.Reservation as NewVixSmart.Web.Models.Stock.StockReservation;
        }
        @if (reservation == null)
        {
            <div class="text-muted">لا يوجد حجز نشط على هذا الأمر. يُنشأ الحجز تلقائياً عند الاعتماد.</div>
        }
        else
        {
            <dl class="row mb-0">
                <dt class="col-sm-3">رقم الحجز</dt>
                <dd class="col-sm-9"><a asp-controller="StockReservations" asp-action="Details" asp-route-id="@reservation.PublicId">@reservation.ReservationNumber</a></dd>
                <dt class="col-sm-3">الحالة</dt>
                <dd class="col-sm-9">@reservation.Status.GetDisplayName()</dd>
                <dt class="col-sm-3">الكمية المحجوزة</dt>
                <dd class="col-sm-9">@reservation.TotalQuantity.ToString("N2") كمية / @reservation.TotalCount.ToString("N2") عدد</dd>
            </dl>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><i class="bi bi-truck"></i> أذونات التسليم وأوامرها</div>
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table mb-0">
                <caption class="visually-hidden">أذونات التسليم المرتبطة بالأمر وأوامر التسليم وحالاتها</caption>
                <thead><tr><th scope="col">أذن التسليم</th><th scope="col">التاريخ</th><th scope="col">الحالة</th><th scope="col">أوامر التسليم</th></tr></thead>
                <tbody>
                    @if (Model.DeliveryOrders == null || !Model.DeliveryOrders.Any())
                    {
                        <tr><td colspan="4" class="text-muted">لا توجد أذونات تسليم لهذا الأمر بعد.</td></tr>
                    }
                    @foreach (var note in Model.DeliveryOrders!.OrderByDescending(d => d.Id))
                    {
                        <tr>
                            <th scope="row"><a asp-controller="DeliveryOrders" asp-action="Details" asp-route-id="@note.PublicId">@note.DeliveryNumber</a></th>
                            <td>@note.DeliveryDate.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge @(note.Status switch { DeliveryOrderStatus.Delivered => "bg-success", DeliveryOrderStatus.Cancelled => "bg-danger", _ => "bg-warning text-dark" })">@note.Status.GetDisplayName()</span></td>
                            <td>
                                @if (note.Issues == null || !note.Issues.Any())
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    foreach (var issue in note.Issues.OrderBy(i => i.Id))
                                    {
                                        <a asp-controller="DeliveryIssues" asp-action="Details" asp-route-id="@issue.PublicId" class="me-2">
                                            @issue.IssueNumber
                                            <span class="badge @(issue.Status switch { DeliveryIssueStatus.Issued => "bg-success", DeliveryIssueStatus.Cancelled => "bg-danger", _ => "bg-warning text-dark" })">@issue.Status.GetDisplayName()</span>
                                        </a>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><i class="bi bi-receipt"></i> الفواتير</div>
    <div class="card-body p-0">
        <div class="table-container">
            <table class="table mb-0">
                <caption class="visually-hidden">فواتير البيع المرتبطة بهذا الأمر</caption>
                <thead><tr><th scope="col">رقم الفاتورة</th><th scope="col">التاريخ</th><th scope="col">الصافي</th><th scope="col">الضريبة</th><th scope="col">الخصم</th><th scope="col">الحالة</th></tr></thead>
                <tbody>
                    @{
                        var invoices = ViewBag.Invoices as List<NewVixSmart.Web.Models.Sales.SaleInvoice>;
                    }
                    @if (invoices == null || !invoices.Any())
                    {
                        <tr><td colspan="6" class="text-muted">لم تُصدر فواتير لهذا الأمر بعد.</td></tr>
                    }
                    else
                    {
                        foreach (var inv in invoices)
                        {
                            <tr>
                                <th scope="row"><a asp-controller="Sales" asp-action="Details" asp-route-id="@inv.PublicId">@inv.InvoiceNumber</a></th>
                                <td>@inv.InvoiceDate.ToString("dd/MM/yyyy")</td>
                                <td>@Money.Format(inv.NetAmount)</td>
                                <td>@Money.Format(inv.Tax)</td>
                                <td>@Money.Format(inv.Discount)</td>
                                <td><span class="badge @(inv.IsPaid ? "bg-success" : "bg-warning text-dark")">@OrderProgress.SettlementLabel(inv)</span></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4"><div class="card text-center"><div class="card-body"><div class="text-muted small">الإجمالي</div><h4>@Money.Format(OrderProgress.Summarize(Model).Total)</h4></div></div></div>
</div>