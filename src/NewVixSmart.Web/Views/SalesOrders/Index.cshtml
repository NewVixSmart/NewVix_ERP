@model IReadOnlyList<NewVixSmart.Web.Models.Sales.SalesOrder>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@using NewVixSmart.Web.Models.Sales
@using NewVixSmart.Web.Extensions
@{
    ViewData["Title"] = "أوامر البيع";
    var counts = ViewBag.StatusCounts as Dictionary<SalesOrderStatus, int> ?? new Dictionary<SalesOrderStatus, int>();
    var totalCount = ViewBag.TotalCount as int? ?? Model.Count;
    var activeFilter = ViewBag.StatusFilter as SalesOrderStatus?;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-clipboard2-check text-primary" aria-hidden="true"></i> أوامر البيع</h2>
    <div class="d-flex gap-2">
        @if (await Perm.HasAsync("SalesOrders.Create"))
        {
            <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg" aria-hidden="true"></i> أمر بيع جديد</a>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button></div>
}

<ul class="nav nav-pills mb-3" aria-label="فلترة أوامر البيع">
    <li class="nav-item">
        <a class="nav-link d-flex align-items-center gap-1 @(activeFilter == null ? "active" : "")" asp-action="Index">
            الكل <span class="badge bg-light text-dark">@totalCount</span>
        </a>
    </li>
    @foreach (var st in Enum.GetValues<SalesOrderStatus>())
    {
        var count = counts.TryGetValue(st, out var c) ? c : 0;
        <li class="nav-item">
            <a class="nav-link d-flex align-items-center gap-1 @(activeFilter == st ? "active" : "") @(count == 0 && activeFilter != st ? "disabled" : "")"
               asp-action="Index" asp-route-status="@st">
                @st.GetDisplayName() <span class="badge @(activeFilter == st ? "bg-light text-dark" : "bg-secondary")">@count</span>
            </a>
        </li>
    }
</ul>

@if (!Model.Any())
{
    <div class="alert alert-info">
        @(activeFilter == null ? "لا توجد أوامر بيع بعد." : $"لا توجد أوامر بحالة «{activeFilter.Value.GetDisplayName()}».")
    </div>
}
else
{
    <div class="table-container">
        <table class="table table-hover mb-0">
            <caption class="visually-hidden">قائمة أوامر البيع مع الكميات المطلوبة والمسلّمة والمفوترة</caption>
            <thead><tr><th scope="col">رقم الأمر</th><th scope="col">العميل</th><th scope="col">التاريخ</th><th scope="col">المتوقع</th><th scope="col">الإجمالي</th><th scope="col">مطلوب</th><th scope="col">مسلَّم</th><th scope="col">مفوتر</th><th scope="col">الحالة</th><th scope="col" class="text-center">إجراءات</th></tr></thead>
            <tbody>
                @foreach (var o in Model)
                {
                    var t = OrderProgress.Summarize(o);
                    <tr>
                        <th scope="row"><code>@o.OrderNumber</code></th>
                        <td><strong>@(o.Customer?.Name ?? "—")</strong></td>
                        <td>@o.OrderDate.ToString("dd/MM/yyyy")</td>
                        <td>@(o.ExpectedDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="fw-bold">@Money.Format(t.Total)</td>
                        <td>@t.OrderedQuantity.ToString("N2") / @t.OrderedCount.ToString("N2")</td>
                        <td>@t.DeliveredQuantity.ToString("N2") / @t.DeliveredCount.ToString("N2")</td>
                        <td>@t.InvoicedQuantity.ToString("N2") / @t.InvoicedCount.ToString("N2")</td>
                        <td><span class="badge @(o.Status switch { SalesOrderStatus.Approved => "bg-success", SalesOrderStatus.Invoiced => "bg-info", SalesOrderStatus.PartiallyInvoiced => "bg-warning", SalesOrderStatus.Cancelled => "bg-danger", _ => "bg-secondary" })">@o.Status.GetDisplayName()</span></td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@o.PublicId" class="btn btn-sm btn-outline-info" aria-label="عرض أمر البيع @o.OrderNumber"><i class="bi bi-eye" aria-hidden="true"></i></a>
                            @if (o.Status == SalesOrderStatus.Draft && await Perm.HasAsync("SalesOrders.Edit"))
                            {
                                <a asp-action="Edit" asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary" aria-label="تعديل أمر البيع @o.OrderNumber"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small mt-2 mb-0">الأرقام معروضة بالترتيب: كمية / عدد.</p>
}
