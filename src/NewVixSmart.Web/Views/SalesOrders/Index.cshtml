@model IReadOnlyList<NewVixSmart.Web.Models.Sales.SalesOrder>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@using NewVixSmart.Web.Models.Sales
@using NewVixSmart.Web.Extensions
@{
    ViewData["Title"] = "أوامر البيع";
    var counts = ViewBag.StatusCounts as Dictionary<SalesOrderStatus, int> ?? new Dictionary<SalesOrderStatus, int>();
    var totalCount = ViewBag.TotalCount as int? ?? Model.Count;
    var activeFilter = ViewBag.StatusFilter as SalesOrderStatus?;
}

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المبيعات</span>
        <h2>أوامر البيع</h2>
    </div>
    <div class="ui-pagehead-actions">
        @if (await Perm.HasAsync("SalesOrders.Create"))
        {
            <a asp-action="Create" class="ui-btn ui-btn-pri"><i class="bi bi-plus-lg" aria-hidden="true"></i> أمر بيع جديد</a>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="ui-alert ui-alert-ok ui-rise" role="alert" aria-live="polite">
        <i class="bi bi-check-circle" aria-hidden="true"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="ui-alert ui-alert-bad ui-rise" role="alert" aria-live="assertive">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @TempData["Error"]
    </div>
}

<ul class="nav nav-pills mb-4 ui-rise" aria-label="فلترة أوامر البيع">
    <li>
        <a class="nav-link flex items-center gap-1 @(activeFilter == null ? "active" : "")" asp-action="Index">
            الكل <span class="ui-badge ui-badge-mute">@totalCount</span>
        </a>
    </li>
    @foreach (var st in Enum.GetValues<SalesOrderStatus>())
    {
        var count = counts.TryGetValue(st, out var c) ? c : 0;
        <li>
            <a class="nav-link flex items-center gap-1 @(activeFilter == st ? "active" : "") @(count == 0 && activeFilter != st ? "disabled" : "")"
               asp-action="Index" asp-route-status="@st"
               aria-current="@(activeFilter == st ? "page" : null)"
               aria-disabled="@(count == 0 && activeFilter != st ? "true" : null)"
               tabindex="@(count == 0 && activeFilter != st ? "-1" : null)">
                @st.GetDisplayName() <span class="ui-badge @(activeFilter == st ? "ui-badge-mute" : "ui-badge-mute")">@count</span>
            </a>
        </li>
    }
</ul>

@if (!Model.Any())
{
    <div class="ui-alert ui-alert-info ui-rise">
        @(activeFilter == null ? "لا توجد أوامر بيع بعد." : $"لا توجد أوامر بحالة «{activeFilter.Value.GetDisplayName()}».")
    </div>
}
else
{
    <div class="table-container ui-rise">
        <table class="table mb-0">
            <caption class="visually-hidden">قائمة أوامر البيع مع الكميات المطلوبة والمسلّمة والمفوترة</caption>
            <thead><tr><th scope="col">رقم الأمر</th><th scope="col">العميل</th><th scope="col">التاريخ</th><th scope="col">المتوقع</th><th scope="col">الإجمالي</th><th scope="col">مطلوب</th><th scope="col">مسلَّم</th><th scope="col">مفوتر</th><th scope="col">الحالة</th><th scope="col" class="text-center">إجراءات</th></tr></thead>
            <tbody>
                @foreach (var o in Model)
                {
                    var t = OrderProgress.Summarize(o);
                    <tr>
                        <th scope="row"><code>@o.OrderNumber</code></th>
                        <td><strong>@(o.Customer?.Name ?? "—")</strong></td>
                        <td>@o.OrderDate.ToString("dd/MM/yyyy")</td>
                        <td>@(o.ExpectedDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td class="fw-bold">@Money.Format(t.Total)</td>
                        <td>@t.OrderedQuantity.ToString("N2") / @t.OrderedCount.ToString("N2")</td>
                        <td>@t.DeliveredQuantity.ToString("N2") / @t.DeliveredCount.ToString("N2")</td>
                        <td>@t.InvoicedQuantity.ToString("N2") / @t.InvoicedCount.ToString("N2")</td>
                        <td><span class="ui-badge @(o.Status switch { SalesOrderStatus.Approved => "ui-badge-ok", SalesOrderStatus.Invoiced => "ui-badge-info", SalesOrderStatus.PartiallyInvoiced => "ui-badge-warn", SalesOrderStatus.Cancelled => "ui-badge-bad", _ => "ui-badge-mute" })">@o.Status.GetDisplayName()</span></td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@o.PublicId" class="ui-btn ui-btn-sm ui-btn-outline" aria-label="عرض أمر البيع @o.OrderNumber"><i class="bi bi-eye" aria-hidden="true"></i></a>
                            @if (o.Status == SalesOrderStatus.Draft && await Perm.HasAsync("SalesOrders.Edit"))
                            {
                                <a asp-action="Edit" asp-route-id="@o.Id" class="ui-btn ui-btn-sm ui-btn-quiet" aria-label="تعديل أمر البيع @o.OrderNumber"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="text-muted small mt-4 mb-0">الأرقام معروضة بالترتيب: كمية / عدد.</p>
}
