@model NewVixSmart.Web.ViewModels.Reports.SalesReportViewModel
@{ ViewData["Title"] = "تقرير المبيعات"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-cart-check text-primary"></i> تقرير المبيعات</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> كل التقارير</a>
</div>

<div class="card mb-4"><div class="card-body">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label" for="from">من تاريخ</label>
            <input type="date" name="from" id="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="to">إلى تاريخ</label>
            <input type="date" name="to" id="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> عرض</button></div>
        <div class="col-md-2">
            <a asp-action="ExportSalesXlsx" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" class="btn btn-outline-success w-100"><i class="bi bi-file-earmark-excel"></i> تصدير Excel</a>
        </div>
    </form>
</div></div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3"><div class="stat-card text-center"><div class="text-muted small">عدد الفواتير</div><h3 class="mb-0">@Model.InvoiceCount</h3></div></div>
    <div class="col-12 col-sm-6 col-lg-3"><div class="stat-card text-center"><div class="text-muted small">صافي المبيعات</div><h3 class="mb-0">@Model.NetSales.ToString("N2")</h3></div></div>
    <div class="col-12 col-sm-6 col-lg-3"><div class="stat-card text-center"><div class="text-muted small">مرتجعات البيع</div><h3 class="mb-0 text-danger">@Model.TotalReturns.ToString("N2")</h3></div></div>
    <div class="col-12 col-sm-6 col-lg-3"><div class="stat-card text-center border-success"><div class="text-muted small">صافي بعد المرتجعات</div><h3 class="mb-0 text-success">@Model.Net.ToString("N2")</h3></div></div>
</div>

<div class="table-container">
    <table class="table table-hover mb-0">
        <thead><tr><th scope="col">الفاتورة</th><th scope="col">العميل</th><th scope="col">التاريخ</th><th scope="col">الإجمالي</th><th scope="col">الخصم</th><th scope="col">الضريبة</th><th scope="col">الصافي</th><th scope="col" class="visually-hidden">إجراءات</th></tr></thead>
        <tbody>
            @foreach (var i in Model.Invoices)
            {
                <tr>
                    <td><code>@i.InvoiceNumber</code></td>
                    <td>@(i.Customer?.Name ?? "—")</td>
                    <td>@i.InvoiceDate.ToString("dd/MM/yyyy")</td>
                    <td>@i.TotalAmount.ToString("N2")</td>
                    <td>@i.Discount.ToString("N2")</td>
                    <td>@i.Tax.ToString("N2")</td>
                    <td class="fw-bold">@i.NetAmount.ToString("N2")</td>
                    <td><a asp-action="PrintInvoice" asp-route-id="@i.Id" asp-route-type="sale" class="btn btn-sm btn-outline-danger" aria-label="طباعة فاتورة PDF"><i class="bi bi-file-earmark-pdf"></i></a></td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="table-light fw-bold">
                <td colspan="3">الإجمالي</td>
                <td>@Model.TotalSales.ToString("N2")</td>
                <td>@Model.TotalDiscounts.ToString("N2")</td>
                <td>@Model.TotalTax.ToString("N2")</td>
                <td class="text-success">@Model.NetSales.ToString("N2")</td>
                <td></td>
            </tr>
        </tfoot>
    </table>
</div>

@if (!Model.Invoices.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox" style="font-size:3rem;"></i>
        <p class="mt-2">لا توجد فواتير بيع في هذه الفترة</p>
    </div>
}

<div class="mt-4 d-print-none">
    <button type="button" class="btn btn-outline-dark" data-auto-print><i class="bi bi-printer"></i> طباعة</button>
</div>