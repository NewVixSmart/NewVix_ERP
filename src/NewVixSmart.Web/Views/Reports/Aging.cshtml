@model NewVixSmart.Web.ViewModels.Reports.AgingReportViewModel
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "القائمة العمرية"; }

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h2><i class="bi bi-hourglass-split text-warning"></i> القائمة العمرية</h2>
        <p class="text-muted mb-0">حتى تاريخ @Model.AsOf.ToString("dd/MM/yyyy") — تحليل ذمم العملاء والموردين حسب تأخر الاستحقاق</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> كل التقارير</a>
        @if (await Perm.HasAsync("Aging.Export"))
        {
            <a asp-action="AgingXlsx" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel"></i> تصدير Excel</a>
        }
    </div>
</div>

<div class="row g-3 my-3">
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">ذمم عملاء — إجمالي</div>
                    <h3 class="mb-0 mt-1">@Money.Format(Model.ArTotal)</h3>
                </div>
                <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-people"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">ذمم عملاء — متأخر</div>
                    <h3 class="mb-0 mt-1">@Money.Format(Model.ArOverdue)</h3>
                </div>
                <div class="stat-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-exclamation-octagon"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">ذمم موردين — إجمالي</div>
                    <h3 class="mb-0 mt-1">@Money.Format(Model.ApTotal)</h3>
                </div>
                <div class="stat-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-truck"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="stat-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-muted small">ذمم موردين — متأخر</div>
                    <h3 class="mb-0 mt-1">@Money.Format(Model.ApOverdue)</h3>
                </div>
                <div class="stat-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-exclamation-octagon"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0 fs-5" id="aging-ar-heading"><i class="bi bi-people text-primary"></i> ذمم العملاء</h3>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle" aria-labelledby="aging-ar-heading">
            <caption class="visually-hidden">ذمم العملاء مقسمة حسب عمر الاستحقاق: لم يستحق، 1-30، 31-60، 61-90، أكثر من 90 يوم</caption>
            <thead class="table-light">
                <tr>
                    <th scope="col">العميل</th>
                    <th scope="col" class="text-end">لم يستحق</th>
                    <th scope="col" class="text-end">1-30 يوم</th>
                    <th scope="col" class="text-end">31-60 يوم</th>
                    <th scope="col" class="text-end">61-90 يوم</th>
                    <th scope="col" class="text-end">أكثر من 90</th>
                    <th scope="col" class="text-end">الإجمالي</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Receivables.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">لا توجد ذمم عملاء مفتوحة</td></tr>
                }
                @foreach (var row in Model.Receivables)
                {
                    <tr>
                        <td><strong>@row.PartyName</strong></td>
                        <td class="text-end">@Money.Format(row.Current)</td>
                        <td class="text-end">@Money.Format(row.Days1To30)</td>
                        <td class="text-end">@Money.Format(row.Days31To60)</td>
                        <td class="text-end">@Money.Format(row.Days61To90)</td>
                        <td class="text-end">@Money.Format(row.Days90Plus)</td>
                        <td class="text-end fw-bold">@Money.Format(row.Total)</td>
                    </tr>
                }
            </tbody>
            <tfoot class="fw-bold table-light">
                <tr>
                    <td>الإجمالي</td>
                    <td class="text-end">@Money.Format(Model.ArCurrent)</td>
                    <td class="text-end">@Money.Format(Model.ArDays1To30)</td>
                    <td class="text-end">@Money.Format(Model.ArDays31To60)</td>
                    <td class="text-end">@Money.Format(Model.ArDays61To90)</td>
                    <td class="text-end">@Money.Format(Model.ArDays90Plus)</td>
                    <td class="text-end">@Money.Format(Model.ArTotal)</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="mb-0 fs-5" id="aging-ap-heading"><i class="bi bi-truck text-warning"></i> ذمم الموردين</h3>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle" aria-labelledby="aging-ap-heading">
            <caption class="visually-hidden">ذمم الموردين مقسمة حسب عمر الاستحقاق: لم يستحق، 1-30، 31-60، 61-90، أكثر من 90 يوم</caption>
            <thead class="table-light">
                <tr>
                    <th scope="col">المورد</th>
                    <th scope="col" class="text-end">لم يستحق</th>
                    <th scope="col" class="text-end">1-30 يوم</th>
                    <th scope="col" class="text-end">31-60 يوم</th>
                    <th scope="col" class="text-end">61-90 يوم</th>
                    <th scope="col" class="text-end">أكثر من 90</th>
                    <th scope="col" class="text-end">الإجمالي</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Payables.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">لا توجد ذمم موردين مفتوحة</td></tr>
                }
                @foreach (var row in Model.Payables)
                {
                    <tr>
                        <td><strong>@row.PartyName</strong></td>
                        <td class="text-end">@Money.Format(row.Current)</td>
                        <td class="text-end">@Money.Format(row.Days1To30)</td>
                        <td class="text-end">@Money.Format(row.Days31To60)</td>
                        <td class="text-end">@Money.Format(row.Days61To90)</td>
                        <td class="text-end">@Money.Format(row.Days90Plus)</td>
                        <td class="text-end fw-bold">@Money.Format(row.Total)</td>
                    </tr>
                }
            </tbody>
            <tfoot class="fw-bold table-light">
                <tr>
                    <td>الإجمالي</td>
                    <td class="text-end">@Money.Format(Model.ApCurrent)</td>
                    <td class="text-end">@Money.Format(Model.ApDays1To30)</td>
                    <td class="text-end">@Money.Format(Model.ApDays31To60)</td>
                    <td class="text-end">@Money.Format(Model.ApDays61To90)</td>
                    <td class="text-end">@Money.Format(Model.ApDays90Plus)</td>
                    <td class="text-end">@Money.Format(Model.ApTotal)</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>