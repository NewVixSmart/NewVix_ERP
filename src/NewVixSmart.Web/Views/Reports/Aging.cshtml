@model NewVixSmart.Web.ViewModels.Reports.AgingReportViewModel
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "القائمة العمرية"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">التقارير</span>
        <h2><i class="bi bi-hourglass-split text-warning" aria-hidden="true"></i> القائمة العمرية</h2>
        <p class="text-muted small mb-0">حتى تاريخ @Model.AsOf.ToString("dd/MM/yyyy") — تحليل ذمم العملاء والموردين حسب تأخر الاستحقاق</p>
    </div>
    <div class="ui-pagehead-actions">
        <a asp-action="Index" class="ui-btn ui-btn-quiet"><i class="bi bi-arrow-right" aria-hidden="true"></i> كل التقارير</a>
        @if (await Perm.HasAsync("Aging.Export"))
        {
            <a asp-action="AgingXlsx" class="ui-btn ui-btn-ok"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> تصدير Excel</a>
        }
    </div>
</div>

<div class="ui-grid ui-grid-4 ui-section ui-rise">
    <div class="ui-stat">
        <span class="ui-stat-label">ذمم عملاء — إجمالي</span>
        <span class="ui-stat-value">@Money.Format(Model.ArTotal)</span>
    </div>
    <div class="ui-stat">
        <span class="ui-stat-label">ذمم عملاء — متأخر</span>
        <span class="ui-stat-value text-danger">@Money.Format(Model.ArOverdue)</span>
    </div>
    <div class="ui-stat">
        <span class="ui-stat-label">ذمم موردين — إجمالي</span>
        <span class="ui-stat-value">@Money.Format(Model.ApTotal)</span>
    </div>
    <div class="ui-stat">
        <span class="ui-stat-label">ذمم موردين — متأخر</span>
        <span class="ui-stat-value text-danger">@Money.Format(Model.ApOverdue)</span>
    </div>
</div>

<div class="ui-card ui-section ui-rise">
    <div class="card-header">
        <h3 class="card-title" id="aging-ar-heading"><i class="bi bi-people text-primary" aria-hidden="true"></i> ذمم العملاء</h3>
    </div>
    <div class="table-responsive">
        <table class="table" aria-labelledby="aging-ar-heading">
            <caption class="visually-hidden">ذمم العملاء مقسمة حسب عمر الاستحقاق: لم يستحق، 1-30، 31-60، 61-90، أكثر من 90 يوم</caption>
            <thead>
                <tr>
                    <th scope="col">العميل</th>
                    <th scope="col" class="text-end">لم يستحق</th>
                    <th scope="col" class="text-end">1-30 يوم</th>
                    <th scope="col" class="text-end">31-60 يوم</th>
                    <th scope="col" class="text-end">61-90 يوم</th>
                    <th scope="col" class="text-end">أكثر من 90</th>
                    <th scope="col" class="text-end">الإجمالي</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Receivables.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">لا توجد ذمم عملاء مفتوحة</td></tr>
                }
                @foreach (var row in Model.Receivables)
                {
                    <tr>
                        <td><strong>@row.PartyName</strong></td>
                        <td class="num">@Money.Format(row.Current)</td>
                        <td class="num">@Money.Format(row.Days1To30)</td>
                        <td class="num">@Money.Format(row.Days31To60)</td>
                        <td class="num">@Money.Format(row.Days61To90)</td>
                        <td class="num">@Money.Format(row.Days90Plus)</td>
                        <td class="num fw-bold">@Money.Format(row.Total)</td>
                    </tr>
                }
            </tbody>
            <tfoot class="fw-bold">
                <tr>
                    <th scope="row">الإجمالي</th>
                    <td class="num fw-bold">@Money.Format(Model.ArCurrent)</td>
                    <td class="num fw-bold">@Money.Format(Model.ArDays1To30)</td>
                    <td class="num fw-bold">@Money.Format(Model.ArDays31To60)</td>
                    <td class="num fw-bold">@Money.Format(Model.ArDays61To90)</td>
                    <td class="num fw-bold">@Money.Format(Model.ArDays90Plus)</td>
                    <td class="num fw-bold">@Money.Format(Model.ArTotal)</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<div class="ui-card ui-section ui-rise">
    <div class="card-header">
        <h3 class="card-title" id="aging-ap-heading"><i class="bi bi-truck text-warning" aria-hidden="true"></i> ذمم الموردين</h3>
    </div>
    <div class="table-responsive">
        <table class="table" aria-labelledby="aging-ap-heading">
            <caption class="visually-hidden">ذمم الموردين مقسمة حسب عمر الاستحقاق: لم يستحق، 1-30، 31-60، 61-90، أكثر من 90 يوم</caption>
            <thead>
                <tr>
                    <th scope="col">المورد</th>
                    <th scope="col" class="text-end">لم يستحق</th>
                    <th scope="col" class="text-end">1-30 يوم</th>
                    <th scope="col" class="text-end">31-60 يوم</th>
                    <th scope="col" class="text-end">61-90 يوم</th>
                    <th scope="col" class="text-end">أكثر من 90</th>
                    <th scope="col" class="text-end">الإجمالي</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Payables.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">لا توجد ذمم موردين مفتوحة</td></tr>
                }
                @foreach (var row in Model.Payables)
                {
                    <tr>
                        <td><strong>@row.PartyName</strong></td>
                        <td class="num">@Money.Format(row.Current)</td>
                        <td class="num">@Money.Format(row.Days1To30)</td>
                        <td class="num">@Money.Format(row.Days31To60)</td>
                        <td class="num">@Money.Format(row.Days61To90)</td>
                        <td class="num">@Money.Format(row.Days90Plus)</td>
                        <td class="num fw-bold">@Money.Format(row.Total)</td>
                    </tr>
                }
            </tbody>
            <tfoot class="fw-bold">
                <tr>
                    <th scope="row">الإجمالي</th>
                    <td class="num fw-bold">@Money.Format(Model.ApCurrent)</td>
                    <td class="num fw-bold">@Money.Format(Model.ApDays1To30)</td>
                    <td class="num fw-bold">@Money.Format(Model.ApDays31To60)</td>
                    <td class="num fw-bold">@Money.Format(Model.ApDays61To90)</td>
                    <td class="num fw-bold">@Money.Format(Model.ApDays90Plus)</td>
                    <td class="num fw-bold">@Money.Format(Model.ApTotal)</td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
