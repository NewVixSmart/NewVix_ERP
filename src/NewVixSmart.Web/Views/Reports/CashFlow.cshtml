@model NewVixSmart.Web.ViewModels.Reports.CashFlowReportViewModel
@using NewVixSmart.Web.Models.Accounting
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "كشف التدفق النقدي"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">التقارير</span>
        <h2><i class="bi bi-cash-stack" aria-hidden="true"></i> كشف التدفق النقدي</h2>
    </div>
    <div class="ui-pagehead-actions">
        <a asp-action="Index" class="ui-btn ui-btn-quiet"><i class="bi bi-arrow-right" aria-hidden="true"></i> كل التقارير</a>
    </div>
</div>

<div class="ui-section ui-card ui-rise">
    <div class="card-body">
        <form method="get" class="ui-grid ui-grid-4 items-end">
            <div>
                <label class="form-label" for="from">من تاريخ</label>
                <input type="date" name="from" id="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div>
                <label class="form-label" for="to">إلى تاريخ</label>
                <input type="date" name="to" id="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div><button type="submit" class="ui-btn ui-btn-outline w-full"><i class="bi bi-search" aria-hidden="true"></i> عرض</button></div>
            @if (await Perm.HasAsync("Reports.Export"))
            {
                <div>
                    <a asp-action="CashFlowXlsx" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" class="ui-btn ui-btn-outline w-full"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> تصدير Excel</a>
                </div>
            }
        </form>
    </div>
</div>

<div class="ui-grid ui-grid-4 ui-section">
    <div class="ui-stat text-center"><div class="ui-stat-label">رصيد افتتاحي</div><h3 class="ui-stat-value num">@Money.Format(Model.OpeningBalance)</h3></div>
    <div class="ui-stat text-center"><div class="ui-stat-label">مقبوضات</div><h3 class="ui-stat-value text-success num">@Money.Format(Model.TotalReceipts)</h3></div>
    <div class="ui-stat text-center"><div class="ui-stat-label">مصروفات</div><h3 class="ui-stat-value text-danger num">@Money.Format(Model.TotalDisbursements)</h3></div>
    <div class="ui-stat text-center"><div class="ui-stat-label">رصيد ختامي</div><h3 class="ui-stat-value fw-bold @(Model.ClosingBalance >= 0 ? "text-primary" : "text-danger") num">@Money.Format(Model.ClosingBalance)</h3></div>
</div>

<div class="ui-section ui-card">
    <div class="card-header">
        <h3>صافي التدفق النقدي: <span class="@(Model.NetCashFlow >= 0 ? "text-success" : "text-danger") num">@Money.Format(Model.NetCashFlow)</span></h3>
    </div>
</div>

<div class="ui-section ui-card">
    <div class="card-header"><h3 id="cashflow-method-heading"><i class="bi bi-wallet2" aria-hidden="true"></i> التوزيع حسب طريقة الدفع</h3></div>
    <div class="table-container">
        <table class="table" aria-labelledby="cashflow-method-heading">
            <caption class="visually-hidden">مقبوضات ومصروفات الفترة مقسمة حسب طريقة الدفع</caption>
            <thead>
                <tr>
                    <th scope="col">طريقة الدفع</th>
                    <th scope="col" class="text-end">مقبوضات</th>
                    <th scope="col" class="text-end">مصروفات</th>
                    <th scope="col" class="text-end">الصافي</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ByMethod.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">لا توجد حركات نقدية في الفترة</td></tr>
                }
                @foreach (var m in Model.ByMethod)
                {
                    <tr>
                        <td>@m.Method.GetDisplayName()</td>
                        <td class="text-end num">@Money.Format(m.Receipts)</td>
                        <td class="text-end num">@Money.Format(m.Disbursements)</td>
                        <td class="text-end fw-bold @(m.Net >= 0 ? "text-success" : "text-danger") num">@Money.Format(m.Net)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="ui-section ui-card">
    <div class="card-header"><h3 id="cashflow-detail-heading"><i class="bi bi-list-ul" aria-hidden="true"></i> تفاصيل الحركات</h3></div>
    <div class="table-container">
        <table class="table" aria-labelledby="cashflow-detail-heading">
            <caption class="visually-hidden">حركات المقبوضات والمصروفات في الفترة المحددة</caption>
            <thead>
                <tr>
                    <th scope="col">التاريخ</th>
                    <th scope="col">الإيصال</th>
                    <th scope="col">النوع</th>
                    <th scope="col">الطرف</th>
                    <th scope="col">الطريقة</th>
                    <th scope="col">المرجع</th>
                    <th scope="col" class="text-end">المبلغ</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Details.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">لا توجد حركات نقدية في الفترة</td></tr>
                }
                @foreach (var d in Model.Details)
                {
                    <tr>
                        <td>@d.Date.ToString("dd/MM/yyyy")</td>
                        <td><code>@d.Doc</code></td>
                        <td>
                            @if (d.Type == PaymentType.Receipt) { <span class="ui-badge ui-badge-ok">قبض</span> }
                            else { <span class="ui-badge ui-badge-bad">صرف</span> }
                        </td>
                        <td>@d.Party</td>
                        <td>@d.Method.GetDisplayName()</td>
                        <td>@(d.Reference ?? "—")</td>
                        <td class="text-end fw-bold num">@Money.Format(d.Amount)</td>
                    </tr>
                }
            </tbody>
            @if (Model.Details.Count > 0)
            {
                <tfoot class="fw-bold">
                    <tr>
                        <td colspan="6">مجموع التفاصيل</td>
                        <td class="text-end">قبض: <span class="text-success num">@Money.Format(Model.TotalReceipts)</span> / صرف: <span class="text-danger num">@Money.Format(Model.TotalDisbursements)</span></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>
