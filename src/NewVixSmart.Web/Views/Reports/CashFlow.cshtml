@model NewVixSmart.Web.ViewModels.Reports.CashFlowReportViewModel
@using NewVixSmart.Web.Models.Accounting
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "كشف التدفق النقدي"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-cash-stack text-success"></i> كشف التدفق النقدي</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> كل التقارير</a>
</div>

<div class="card mb-4"><div class="card-body">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-3">
            <label class="form-label" for="from">من تاريخ</label>
            <input type="date" name="from" id="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="to">إلى تاريخ</label>
            <input type="date" name="to" id="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-2"><button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> عرض</button></div>
        @if (await Perm.HasAsync("Reports.Export"))
        {
            <div class="col-md-2">
                <a asp-action="CashFlowXlsx" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" class="btn btn-outline-success w-100"><i class="bi bi-file-earmark-excel"></i> تصدير Excel</a>
            </div>
        }
    </form>
</div></div>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="stat-card text-center"><div class="text-muted small">رصيد افتتاحي</div><h3 class="mb-0">@Money.Format(Model.OpeningBalance)</h3></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card text-center"><div class="text-muted small">مقبوضات</div><h3 class="mb-0 text-success">@Money.Format(Model.TotalReceipts)</h3></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card text-center"><div class="text-muted small">مصروفات</div><h3 class="mb-0 text-danger">@Money.Format(Model.TotalDisbursements)</h3></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card text-center"><div class="text-muted small">رصيد ختامي</div><h3 class="mb-0 fw-bold @(Model.ClosingBalance >= 0 ? "text-primary" : "text-danger")">@Money.Format(Model.ClosingBalance)</h3></div></div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h3 class="mb-0 fs-5">صافي التدفق النقدي: <span class="@(Model.NetCashFlow >= 0 ? "text-success" : "text-danger")">@Money.Format(Model.NetCashFlow)</span></h3>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><h3 class="mb-0 fs-5" id="cashflow-method-heading"><i class="bi bi-wallet2 text-primary"></i> التوزيع حسب طريقة الدفع</h3></div>
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle" aria-labelledby="cashflow-method-heading">
            <caption class="visually-hidden">مقبوضات ومصروفات الفترة مقسمة حسب طريقة الدفع</caption>
            <thead class="table-light">
                <tr>
                    <th scope="col">طريقة الدفع</th>
                    <th scope="col" class="text-end">مقبوضات</th>
                    <th scope="col" class="text-end">مصروفات</th>
                    <th scope="col" class="text-end">الصافي</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.ByMethod.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">لا توجد حركات نقدية في الفترة</td></tr>
                }
                @foreach (var m in Model.ByMethod)
                {
                    <tr>
                        <td>@m.Method.GetDisplayName()</td>
                        <td class="text-end">@Money.Format(m.Receipts)</td>
                        <td class="text-end">@Money.Format(m.Disbursements)</td>
                        <td class="text-end fw-bold @(m.Net >= 0 ? "text-success" : "text-danger")">@Money.Format(m.Net)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header"><h3 class="mb-0 fs-5" id="cashflow-detail-heading"><i class="bi bi-list-ul text-success"></i> تفاصيل الحركات</h3></div>
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle" aria-labelledby="cashflow-detail-heading">
            <caption class="visually-hidden">حركات المقبوضات والمصروفات في الفترة المحددة</caption>
            <thead class="table-light">
                <tr>
                    <th scope="col">التاريخ</th>
                    <th scope="col">الإيصال</th>
                    <th scope="col">النوع</th>
                    <th scope="col">الطرف</th>
                    <th scope="col">الطريقة</th>
                    <th scope="col">المرجع</th>
                    <th scope="col" class="text-end">المبلغ</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Details.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">لا توجد حركات نقدية في الفترة</td></tr>
                }
                @foreach (var d in Model.Details)
                {
                    <tr>
                        <td>@d.Date.ToString("dd/MM/yyyy")</td>
                        <td><code>@d.Doc</code></td>
                        <td>
                            @if (d.Type == PaymentType.Receipt) { <span class="badge bg-success">قبض</span> }
                            else { <span class="badge bg-danger">صرف</span> }
                        </td>
                        <td>@d.Party</td>
                        <td>@d.Method.GetDisplayName()</td>
                        <td>@(d.Reference ?? "—")</td>
                        <td class="text-end fw-bold">@Money.Format(d.Amount)</td>
                    </tr>
                }
            </tbody>
            @if (Model.Details.Count > 0)
            {
                <tfoot class="table-light fw-bold">
                    <tr>
                        <td colspan="6">مجموع التفاصيل</td>
                        <td class="text-end">قبض: <span class="text-success">@Money.Format(Model.TotalReceipts)</span> / صرف: <span class="text-danger">@Money.Format(Model.TotalDisbursements)</span></td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
</div>