@model NewVixSmart.Web.ViewModels.Reports.AuditLedgerViewModel
@using NewVixSmart.Web.Extensions
@using NewVixSmart.Web.Models.Accounting
@{ ViewData["Title"] = "سجل التدقيق المركزي"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-journal-bookmark text-primary"></i> سجل التدقيق المركزي</h2>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> كل التقارير</a>
</div>

<div class="card mb-4"><div class="card-body">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-2">
            <label class="form-label" for="fromDate">من تاريخ</label>
            <input type="date" name="from" value="@ViewBag.From" id="fromDate" class="form-control" />
        </div>
        <div class="col-md-2">
            <label class="form-label" for="toDate">إلى تاريخ</label>
            <input type="date" name="to" value="@ViewBag.To" id="toDate" class="form-control" />
        </div>
        <div class="col-md-3">
            <label class="form-label" for="accountFilter">الحساب</label>
            <select name="accountId" id="accountFilter" class="form-select">
                <option value="">كل الحسابات</option>
                @foreach (var a in (System.Collections.Generic.IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Accounts ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                {
                    var isSelected = Model.AccountId.HasValue && Model.AccountId.Value.ToString() == a.Value;
                    <option value="@a.Value" selected="@(isSelected)">@a.Text</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label" for="sourceFilter">المصدر</label>
            <select name="source" id="sourceFilter" class="form-select">
                <option value="">كل المصادر</option>
                @foreach (var s in Enum.GetValues<JournalSource>())
                {
                    <option value="@s" selected="@(Model.Source == s)">@s.GetDisplayName()</option>
                }
            </select>
        </div>
        <div class="col-md-1"><button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> عرض</button></div>
        <div class="col-md-2">
            <a asp-action="AuditLedgerXlsx"
               asp-route-from="@ViewBag.From"
               asp-route-to="@ViewBag.To"
               asp-route-accountId="@Model.AccountId"
               asp-route-source="@Model.Source?.ToString()"
               class="btn btn-outline-success w-100"><i class="bi bi-file-earmark-excel"></i> تصدير Excel</a>
        </div>
    </form>
</div></div>

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-3"><div class="stat-card text-center"><div class="text-muted small">عدد القيود</div><h3 class="mb-0">@Model.TotalEntries</h3></div></div>
    <div class="col-12 col-sm-6 col-lg-3"><div class="stat-card text-center"><div class="text-muted small">إجمالي المدين</div><h3 class="mb-0 text-primary">@Model.TotalDebit.ToString("N2")</h3></div></div>
    <div class="col-12 col-sm-6 col-lg-3"><div class="stat-card text-center"><div class="text-muted small">إجمالي الدائن</div><h3 class="mb-0 text-success">@Model.TotalCredit.ToString("N2")</h3></div></div>
    <div class="col-12 col-sm-6 col-lg-3"><div class="stat-card text-center">
        <div class="text-muted small">حالة توازن الفترة</div>
        @if (Model.IsBalanced)
        { <h4 class="mb-0 text-success"><i class="bi bi-check-circle"></i> متوازن</h4> }
        else
        { <h4 class="mb-0 text-danger"><i class="bi bi-x-circle"></i> غير متوازن</h4> }
    </div></div>
</div>

<div class="table-container">
    <table class="table table-hover mb-0">
        <thead><tr>
            <th scope="col">رقم القيد</th><th scope="col">التاريخ</th><th scope="col">البيان</th><th scope="col">المصدر</th><th scope="col">المرجع</th><th scope="col">الفرع</th><th scope="col">أنشئ بواسطة</th><th scope="col">مدين</th><th scope="col">دائن</th><th scope="col">التوازن</th><th scope="col" class="visually-hidden">التفاصيل</th>
        </tr></thead>
        <tbody>
            @foreach (var e in Model.Entries)
            {
                var detailsId = "details-" + e.Id;
                <tr class="table-primary fw-bold">
                    <td><code>@e.EntryNumber</code></td>
                    <td>@e.Date.ToString("dd/MM/yyyy")</td>
                    <td>@e.Description</td>
                    <td>@e.SourceDisplayName</td>
                    <td>@(e.SourceId > 0 ? e.SourceId.ToString() : "—")</td>
                    <td>@(e.BranchId?.ToString() ?? "—")</td>
                    <td>@(e.CreatedBy ?? "—")</td>
                    <td class="text-primary">@e.TotalDebit.ToString("N2")</td>
                    <td class="text-success">@e.TotalCredit.ToString("N2")</td>
                    <td class="@(e.IsBalanced ? "text-success" : "text-danger")">@e.Balance.ToString("N2")</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="collapse" data-bs-target="#@detailsId" aria-expanded="false" aria-controls="@detailsId" aria-label="عرض تفاصيل القيد @e.EntryNumber">
                            <i class="bi bi-eye" aria-hidden="true"></i>
                        </button>
                    </td>
                </tr>
                <tr class="collapse" id="@detailsId">@* aria via heading row above *@
                    <td colspan="11" class="p-0">
                        <table class="table table-sm table-striped mb-0">
                            <thead><tr class="table-light">
                                <th scope="col">رمز الحساب</th><th scope="col">اسم الحساب</th><th scope="col">مدين</th><th scope="col">دائن</th><th scope="col">البيان</th>
                            </tr></thead>
                            <tbody>
                                @foreach (var l in e.Lines)
                                {
                                    <tr>
                                        <td><code>@l.AccountCode</code></td>
                                        <td>@l.AccountName</td>
                                        <td>@(l.Debit > 0 ? l.Debit.ToString("N2") : "—")</td>
                                        <td>@(l.Credit > 0 ? l.Credit.ToString("N2") : "—")</td>
                                        <td>@(l.Description ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Entries.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-inbox" style="font-size:3rem;"></i>
        <p class="mt-2">لا توجد قيود مطابقة في هذه الفترة</p>
    </div>
}

<div class="mt-4 d-print-none">
    <button type="button" class="btn btn-outline-dark" data-auto-print><i class="bi bi-printer"></i> طباعة</button>
</div>