@model NewVixSmart.Web.ViewModels.Reports.BalanceSheetReportViewModel
@{ ViewData["Title"] = "الميزانية العمومية"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">القوائم المالية</span>
        <h2><i class="bi bi-layers text-primary" aria-hidden="true"></i> الميزانية العمومية</h2>
    </div>
    <div class="ui-pagehead-actions">
        <a asp-action="Index" class="ui-btn ui-btn-quiet"><i class="bi bi-arrow-right" aria-hidden="true"></i> كل التقارير</a>
    </div>
</div>

<div class="ui-card ui-section ui-rise">
    <div class="card-body">
        <form method="get" class="ui-grid ui-grid-3 items-end">
            <div>
                <label class="form-label" for="asOfDate">حتى تاريخ</label>
                <input type="date" name="asOf" value="@Model.AsOf.ToString("yyyy-MM-dd")" id="asOfDate" class="form-control" />
            </div>
            <div><button type="submit" class="ui-btn ui-btn-outline w-full"><i class="bi bi-search" aria-hidden="true"></i> عرض</button></div>
        </form>
    </div>
</div>

<div class="ui-grid ui-grid-3 ui-section ui-rise">
    <div class="ui-stat">
        <span class="ui-stat-label">إجمالي الأصول</span>
        <span class="ui-stat-value text-primary">@Money.Format(Model.TotalAssets)</span>
    </div>
    <div class="ui-stat">
        <span class="ui-stat-label">إجمالي الخصوم + حقوق الملكية</span>
        <span class="ui-stat-value text-primary">@Money.Format(Model.TotalLiabilitiesEquity)</span>
    </div>
    <div class="ui-stat">
        <span class="ui-stat-label">حالة التوازن</span>
        @if (Model.IsBalanced)
        { <span class="ui-stat-value text-success"><i class="bi bi-check-circle" aria-hidden="true"></i> متوازنة</span> }
        else
        { <span class="ui-stat-value text-danger"><i class="bi bi-x-circle" aria-hidden="true"></i> غير متوازنة</span> }
    </div>
</div>

<div class="ui-grid ui-grid-2 ui-rise">
    <div class="ui-card">
        <div class="card-header fw-bold">@Model.Assets.Title</div>
        <div class="table-container">
            <table class="table" data-table-plain>
                <caption class="visually-hidden">@Model.Assets.Title</caption>
                <thead><tr><th scope="col">الرمز</th><th scope="col">الحساب</th><th scope="col" class="text-end">المبلغ</th></tr></thead>
                <tbody>
                    @foreach (var l in Model.Assets.Lines)
                    {
                        <tr><td><code>@l.Code</code></td><td>@l.Name</td><td class="num">@Money.Format(l.Amount)</td></tr>
                    }
                </tbody>
                <tfoot><tr class="fw-bold"><th scope="row" colspan="2">إجمالي الأصول</th><td class="text-primary num fw-bold">@Money.Format(Model.Assets.Total)</td></tr></tfoot>
            </table>
        </div>
    </div>
    <div class="flex flex-col gap-4">
        <div class="ui-card">
            <div class="card-header fw-bold">@Model.Liabilities.Title</div>
            <div class="table-container">
                <table class="table" data-table-plain>
                    <caption class="visually-hidden">@Model.Liabilities.Title</caption>
                    <thead><tr><th scope="col">الرمز</th><th scope="col">الحساب</th><th scope="col" class="text-end">المبلغ</th></tr></thead>
                    <tbody>
                        @foreach (var l in Model.Liabilities.Lines)
                        {
                            <tr><td><code>@l.Code</code></td><td>@l.Name</td><td class="num">@Money.Format(l.Amount)</td></tr>
                        }
                    </tbody>
                    <tfoot><tr class="fw-bold"><th scope="row" colspan="2">إجمالي الخصوم</th><td class="num fw-bold">@Money.Format(Model.Liabilities.Total)</td></tr></tfoot>
                </table>
            </div>
        </div>
        <div class="ui-card">
            <div class="card-header fw-bold">@Model.Equity.Title</div>
            <div class="table-container">
                <table class="table" data-table-plain>
                    <caption class="visually-hidden">@Model.Equity.Title</caption>
                    <thead><tr><th scope="col">الرمز</th><th scope="col">الحساب</th><th scope="col" class="text-end">المبلغ</th></tr></thead>
                    <tbody>
                        @foreach (var l in Model.Equity.Lines)
                        {
                            <tr><td><code>@l.Code</code></td><td>@l.Name</td><td class="num">@Money.Format(l.Amount)</td></tr>
                        }
                        <tr><td></td><td>صافي الدخل (الفترة)</td><td class="fw-bold num @(Model.NetIncome >= 0 ? "text-success" : "text-danger")">@Money.Format(Model.NetIncome)</td></tr>
                    </tbody>
                    <tfoot><tr class="fw-bold"><th scope="row" colspan="2">إجمالي حقوق الملكية</th><td class="text-success num fw-bold">@Money.Format(Model.Equity.Total + Model.NetIncome)</td></tr></tfoot>
                </table>
            </div>
        </div>
        <div class="table-container">
            <table class="table">
                <caption class="visually-hidden">إجمالي الخصوم مضافاً إليه حقوق الملكية</caption>
                <tbody>
                    <tr class="fw-bold"><td>إجمالي الخصوم + حقوق الملكية</td><td class="text-end text-primary num fw-bold">@Money.Format(Model.TotalLiabilitiesEquity)</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (!Model.Assets.Lines.Any() && !Model.Liabilities.Lines.Any() && !Model.Equity.Lines.Any())
{
    <div class="empty-state ui-rise">
        <div class="empty-icon"><i class="bi bi-inbox" aria-hidden="true"></i></div>
        <strong>لا توجد حسابات في القائمة</strong>
    </div>
}

<div class="mt-4 flex flex-wrap gap-2 no-print">
    <button type="button" class="ui-btn ui-btn-quiet" data-auto-print><i class="bi bi-printer" aria-hidden="true"></i> طباعة</button>
    <a asp-action="ExportBalanceSheetPdf" asp-route-asOf="@Model.AsOf.ToString("yyyy-MM-dd")" class="ui-btn ui-btn-danger"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> تصدير PDF</a>
    <a asp-action="ExportBalanceSheetXlsx" asp-route-asOf="@Model.AsOf.ToString("yyyy-MM-dd")" class="ui-btn ui-btn-ok"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> تصدير Excel</a>
</div>
