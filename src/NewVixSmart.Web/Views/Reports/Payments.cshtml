@model NewVixSmart.Web.ViewModels.Reports.PaymentReportViewModel
@using NewVixSmart.Web.Models.Accounting
@{ ViewData["Title"] = "تقرير المدفوعات"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">التقارير</span>
        <h2><i class="bi bi-wallet2" aria-hidden="true"></i> تقرير المدفوعات</h2>
    </div>
    <div class="ui-pagehead-actions">
        <a asp-action="Index" class="ui-btn ui-btn-quiet"><i class="bi bi-arrow-right" aria-hidden="true"></i> كل التقارير</a>
    </div>
</div>

<div class="ui-section ui-card ui-rise">
    <div class="card-body">
        <form method="get" class="ui-grid ui-grid-4 items-end">
            <div>
                <label class="form-label" for="from">من تاريخ</label>
                <input type="date" name="from" id="from" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div>
                <label class="form-label" for="to">إلى تاريخ</label>
                <input type="date" name="to" id="to" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div><button type="submit" class="ui-btn ui-btn-outline w-full"><i class="bi bi-search" aria-hidden="true"></i> عرض</button></div>
            <div>
                <a asp-action="ExportPaymentsXlsx" asp-route-from="@ViewBag.From" asp-route-to="@ViewBag.To" class="ui-btn ui-btn-outline w-full"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> تصدير Excel</a>
            </div>
        </form>
    </div>
</div>

<div class="ui-grid ui-grid-3 ui-section">
    <div class="ui-stat text-center"><div class="ui-stat-label">مقبوضات (من عملاء)</div><h3 class="ui-stat-value text-success num">@Money.Format(Model.TotalReceipts)</h3><div class="ui-stat-hint">@Model.ReceiptCount عملية</div></div>
    <div class="ui-stat text-center"><div class="ui-stat-label">مصروفات (لموردين)</div><h3 class="ui-stat-value text-danger num">@Money.Format(Model.TotalDisbursements)</h3><div class="ui-stat-hint">@Model.DisbursementCount عملية</div></div>
    <div class="ui-stat text-center"><div class="ui-stat-label">الصافي</div><h3 class="ui-stat-value @(Model.Balance >= 0 ? "text-success" : "text-danger") num">@Money.Format(Model.Balance)</h3></div>
</div>

<div class="table-container ui-rise">
    <table class="table">
        <caption class="visually-hidden">حركات المقبوضات والمصروفات في الفترة: الإيصال والنوع والطرف والمبلغ والطريقة</caption>
        <thead><tr><th scope="col">الإيصال</th><th scope="col">النوع</th><th scope="col">العميل/المورد</th><th scope="col">المبلغ</th><th scope="col">الطريقة</th><th scope="col">التاريخ</th></tr></thead>
        <tbody>
            @foreach (var p in Model.Payments)
            {
                <tr>
                    <td><code>@p.ReceiptNumber</code></td>
                    <td>
                        @if (p.Type == PaymentType.Receipt)
                        { <span class="ui-badge ui-badge-ok">قبض</span> }
                        else
                        { <span class="ui-badge ui-badge-bad">صرف</span> }
                    </td>
                    <td>@(p.Customer?.Name ?? p.Supplier?.Name ?? "—")</td>
                    <td class="fw-bold @(p.Type == PaymentType.Receipt ? "text-success" : "text-danger") num">@Money.Format(p.Amount)</td>
                    <td>@p.Method.GetDisplayName()</td>
                    <td>@p.PaymentDate.ToString("dd/MM/yyyy")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Payments.Any())
{
    <div class="empty-state ui-rise">
        <div class="empty-icon"><i class="bi bi-inbox" aria-hidden="true"></i></div>
        <p class="text-muted">لا توجد مدفوعات في هذه الفترة</p>
    </div>
}

<div class="mt-4 d-print-none">
    <button type="button" class="ui-btn ui-btn-quiet" data-auto-print><i class="bi bi-printer" aria-hidden="true"></i> طباعة</button>
</div>
