@{ ViewData["Title"] = "التقارير"; }

@inject NewVixSmart.Web.Services.IPermissionService Perm

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">التقارير</span>
        <h2><i class="bi bi-file-earmark-bar-graph" aria-hidden="true"></i> التقارير</h2>
    </div>
    <div class="ui-pagehead-actions">
        <a asp-action="Dashboard" class="ui-btn ui-btn-pri"><i class="bi bi-speedometer2" aria-hidden="true"></i> لوحة التقارير</a>
    </div>
</div>
<p class="text-muted mb-4">اختار نوع التقرير لعرض ملخص وحركات الفترة</p>

<div class="ui-grid ui-grid-3 ui-section ui-rise">
    <div class="ui-card text-center">
        <div class="card-body">
            <i class="bi bi-cart-check text-primary text-5xl" aria-hidden="true"></i>
            <h3 class="mt-3">تقرير المبيعات</h3>
            <p class="text-muted small">فواتير البيع ومرتجعات البيع في فترة محددة</p>
            <a asp-action="Sales" class="ui-btn ui-btn-pri"><i class="bi bi-arrow-left" aria-hidden="true"></i> فتح التقرير</a>
        </div>
    </div>
    <div class="ui-card text-center">
        <div class="card-body">
            <i class="bi bi-cart-dash text-warning text-5xl" aria-hidden="true"></i>
            <h3 class="mt-3">تقرير المشتريات</h3>
            <p class="text-muted small">فواتير الشراء ومرتجعات الشراء في فترة محددة</p>
            <a asp-action="Purchases" class="ui-btn ui-btn-pri"><i class="bi bi-arrow-left" aria-hidden="true"></i> فتح التقرير</a>
        </div>
    </div>
    <div class="ui-card text-center">
        <div class="card-body">
            <i class="bi bi-wallet2 text-success text-5xl" aria-hidden="true"></i>
            <h3 class="mt-3">تقرير المدفوعات</h3>
            <p class="text-muted small">المقبوضات والمصروفات في فترة محددة</p>
            <a asp-action="Payments" class="ui-btn ui-btn-pri"><i class="bi bi-arrow-left" aria-hidden="true"></i> فتح التقرير</a>
        </div>
    </div>
</div>

<div class="ui-grid ui-grid-3 ui-section">
    <div class="ui-card text-center">
        <div class="card-body">
            <i class="bi bi-box-seam text-primary text-5xl" aria-hidden="true"></i>
            <h3 class="mt-3">تصدير الأصناف</h3>
            <p class="text-muted small">قائمة الأصناف وأرصدتها (Excel)</p>
            <a asp-action="ExportItemsXlsx" class="ui-btn ui-btn-outline"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> تصدير Excel</a>
        </div>
    </div>
    <div class="ui-card text-center">
        <div class="card-body">
            <i class="bi bi-boxes text-warning text-5xl" aria-hidden="true"></i>
            <h3 class="mt-3">لقطة المخزون</h3>
            <p class="text-muted small">أرصدة المخزون الحالية (Excel)</p>
            <div class="flex flex-wrap items-center justify-center gap-2">
                <a asp-action="ExportStockXlsx" class="ui-btn ui-btn-outline"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> كل الأصناف</a>
                <a asp-action="ExportStockXlsx" asp-route-lowOnly="true" class="ui-btn ui-btn-outline"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> المنخفض</a>
            </div>
        </div>
    </div>
    <div class="ui-card text-center">
        <div class="card-body">
            <i class="bi bi-balance-scale text-danger text-5xl" aria-hidden="true"></i>
            <h3 class="mt-3">القوائم المالية</h3>
            <p class="text-muted small">ميزان المراجعة والقوائم مع تصدير PDF وExcel</p>
            <a asp-action="TrialBalance" class="ui-btn ui-btn-pri"><i class="bi bi-arrow-left" aria-hidden="true"></i> فتح القوائم</a>
        </div>
    </div>
    @if (await Perm.HasAsync("AuditLedger.View"))
    {
        <div class="ui-card text-center">
            <div class="card-body">
                <i class="bi bi-journal-bookmark text-primary text-5xl" aria-hidden="true"></i>
                <h3 class="mt-3">سجل التدقيق المركزي</h3>
                <p class="text-muted small">كل قيود دفتر الأستاذ العام مع تصدير Excel</p>
                <a asp-action="AuditLedger" class="ui-btn ui-btn-pri"><i class="bi bi-arrow-left" aria-hidden="true"></i> فتح السجل</a>
            </div>
        </div>
    }
    @if (await Perm.HasAsync("Aging.View"))
    {
        <div class="ui-card text-center">
            <div class="card-body">
                <i class="bi bi-hourglass-split text-warning text-5xl" aria-hidden="true"></i>
                <h3 class="mt-3">القائمة العمرية</h3>
                <p class="text-muted small">تحليل ذمم العملاء والموردين حسب تاريخ الاستحقاق مع تصدير Excel</p>
                <a asp-action="Aging" class="ui-btn ui-btn-pri"><i class="bi bi-arrow-left" aria-hidden="true"></i> فتح التقرير</a>
            </div>
        </div>
    }
    <div class="ui-card text-center">
        <div class="card-body">
            <i class="bi bi-cash-stack text-success text-5xl" aria-hidden="true"></i>
            <h3 class="mt-3">كشف التدفق النقدي</h3>
            <p class="text-muted small">المقبوضات والمصروفات وصافي التدفق مع تصدير Excel</p>
            <a asp-action="CashFlow" class="ui-btn ui-btn-pri"><i class="bi bi-arrow-left" aria-hidden="true"></i> فتح التقرير</a>
        </div>
    </div>
</div>

@{
    var pending = ViewBag.PendingDeliveries as NewVixSmart.Web.ViewModels.Reports.PendingDeliveryReportViewModel;
}
@if (pending != null)
{
    <div class="ui-section ui-card">
        <div class="card-header">
            <span><i class="bi bi-truck" aria-hidden="true"></i> تسليمات معلّقة (ملتزمة وغير مسلَّمة)</span>
            <span class="ui-badge ui-badge-info">
                @pending.Lines.Count سطراً · @pending.TotalQty.ToString("N0") كمية · @pending.TotalCount.ToString("N0") عدد · <span class="num">@Money.Format(pending.TotalValue)</span>
            </span>
        </div>
        <div class="card-body p-0">
            <div class="table-container">
                <table class="table">
                    <caption class="visually-hidden">الكميات المتعاقد عليها وغير المسلّمة لكل عميل</caption>
                    <thead><tr>
                        <th scope="col">العميل</th>
                        <th scope="col">الأمر</th>
                        <th scope="col">المتوقع</th>
                        <th scope="col">الصنف</th>
                        <th scope="col">مطلوب</th>
                        <th scope="col">مسلَّم</th>
                        <th scope="col">مفوتر</th>
                        <th scope="col">محجوز</th>
                        <th scope="col">متبقٍ</th>
                        <th scope="col">القيمة</th>
                    </tr></thead>
                    <tbody>
                        @if (!pending.Lines.Any())
                        {
                            <tr><td colspan="10" class="text-center text-muted">لا توجد تسليمات معلّقة</td></tr>
                        }
                        @foreach (var l in pending.Lines.Take(15))
                        {
                            <tr>
                                <th scope="row"><a asp-controller="Customers" asp-action="PendingDeliveries" asp-route-id="@l.CustomerId">@l.CustomerName</a></th>
                                <td><a asp-controller="SalesOrders" asp-action="Details" asp-route-id="@l.OrderPublicId">@l.OrderNumber</a></td>
                                <td>@(l.ExpectedDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td>@l.ItemName</td>
                                <td class="num">@l.Quantity.ToString("N2") / @l.Count.ToString("N2")</td>
                                <td class="num">@l.DeliveredQty.ToString("N2") / @l.DeliveredCount.ToString("N2")</td>
                                <td class="num">@l.InvoicedQty.ToString("N2") / @l.InvoicedCount.ToString("N2")</td>
                                <td class="num">@l.ReservedQty.ToString("N2") / @l.ReservedCount.ToString("N2")</td>
                                <td class="fw-bold num">@l.PendingQty.ToString("N2") / @l.PendingCount.ToString("N2")</td>
                                <td class="num">@Money.Format(l.PendingValue)</td>
                            </tr>
                        }
                    </tbody>
                    @if (pending.Lines.Any())
                    {
                        <tfoot><tr class="fw-bold">
                            <th scope="row" colspan="9">الإجمالي</th>
                            <td class="num">@Money.Format(pending.TotalValue)</td>
                        </tr></tfoot>
                    }
                </table>
            </div>
            @if (pending.Lines.Count > 15)
            {
                <div class="card-footer text-muted small">تُعرض أول 15 سطراً من @pending.Lines.Count. للقائمة الكاملة راجع صفحة كل عميل.</div>
            }
            else
            {
                <div class="card-footer text-muted small">الأرقام معروضة بالترتيب: كمية / عدد. القيمة غير محسوبة في ذمم العميل.</div>
            }
        </div>
    </div>
}
