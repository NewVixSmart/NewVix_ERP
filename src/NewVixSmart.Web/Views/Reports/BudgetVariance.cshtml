@model NewVixSmart.Web.ViewModels.Reports.BudgetVarianceViewModel
@{ ViewData["Title"] = $"واريانس الميزانية — سنة {Model.Year}"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">التقارير</span>
        <h2><i class="bi bi-graph-up text-primary" aria-hidden="true"></i> واريانس الميزانية — سنة @Model.Year</h2>
    </div>
    <div class="ui-pagehead-actions">
        <form method="get" class="flex items-center gap-2">
            <label class="visually-hidden" for="yearFilter">السنة</label>
            <select name="year" id="yearFilter" class="form-select" data-auto-submit>
                @foreach (var y in Model.Revenues)
                {
                    <option value="@y" selected="@(y == Model.Year)">@y</option>
                }
            </select>
        </form>
        <a asp-action="BudgetVarianceXlsx" asp-route-year="@Model.Year" class="ui-btn ui-btn-ok"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> تصدير XLSX</a>
    </div>
</div>

<div class="ui-grid ui-grid-4 ui-section ui-rise">
    <div class="ui-stat">
        <span class="ui-stat-label"><i class="bi bi-arrow-up text-success" aria-hidden="true"></i> ميزانية الإيرادات</span>
        <span class="ui-stat-value">@Money.Format(Model.TotalBudgetRevenue)</span>
    </div>
    <div class="ui-stat">
        <span class="ui-stat-label"><i class="bi bi-currency-exchange text-success" aria-hidden="true"></i> فعلي الإيرادات</span>
        <span class="ui-stat-value">@Money.Format(Model.TotalActualRevenue)</span>
    </div>
    <div class="ui-stat">
        <span class="ui-stat-label"><i class="bi bi-arrow-down text-danger" aria-hidden="true"></i> ميزانية المصاريف</span>
        <span class="ui-stat-value">@Money.Format(Model.TotalBudgetExpense)</span>
    </div>
    <div class="ui-stat">
        <span class="ui-stat-label"><i class="bi bi-currency-exchange text-danger" aria-hidden="true"></i> فعلي المصاريف</span>
        <span class="ui-stat-value">@Money.Format(Model.TotalActualExpense)</span>
    </div>
</div>

<div class="table-container ui-rise">
    <table class="table">
        <caption class="visually-hidden">واريانس الميزانية لكل حساب: الميزانية والفعلي والفرق ونسبة الإنجاز</caption>
        <thead>
            <tr>
                <th scope="col">الرمز</th>
                <th scope="col">الحساب</th>
                <th scope="col">النوع</th>
                <th scope="col" class="text-end">الميزانية</th>
                <th scope="col" class="text-end">الفعلي</th>
                <th scope="col" class="text-end">الواريانس (فعلي - ميزانية)</th>
                <th scope="col" class="text-end">النسبة %</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td><code>@r.Code</code></td>
                    <td><strong>@r.Name</strong></td>
                    <td>@r.Type.ToString()</td>
                    <td class="num">@Money.Format(r.Budget)</td>
                    <td class="num">@Money.Format(r.Actual)</td>
                    <td class="num">
                        <span class="@(r.Variance >= 0 ? "text-success" : "text-danger")">@Money.Format(r.Variance)</span>
                    </td>
                    <td class="num">@r.VariancePct.ToString("P2")</td>
                </tr>
            }
            @if (!Model.Rows.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">لا توجد بنود ميزانية مسجلة لهذه السنة من حسابات P&amp;L</td></tr>
            }
        </tbody>
        @if (Model.Rows.Any())
        {
            <tfoot>
                <tr class="fw-bold">
                    <th scope="row" colspan="2">الإجمالي</th>
                    <td></td>
                    <td class="num fw-bold">@Money.Format(Model.TotalBudgetRevenue + Model.TotalBudgetExpense)</td>
                    <td class="num fw-bold">@Money.Format(Model.TotalActualRevenue + Model.TotalActualExpense)</td>
                    <td class="num fw-bold">@Money.Format(Model.TotalActualRevenue - Model.TotalBudgetRevenue + Model.TotalActualExpense - Model.TotalBudgetExpense)</td>
                    <td></td>
                </tr>
            </tfoot>
        }
    </table>
</div>

<div class="mt-3">
    <small class="text-muted">
        اصطلاح الإشارة: الواريانس = الفعلي − الميزانية. بالنسبة لحسابات الإيرادات يكون الواريانس الموجب إيجابيًا (إنجاز أعلى من المخطط)، وبالنسبة لحسابات المصاريف يُحسب بالمعادلة نفسها (الموجب يعني إنفاق أعلى من المخطط).
    </small>
</div>
