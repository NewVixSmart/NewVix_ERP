@model NewVixSmart.Web.ViewModels.Reports.BudgetVarianceViewModel
@{ ViewData["Title"] = $"واريانس الميزانية — سنة {Model.Year}"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-graph-up text-primary"></i> واريانس الميزانية — سنة @Model.Year</h2>
    <div class="d-flex gap-2">
        <form method="get" class="d-flex gap-2">
            <label class="visually-hidden" for="yearFilter">السنة</label>
            <select name="year" id="yearFilter" class="form-select" data-auto-submit>
                @foreach (var y in Model.Revenues)
                {
                    <option value="@y" selected="@(y == Model.Year)">@y</option>
                }
            </select>
        </form>
        <a asp-action="BudgetVarianceXlsx" asp-route-year="@Model.Year" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel"></i> تصدير XLSX</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-2">
                <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-arrow-up"></i></div>
                <div><small class="text-muted">ميزانية الإيرادات</small><div class="fw-bold">@Money.Format(Model.TotalBudgetRevenue)</div></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-2">
                <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-currency"></i></div>
                <div><small class="text-muted">فعلي الإيرادات</small><div class="fw-bold">@Money.Format(Model.TotalActualRevenue)</div></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-2">
                <div class="stat-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-arrow-down"></i></div>
                <div><small class="text-muted">ميزانية المصاريف</small><div class="fw-bold">@Money.Format(Model.TotalBudgetExpense)</div></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-3">
        <div class="stat-card">
            <div class="d-flex align-items-center gap-2">
                <div class="stat-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-currency"></i></div>
                <div><small class="text-muted">فعلي المصاريف</small><div class="fw-bold">@Money.Format(Model.TotalActualExpense)</div></div>
            </div>
        </div>
    </div>
</div>

<div class="table-container">
    <table class="table table-hover mb-0">
        <caption class="visually-hidden">واريانس الميزانية لكل حساب: الميزانية والفعلي والفرق ونسبة الإنجاز</caption>
        <thead>
                    <tr>
                        <th scope="col">الرمز</th>
                        <th scope="col">الحساب</th>
                        <th scope="col">النوع</th>
                        <th scope="col" class="text-start">الميزانية</th>
                        <th scope="col" class="text-start">الفعلي</th>
                        <th scope="col" class="text-start">الواريانس (فعلي - ميزانية)</th>
                        <th scope="col" class="text-start">النسبة %</th>
                    </tr>
        </thead>
        <tbody>
            @foreach (var r in Model.Rows)
            {
                <tr>
                    <td><code>@r.Code</code></td>
                    <td><strong>@r.Name</strong></td>
                    <td>@r.Type.ToString()</td>
                    <td class="text-start">@Money.Format(r.Budget)</td>
                    <td class="text-start">@Money.Format(r.Actual)</td>
                    <td class="text-start">
                        <span class="@(r.Variance >= 0 ? "text-success" : "text-danger")">@Money.Format(r.Variance)</span>
                    </td>
                    <td class="text-start">@r.VariancePct.ToString("P2")</td>
                </tr>
            }
            @if (!Model.Rows.Any())
            {
                <tr><td colspan="7" class="text-center text-muted py-4">لا توجد بنود ميزانية مسجلة لهذه السنة من حسابات P&amp;L</td></tr>
            }
        </tbody>
        @if (Model.Rows.Any())
        {
            <tfoot>
                <tr class="fw-bold table-light">
                    <th scope="row" colspan="2">الإجمالي</th>
                    <td></td>
                    <td class="text-start">@Money.Format(Model.TotalBudgetRevenue + Model.TotalBudgetExpense)</td>
                    <td class="text-start">@Money.Format(Model.TotalActualRevenue + Model.TotalActualExpense)</td>
                    <td class="text-start">@Money.Format(Model.TotalActualRevenue - Model.TotalBudgetRevenue + Model.TotalActualExpense - Model.TotalBudgetExpense)</td>
                    <td></td>
                </tr>
            </tfoot>
        }
    </table>
</div>

<div class="mt-3">
    <small class="text-muted">
        اصطلاح الإشارة: الواريانس = الفعلي − الميزانية. بالنسبة لحسابات الإيرادات يكون الواريانس الموجب إيجابيًا (إنجاز أعلى من المخطط)، وبالنسبة لحسابات المصاريف يُحسب بالمعادلة نفسها (الموجب يعني إنفاق أعلى من المخطط).
    </small>
</div>
