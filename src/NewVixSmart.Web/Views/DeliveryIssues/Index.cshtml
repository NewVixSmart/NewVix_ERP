@model IReadOnlyList<NewVixSmart.Web.Models.Sales.DeliveryIssue>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@using NewVixSmart.Web.Models.Sales
@using NewVixSmart.Web.Extensions
@{ ViewData["Title"] = "أوامر التسليم"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المبيعات</span>
        <h2>أوامر التسليم</h2>
    </div>
    @if (await Perm.HasAsync("DeliveryIssues.Create"))
    {
        <div class="ui-pagehead-actions">
            <a asp-action="Create" class="ui-btn ui-btn-pri"><i class="bi bi-plus-lg" aria-hidden="true"></i> أمر تسليم جديد</a>
        </div>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="ui-alert ui-alert-ok ui-rise" role="alert" aria-live="polite"><i class="bi bi-check-circle" aria-hidden="true"></i> @TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="ui-alert ui-alert-bad ui-rise" role="alert" aria-live="assertive"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @TempData["Error"]</div>
}

<ul class="nav nav-pills mb-4 ui-rise" aria-label="فلترة أوامر التسليم">
    <li><a class="nav-link @(ViewBag.StatusFilter == null ? "active" : "")" asp-action="Index">الكل</a></li>
    @foreach (var st in Enum.GetValues<DeliveryIssueStatus>())
    {
        <li><a class="nav-link @(ViewBag.StatusFilter as DeliveryIssueStatus? == st ? "active" : "")" asp-action="Index" asp-route-status="@st">@st.GetDisplayName()</a></li>
    }
</ul>

@if (!Model.Any())
{
    <div class="ui-alert ui-alert-info ui-rise">لا توجد أوامر تسليم بعد.</div>
}
else
{
    <div class="table-container ui-rise">
        <table class="table mb-0">
            <caption class="visually-hidden">قائمة أوامر التسليم مع رقم الأذن والأمر وحالة الفوترة</caption>
            <thead>
                <tr>
                    <th scope="col">رقم الأمر</th>
                    <th scope="col">أذن التسليم</th>
                    <th scope="col">أمر البيع</th>
                    <th scope="col">العميل</th>
                    <th scope="col">التاريخ</th>
                    <th scope="col">الحالة</th>
                    <th scope="col">الفاتورة</th>
                    <th scope="col" class="text-center">إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model)
                {
                    <tr>
                        <th scope="row"><code>@i.IssueNumber</code></th>
                        <td>
                            <a asp-controller="DeliveryOrders" asp-action="Details" asp-route-id="@i.DeliveryOrder?.PublicId">@i.DeliveryOrder?.DeliveryNumber</a>
                        </td>
                        <td>
                            @if (i.SalesOrder != null)
                            {
                                <a asp-controller="SalesOrders" asp-action="Details" asp-route-id="@i.SalesOrder.PublicId">@i.SalesOrder.OrderNumber</a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td>@(i.Customer?.Name ?? "—")</td>
                        <td>@i.IssueDate.ToString("dd/MM/yyyy")</td>
                        <td><span class="ui-badge @(i.Status switch { DeliveryIssueStatus.Issued => "ui-badge-ok", DeliveryIssueStatus.Cancelled => "ui-badge-bad", _ => "ui-badge-warn" })">@i.Status.GetDisplayName()</span></td>
                        <td>
                            @if (i.SaleInvoice != null)
                            {
                                <a asp-controller="Sales" asp-action="Details" asp-route-id="@i.SaleInvoice.PublicId">@i.SaleInvoice.InvoiceNumber</a>
                            }
                            else
                            {
                                <span>غير مفوتر</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@i.PublicId" class="ui-btn ui-btn-sm ui-btn-outline" aria-label="عرض أمر التسليم @i.IssueNumber"><i class="bi bi-eye" aria-hidden="true"></i></a>
                            <a asp-action="Print" asp-route-id="@i.PublicId" class="ui-btn ui-btn-sm ui-btn-quiet" aria-label="طباعة أمر التسليم @i.IssueNumber"><i class="bi bi-printer" aria-hidden="true"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
