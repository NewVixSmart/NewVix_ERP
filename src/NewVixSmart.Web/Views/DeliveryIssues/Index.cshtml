@model IReadOnlyList<NewVixSmart.Web.Models.Sales.DeliveryIssue>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@using NewVixSmart.Web.Models.Sales
@using NewVixSmart.Web.Extensions
@{ ViewData["Title"] = "أوامر التسليم"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-box-arrow-up-right text-primary"></i> أوامر التسليم</h2>
    @if (await Perm.HasAsync("DeliveryIssues.Create"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> أمر تسليم جديد</a>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button></div>
}

<ul class="nav nav-pills mb-3" aria-label="فلترة أوامر التسليم">
    <li class="nav-item"><a class="nav-link @(ViewBag.StatusFilter == null ? "active" : "")" asp-action="Index">الكل</a></li>
    @foreach (var st in Enum.GetValues<DeliveryIssueStatus>())
    {
        <li class="nav-item"><a class="nav-link @(ViewBag.StatusFilter as DeliveryIssueStatus? == st ? "active" : "")" asp-action="Index" asp-route-status="@st">@st.GetDisplayName()</a></li>
    }
</ul>

@if (!Model.Any())
{
    <div class="alert alert-info">لا توجد أوامر تسليم بعد.</div>
}
else
{
    <div class="table-container">
        <table class="table table-hover mb-0">
            <caption class="visually-hidden">قائمة أوامر التسليم مع رقم الأذن والأمر وحالة الفوترة</caption>
            <thead>
                <tr>
                    <th scope="col">رقم الأمر</th>
                    <th scope="col">أذن التسليم</th>
                    <th scope="col">أمر البيع</th>
                    <th scope="col">العميل</th>
                    <th scope="col">التاريخ</th>
                    <th scope="col">الحالة</th>
                    <th scope="col">الفاتورة</th>
                    <th scope="col" class="text-center">إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var i in Model)
                {
                    <tr>
                        <th scope="row"><code>@i.IssueNumber</code></th>
                        <td>
                            <a asp-controller="DeliveryOrders" asp-action="Details" asp-route-id="@i.DeliveryOrder?.PublicId">@i.DeliveryOrder?.DeliveryNumber</a>
                        </td>
                        <td>
                            @if (i.SalesOrder != null)
                            {
                                <a asp-controller="SalesOrders" asp-action="Details" asp-route-id="@i.SalesOrder.PublicId">@i.SalesOrder.OrderNumber</a>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                        <td>@(i.Customer?.Name ?? "—")</td>
                        <td>@i.IssueDate.ToString("dd/MM/yyyy")</td>
                        <td><span class="badge @(i.Status switch { DeliveryIssueStatus.Issued => "bg-success", DeliveryIssueStatus.Cancelled => "bg-danger", _ => "bg-warning text-dark" })">@i.Status.GetDisplayName()</span></td>
                        <td>
                            @if (i.SaleInvoice != null)
                            {
                                <a asp-controller="Sales" asp-action="Details" asp-route-id="@i.SaleInvoice.PublicId">@i.SaleInvoice.InvoiceNumber</a>
                            }
                            else
                            {
                                <span>غير مفوتر</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@i.PublicId" class="btn btn-sm btn-outline-info" aria-label="عرض أمر التسليم @i.IssueNumber"><i class="bi bi-eye"></i></a>
                            <a asp-action="Print" asp-route-id="@i.PublicId" class="btn btn-sm btn-outline-secondary" aria-label="طباعة أمر التسليم @i.IssueNumber"><i class="bi bi-printer"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
