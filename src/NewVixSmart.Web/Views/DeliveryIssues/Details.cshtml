@model NewVixSmart.Web.Models.Sales.DeliveryIssue
@inject NewVixSmart.Web.Services.IPermissionService Perm
@using NewVixSmart.Web.Models.Sales
@using NewVixSmart.Web.Extensions
@{
    ViewData["Title"] = "تفاصيل أمر التسليم";
    var canAct = Model.Status == DeliveryIssueStatus.Draft;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-box-arrow-up-right text-primary"></i> أمر تسليم <code>@Model.IssueNumber</code></h2>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">رجوع</a>
        <a asp-action="Print" asp-route-id="@Model.PublicId" class="btn btn-outline-secondary"><i class="bi bi-printer"></i> طباعة</a>
        @if (canAct && await Perm.HasAsync("DeliveryIssues.Issue"))
        {
            <form method="post" asp-action="Issue" asp-route-id="@Model.PublicId" class="d-inline"
                  onsubmit="return confirm('سيتم خصم المخزون وتسجيل التكلفة. هل تريد المتابعة؟');">
                <button type="submit" class="btn btn-success"><i class="bi bi-check2-circle"></i> ترحيل</button>
            </form>
            <form method="post" asp-action="Cancel" asp-route-id="@Model.PublicId" class="d-inline"
                  onsubmit="return confirm('هل تريد إلغاء أمر التسليم؟');">
                <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-circle"></i> إلغاء</button>
            </form>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success" role="alert">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
}

<div class="card mb-3">
    <div class="card-header">بيانات الأمر</div>
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">الحالة</dt>
            <dd class="col-sm-9">
                <span class="badge @(Model.Status switch { DeliveryIssueStatus.Issued => "bg-success", DeliveryIssueStatus.Cancelled => "bg-danger", _ => "bg-warning text-dark" })">@Model.Status.GetDisplayName()</span>
                @if (Model.Status == DeliveryIssueStatus.Draft)
                {
                    <span class="text-muted">— لم يُرحّل بعد، الكمية ما زالت في المخزون</span>
                }
                else if (Model.Status == DeliveryIssueStatus.Issued)
                {
                    <span class="text-muted">— خرجت الكمية من المخزون ورُحّلت تكلفتها</span>
                }
            </dd>

            <dt class="col-sm-3">أذن التسليم</dt>
            <dd class="col-sm-9">
                <a asp-controller="DeliveryOrders" asp-action="Details" asp-route-id="@Model.DeliveryOrder?.PublicId">@Model.DeliveryOrder?.DeliveryNumber</a>
            </dd>

            <dt class="col-sm-3">أمر البيع</dt>
            <dd class="col-sm-9">
                @if (Model.SalesOrder != null)
                {
                    <a asp-controller="SalesOrders" asp-action="Details" asp-route-id="@Model.SalesOrder.PublicId">@Model.SalesOrder.OrderNumber</a>
                }
                else
                {
                    <span>—</span>
                }
            </dd>

            <dt class="col-sm-3">العميل</dt>
            <dd class="col-sm-9">@(Model.Customer?.Name ?? "—")</dd>

            <dt class="col-sm-3">التاريخ</dt>
            <dd class="col-sm-9">@Model.IssueDate.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">الناقل</dt>
            <dd class="col-sm-9">@(Model.Carrier ?? "—")</dd>

            <dt class="col-sm-3">رقم التتبع</dt>
            <dd class="col-sm-9">@(Model.TrackingNumber ?? "—")</dd>

            <dt class="col-sm-3">الفاتورة</dt>
            <dd class="col-sm-9">
                @if (Model.SaleInvoice != null)
                {
                    <a asp-controller="Sales" asp-action="Details" asp-route-id="@Model.SaleInvoice.PublicId">@Model.SaleInvoice.InvoiceNumber</a>
                }
                else if (Model.Status == DeliveryIssueStatus.Issued)
                {
                    <span class="badge bg-info text-dark">غير مفوتر</span>
                }
                else
                {
                    <span>—</span>
                }
            </dd>

            @if (Model.Status == DeliveryIssueStatus.Issued)
            {
                <dt class="col-sm-3">رحّله</dt>
                <dd class="col-sm-9">@Model.IssuedAt?.ToString("dd/MM/yyyy HH:mm") بواسطة @(Model.IssuedBy ?? "—")</dd>
            }
        </dl>
    </div>
</div>

<div class="card">
    <div class="card-header">الأصناف</div>
    <div class="card-body">
        <div class="table-container">
            <table class="table table-hover mb-0">
                <caption class="visually-hidden">أصناف أمر التسليم بالكميات والعدد</caption>
                <thead><tr><th scope="col">الصنف</th><th scope="col">الكمية</th><th scope="col">العدد</th></tr></thead>
                <tbody>
                    @foreach (var line in Model.Items)
                    {
                        <tr>
                            <th scope="row">@line.Item?.Name</th>
                            <td>@line.Quantity.ToString("N2")</td>
                            <td>@line.Count.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
