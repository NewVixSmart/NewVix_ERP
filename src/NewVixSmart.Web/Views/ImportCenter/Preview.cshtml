@model NewVixSmart.Web.ViewModels.Import.ImportPreviewViewModel
@{
    ViewData["Title"] = "معاينة الاستيراد";
}

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">مركز الاستيراد</span>
        <h2><i class="bi bi-eye" aria-hidden="true"></i> معاينة استيراد @Model.EntityNameAr</h2>
    </div>
    <div class="ui-pagehead-actions">
        <a asp-action="Index" class="ui-btn ui-btn-sm ui-btn-quiet"><i class="bi bi-arrow-right" aria-hidden="true"></i> العودة لمركز الاستيراد</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.FatalError))
{
    <div class="ui-alert ui-alert-bad flex items-center gap-2" role="alert">
        <i class="bi bi-x-octagon" aria-hidden="true"></i>
        <span>@Model.FatalError</span>
    </div>
}
else
{
    <div class="flex flex-wrap items-center gap-2 mb-4">
        <span class="ui-badge ui-badge-mute">إجمالي الصفوف: @Model.TotalCount</span>
        <span class="ui-badge ui-badge-ok">مقبولة: @Model.ValidCount</span>
        <span class="ui-badge ui-badge-bad">بها أخطاء: @Model.ErrorCount</span>
        @if (Model.DuplicateCount > 0)
        {
            <span class="ui-badge ui-badge-warn">مكررة في الملف: @Model.DuplicateCount</span>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.Warning))
    {
        <div class="ui-alert ui-alert-warn flex items-center gap-2" role="note">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            <span>@Model.Warning</span>
        </div>
    }

    <div class="ui-section ui-card">
        <div class="ui-card-body table-responsive">
            @if (Model.Rows.Count == 0)
            {
                <p class="mb-0">لا توجد صفوف بيانات لعرضها.</p>
            }
            else
            {
                <table class="table">
                    <caption class="visually-hidden">معاينة صفوف ملف الاستيراد: رقم الصف، أعمدة الملف، حالة الصف</caption>
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            @foreach (var header in Model.Headers)
                            {
                                <th scope="col">@header</th>
                            }
                            <th scope="col">الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td class="num">@row.RowNumber</td>
                                @foreach (var value in row.Values)
                                {
                                    <td>@value</td>
                                }
                                <td>
                                    @if (row.Errors.Count > 0)
                                    {
                                        <span class="small text-danger block">@string.Join(" - ", row.Errors)</span>
                                    }
                                    @if (!string.IsNullOrEmpty(row.Notice))
                                    {
                                        <span class="small @(row.IsDuplicate ? "text-warning" : "text-success") block">@row.Notice</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @if (Model.HasValidRows)
    {
        <form asp-action="Apply" method="post" id="applyForm"
              class="ui-form-actions">
            @Html.AntiForgeryToken()
            <input type="hidden" name="key" value="@Model.EntityKey" />
            <input type="hidden" name="payload" value="@Model.Payload" />
            <input type="hidden" name="applyToken" value="@Model.ApplyToken" />
            <button type="submit" id="applyButton" class="ui-btn ui-btn-pri"><i class="bi bi-check-lg" aria-hidden="true"></i> اعتماد الاستيراد</button>
            <span class="text-muted small">السجلات المقبولة فقط ستدخل، والصفوف التي بها أخطاء تتجاهل.</span>
        </form>
    }
}

@if (Model.HasValidRows)
{
    <script nonce="@Context.GetCspNonce()">
        (function () {
            var form = document.getElementById('applyForm');
            var btn = document.getElementById('applyButton');
            if (!form || !btn) return;
            form.addEventListener('submit', function (e) {
                if (typeof window.confirmAction !== 'function') return;
                e.preventDefault();
                if (btn.disabled) return;
                window.confirmAction('سيتم اعتماد استيراد @Model.ValidCount مسجل وتحفظ مباشرة في قاعدة البيانات. هل أنت متأكد؟', function () {
                    btn.disabled = true;
                    btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> جارٍ الاعتماد...';
                    form.submit();
                }, 'اعتماد الاستيراد');
            });
        })();
    </script>
}
