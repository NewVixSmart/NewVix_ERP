@model NewVixSmart.Web.ViewModels.Import.ImportCenterViewModel
@{
    ViewData["Title"] = "مركز الاستيراد";
    string FieldWord(int count) => count == 1 ? "حقل واحد" : $"{count} حقول";
}

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">الإعدادات</span>
        <h2><i class="bi bi-box-arrow-in-down" aria-hidden="true"></i> مركز الاستيراد</h2>
    </div>
</div>
<p class="text-muted mb-4">
    ارفع ملف Excel (.xlsx) أو CSV (بترميز UTF-8) لكل وحدة من وحدات النظام بعد تعبئته من القالب، ثم اعاين النتائج قبل اعتماد الاستيراد.
    السجلات الموجودة تُحدَّث والسجلات الجديدة تُنشأ تلقائيًا حسب آليّة المطابقة الموضّحة لكل وحدة.
</p>

<div class="ui-grid ui-grid-3">
    @foreach (var item in Model.Items)
    {
        <div class="ui-card ui-rise">
            <div class="ui-card-body">
                <div class="flex items-center gap-3 mb-1">
                    <i class="bi @item.Icon text-primary text-3xl" aria-hidden="true"></i>
                    <div>
                        <h3 class="ui-card-title mb-0">@item.NameAr</h3>
                        <small class="text-muted">@item.Description · @FieldWord(item.FieldCount)</small>
                    </div>
                </div>
                <p class="small text-muted mt-2 mb-4">@item.MatchNote</p>
                <form asp-action="Preview" asp-route-key="@item.Key" method="post" enctype="multipart/form-data" class="mb-2">
                    @Html.AntiForgeryToken()
                    <div class="flex flex-wrap items-center gap-2">
                        <input type="file" name="file" accept=".xlsx,.csv" class="ui-input" aria-label="اختر ملف @item.NameAr" required />
                        <button type="submit" class="ui-btn ui-btn-sm ui-btn-pri" aria-label="عاينة استيراد @item.NameAr"><i class="bi bi-eye" aria-hidden="true"></i> عاينة</button>
                    </div>
                </form>
                <div class="flex flex-wrap gap-2">
                    <a asp-action="Template" asp-route-key="@item.Key" class="ui-btn ui-btn-sm ui-btn-ok" aria-label="تحميل قالب @item.NameAr"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> تحميل القالب</a>
                </div>
            </div>
        </div>
    }
</div>

<div class="ui-alert ui-alert-info mt-4 flex items-center gap-2 mb-0" role="note">
    <i class="bi bi-shield-check" aria-hidden="true"></i>
    <span>لا تُحفظ أي بيانات عند رفع الملف؛ تُعرض المعاينة أولًا وتعتمد النتيجة يدويًّا من زر «اعتماد الاستيراد». تُراجع القيم المنطقية والحسابية وتسوية الفواصل صفًّا بصف في صفحة المعاينة.</span>
</div>
