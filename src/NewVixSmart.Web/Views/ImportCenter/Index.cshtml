@model NewVixSmart.Web.ViewModels.Import.ImportCenterViewModel
@{
    ViewData["Title"] = "مركز الاستيراد";
    string FieldWord(int count) => count == 1 ? "حقل واحد" : $"{count} حقول";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-box-arrow-in-down text-primary" aria-hidden="true"></i> مركز الاستيراد</h2>
</div>
<p class="text-muted mb-4">
    ارفع ملف Excel (.xlsx) أو CSV (بترميز UTF-8) لكل وحدة من وحدات النظام بعد تعبئته من القالب، ثم اعاين النتائج قبل اعتماد الاستيراد.
    السجلات الموجودة تُحدَّث والسجلات الجديدة تُنشأ تلقائيًا حسب آليّة المطابقة الموضّحة لكل وحدة.
</p>

<div class="row g-3">
    @foreach (var item in Model.Items)
    {
        <div class="col-12 col-sm-6 col-lg-4">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-1">
                        <i class="bi @item.Icon text-primary" style="font-size:2rem;" aria-hidden="true"></i>
                        <div>
                            <h3 class="fs-6 fw-bold mb-0">@item.NameAr</h3>
                            <small class="text-muted">@item.Description · @FieldWord(item.FieldCount)</small>
                        </div>
                    </div>
                    <p class="small text-muted mt-2 mb-3">@item.MatchNote</p>
                    <form asp-action="Preview" asp-route-key="@item.Key" method="post" enctype="multipart/form-data" class="mb-2">
                        @Html.AntiForgeryToken()
                        <div class="input-group input-group-sm">
                            <input type="file" name="file" accept=".xlsx,.csv" class="form-control" aria-label="اختر ملف @item.NameAr" required />
                            <button type="submit" class="btn btn-sm btn-primary" aria-label="عاينة استيراد @item.NameAr"><i class="bi bi-eye" aria-hidden="true"></i> عاينة</button>
                        </div>
                    </form>
                    <div class="d-flex gap-2">
                        <a asp-action="Template" asp-route-key="@item.Key" class="btn btn-sm btn-outline-success" aria-label="تحميل قالب @item.NameAr"><i class="bi bi-file-earmark-excel" aria-hidden="true"></i> تحميل القالب</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="alert alert-info mt-4 d-flex align-items-center gap-2 mb-0" role="note">
    <i class="bi bi-shield-check" aria-hidden="true"></i>
    <span>لا تُحفظ أي بيانات عند رفع الملف؛ تُعرض المعاينة أولًا وتعتمد النتيجة يدويًّا من زر «اعتماد الاستيراد». تُراجع القيم المنطقية والحسابية وتسوية الفواصل صفًّا بصف في صفحة المعاينة.</span>
</div>
