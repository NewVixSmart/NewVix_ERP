@model int
@{
    var rowIndex = Model;
    var keyPrefix = "items[" + rowIndex + "].";
    var colspan = ViewData["LineItemColumns"] ?? 1;
    var messages = ViewData.ModelState.LineItemErrorMessages(keyPrefix);
}
@if (messages.Count > 0)
{
    <tr class="line-item-error" style="background-color: var(--color-bad-soft);">
        <td colspan="@colspan">
            <div id="line-error-@rowIndex" class="ui-alert ui-alert-bad" role="alert">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                <span class="small"><strong>خطأ في السطر رقم @(rowIndex + 1):</strong> @string.Join(" — ", messages)</span>
            </div>
        </td>
    </tr>
}
