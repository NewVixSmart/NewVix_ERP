                            @if (await Perm.HasAsync("AuditLedger.View"))
                            {
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "AuditLedger" ? "active" : "")" aria-label="سجل التدقيق" asp-controller="Reports" asp-action="AuditLedger">
                                    <i class="bi bi-journal-bookmark" aria-hidden="true"></i>
                                    <span class="nav-link-text">سجل التدقيق</span>
                                </a>
                            }
                            @if (await Perm.HasAsync("Reports.View"))
                            {
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Aging" ? "active" : "")" aria-label="أعمار الذمم" asp-controller="Reports" asp-action="Aging">
                                    <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                                    <span class="nav-link-text">أعمار الذمم</span>
                                </a>
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "BudgetVariance" ? "active" : "")" aria-label="واريانس الميزانية" asp-controller="Reports" asp-action="BudgetVariance">
                                    <i class="bi bi-graph-up" aria-hidden="true"></i>
                                    <span class="nav-link-text">واريانس الميزانية</span>
                                </a>
