<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme-mode="system" data-theme="light" data-bs-theme="light">
@inject NewVixSmart.Web.Services.IPermissionService Perm
@inject NewVixSmart.Web.Services.IBrandingService Branding
@{ var _brand = await Branding.LoadAsync(); }
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - @_brand.Profile.CompanyName</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/lib/bootstrap-icons/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/lib/fonts/cairo/cairo.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <style nonce="@Context.GetCspNonce()">
        @Html.Raw(Branding.RenderThemeCss(_brand.Theme))
    </style>
    <script nonce="@Context.GetCspNonce()">
        (function () {
            var stored = null;
            try { stored = localStorage.getItem('theme-mode'); } catch (e) { stored = null; }
            var mode = (stored === 'light' || stored === 'dark') ? stored : 'system';
            var resolved = mode === 'system'
                ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                : mode;
            document.documentElement.setAttribute('data-theme-mode', mode);
            document.documentElement.setAttribute('data-theme', resolved);
            document.documentElement.setAttribute('data-bs-theme', resolved);
        })();
    </script>
    <link href="~/css/dark-theme.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    @Html.AntiForgeryToken()
    <a class="skip-link" href="#mainContent">تخطى إلى المحتوى الرئيسي</a>
    <div class="mobile-overlay" id="mobileOverlay" aria-hidden="true"></div>

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">
            @if (_brand.Profile.HasLogo)
            {
                <span class="brand-frame"><img class="brand-logo" src="@_brand.Profile.LogoDataUri()" alt="@_brand.Profile.CompanyName" /></span>
            }
            else
            {
                <span class="brand-frame"><span class="brand-monogram" aria-hidden="true">@(_brand.Profile.CompanyName.Length > 0 ? _brand.Profile.CompanyName[..1] : "س")</span></span>
            }
            <span class="brand-text">
                <strong>@_brand.Profile.CompanyName</strong>
                <small>@(_brand.Profile.Tagline ?? "Smart Solutions")</small>
            </span>
        </div>
        <nav class="sidebar-nav" id="mainMenu" aria-label="القائمة الرئيسية">
            <div class="nav-section">الرئيسية</div>
            <a class="nav-link nav-link-home @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" aria-label="لوحة التحكم" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door" aria-hidden="true"></i>
                <span class="nav-link-text">لوحة التحكم</span>
            </a>

            @if (await Perm.HasAnyAsync("Sales.View", "SalesQuotes.View", "SaleReturns.View", "Shipments.View", "Batch.SalesCreate", "Customers.View"))
            {
                <div class="nav-group" data-group="sales">
                    <button type="button" class="nav-group-header" aria-expanded="true" aria-controls="nav-sales" aria-label="المبيعات" title="المبيعات">
                        <i class="bi bi-cart-check" aria-hidden="true"></i>
                        <span>المبيعات</span>
                        <i class="bi bi-chevron-down nav-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="nav-group-body" id="nav-sales" role="region" aria-label="المبيعات">
                        <div class="nav-group-content">
                            @if (await Perm.HasAsync("Customers.View"))
                            {
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Customers" ? "active" : "")" aria-label="العملاء" asp-controller="Customers" asp-action="Index">
                                    <i class="bi bi-people" aria-hidden="true"></i>
                                    <span class="nav-link-text">العملاء</span>
                                </a>
                            }
                            @if (await Perm.HasAsync("Sales.View"))
                            {
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Sales" ? "active" : "")" aria-label="المبيعات" asp-controller="Sales" asp-action="Index">
                                    <i class="bi bi-cart-check" aria-hidden="true"></i>
                                    <span class="nav-link-text">المبيعات</span>
                                </a>
                            }
                            @if (await Perm.HasAsync("SalesQuotes.View"))
                            {
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "SalesQuotes" ? "active" : "")" aria-label="عروض أسعار العملاء" asp-controller="SalesQuotes" asp-action="Index">
                                    <i class="bi bi-receipt-cutoff" aria-hidden="true"></i>
                                    <span class="nav-link-text">عروض أسعار العملاء</span>
                                </a>
                            }
                            @if (await Perm.HasAsync("SaleReturns.View"))
                            {
