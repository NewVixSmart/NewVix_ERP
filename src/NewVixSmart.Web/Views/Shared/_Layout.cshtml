                                    <span class="nav-link-text">الميزانية العمومية</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (await Perm.HasAnyAsync("Settings.View", "ExportCenter.View", "ImportCenter.View") || User.IsInRole("Admin"))
            {
                <div class="nav-group" data-group="settings">
                    <button type="button" class="nav-group-header" aria-expanded="true" aria-controls="nav-settings" aria-label="الإعدادات" title="الإعدادات">
                        <i class="bi bi-gear" aria-hidden="true"></i>
                        <span>الإعدادات</span>
                        <i class="bi bi-chevron-down nav-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="nav-group-body" id="nav-settings" role="region" aria-label="الإعدادات">
                        <div class="nav-group-content">
                            @if (await Perm.HasAsync("Settings.View"))
                            {
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")" aria-label="الإعدادات" asp-controller="Settings" asp-action="Index">
                                    <i class="bi bi-gear" aria-hidden="true"></i>
                                    <span class="nav-link-text">الإعدادات</span>
                                </a>
                            }
                            @if (await Perm.HasAnyAsync("ExportCenter.View"))
                            {
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ExportCenter" ? "active" : "")" aria-label="مركز التصدير" asp-controller="ExportCenter" asp-action="Index">
                                    <i class="bi bi-box-arrow-up" aria-hidden="true"></i>
                                    <span class="nav-link-text">مركز التصدير</span>
                                </a>
                            }
                            @if (await Perm.HasAsync("ImportCenter.View"))
                            {
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ImportCenter" ? "active" : "")" aria-label="مركز الاستيراد" asp-controller="ImportCenter" asp-action="Index">
                                    <i class="bi bi-box-arrow-in-down" aria-hidden="true"></i>
                                    <span class="nav-link-text">مركز الاستيراد</span>
                                </a>
                            }
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")" aria-label="المستخدمون والصلاحيات" asp-controller="Users" asp-action="Index">
                                    <i class="bi bi-person-gear" aria-hidden="true"></i>
                                    <span class="nav-link-text">المستخدمون والصلاحيات</span>
                                </a>
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Backup" ? "active" : "")" aria-label="النسخ الاحتياطي والاستعادة" asp-controller="Backup" asp-action="Index">
                                    <i class="bi bi-database" aria-hidden="true"></i>
                                    <span class="nav-link-text">النسخ الاحتياطي والاستعادة</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-extras">
                <button type="button" class="rail-toggle" id="railToggle" aria-expanded="true" aria-controls="sidebar" aria-label="طي القائمة الجانبية" title="طي القائمة الجانبية">
                    <i class="bi bi-layout-sidebar-inset" aria-hidden="true"></i>
                </button>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="sidebar-profile">
                    <span class="user-avatar" aria-hidden="true">@(!string.IsNullOrEmpty(User.Identity.Name) ? User.Identity.Name.Substring(0, 1).ToUpper() : "؟")<span class="status-dot" aria-hidden="true"></span></span>
                    <div class="user-meta">
                        <strong>@User.Identity.Name</strong>
                        <small>مستخدم مسجل الدخول</small>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post" role="none">
                        <button type="submit" class="btn btn-sm" aria-label="تسجيل الخروج">
                            <i class="bi bi-box-arrow-left" aria-hidden="true"></i>
                        </button>
                    </form>
                </div>
            }
        </div>
    </aside>

    <div class="main-content">
        <div class="top-bar">
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm navbar-toggler" id="sidebarToggle" aria-label="فتح القائمة الجانبية" aria-expanded="false" aria-controls="sidebar">
                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>
                <span class="topbar-title"><h6 class="mb-0 text-muted d-none d-md-inline">@ViewData["Title"]</h6></span>
            </div>
            <div class="topbar-actions d-flex align-items-center gap-3">
                <div class="theme-selector" role="group" aria-label="مظهر الواجهة">
                    <button type="button" class="theme-mode-btn" data-theme-value="system" aria-pressed="true">
                        <i class="bi bi-display" aria-hidden="true"></i>
                        <span class="theme-mode-label">النظام</span>
                    </button>
                    <button type="button" class="theme-mode-btn" data-theme-value="light" aria-pressed="false">
                        <i class="bi bi-sun" aria-hidden="true"></i>
                        <span class="theme-mode-label">فاتح</span>
                    </button>
                    <button type="button" class="theme-mode-btn" data-theme-value="dark" aria-pressed="false">
                        <i class="bi bi-moon-stars" aria-hidden="true"></i>
                        <span class="theme-mode-label">داكن</span>
                    </button>
                </div>
                <span class="topbar-date text-muted small d-none d-lg-inline" data-clock></span>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="text-muted small d-none d-xl-inline">
                        <i class="bi bi-person-circle" aria-hidden="true"></i> @User.Identity.Name
                    </span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline d-lg-none" role="none">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-box-arrow-left" aria-hidden="true"></i> خروج
                        </button>
                    </form>
                }
            </div>
        </div>

        <main class="page-content" id="mainContent" role="main" tabindex="-1">
            <h1 class="visually-hidden">@(ViewData["Title"] ?? _brand.Profile.CompanyName)</h1>
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert" aria-live="assertive">
                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق التنبيه"></button>
                </div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status" aria-live="polite">
                    <i class="bi bi-check-circle" aria-hidden="true"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق التنبيه"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>