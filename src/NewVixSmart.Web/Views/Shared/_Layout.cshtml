                                    <i class="bi bi-clipboard-check" aria-hidden="true"></i>
                                    <span class="nav-link-text">جرد جماعي</span>
                                </a>
                            }
                            @if (await Perm.HasAsync("Warehouses.View"))
                            {
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Warehouses" ? "active" : "")" aria-label="المستودعات" asp-controller="Warehouses" asp-action="Index">
                                    <i class="bi bi-house-gear" aria-hidden="true"></i>
                                    <span class="nav-link-text">المستودعات</span>
                                </a>
                            }
                            @if (await Perm.HasAsync("StockTransfers.View"))
                            {
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "StockTransfers" ? "active" : "")" aria-label="نقل مخزون" asp-controller="StockTransfers" asp-action="Index">
                                    <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                                    <span class="nav-link-text">نقل مخزون</span>
                                </a>
                            }
                            @if (await Perm.HasAsync("StockReport.View"))
                            {
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Stock" && ViewContext.RouteData.Values["action"]?.ToString() == "Report" ? "active" : "")" aria-label="تقرير المخزون" asp-controller="Stock" asp-action="Report">
                                    <i class="bi bi-clipboard2-data" aria-hidden="true"></i>
                                    <span class="nav-link-text">تقرير المخزون</span>
                                </a>
                            }
                            @if (await Perm.HasAsync("Stock.View"))
                            {
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Stock" && ViewContext.RouteData.Values["action"]?.ToString() == "LowStock" ? "active" : "")" aria-label="انخفاض المخزون" asp-controller="Stock" asp-action="LowStock">
                                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                                    <span class="nav-link-text">انخفاض المخزون</span>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (await Perm.HasAsync("Reports.View"))
            {
                <div class="nav-group" data-group="reports">
                    <button type="button" class="nav-group-header" aria-expanded="true" aria-controls="nav-reports" aria-label="التقارير" title="التقارير">
                        <i class="bi bi-clipboard2-data" aria-hidden="true"></i>
                        <span>التقارير</span>
                        <i class="bi bi-chevron-down nav-chevron" aria-hidden="true"></i>
                    </button>
                    <div class="nav-group-body" id="nav-reports" role="region" aria-label="التقارير">
                        <div class="nav-group-content">
                            @if (await Perm.HasAsync("Reports.Dashboard"))
                            {
                                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")" aria-label="لوحة التقارير" asp-controller="Reports" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2" aria-hidden="true"></i>
                                    <span class="nav-link-text">لوحة التقارير</span>
                                </a>
                            }
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" aria-label="قائمة التقارير" asp-controller="Reports" asp-action="Index">
                                <i class="bi bi-list-ul" aria-hidden="true"></i>
                                <span class="nav-link-text">قائمة التقارير</span>
                            </a>
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Sales" ? "active" : "")" aria-label="تقرير المبيعات" asp-controller="Reports" asp-action="Sales">
                                <i class="bi bi-cart-check" aria-hidden="true"></i>
                                <span class="nav-link-text">تقرير المبيعات</span>
                            </a>
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Purchases" ? "active" : "")" aria-label="تقرير المشتريات" asp-controller="Reports" asp-action="Purchases">
                                <i class="bi bi-cart-dash" aria-hidden="true"></i>
                                <span class="nav-link-text">تقرير المشتريات</span>
                            </a>
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "Payments" ? "active" : "")" aria-label="تقرير المدفوعات" asp-controller="Reports" asp-action="Payments">
                                <i class="bi bi-wallet2" aria-hidden="true"></i>
                                <span class="nav-link-text">تقرير المدفوعات</span>
                            </a>
                            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" && ViewContext.RouteData.Values["action"]?.ToString() == "CashFlow" ? "active" : "")" aria-label="التدفق النقدي" asp-controller="Reports" asp-action="CashFlow">
