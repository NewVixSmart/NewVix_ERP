@{
    var renderedKeys = ViewData["ErrorKeysWithVisibleField"] as string[] ?? System.Array.Empty<string>();
    var messages = ViewData.ModelState.UnhandledFieldErrorMessages(renderedKeys);
}
@if (messages.Count > 0)
{
    <div class="alert alert-danger" role="alert" tabindex="-1">
        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
        <span>لم يُحفظ المستند. صحّح ما يلي ثم أعد الحفظ:</span>
        <ul class="mb-0 mt-1">
            @foreach (var message in messages)
            {
                <li>@message</li>
            }
        </ul>
    </div>
}
