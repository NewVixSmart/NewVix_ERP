@model ErrorViewModel
@{
    ViewData["Title"] = "خطأ";
}

<div class="empty-state ui-card mx-auto my-5 ui-rise" style="max-width:520px;">
    <div class="empty-icon" aria-hidden="true">
        <i class="bi bi-exclamation-triangle text-danger" aria-hidden="true"></i>
    </div>
    <h1 class="h3">حدث خطأ أثناء معالجة طلبك</h1>
    <p class="text-muted">نعتذر عن هذا الإزعاج، يرجى المحاولة مرة أخرى أو العودة إلى الرئيسية.</p>

    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">
            معرّف الطلب: <code class="num">@Model.RequestId</code>
        </p>
    }

    <div class="ui-pagehead-actions mt-2">
        <a asp-controller="Home" asp-action="Index" class="ui-btn ui-btn-pri"><i class="bi bi-house-door" aria-hidden="true"></i> العودة للرئيسية</a>
    </div>
</div>
