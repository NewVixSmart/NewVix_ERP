@model ErrorViewModel
@{
    ViewData["Title"] = "خطأ";
}

<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle text-warning" style="font-size:4rem"></i>
    <h1 class="mt-3 text-danger">حدث خطأ أثناء معالجة طلبك</h1>
    <p class="text-muted">نعتذر عن هذا الإزعاج، يرجى المحاولة مرة أخرى أو العودة إلى الرئيسية.</p>
    @if (Model.ShowRequestId)
    {
        <p>
            <small class="text-muted">معرّف الطلب: </small>
            <code>@Model.RequestId</code>
        </p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3"><i class="bi bi-house-door"></i> العودة للرئيسية</a>
</div>
