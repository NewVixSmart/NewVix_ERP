@model bool
@{
    // true = dynamic loader for _Layout (site.js toggles dark-theme.css in-session)
    // false = static <link> for Layout=null standalone pages (Login/AccessDenied)
}
<script nonce="@Context.GetCspNonce()">
    (function () {
        var stored = null;
        try { stored = localStorage.getItem('theme-mode'); } catch (e) { stored = null; }
        var mode = (stored === 'light' || stored === 'dark') ? stored : 'system';
        var resolved = mode === 'system'
            ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : mode;
        document.documentElement.setAttribute('data-theme-mode', mode);
        document.documentElement.setAttribute('data-theme', resolved);
        document.documentElement.setAttribute('data-bs-theme', resolved);
        @if (Model)
        {
            <text>window.__applyDarkThemeCss = function (apply) {
                var existing = document.getElementById('dark-theme-css');
                if (apply) {
                    if (!existing) {
                        var link = document.createElement('link');
                        link.id = 'dark-theme-css';
                        link.rel = 'stylesheet';
                        link.href = '@Url.Content("~/css/dark-theme.css")';
                        document.head.appendChild(link);
                    }
                } else if (existing) {
                    existing.parentNode.removeChild(existing);
                }
            };
            window.__applyDarkThemeCss(resolved === 'dark');</text>
        }
    })();
</script>
@if (!Model)
{
    <link href="~/css/dark-theme.css" rel="stylesheet" asp-append-version="true" />
}
