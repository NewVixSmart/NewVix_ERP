@model NewVixSmart.Web.ViewModels.PrintStudio.PrintDocModel
@using NewVixSmart.Web.ViewModels.Core
@using NewVixSmart.Web.ViewModels.PrintStudio
@using System.Globalization

@{
    Layout = null;
    var _l = Model.Layout;
    var _dec = _l.Decimals;
    var _culture = CultureInfo.InvariantCulture;
    var _sizeName = _l.PageSize == PrintPageSize.Letter ? "letter" : _l.PageSize == PrintPageSize.A5 ? "A5" : "A4";
    var _orient = _l.Orientation == PrintOrientation.Landscape ? " landscape" : "";
    var _margin = _l.Orientation == PrintOrientation.Landscape ? "10mm" : _l.Margin == PrintMarginSize.Narrow ? "6mm" : _l.Margin == PrintMarginSize.Wide ? "20mm" : "12mm";
    var _pageRule = "@page { size: " + _sizeName + _orient + "; margin: " + _margin + "; }";
    var _fontSize = (14.0 * _l.FontScale).ToString("0.0", _culture) + "px";
    var _logoHeight = Math.Max(1, 64 * _l.LogoScalePercent / 100).ToString("0", _culture) + "px";
    var _accent = _l.AccentColor;
    var _thBg = _l.TableHeaderBg;
    var _thText = _l.TableHeaderText;
}
@functions {
    private static string Fmt(decimal value, int decimals)
    {
        return value.ToString("N" + decimals.ToString(CultureInfo.InvariantCulture), CultureInfo.InvariantCulture);
    }

    private static string ArabicDigits(string input)
    {
        var sb = new System.Text.StringBuilder(input.Length);
        foreach (var ch in input)
        {
            sb.Append(ch switch
            {
                '0' => '٠',
                '1' => '١',
                '2' => '٢',
                '3' => '٣',
                '4' => '٤',
                '5' => '٥',
                '6' => '٦',
                '7' => '٧',
                '8' => '٨',
                '9' => '٩',
                _ => ch
            });
        }
        return sb.ToString();
    }

    private static string OnesWords(int value) => value switch
    {
        1 => "واحد",
        2 => "اثنان",
        3 => "ثلاثة",
        4 => "أربعة",
        5 => "خمسة",
        6 => "ستة",
        7 => "سبعة",
        8 => "ثمانية",
        9 => "تسعة",
        _ => ""
    };

    private static string TensWords(int value) => value switch
    {
        2 => "عشرون",
        3 => "ثلاثون",
        4 => "أربعون",
        5 => "خمسون",
        6 => "ستون",
        7 => "سبعون",
        8 => "ثمانون",
        9 => "تسعون",
        _ => ""
    };

    private static string SmallWords(int value) => value switch
    {
        0 => "صفر",
        1 => "واحد",
        2 => "اثنان",
        3 => "ثلاثة",
        4 => "أربعة",
        5 => "خمسة",
        6 => "ستة",
        7 => "سبعة",
        8 => "ثمانية",
        9 => "تسعة",
        10 => "عشرة",
        11 => "أحد عشر",
        12 => "اثنا عشر",
        13 => "ثلاثة عشر",
        14 => "أربعة عشر",
        15 => "خمسة عشر",
        16 => "ستة عشر",
        17 => "سبعة عشر",
        18 => "ثمانية عشر",
        19 => "تسعة عشر",
        _ => ""
    };

    private static string ThreeDigits(int value)
    {
        var hundred = value / 100;
        var rest = value % 100;
        var sb = new System.Text.StringBuilder();
        if (hundred == 1) sb.Append("مائة");
        else if (hundred == 2) sb.Append("مائتان");
        else if (hundred > 2) sb.Append(OnesWords(hundred)).Append("مائة");
        if (rest == 0) return sb.ToString();
        if (sb.Length > 0) sb.Append(" و");
        if (rest < 20) sb.Append(SmallWords(rest));
        else if (rest % 10 == 0) sb.Append(TensWords(rest / 10));
        else sb.Append(OnesWords(rest % 10)).Append(" و").Append(TensWords(rest / 10));
        return sb.ToString();
    }

    private static string GroupWords(long value)
    {
        if (value == 0) return "صفر";
        var parts = new System.Collections.Generic.List<string>();
        var index = 0;
        while (value > 0)
        {
            var chunk = (int)(value % 1000);
            if (chunk != 0)
            {
                var text = ThreeDigits(chunk);
                if (index == 1 && chunk == 1) text = "ألف";
                else if (index == 1 && chunk == 2) text = "ألفان";
                else if (index == 2 && chunk == 1) text = "مليون";
                else if (index == 2 && chunk == 2) text = "مليونان";
                else if (index == 3 && chunk == 1) text = "مليار";
                else if (index == 3 && chunk == 2) text = "ملياران";
                else if (index == 1) text += " ألف";
                else if (index == 2) text += " مليون";
                else if (index == 3) text += " مليار";
                parts.Insert(0, text);
            }
            index++;
            value /= 1000;
        }
        return string.Join(" و", parts);
    }

    private static decimal Pow10(int n)
    {
        var value = 1m;
        for (var i = 0; i < n; i++) value *= 10m;
        return value;
    }

    private static string ArabicAmountWords(decimal amount, int decimals)
    {
        if (amount < 0) return "سالب " + ArabicAmountWords(-amount, decimals);
        var scale = Pow10(decimals);
        var scaled = Math.Round(amount * scale, MidpointRounding.AwayFromZero);
        var whole = (long)(scaled / scale);
        var fraction = (long)(scaled % scale);
        var sb = new System.Text.StringBuilder(GroupWords(whole));
        if (fraction > 0)
        {
            sb.Append(" و")
              .Append(ArabicDigits(fraction.ToString().PadLeft(decimals, '0')))
              .Append('/')
              .Append(ArabicDigits(scale.ToString()));
        }
        return sb.ToString();
    }
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>@Model.DocTitle — @Model.DocNumber</title>
    <style>
        :root {
            --accent: @_accent;
            --th-bg: @_thBg;
            --th-text: @_thText;
        }
        *, *::before, *::after { box-sizing: border-box; }
        html { font-family: Tahoma, 'Segoe UI', Arial, sans-serif; direction: rtl; }
        body { margin: 0; padding: 16px; color: #1e293b; font-size: @_fontSize; }
        .print-doc { width: 100%; max-width: none; }
        .visually-hidden { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

        .no-print { display: flex; flex-wrap: wrap; gap: 12px; margin-bottom: 16px; }
        .no-print button { min-height: 44px; min-width: 44px; padding: 10px 24px; border: none; border-radius: 6px; background: @_accent; color: #fff; font-size: 15px; font-family: inherit; cursor: pointer; }
        .no-print button.secondary { background: #e2e8f0; color: #1e293b; }

        .doc-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 24px; border-bottom: 2px solid @_accent; padding-bottom: 14px; margin-bottom: 16px; }
        .header-brand { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; }
        .print-logo { max-width: 170px; object-fit: contain; margin-bottom: 4px; }
        .brand-name { margin: 0; font-size: 20px; font-weight: 700; color: @_accent; }
        .brand-tagline { margin: 0; font-size: 13px; color: #64748b; }
        .brand-contact { margin: 0; font-size: 12px; color: #64748b; unicode-bidi: plaintext; }
        .brand-tax { margin: 0; font-size: 12px; color: #64748b; }
        .doc-meta { text-align: left; min-width: 200px; }
        .doc-title { font-size: 18px; font-weight: 700; color: @_accent; margin-bottom: 4px; }
        .doc-number { font-size: 16px; font-weight: 700; color: #1e293b; }
        .doc-date { font-size: 13px; color: #64748b; margin-top: 2px; }

        .info-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px 24px; margin-bottom: 16px; font-size: 13px; }
        .info-row .label { color: #64748b; }
        .info-row .value { font-weight: 600; color: #1e293b; }

        table { width: 100%; border-collapse: collapse; margin-bottom: 16px; }
        thead th { background: var(--th-bg); color: var(--th-text); border-bottom: 2px solid @_accent; padding: 8px 10px; font-size: 13px; font-weight: 600; text-align: right; }
        tbody td { border-bottom: 1px solid #e2e8f0; padding: 8px 10px; font-size: 13px; }
        tbody tr:nth-child(even) { background: #f8fafc; }
        th.text-center, td.text-center { text-align: center; }
        .fw-bold { font-weight: 700; }
        .item-name { font-weight: 600; }

        .totals-wrap { display: flex; justify-content: flex-end; margin-bottom: 16px; }
        .totals { min-width: 280px; max-width: 100%; border-top: 2px solid @_accent; padding-top: 8px; }
        .t-row { display: flex; justify-content: space-between; gap: 24px; padding: 4px 0; font-size: 13px; }
        .t-row .lbl { color: #64748b; }
        .t-row .val { font-weight: 600; }
        .t-row.grand { font-size: 16px; font-weight: 700; color: @_accent; border-top: 1px solid #e2e8f0; margin-top: 6px; padding-top: 8px; }
        .t-row.grand .val { color: @_accent; }
        .paid-badge { display: inline-block; padding: 3px 14px; border-radius: 4px; font-size: 12px; font-weight: 700; margin-top: 10px; }
        .paid-badge.paid { background: @_accent; color: #fff; }
        .paid-badge.unpaid { background: #f1f5f9; color: #64748b; }
        .amount-words { margin-top: 10px; border-top: 1px solid #e2e8f0; padding-top: 8px; font-size: 13px; color: #1e293b; }
        .amount-words .lbl { color: #64748b; }

        .invoice-notes { border-top: 1px solid #e2e8f0; padding-top: 10px; margin-top: 8px; font-size: 13px; color: #64748b; }
        .invoice-notes strong { color: #1e293b; }

        @_pageRule

        .footer-note { text-align: center; font-size: 12px; color: #64748b; margin-top: 20px; }
        .sig-row { display: flex; justify-content: space-between; gap: 48px; margin-top: 44px; padding: 0 24px; }
        .sig-box { text-align: center; min-width: 200px; }
        .sig-line { border-top: 1px solid #1e293b; height: 40px; margin-bottom: 8px; }
        .sig-label { font-size: 13px; color: #64748b; }

        .pagefooter { position: fixed; bottom: 0; left: 0; right: 0; pointer-events: none; }

        @@media print {
            body { counter-reset: page; padding: 0; }
            .no-print { display: none !important; }
            *, *::before, *::after { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .pagefooter::after {
                content: "صفحة " counter(page) " من " counter(pages);
                position: fixed;
                bottom: 6px;
                right: 12px;
                font-size: 11px;
                color: #64748b;
            }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <button type="button" id="btnPrintDoc">طباعة</button>
        <button type="button" id="btnCloseDoc" class="secondary">إغلاق</button>
    </div>

    <main class="print-doc">
        <div class="doc-header">
            <div class="header-brand">
                @if (Model.Layout.ShowLogo && Model.LogoUri != null)
                {
                    <img src="@Model.LogoUri" alt="@Model.CompanyName" class="print-logo" style="max-height:@_logoHeight;" />
                }
                @if (Model.Layout.ShowCompanyName && !string.IsNullOrWhiteSpace(Model.CompanyName))
                {
                    <h1 class="brand-name">@Model.CompanyName</h1>
                }
                @if (Model.Layout.ShowTagline && !string.IsNullOrWhiteSpace(Model.Tagline))
                {
                    <p class="brand-tagline">@Model.Tagline</p>
                }
                @if (Model.Layout.ShowCompanyContact && !string.IsNullOrWhiteSpace(Model.CompanyContact))
                {
                    <p class="brand-contact">@Model.CompanyContact</p>
                }
                @if (Model.Layout.ShowTaxNumber && !string.IsNullOrWhiteSpace(Model.TaxNumber))
                {
                    <p class="brand-tax">الرقم الضريبي: @Model.TaxNumber</p>
                }
            </div>
            <div class="doc-meta">
                @if (Model.Layout.ShowDocTitle)
                {
                    <div class="doc-title">@Model.DocTitle</div>
                }
                <div class="doc-number">@Model.DocNumber</div>
                @if (!string.IsNullOrWhiteSpace(Model.DocDateLabel) && !string.IsNullOrWhiteSpace(Model.DocDateValue))
                {
                    <div class="doc-date">@Model.DocDateLabel: @Model.DocDateValue</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.SecondDateLabel) && !string.IsNullOrWhiteSpace(Model.SecondDateValue))
                {
                    <div class="doc-date">@Model.SecondDateLabel: @Model.SecondDateValue</div>
                }
            </div>
        </div>

        @if (!Model.HidesPartyBlock)
        {
            <div class="info-row">
                <div>
                    <span class="label">@Model.PartyTitle:</span>
                    <span class="value">@Model.PartyName</span>
                    @if (!string.IsNullOrWhiteSpace(Model.PartyCode))
                    {
                        <span class="label"> — كود: @Model.PartyCode</span>
                    }
                </div>
                @if (Model.Layout.ShowCreatedBy && !string.IsNullOrWhiteSpace(Model.CreatedBy))
                {
                    <div><span class="label">أُنشئ بواسطة:</span> <span class="value">@Model.CreatedBy</span></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <div><span class="label">ملاحظات:</span> <span class="value">@Model.Note</span></div>
                }
            </div>
        }
        else if (Model.Layout.ShowCreatedBy && !string.IsNullOrWhiteSpace(Model.CreatedBy) || !string.IsNullOrWhiteSpace(Model.Note))
        {
            <div class="info-row">
                @if (Model.Layout.ShowCreatedBy && !string.IsNullOrWhiteSpace(Model.CreatedBy))
                {
                    <div><span class="label">أُنشئ بواسطة:</span> <span class="value">@Model.CreatedBy</span></div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Note))
                {
                    <div><span class="label">ملاحظات:</span> <span class="value">@Model.Note</span></div>
                }
            </div>
        }

        <table>
            <caption class="visually-hidden">@Model.DocTitle — @Model.DocNumber</caption>
            <thead>
                <tr>
                    <th scope="col" class="text-center">#</th>
                    @if (Model.Layout.ShowItemCode) { <th scope="col" class="text-center">كود الصنف</th> }
                    @if (Model.Layout.ShowBarcode) { <th scope="col" class="text-center">الباركود</th> }
                    <th scope="col">الصنف</th>
                    <th scope="col" class="text-center">الوحدة</th>
                    @if (Model.Layout.ShowCount) { <th scope="col" class="text-center">العدد</th> }
                    @if (Model.Layout.ShowQuantity) { <th scope="col" class="text-center">الكمية</th> }
                    @if (Model.Layout.ShowUnitPrice) { <th scope="col" class="text-center">سعر الوحدة</th> }
                    @if (Model.Layout.ShowDiscountColumn) { <th scope="col" class="text-center">الخصم</th> }
                    <th scope="col" class="text-center">الإجمالي</th>
                </tr>
            </thead>
            <tbody>
                @{ var rowNo = 0; }
                @foreach (var line in Model.Lines)
                {
                    rowNo++;
                    <tr>
                        <td class="text-center">@rowNo</td>
                        @if (Model.Layout.ShowItemCode) { <td class="text-center">@(string.IsNullOrWhiteSpace(line.ItemCode) ? "—" : line.ItemCode)</td> }
                        @if (Model.Layout.ShowBarcode)
                        {
                            <td class="text-center">
                                @if (!string.IsNullOrWhiteSpace(line.Barcode))
                                {
                                    <partial name="_Barcode" model="line.Barcode" />
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                        }
                        <td class="item-name">@line.Name</td>
                        <td class="text-center">@(string.IsNullOrWhiteSpace(line.Unit) ? "—" : line.Unit)</td>
                        @if (Model.Layout.ShowCount) { <td class="text-center">@Fmt(line.Count, _dec)</td> }
                        @if (Model.Layout.ShowQuantity) { <td class="text-center">@Fmt(line.Quantity, _dec)</td> }
                        @if (Model.Layout.ShowUnitPrice) { <td class="text-center">@Fmt(line.UnitPrice, _dec)</td> }
                        @if (Model.Layout.ShowDiscountColumn) { <td class="text-center">@Fmt(line.Discount, _dec)</td> }
                        <td class="text-center fw-bold">@Fmt(line.LineTotal, _dec)</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="totals-wrap">
            <div class="totals">
                @{
                    var _moneyDoc = Model.Group == PrintGroup.SalesInvoice || Model.Group == PrintGroup.PurchaseInvoice || Model.Group == PrintGroup.SalesQuote;
                    var _invoiceDoc = Model.Group == PrintGroup.SalesInvoice || Model.Group == PrintGroup.PurchaseInvoice;
                }
                @if (_moneyDoc && Model.Layout.ShowSubtotal) { <div class="t-row"><span class="lbl">الإجمالي قبل الخصم</span><span class="val">@Fmt(Model.Totals.Subtotal, _dec)</span></div> }
                @if (_moneyDoc && Model.Layout.ShowTotalDiscount) { <div class="t-row"><span class="lbl">الخصم</span><span class="val">@Fmt(Model.Totals.Discount, _dec)</span></div> }
                @if (_moneyDoc && Model.Layout.ShowTotalTax) { <div class="t-row"><span class="lbl">الضريبة</span><span class="val">@Fmt(Model.Totals.Tax, _dec)</span></div> }
                @if (_moneyDoc && Model.Layout.ShowGrandTotal)
                {
                    <div class="t-row grand">
                        <span class="lbl">الصافي (الإجمالي)</span>
                        <span class="val">@Fmt(Model.Totals.GrandTotal, _dec)@(string.IsNullOrWhiteSpace(Model.Totals.CurrencyCode) ? "" : " " + Model.Totals.CurrencyCode)</span>
                    </div>
                }
                @if (_invoiceDoc && Model.Layout.ShowPaidBadge)
                {
                    @if (Model.Totals.IsPaid)
                    {
                        <span class="paid-badge paid">مدفوعة</span>
                    }
                    else
                    {
                        <span class="paid-badge unpaid">غير مدفوعة</span>
                    }
                }
                @if (_moneyDoc && Model.Layout.ShowAmountInWords)
                {
                    <div class="amount-words">
                        <span class="lbl">المبلغ كتابةً:</span>
                        <span>@ArabicAmountWords(Model.Totals.GrandTotal, _dec)@(string.IsNullOrWhiteSpace(Model.Totals.CurrencyCode) ? "" : " " + Model.Totals.CurrencyCode)</span>
                    </div>
                }
            </div>
        </div>
    </main>

    @if (Model.Layout.ShowFooter)
    {
        <div class="footer-note">
            @if (!string.IsNullOrWhiteSpace(Model.Layout.FooterNoteText))
            {
                @Model.Layout.FooterNoteText
            }
            @if (!string.IsNullOrWhiteSpace(Model.CompanyName))
            {
                <span>@(string.IsNullOrWhiteSpace(Model.Layout.FooterNoteText) ? "" : " — ")@Model.CompanyName</span>
            }
        </div>
    }

    @if (Model.Layout.ShowSignatureLines)
    {
        <div class="sig-row">
            <div class="sig-box">
                <div class="sig-line"></div>
                <div class="sig-label">@Model.Layout.SignatureOne</div>
            </div>
            <div class="sig-box">
                <div class="sig-line"></div>
                <div class="sig-label">@Model.Layout.SignatureTwo</div>
            </div>
        </div>
    }

    <div class="pagefooter" aria-hidden="true"></div>

    <script nonce="@Context.GetCspNonce()">
        (function () {
            var printBtn = document.getElementById('btnPrintDoc');
            var closeBtn = document.getElementById('btnCloseDoc');
            if (printBtn) printBtn.addEventListener('click', function () { window.print(); });
            if (closeBtn) closeBtn.addEventListener('click', function () { window.close(); });
        })();
    </script>
</body>
</html>