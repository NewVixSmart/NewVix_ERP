@model NewVixSmart.Web.ViewModels.Accounting.PaymentFormViewModel
@{
    ViewData["Title"] = Model.Payment.Type == NewVixSmart.Web.Models.Accounting.PaymentType.Receipt ? "قبض من عميل" : "صرف لمورد";
}

<div class="page-header"><h2><i class="bi bi-wallet2 text-primary"></i> @ViewData["Title"]</h2></div>

<div class="card"><div class="card-body">
    <form asp-action="Create" asp-route-type="@Model.Type">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Payment.Type" />
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Payment.ReceiptNumber" class="form-label"></label>
                <input asp-for="Payment.ReceiptNumber" class="form-control" readonly />
            </div>
            <div class="col-md-4">
                <label asp-for="Payment.PaymentDate" class="form-label"></label>
                <input asp-for="Payment.PaymentDate" class="form-control" type="date" />
            </div>
            <div class="col-md-4">
                <label asp-for="Payment.Amount" class="form-label"></label>
                <input asp-for="Payment.Amount" class="form-control" type="number" step="0.01" aria-describedby="Payment_Amount-error" />
                <span asp-validation-for="Payment.Amount" class="text-danger small" id="Payment_Amount-error"></span>
            </div>
            @if (Model.Payment.Type == NewVixSmart.Web.Models.Accounting.PaymentType.Receipt)
            {
                <div class="col-md-4">
                    <label asp-for="Payment.CustomerId" class="form-label"></label>
                    <select asp-for="Payment.CustomerId" asp-items="@Model.Customers" class="form-select">
                        <option value="">-- اختر العميل --</option>
                    </select>
                    <span asp-validation-for="Payment.CustomerId" class="text-danger small"></span>
                </div>
            }
            else
            {
                <div class="col-md-4">
                    <label asp-for="Payment.SupplierId" class="form-label"></label>
                    <select asp-for="Payment.SupplierId" asp-items="@Model.Suppliers" class="form-select">
                        <option value="">-- اختر المورد --</option>
                    </select>
                    <span asp-validation-for="Payment.SupplierId" class="text-danger small"></span>
                </div>
            }
            <div class="col-md-4">
                <label asp-for="Payment.Method" class="form-label"></label>
                <select asp-for="Payment.Method" class="form-select" aria-describedby="Payment_Method-error">
                    <option value="1">نقداً</option>
                    <option value="2">شيك</option>
                    <option value="3">تحويل بنكي</option>
                    <option value="4">بطاقة ائتمان</option>
                </select>
                <span asp-validation-for="Payment.Method" class="text-danger small" id="Payment_Method-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Payment.ReferenceNumber" class="form-label"></label>
                <input asp-for="Payment.ReferenceNumber" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="Payment.Notes" class="form-label"></label>
                <textarea asp-for="Payment.Notes" class="form-control" rows="2"></textarea>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
            <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
        </div>
    </form>
</div></div>
