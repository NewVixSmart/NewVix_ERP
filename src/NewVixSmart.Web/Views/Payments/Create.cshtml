@model NewVixSmart.Web.ViewModels.Accounting.PaymentFormViewModel
@{
    ViewData["Title"] = Model.Payment.Type == NewVixSmart.Web.Models.Accounting.PaymentType.Receipt ? "قبض من عميل" : "صرف لمورد";
}

<div class="page-header"><h2><i class="bi bi-wallet2 text-primary"></i> @ViewData["Title"]</h2></div>

<div class="card"><div class="card-body">
    <form asp-action="Create" asp-route-type="@Model.Type">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Payment.Type" />
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Payment.ReceiptNumber" class="form-label"></label>
                <input asp-for="Payment.ReceiptNumber" class="form-control" readonly />
            </div>
            <div class="col-md-4">
                <label asp-for="Payment.PaymentDate" class="form-label"></label>
                <input asp-for="Payment.PaymentDate" class="form-control" type="date" />
            </div>
            <div class="col-md-4">
                <label asp-for="Payment.Amount" class="form-label"></label>
                <input asp-for="Payment.Amount" class="form-control" type="number" step="0.01" aria-describedby="Payment_Amount-error" />
                <span asp-validation-for="Payment.Amount" class="text-danger small" id="Payment_Amount-error"></span>
            </div>
            @if (Model.Payment.Type == NewVixSmart.Web.Models.Accounting.PaymentType.Receipt)
            {
                <div class="col-md-4">
                    <label asp-for="Payment.CustomerId" class="form-label"></label>
                    <select asp-for="Payment.CustomerId" asp-items="@Model.Customers" class="form-select">
                        <option value="">-- اختر العميل --</option>
                    </select>
                    <span asp-validation-for="Payment.CustomerId" class="text-danger small"></span>
                </div>
            }
            else
            {
                <div class="col-md-4">
                    <label asp-for="Payment.SupplierId" class="form-label"></label>
                    <select asp-for="Payment.SupplierId" asp-items="@Model.Suppliers" class="form-select">
                        <option value="">-- اختر المورد --</option>
                    </select>
                    <span asp-validation-for="Payment.SupplierId" class="text-danger small"></span>
                </div>
            }
            <div class="col-md-4">
                <label asp-for="Payment.CurrencyId" class="form-label"></label>
                <select asp-for="Payment.CurrencyId" asp-items="@Model.Currencies" class="form-select" id="currencySelect">
                    <option value="">-- العملة --</option>
                </select>
                <span asp-validation-for="Payment.CurrencyId" class="text-danger small"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Payment.ExchangeRate" class="form-label"></label>
                <input asp-for="Payment.ExchangeRate" class="form-control" type="number" step="any" id="exchangeRate" aria-describedby="exchangeRate-help Payment_ExchangeRate-error" />
                <small class="text-muted" id="exchangeRate-help">وحدات العملة الأساسية لكل وحدة من العملة المختارة</small>
                <span asp-validation-for="Payment.ExchangeRate" class="text-danger small" id="Payment_ExchangeRate-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Payment.BaseAmount" class="form-label"></label>
                <input asp-for="Payment.BaseAmount" class="form-control" id="baseAmount" readonly />
                <small class="text-muted">المبلغ بالعملة الأساسية المحتسب</small>
            </div>
            <div class="col-md-4">
                <label asp-for="Payment.Method" class="form-label"></label>
                <select asp-for="Payment.Method" class="form-select" aria-describedby="Payment_Method-error">
                    <option value="1">نقداً</option>
                    <option value="2">شيك</option>
                    <option value="3">تحويل بنكي</option>
                    <option value="4">بطاقة ائتمان</option>
                </select>
                <span asp-validation-for="Payment.Method" class="text-danger small" id="Payment_Method-error"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Payment.ReferenceNumber" class="form-label"></label>
                <input asp-for="Payment.ReferenceNumber" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="Payment.Notes" class="form-label"></label>
                <textarea asp-for="Payment.Notes" class="form-control" rows="2"></textarea>
            </div>
        </div>
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> حفظ</button>
            <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
        </div>
    </form>
</div></div>
@section Scripts {
<script nonce="@Context.GetCspNonce()">
const currencyOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
    Model.CurrencyOptions?.Select(c => new { c.Id, c.ExchangeRate, c.IsBase }) ?? [],
    new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase, Encoder = System.Text.Encodings.Web.JavaScriptEncoder.Default }));

function refreshBaseAmount() {
    var id = document.getElementById('currencySelect').value;
    var amount = parseFloat(document.getElementById('Payment_Amount').value) || 0;
    var rateInput = document.getElementById('exchangeRate');
    var baseOutput = document.getElementById('baseAmount');
    var cur = currencyOptions.find(c => String(c.id) === id);
    if (cur && !cur.isBase) {
        var rate = parseFloat(rateInput.value) || 0;
        baseOutput.value = (amount * rate).toFixed(2);
    } else {
        rateInput.value = cur ? 1 : '';
        baseOutput.value = amount.toFixed(2);
    }
}

document.getElementById('currencySelect').addEventListener('change', refreshBaseAmount);
document.getElementById('exchangeRate').addEventListener('input', refreshBaseAmount);
document.getElementById('Payment_Amount').addEventListener('input', refreshBaseAmount);
refreshBaseAmount();
</script>
<partial name="_ValidationScriptsPartial" />
}