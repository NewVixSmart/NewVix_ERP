@model IEnumerable<NewVixSmart.Web.Models.Accounting.Payment>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "المدفوعات"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المحاسبة</span>
        <h2><i class="bi bi-wallet2" aria-hidden="true"></i> المدفوعات</h2>
    </div>
    @if (await Perm.HasAsync("Payments.Create"))
    {
        <div class="ui-pagehead-actions">
            <a asp-action="Create" asp-route-type="receipt" class="ui-btn ui-btn-ok"><i class="bi bi-plus-lg" aria-hidden="true"></i> قبض من عميل</a>
            <a asp-action="Create" asp-route-type="disbursement" class="ui-btn ui-btn-danger"><i class="bi bi-plus-lg" aria-hidden="true"></i> صرف لمورد</a>
        </div>
    }
</div>

<div class="ui-section ui-card ui-rise">
    <div class="card-body">
        <form method="get" class="flex flex-wrap items-end gap-3">
            <div class="flex-1 min-w-40">
                <label class="form-label" for="paySearch">بحث في المدفوعات</label>
                <input type="search" name="search" id="paySearch" value="@ViewBag.Search" class="ui-input" placeholder="بحث برقم الإيصال أو اسم الجهة">
            </div>
            <div>
                <button type="submit" class="ui-btn ui-btn-outline"><i class="bi bi-search" aria-hidden="true"></i> بحث</button>
            </div>
        </form>
    </div>
</div>

<div class="ui-section table-container ui-rise">
    <table class="table">
        <caption class="visually-hidden">قائمة الدفعات مقبوضة ومصروفة</caption>
        <thead><tr><th scope="col">الإيصال</th><th scope="col">النوع</th><th scope="col">العميل/المورد</th><th scope="col">المبلغ</th><th scope="col">الطريقة</th><th scope="col">التاريخ</th><th scope="col" class="text-center">إجراءات</th></tr></thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td><code>@p.ReceiptNumber</code></td>
                    <td>
                        @if (p.Type == NewVixSmart.Web.Models.Accounting.PaymentType.Receipt)
                        { <span class="ui-badge ui-badge-ok">@p.Type.GetDisplayName()</span> }
                        else
                        { <span class="ui-badge ui-badge-bad">@p.Type.GetDisplayName()</span> }
                    </td>
                    <td>@(p.Customer?.Name ?? p.Supplier?.Name ?? "—")</td>
                    <td class="fw-bold num @(p.Type == NewVixSmart.Web.Models.Accounting.PaymentType.Receipt ? "text-success" : "text-danger")">
                        @Money.Format(p.Amount)
                    </td>
                    <td>@p.Method.GetDisplayName()</td>
                    <td>@p.PaymentDate.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@p.PublicId" class="ui-btn ui-btn-sm ui-btn-ghost" aria-label="عرض إيصال @p.ReceiptNumber"><i class="bi bi-eye" aria-hidden="true"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pager")
