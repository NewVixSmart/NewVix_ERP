@model IEnumerable<NewVixSmart.Web.Models.Accounting.Payment>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{ ViewData["Title"] = "المدفوعات"; }

<div class="page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-wallet2 text-primary"></i> المدفوعات</h2>
    @if (await Perm.HasAsync("Payments.Create"))
    {
    <div class="d-flex gap-2">
        <a asp-action="Create" asp-route-type="receipt" class="btn btn-success"><i class="bi bi-plus-lg"></i> قبض من عميل</a>
        <a asp-action="Create" asp-route-type="disbursement" class="btn btn-danger"><i class="bi bi-plus-lg"></i> صرف لمورد</a>
    </div>
    }
</div>

<div class="mb-3">
    <form method="get" class="row g-2">
        <div class="col-auto flex-grow-1">
            <label class="visually-hidden" for="paySearch">بحث في المدفوعات</label>
            <input type="search" name="search" id="paySearch" value="@ViewBag.Search" class="form-control" placeholder="بحث برقم الإيصال أو اسم الجهة">
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search" aria-hidden="true"></i> بحث</button>
        </div>
    </form>
</div>

<div class="table-container">
    <table class="table table-hover mb-0">
        <thead><tr><th scope="col">الإيصال</th><th scope="col">النوع</th><th scope="col">العميل/المورد</th><th scope="col">المبلغ</th><th scope="col">العملة</th><th scope="col">سعر الصرف</th><th scope="col">المبلغ الأساسي</th><th scope="col">الطريقة</th><th scope="col">التاريخ</th><th scope="col" class="text-center">إجراءات</th></tr></thead>
        <tbody>
            @foreach (var p in Model)
            {
                var isForeign = p.CurrencyId.HasValue && p.ExchangeRate.HasValue;
                <tr>
                    <td><code>@p.ReceiptNumber</code></td>
                    <td>
                        @if (p.Type == NewVixSmart.Web.Models.Accounting.PaymentType.Receipt)
                        { <span class="badge bg-success">@p.Type.GetDisplayName()</span> }
                        else
                        { <span class="badge bg-danger">@p.Type.GetDisplayName()</span> }
                    </td>
                    <td>@(p.Customer?.Name ?? p.Supplier?.Name ?? "—")</td>
                    <td class="fw-bold @(p.Type == NewVixSmart.Web.Models.Accounting.PaymentType.Receipt ? "text-success" : "text-danger")">
                        @p.Amount.ToString("N2") @(p.Currency?.Code ?? "ج.م")
                    </td>
                    <td>@(p.Currency?.Code ?? "—")</td>
                    <td>@(isForeign ? p.ExchangeRate?.ToString("N4") : "—")</td>
                    <td>@(isForeign ? p.BaseAmount.ToString("N2") + " ج.م" : "—")</td>
                    <td>@p.Method.GetDisplayName()</td>
                    <td>@p.PaymentDate.ToString("dd/MM/yyyy")</td>
                    <td class="text-center">
                        <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info" aria-label="عرض إيصال @p.ReceiptNumber"><i class="bi bi-eye"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@await Html.PartialAsync("_Pager")
