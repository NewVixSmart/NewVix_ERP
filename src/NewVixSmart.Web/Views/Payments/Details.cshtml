@model NewVixSmart.Web.Models.Accounting.Payment
@{ ViewData["Title"] = "تفاصيل الدفعة"; }

<div class="ui-pagehead ui-rise">
    <div class="ui-pagehead-title">
        <span class="ui-eyebrow">المحاسبة</span>
        <h2><i class="bi bi-eye" aria-hidden="true"></i> تفاصيل الدفعة: @Model.ReceiptNumber</h2>
    </div>
    <div class="ui-pagehead-actions">
        <a asp-action="Index" class="ui-btn ui-btn-ghost"><i class="bi bi-arrow-right" aria-hidden="true"></i> رجوع</a>
    </div>
</div>

<div class="ui-section ui-card ui-rise">
    <div class="card-body">
        <table class="table">
            <caption class="visually-hidden">بيانات الدفعة</caption>
            <tr><th scope="row" style="width:30%">رقم الإيصال</th><td><code>@Model.ReceiptNumber</code></td></tr>
            <tr><th scope="row">النوع</th><td>@Model.Type.GetDisplayName()</td></tr>
            <tr><th scope="row">العميل/المورد</th><td>@(Model.Customer?.Name ?? Model.Supplier?.Name ?? "—")</td></tr>
            <tr><th scope="row">المبلغ</th><td class="fw-bold num text-xl">@Money.Format(Model.Amount)</td></tr>
            <tr><th scope="row">طريقة الدفع</th><td>@Model.Method.GetDisplayName()</td></tr>
            <tr><th scope="row">رقم المرجع</th><td>@(Model.ReferenceNumber ?? "—")</td></tr>
            <tr><th scope="row">التاريخ</th><td>@Model.PaymentDate.ToString("dd/MM/yyyy")</td></tr>
            <tr><th scope="row">أنشأها</th><td>@(Model.CreatedBy ?? "—")</td></tr>
            <tr><th scope="row">ملاحظات</th><td>@(Model.Notes ?? "—")</td></tr>
        </table>
    </div>
</div>

@if ((Model.SalePaymentAllocations?.Count ?? 0) + (Model.PurchasePaymentAllocations?.Count ?? 0) > 0)
{
    <div class="ui-section ui-card ui-rise">
        <div class="card-header"><span class="ui-card-title"><i class="bi bi-diagram-3" aria-hidden="true"></i> توزيع المبالغ على الفواتير</span></div>
        <div class="card-body p-0">
            <div class="table-container">
                <table class="table">
                    <caption class="visually-hidden">توزيع مبلغ الدفعة على الفواتير المرتبطة بها</caption>
                    <thead>
                        <tr>
                            <th scope="col">رقم الفاتورة</th>
                            <th scope="col">النوع</th>
                            <th scope="col">المبلغ المخصص</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.SalePaymentAllocations ?? [])
                        {
                            <tr>
                                <td>@(a.SaleInvoice?.InvoiceNumber ?? ("فاتورة بيع #" + a.SaleInvoiceId))</td>
                                <td>مبيعات</td>
                                <td class="num">@Money.Format(a.AllocatedAmount)</td>
                            </tr>
                        }
                        @foreach (var a in Model.PurchasePaymentAllocations ?? [])
                        {
                            <tr>
                                <td>@(a.PurchaseInvoice?.InvoiceNumber ?? ("فاتورة شراء #" + a.PurchaseInvoiceId))</td>
                                <td>مشتريات</td>
                                <td class="num">@Money.Format(a.AllocatedAmount)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
