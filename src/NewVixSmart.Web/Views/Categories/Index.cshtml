@model IEnumerable<NewVixSmart.Web.Models.Core.ItemCategory>
@inject NewVixSmart.Web.Services.IPermissionService Perm
@{
    ViewData["Title"] = "التصنيفات الرئيسية";
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (!isAjax)
    {
        Layout = "_Layout";
    }
}
@if (!isAjax)
{
    <div class="ui-pagehead ui-rise">
        <div class="ui-pagehead-title">
            <span class="ui-eyebrow">الأصناف</span>
            <h2>التصنيفات الرئيسية</h2>
        </div>
        @if (await Perm.HasAsync("Items.Create"))
        {
            <div class="ui-pagehead-actions">
                <button type="button" class="ui-btn ui-btn-pri" id="pageAddCatBtn" data-focus-target="pageNewCat"><i class="bi bi-plus-lg" aria-hidden="true"></i> إضافة تصنيف</button>
            </div>
        }
    </div>
    @if (await Perm.HasAsync("Items.Create"))
    {
        <div class="ui-section ui-card">
            <div class="card-body">
                <div class="input-group">
                    <label for="pageNewCat" class="visually-hidden">اسم تصنيف جديد</label>
                    <input type="text" id="pageNewCat" class="ui-input" placeholder="اسم تصنيف جديد..." autocomplete="off" />
                    <button type="button" class="ui-btn ui-btn-ok" id="pageAddCatBtn2" data-create-category><i class="bi bi-check-lg" aria-hidden="true"></i> إضافة</button>
                </div>
            </div>
        </div>
    }
}
<div class="table-container ui-rise">
    <table class="table" id="categoriesTable" data-load="true">
        <caption class="visually-hidden">التصنيفات الرئيسية: الاسم، الحالة</caption>
        <thead>
            <tr>
                <th scope="col">الاسم</th>
                <th scope="col">الحالة</th>
                <th scope="col" class="text-center">إجراءات</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr data-id="@c.Id" data-rowversion="@(c.RowVersion is null ? string.Empty : Convert.ToBase64String(c.RowVersion))">
                    <td data-name="@c.Name">@c.Name</td>
                    <td><span class="ui-badge @(c.IsActive ? "ui-badge-ok" : "ui-badge-mute")">@(c.IsActive ? "نشط" : "غير نشط")</span></td>
                    <td class="text-center">
                        @if (await Perm.HasAsync("Items.Edit"))
                        {
                            <button type="button" class="ui-btn ui-btn-sm btn-edit" data-id="@c.Id" title="تعديل" aria-label="تعديل @c.Name"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                        }
                        @if (await Perm.HasAsync("Items.Delete"))
                        {
                            <button type="button" class="ui-btn ui-btn-sm btn-del" data-id="@c.Id" title="حذف" aria-label="حذف @c.Name"><i class="bi bi-trash" aria-hidden="true"></i></button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
