{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Host header filtering: "*" is required for Azure App Service / container host names
  // and is intentional (appsettings.Development.json uses "*"). The base value below is
  // intentionally narrowed to "localhost" - do not treat it as an oversight or remove it
  // without a matching production override.
  "AllowedHosts": "localhost",
  // No Seed section is shipped here any more: the default usernames/passwords are NOT in this
  // repository. Development defaults live in appsettings.Development.json; every other environment
  // MUST supply Seed__AdminPassword / Seed__AccountantPassword / Seed__WarehousePassword through
  // environment variables or user secrets, and the production startup gate refuses to boot when any
  // of the three is missing, blank, a shipped default, or a "REPLACE_WITH" placeholder.
  //
  "ForwardedHeaders": {
    // Opt-in (M-1). Keep false unless the app really sits behind a reverse proxy/load balancer.
    // When true you MUST also list KnownProxies (single IPs) or KnownNetworks (IPv4 CIDR, e.g.
    // 10.0.0.0/8) - unknown proxies are never trusted. If the proxy is not listed, RemoteIpAddress
    // stays the proxy IP and the "login" rate limiter (20 requests / 5 min) becomes a single shared
    // bucket for every client.
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": "",
    "KnownNetworks": ""
  },
  "Hosting": {
    "AllowedHosts": ""
  },
  "Jwt": {
    "Issuer": "NewVixSmart",
    "Audience": "NewVixSmart"
  }
}
