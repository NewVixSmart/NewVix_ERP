root = true

# ---------------------------------------------------------------- formatting

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 160

[*.{json,yml,yaml,js,mjs,cjs,css,scss,html}]
indent_size = 2

[*.{csproj,props,targets,slnx,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ---------------------------------------------------------------- C#

[*.cs]
# --- language conventions
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion

# --- readability: a file may declare one top-level type, and that type matches the file name
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
dotnet_style_prefer_conditional_expression_over_return = false:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion

# --- naming: private fields are _camelCase
# `warning`, and the format gate below enforces it. These rules used to sit at
# `suggestion` because Roslyn's NamingStyleCodeFixProvider cannot "Fix All in
# Solution" (`dotnet format` reports IDE1006 but refuses to fix it: "Unable to
# fix IDE1006. Code fix NamingStyleCodeFixProvider doesn't support Fix All in
# Solution"), so a `warning` rule was treated as a finding the enforcing tool
# could never clear. That was a tool limitation, not a backlog: the gate only
# has to *report* zero findings, it never has to fix them. The 110 violations
# were renamed by hand and the tree now sits at 0, so IDE1006 is inside the
# gate. A new field missing the `_` prefix, or a non-PascalCase type, is red in
# CI -- fix the name, never drop the rule to make the gate green.
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

dotnet_naming_rule.types_pascal.symbols = types
dotnet_naming_rule.types_pascal.style = pascal_case
dotnet_naming_rule.types_pascal.severity = warning
dotnet_naming_symbols.types.applicable_kinds = class,struct,interface,enum,delegate
dotnet_naming_symbols.types.applicable_accessibilities = *
dotnet_naming_style.pascal_case.capitalization = pascal_case

# --- formatting
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = true

# --- correctness / suspicious code
# Severities stay at suggestion on purpose: this file is a style guide, not a build gate.
# `TreatWarningsAsErrors` is on, so promoting any of these to warning would fail the build on
# the existing code (including the historical migrations) instead of guiding new code.
dotnet_diagnostic.CA1822.severity = none          # MVC actions legitimately do not use the instance
dotnet_diagnostic.CA2007.severity = none          # the project intentionally awaits without ConfigureAwait
dotnet_diagnostic.CA1031.severity = none          # the global exception filter is the boundary
dotnet_diagnostic.CA1848.severity = suggestion    # LoggerMessage delegates
dotnet_diagnostic.CA1305.severity = suggestion    # StringComparison / IFormatProvider must be explicit
dotnet_diagnostic.CA1861.severity = suggestion    # no constant arrays as arguments
dotnet_diagnostic.CA1852.severity = suggestion    # seal internal types
# Formatting IS enforced, in exactly one place: the `build-and-test` job in
# .github/workflows/ci.yml runs, before the build and test steps,
#     dotnet format NewVixSmart.slnx --verify-no-changes --no-restore
# That command is the single source of truth. `EnforceCodeStyleInBuild` is
# deliberately NOT set anywhere: two gates for one contract drift, and the IDE
# analyzers are not error-level at build time regardless, so it would add a
# second, weaker opinion rather than a second safety net.
#
# What the gate now enforces on the tree. The figures are the whole-tree reformat
# of 2026-09-30 (Release build, .NET SDK 10.0.401), 15,642 findings -> 0:
#     ENDOFLINE     13844 findings /  70 files  CRLF -> LF
#     IDE0011        1201 findings / 100 files  add braces
#     WHITESPACE      277 findings /  23 files
#     FINALNEWLINE    107 findings / 107 files
#     CHARSET          81 findings /  81 files  strip the UTF-8 BOM
#     IDE0161          38 findings /  38 files  file-scoped namespace
#     IMPORTS          19 findings /  19 files  using order
#     IDE0065           2 findings /   2 files  usings outside the namespace
# `charset = utf-8` above is why the 81 BOMs went: the tree is now uniformly
# UTF-8 without BOM, which is also what a `git add --renormalize .` on a
# `text=auto eol=lf` checkout produces.
#
# Deliberately outside the gate:
#   - IDE0055 (the C# formatter) stays `none` for .cs and .cshtml below, so the
#     gate checks layout, not the full formatter opinion.
#   - .cshtml is not in the `dotnet format` gate's scope. Razor views are never
#     reported by it (0 findings across all 122 of them) and were left
#     byte-identical, so the `nonce` / `scope` / `<caption>` accessibility work is
#     not exposed to it. This says nothing about encoding: `charset = utf-8` /
#     `end_of_line = lf` / `insert_final_newline` above still apply to .cshtml,
#     and a separate read-only gate enforces them - see the text hygiene section.
#   - IDE1006 IS inside the gate now: both naming rules above are `warning`, so
#     a new private field without the `_` prefix or a non-PascalCase type is red
#     in CI. Rename the symbol; do not demote the rule to `suggestion`.
dotnet_diagnostic.IDE0055.severity = none

# --- historical migrations are frozen: they describe schemas that no longer exist
[{src,tests}/**/Migrations/*.cs]
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1305.severity = none

# --- Razor / views: the UI is Arabic RTL, so no bidi-sensitive formatter churn
[*.cshtml]
indent_size = 4
dotnet_diagnostic.IDE0055.severity = none

# ------------------------------------------------- text hygiene (.cshtml, .md)
# `dotnet format` above does not see .cshtml or .md, so the `charset` /
# `end_of_line` / `insert_final_newline` / `trim_trailing_whitespace` contract
# above had no mechanical enforcer on those two file kinds. It does now:
#
#   scripts/check-text-hygiene.ps1        run it directly, or rely on CI
#   .github/workflows/ci.yml             `build-and-test`, before the build and
#                                        test steps, so drift fails before the
#                                        compiler and the suite spend their time
#   tests/NewVixSmart.Web.Tests/         RazorHygieneTests mirrors every rule,
#     RazorHygieneTests.cs               so a weakened rule or a deleted CI step
#                                        fails the test suite instead of passing
#                                        quietly
#
# The gate is read-only: it reports, it never rewrites. Fixing a finding is the
# editor saving the file per the contract above.
#
#   BLOCKING  R1 invalid UTF-8     R2 U+FFFD        R3 UTF-8 BOM
#             R4 CR / CRLF         R5 final newline (exactly one LF, no
#                                    trailing blank lines)
#             R6 trailing whitespace              R7/R9 tab indentation
#   WARNING   R8 CJK/Hangul/Cyrillic/Greek/Hebrew inside an Arabic-dominant
#               line, outside code fences            (judgement call, not a failure)
#             R10 tab used as a column separator     (judgement call, not a failure)
#
# Excluded on purpose, listed by `-ListExclusions`: EF-generated
# Migrations/*.Designer.cs, the vendored wwwroot/lib tree, bin/obj, and the
# local output folders (TestResults, artifacts, screenshots, test-results).
#
# `[*.md] trim_trailing_whitespace = false` above is the one rule this gate does
# not take at face value: Markdown hard line breaks are exactly two trailing
# spaces, so R6 exempts that shape and still blocks every other trailing space.
# A whitespace-only line is not a hard break and is still reported.
