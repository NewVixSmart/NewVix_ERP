root = true

# ---------------------------------------------------------------- formatting

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 160

[*.{json,yml,yaml,js,mjs,cjs,css,scss,html}]
indent_size = 2

[*.{csproj,props,targets,slnx,config}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# ---------------------------------------------------------------- C#

[*.cs]
# --- language conventions
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion

# --- readability: a file may declare one top-level type, and that type matches the file name
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
dotnet_style_prefer_conditional_expression_over_return = false:suggestion
dotnet_style_object_initializer = true:suggestion
dotnet_style_collection_initializer = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_null_propagation = true:suggestion

# --- naming: private fields are _camelCase
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

dotnet_naming_rule.types_pascal.symbols = types
dotnet_naming_rule.types_pascal.style = pascal_case
dotnet_naming_rule.types_pascal.severity = warning
dotnet_naming_symbols.types.applicable_kinds = class,struct,interface,enum,delegate
dotnet_naming_symbols.types.applicable_accessibilities = *
dotnet_naming_style.pascal_case.capitalization = pascal_case

# --- formatting
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_space_between_method_call_parameter_list_parentheses = false
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = true

# --- correctness / suspicious code
# Severities stay at suggestion on purpose: this file is a style guide, not a build gate.
# `TreatWarningsAsErrors` is on, so promoting any of these to warning would fail the build on
# the existing code (including the historical migrations) instead of guiding new code.
dotnet_diagnostic.CA1822.severity = none          # MVC actions legitimately do not use the instance
dotnet_diagnostic.CA2007.severity = none          # the project intentionally awaits without ConfigureAwait
dotnet_diagnostic.CA1031.severity = none          # the global exception filter is the boundary
dotnet_diagnostic.CA1848.severity = suggestion    # LoggerMessage delegates
dotnet_diagnostic.CA1305.severity = suggestion    # StringComparison / IFormatProvider must be explicit
dotnet_diagnostic.CA1861.severity = suggestion    # no constant arrays as arguments
dotnet_diagnostic.CA1852.severity = suggestion    # seal internal types
# NOT enforced anywhere today, on purpose. There is no `dotnet format --verify-no-changes`
# step in .github/workflows/ci.yml and no EnforceCodeStyleInBuild, because neither
# passes on the current tree (measured 2026-09-29 on a Release build):
#   dotnet format NewVixSmart.slnx --verify-no-changes --no-restore  ->  exit 2,
#   13922 findings across 236 .cs files:
#     ENDOFLINE    12224 findings /  69 files  (working tree is CRLF on this
#                                                  checkout; goes away once
#                                                  .gitattributes is renormalised)
#     IDE0011       1132 findings /  92 files  (add braces)
#     WHITESPACE     268 findings /  23 files
#     FINALNEWLINE   107 findings / 107 files
#     CHARSET         81 findings /  81 files
#     IDE1006         53 findings /  30 files  (naming)
#     IDE0161         37 findings /  37 files  (file-scoped namespace)
#     IMPORTS         18 findings /  18 files
#     IDE0065          2 findings /   2 files
# Turning this on is a whole-tree reformat, so it needs its own change. Until
# then this rule is guidance for new code, not a gate.
dotnet_diagnostic.IDE0055.severity = none

# --- historical migrations are frozen: they describe schemas that no longer exist
[{src,tests}/**/Migrations/*.cs]
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1305.severity = none

# --- Razor / views: the UI is Arabic RTL, so no bidi-sensitive formatter churn
[*.cshtml]
indent_size = 4
dotnet_diagnostic.IDE0055.severity = none
